---
/**
 * «Lo que vendes, en 1 minuto» (docs/PLAYBOOK.md §Aprender): el producto contado en orden, un paso por bloque, cada uno
 * con su imagen grande (QR → pide o manda → pantalla → álbum → resultado). Lo escribe la empresa en tenant.tour.
 * «Entendido» lo marca como hecho y lleva a «Qué ofrecemos».
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Phone from '~/modules/phone-tour/Phone.astro';
import ScreenMini from '~/modules/live-screen/ScreenMini.astro';
import ReportMini from '~/modules/live-screen/ReportMini.astro';
import { phoneTourSchema } from '~/modules/phone-tour/schema';
import AppScreen from '~/modules/app-steps/Screen.astro';
import ConsoleMini from '~/modules/center-console/ConsoleMini.astro';
import { APP_SCREENS, appStepsSchema, type AppScreen as AppScreenName } from '~/modules/app-steps/schema';
import { i18n } from '~/lib/i18n';
import { learnMessages } from '~/lib/i18n/messages/learn';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const pb = admin.playbook;
const { m } = i18n(Astro, learnMessages);
const fromWelcome = Astro.url.searchParams.get('from') === 'welcome';
if (Astro.request.method === 'POST') {
  await pb.markLearned('tour', true);
  return Astro.redirect(fromWelcome ? '/admin/welcome?step=2' : '/admin/learn?ok=tour#offer', 303);
}
const back = fromWelcome ? { href: '/admin/welcome?step=2', label: m.tour.backWelcome } : { href: '/admin/learn', label: m.tour.back };
const { tour, kit } = await pb.learnIndex();
const steps = tour.steps;
// Cada paso, con la UI de verdad cuando la hay (móvil, pantalla, informe); si no, su foto.
const phoneProps = kit.phone ? phoneTourSchema.safeParse(kit.phone) : null;
// Cada pantalla, con los datos de ejemplo del módulo que la enseña (si no, los del primero).
const appFor = (screen: string) => {
  const raw = (kit.apps ?? []).find((x) => Array.isArray(x.screens) && (x.screens as Array<{ screen?: string }>).some((y) => y.screen === screen)) ?? kit.app ?? {};
  const r = appStepsSchema.partial().safeParse(raw);
  return { sample: appStepsSchema.shape.sample.parse(r.success ? r.data.sample ?? {} : {}), photo: r.success ? r.data.photo ?? null : null };
};
const uiOf = (ui: string | null | undefined) => {
  if (!ui) return null;
  if (ui.startsWith('phone:') && phoneProps?.success) return { kind: 'phone' as const, only: ui.slice(6) };
  if (ui.startsWith('screen:') && kit.screen) return { kind: 'screen' as const, scenes: ui.slice(7).split(',') };
  if (ui === 'report') return { kind: 'report' as const };
  // Oquea: un móvil con la pantalla de la app (app-steps) o la consola del centro en pequeño (center-console).
  if (ui.startsWith('app:') && kit.app && (APP_SCREENS as readonly string[]).includes(ui.slice(4))) return { kind: 'app' as const, screen: ui.slice(4) as AppScreenName };
  if (ui.startsWith('console:') && kit.console) return { kind: 'console' as const, view: ui.slice(8) };
  return null;
};
---
<AdminLayout title={m.tourCard.title} wide>
  <div class="mx-auto grid max-w-5xl grid-cols-[minmax(0,1fr)] gap-14 pb-10" data-testid="tour">
    <div class="grid gap-6">
      <a href={back.href} class="inline-flex w-fit items-center gap-1 text-sm text-muted hover:text-ink"><Icon name="chevron-left" size={14} />{back.label}</a>
      <header class="grid gap-3">
        <p class="text-eyebrow">{m.tour.eyebrow}</p>
        <h1 class="co-page-title !text-5xl">{m.tour.title}</h1>
        <p class="co-lede !text-lg">{m.tour.lede}</p>
      </header>
    </div>

    {steps.length === 0 ? (
      <div class="grid gap-4">
        <p class="co-lede">{m.tour.empty}</p>
        <a class="co-btn co-btn--primary w-fit" href="/admin/learn#offer">{m.tour.seeOffer} <span aria-hidden="true">→</span></a>
      </div>
    ) : <>
      <ol class="tour grid gap-16 p-0">
        {steps.map((s, i) => (
          <li class="tour__step grid list-none items-center gap-6 md:grid-cols-2 md:gap-12" data-testid="tour-step">
            {uiOf(s.ui) ? (() => { const u = uiOf(s.ui)!; return (
              <figure class:list={['tour__frame tour__frame--ui', i % 2 === 1 && 'md:order-2']} data-testid="tour-ui" data-ui={u.kind}>
                <span class="tour__glow" aria-hidden="true"></span>
                {u.kind === 'phone' && phoneProps?.success && <Phone {...phoneProps.data} only={u.only} zoom={0.78} float />}
                {u.kind === 'screen' && <div class="tour__screen"><ScreenMini props={kit.screen} scenes={u.scenes} /></div>}
                {u.kind === 'report' && <ReportMini photo={kit.photo} />}
                {u.kind === 'app' && <div class="tn-ui tour__app"><AppScreen screen={u.screen} sample={appFor(u.screen).sample} center={m.tour.yourCentre} photo={appFor(u.screen).photo} zoom={0.78} /></div>}
                {u.kind === 'console' && <div class="tn-ui tour__screen"><ConsoleMini props={kit.console} view={u.view} center={m.tour.yourCentre} /></div>}
              </figure>
            ); })() : s.image ? (
              <figure class:list={['tour__frame', i % 2 === 1 && 'md:order-2']}>
                <img src={s.image} alt="" class="tour__blur" loading={i < 2 ? 'eager' : 'lazy'} />
                <img src={s.image} alt={s.title} class="tour__img co-img" decoding="async" loading={i < 2 ? 'eager' : 'lazy'} />
              </figure>
            ) : <span class:list={['hidden md:block', i % 2 === 1 && 'md:order-2']}></span>}
            <div class="grid content-center gap-4">
              <span class="co-figure text-6xl text-[color:var(--co-signal)]">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="text-3xl font-bold leading-tight sm:text-4xl">{s.title}</h2>
              {s.body && <p class="max-w-md text-lg leading-relaxed text-muted">{s.body}</p>}
            </div>
          </li>
        ))}
      </ol>

      <form method="post" class="grid justify-items-center gap-3 text-center">
        <span class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-[color:var(--co-signal-soft)] text-[color:var(--co-signal)]" aria-hidden="true"><Icon name="sparkles" size={30} /></span>
        <button class="co-btn co-btn--primary" type="submit" data-testid="tour-got">{fromWelcome ? m.tour.got : m.tour.gotNext} <span aria-hidden="true">→</span></button>
      </form>
    </>}
  </div>
</AdminLayout>

<style>
  /* Marco de imagen: la misma foto, difuminada, rellena el fondo; delante, entera. Sirve para móvil vertical y pantalla. */
  .tour__frame { position: relative; isolation: isolate; margin: 0; display: grid; place-items: center; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--console-radius-card, 1.25rem); background: var(--tn-dark, #121014); }
  .tour__blur { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; filter: blur(24px) saturate(1.2); opacity: .7; transform: scale(1.2); }
  /* Con UI: el producto de verdad, sobre un brillo de su color. */
  .tour__frame--ui { aspect-ratio: auto; min-height: 22rem; padding: 1.5rem; background: var(--tn-dark, #0d0a12); }
  .tour__glow { position: absolute; inset: 0; z-index: -1; background: radial-gradient(ellipse at 50% 35%, color-mix(in srgb, var(--tn-primary, #ff27bb) 32%, transparent), transparent 60%), radial-gradient(ellipse at 20% 90%, color-mix(in srgb, var(--tn-accent, #e1ff00) 12%, transparent), transparent 50%); }
  .tour__screen { width: 100%; }
  .tour__app { display: grid; place-items: center; filter: drop-shadow(0 24px 40px rgb(0 0 0 / .35)); }
  @media (max-width: 480px) { .tour__app :global(.as-phone) { zoom: .62 !important; } }
  .tour__img { max-width: 88%; max-height: 88%; object-fit: contain; border-radius: .75rem; box-shadow: 0 20px 50px rgba(0,0,0,.45); }
</style>
