---
/**
 * Aprende (docs/PLAYBOOK.md §Aprender). El título sale al momento; el progreso y los cuatro pasos llegan en un bloque
 * aparte con su shimmer (docs/UX_REVIEW.md §Carga).
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import Shimmer from '~/components/ui/Shimmer.astro';
import LearnBody from '~/components/admin/learn/LearnBody.astro';
import { i18n } from '~/lib/i18n';
import { learnMessages } from '~/lib/i18n/messages/learn';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
if (Astro.request.method === 'POST') {
  await admin.playbook.markSeen();
  return Astro.redirect('/admin/learn', 303);
}
const { locale } = i18n(Astro, learnMessages);
const m = learnMessages[locale];
---
<AdminLayout title={m.title} wide>
  <div class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)] gap-14 pb-10">
    <header class="grid gap-6">
      <div class="grid gap-3">
        <p class="text-eyebrow">{m.eyebrow}</p>
        <h1 class="co-page-title !text-5xl">{m.title}</h1>
        <p class="co-lede !text-lg">{m.lede}</p>
      </div>
    </header>

    <LearnBody server:defer ok={Astro.url.searchParams.get('ok')}>
      <Shimmer slot="fallback" variant="cards" count={6} />
    </LearnBody>
  </div>
</AdminLayout>
