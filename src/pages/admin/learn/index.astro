---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { i18n } from '~/lib/i18n';
import { playbookMessages } from '~/lib/i18n/messages/playbook';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const pb = admin.playbook;
if (Astro.request.method === 'POST') {
  await pb.markSeen();
  return Astro.redirect('/admin/learn', 303);
}
const [idx, market] = await Promise.all([pb.learnIndex(), pb.market()]);
const pct = Math.round((idx.progress.done / Math.max(1, idx.progress.total)) * 100);
const { m: msg, f } = i18n(Astro, playbookMessages);
const date = (iso: string) => f.date(iso, { day: 'numeric', month: 'short' });
---
<AdminLayout title={msg.learn.title}>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-eyebrow mb-3">{msg.learn.eyebrow}</p>
      <h1 class="co-page-title">{msg.learn.title}</h1>
      <p class="text-sm text-muted">{msg.learn.lede}</p>
    </div>
    <div class="w-56" data-testid="progress">
      <div class="flex justify-between text-xs font-semibold"><span>{msg.learn.progress}</span><span>{idx.progress.done}/{idx.progress.total}</span></div>
      <div class="co-progress mt-1"><span style={`width:${pct}%`}></span></div>
    </div>
  </div>

  {(idx.news.length > 0 || idx.newTips > 0) && (
    <section class="mt-6 co-card co-card--soft" data-testid="news">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="co-card-title">{msg.learn.news}</h2>
        <form method="post"><button class="text-xs font-semibold underline" type="submit">{msg.learn.markSeen}</button></form>
      </div>
      <ul class="mt-2 space-y-1 p-0 text-sm">
        {idx.news.map((n) => (
          <li class="list-none">
            <a class="font-semibold underline-offset-2 hover:underline" href={`/admin/learn/${n.topic}#play-${n.playId}`}>{n.title}</a>
            <span class="text-muted"> · {n.topicName} · {date(n.at)}</span>
            {n.note && <span class="text-muted"> — {n.note}</span>}
          </li>
        ))}
        {idx.newTips > 0 && <li class="list-none">{msg.learn.newTips(idx.newTips)}</li>}
      </ul>
    </section>
  )}

  <a href="/admin/learn/general" class="mt-6 flex items-center gap-4 co-card hover:border-ink" data-testid="topic-general">
    <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-ink text-xl text-bg">1</span>
    <span class="min-w-0 flex-1">
      <span class="block text-lg font-bold">{msg.learn.startHere}</span>
      <span class="block text-sm text-muted">{msg.learn.generalMeta(idx.general.playCount)}</span>
    </span>
    {idx.general.learned ? <span class="co-badge co-badge--ink">{msg.learn.learned}</span> : <span class="text-sm font-semibold">{msg.learn.start}</span>}
  </a>

  {market.length > 0 && (
    <>
      <h2 class="mt-8 text-lg font-bold">{msg.learn.whoWeSell}</h2>
      <p class="text-sm text-muted">{msg.learn.whoLede}</p>
      <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-testid="segments">
        {market.map((sg) => (
          <a href={`/admin/learn/sector/${sg.key}`} class="flex flex-col co-card hover:border-ink" data-testid="segment">
            <span class="font-bold">{sg.name}</span>
            {sg.description && <span class="mt-1 text-sm text-muted">{sg.description}</span>}
            <span class="mt-auto pt-3 text-xs text-muted">{msg.learn.segmentMeta(sg.personas.length, sg.modules.length, sg.playCount)}</span>
          </a>
        ))}
      </div>
    </>
  )}

  <h2 class="mt-8 text-lg font-bold">{msg.learn.modulesTitle}</h2>
  <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-testid="topics">
    {idx.modules.map((m) => (
      <a href={`/admin/learn/${m.moduleId}`} class="flex flex-col co-card hover:border-ink" data-testid="topic">
        <span class="flex items-start gap-2">
          <span class="min-w-0 flex-1 font-bold">{m.name}</span>
          {m.learned && <span class="co-badge co-badge--ink">✓</span>}
        </span>
        {m.description && <span class="mt-1 text-sm text-muted">{m.description}</span>}
        <span class="mt-auto pt-3 text-xs text-muted">
          {m.playCount ? msg.learn.playCount(m.playCount) : <span class="text-amber-700">{msg.learn.noPlaysYet}</span>}
          {m.tipCount > 0 && msg.learn.teamCount(m.tipCount)}
        </span>
      </a>
    ))}
  </div>
</AdminLayout>
