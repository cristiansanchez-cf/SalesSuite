---
import AdminLayout from '~/layouts/AdminLayout.astro';
import PlayCard from '~/components/playbook/PlayCard.astro';
import TipCard from '~/components/playbook/TipCard.astro';
import { flash, formAction } from '~/lib/admin/forms';
import { AdminError } from '~/lib/admin/service';
import { LEARN_FLASH, learnAction } from '~/lib/playbook/forms';
import { PLAY_KINDS } from '~/lib/playbook/types';
import { i18n } from '~/lib/i18n';
import { playbookMessages } from '~/lib/i18n/messages/playbook';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const pb = admin.playbook;
const { m: msg, locale } = i18n(Astro, playbookMessages);
const topicId = Astro.params.topic ?? '';
if (topicId !== 'general' && !/^[0-9a-f-]{36}$/.test(topicId)) return Astro.rewrite('/404');

let result: { error: string | null; details: string[] } = { error: null, details: [] };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  let ok = '';
  result = await formAction(async () => { ok = await learnAction(pb, f, { moduleId: topicId === 'general' ? null : topicId, topic: topicId }); });
  if (!result.error) return Astro.redirect(`/admin/learn/${topicId}${ok && ok !== 'vote' ? `?ok=${ok}` : ''}${Astro.url.hash}`, 303);
}

let view;
let fit: Awaited<ReturnType<typeof pb.moduleFit>> = [];
try {
  view = await pb.topic(topicId);
  if (topicId !== 'general') fit = await pb.moduleFit(topicId);
} catch (e) {
  if (e instanceof AdminError && e.status === 404) return Astro.rewrite('/404');
  throw e;
}
const okMsg = flash(Astro.url, LEARN_FLASH(locale));
const partner = admin.session.partner ?? null;
const field = 'co-input';
---
<AdminLayout title={view.name} wide>
  <a href="/admin/learn" class="text-sm text-muted hover:text-ink">{msg.common.backLearn}</a>
  <p class="text-eyebrow mb-3 mt-3">{msg.topic.eyebrow}</p>
  <div class="flex flex-wrap items-center gap-3">
    <h1 class="min-w-0 flex-1 co-page-title">{view.name}</h1>
    <form method="post">
      <input type="hidden" name="action" value="learned" /><input type="hidden" name="done" value={view.learned ? '0' : '1'} />
      <button class:list={['co-btn', view.learned ? 'co-btn--ghost' : 'co-btn--primary']} type="submit" data-testid="learned">
        {view.learned ? msg.learn.learned : msg.topic.markLearned}
      </button>
    </form>
  </div>
  {view.module?.description && <p class="text-muted">{view.module.description}</p>}
  {okMsg && <p class="mt-3 co-alert co-alert--success" role="status">{okMsg}</p>}
  {result.error && (
    <div class="mt-3 co-alert co-alert--rejection" role="alert">
      <p class="font-semibold">{result.error}</p>
      {result.details.length > 0 && <ul class="list-disc pl-5">{result.details.map((d) => <li>{d}</li>)}</ul>}
    </div>
  )}

  <div class:list={['mt-6 grid gap-6', view.module && 'xl:grid-cols-[minmax(0,1fr)_minmax(0,30rem)]']}>
    <div class="space-y-8">
      {fit.length > 0 && (
        <section class="co-card" data-testid="module-fit">
          <h2 class="text-eyebrow">{msg.topic.fitTitle}</h2>
          <div class="mt-3 grid gap-3 md:grid-cols-2">
            {fit.map((f) => (
              <div class="rounded-xl bg-surface p-3 text-sm">
                <a class="font-bold underline-offset-2 hover:underline" href={`/admin/learn/sector/${f.segment.key}`}>{f.segment.name}</a>
                {f.fit?.priority === 1 && <span class="ml-1 text-xs">★</span>}
                {f.fit?.fit && <p class="text-muted">{f.fit.fit}</p>}
                {f.angles.length > 0 && <ul class="mt-1 space-y-0.5 p-0">{f.angles.map((a) => <li class="list-none"><strong>{a.persona}:</strong> {a.angle}</li>)}</ul>}
              </div>
            ))}
          </div>
        </section>
      )}
      {view.sections.length === 0 && (
        <p class="rounded-2xl border border-dashed border-line p-8 text-center text-muted">
          {msg.topic.empty}
        </p>
      )}
      {view.sections.map((sec) => (
        <section>
          <h2 class="mb-3 text-eyebrow">{msg.kind[sec.kind]}</h2>
          <div class="space-y-3">{sec.plays.map((p) => <PlayCard play={p} adminEdit={pb.isAdmin} canPropose />)}</div>
        </section>
      ))}

      <section data-testid="team">
        <h2 class="mb-3 text-eyebrow">{msg.topic.teamTitle}</h2>
        <div class="space-y-3">
          {view.tips.map((t) => <TipCard tip={t} mine={t.authorId === admin.session.userId} />)}
          {view.tips.length === 0 && <p class="text-sm text-muted">{partner ? msg.topic.teamEmptyPartner : msg.topic.teamEmpty}</p>}
        </div>
        <form method="post" class="mt-4 space-y-2 co-card" data-testid="tip-form">
          <input type="hidden" name="action" value="tip" />
          <h3 class="font-bold">{msg.topic.shareTitle}</h3>
          <p class="text-xs text-muted">{partner ? msg.topic.shareHelpPartner : msg.topic.shareHelp}</p>
          <div class="grid gap-2 sm:grid-cols-[1fr_12rem]">
            <input class={field} name="title" required maxlength="200" placeholder={msg.topic.titlePlaceholder} />
            <select class={field} name="kind" aria-label={msg.topic.type}>
              {PLAY_KINDS.filter((k) => !partner || k !== 'monetization').map((k) => <option value={k} selected={k === 'tip'}>{msg.kind[k]}</option>)}
            </select>
          </div>
          <textarea class={`${field} h-24`} name="body" required maxlength="4000" placeholder={msg.topic.bodyPlaceholder}></textarea>
          <button class="co-btn co-btn--primary" type="submit">{partner ? msg.topic.submitPartner : msg.topic.submit}</button>
        </form>
      </section>

      {view.myOpen.length > 0 && (
        <section>
          <h2 class="mb-3 text-eyebrow">{msg.topic.mine}</h2>
          <div class="space-y-3">{view.myOpen.map((t) => <TipCard tip={t} mine />)}</div>
        </section>
      )}
    </div>

    {view.module && (
      <aside>
        <div class="xl:sticky xl:top-4">
          <p class="mb-2 text-sm font-bold">{msg.topic.clientView}</p>
          <iframe title={msg.topic.previewOf(view.name)} src={`/admin/learn/preview/${view.module.moduleId}`} class="h-[70vh] w-full co-card" loading="lazy"></iframe>
        </div>
      </aside>
    )}
  </div>
</AdminLayout>
