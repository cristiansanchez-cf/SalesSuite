---
/**
 * Bienvenida paso a paso (docs/FOUNDATIONS.md §4.1 y §6): una idea por pantalla, poco texto, y se termina HACIENDO algo
 * (la primera propuesta). Es igual para todos (el CEO también vende); preparar el espacio es otra cosa: tarjeta en Inicio.
 * «Empieza aquí» (/admin/start) queda como resumen para volver a consultar.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Alert from '~/components/ui/Alert.astro';
import { BRAND } from '~/lib/site';
import { AdminError } from '~/lib/admin/service';
import { createDossierSchema } from '~/lib/admin/ops';
import { markOnboarded, needsCompanySetup } from '~/lib/onboarding';
import { i18n, LOCALES, LOCALE_NAME } from '~/lib/i18n';
import { welcomeMessages } from '~/lib/i18n/messages/welcome';
import { ICONS, type IconName } from '~/lib/ui/icons';
import { summarize } from '~/lib/playbook/markdown';
import Thumb from '~/modules/Thumb.astro';
import KitCover from '~/modules/KitCover.astro';
import { isBlockType } from '~/modules/registry';

const { admin, tenant } = Astro.locals;
if (!admin || !tenant) return Astro.redirect('/admin/login');
// Primer admin de un espacio vacío: antes que la bienvenida de comercial, preparar la empresa.
if (Astro.request.method === 'GET' && await needsCompanySetup(admin)) return Astro.redirect('/admin/setup/ia?first=1');
const { m, f, locale } = i18n(Astro, welcomeMessages);
const partner = admin.session.role === 'partner';
const KEYS = ['hello', 'sell', 'who', 'how', 'terms', 'first'] as const;
type Key = (typeof KEYS)[number];
const ICON: Record<Key, IconName> = { hello: 'sparkles', sell: 'boxes', who: 'target', how: 'book-open', terms: 'wallet', first: 'file-text' };
const total = KEYS.length;
const n = Math.min(total, Math.max(1, Number(Astro.url.searchParams.get('step') ?? '1') || 1));
const key = KEYS[n - 1] as Key;
const home = partner ? '/admin' : '/admin/inicio';

let error: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  if (action === 'skip' || action === 'later') {
    await markOnboarded(admin);
    return Astro.redirect(home, 303);
  }
  if (action === 'create') {
    const company = String(form.get('company') ?? '').trim();
    const parsed = createDossierSchema.safeParse({ title: company ? m.first.proposalTitle(company) : '', prospectCompany: company });
    if (!company || !parsed.success) error = m.first.company;
    else {
      try {
        const id = await admin.service.createDossier(parsed.data);
        await markOnboarded(admin);
        return Astro.redirect(`/admin/dossiers/${id}`, 303);
      } catch (e) {
        if (!(e instanceof AdminError)) throw e;
        error = e.message;
      }
    }
  }
}

const first = (admin.session.displayName || admin.session.email).split(/[\s@]/)[0];
const [catalog, learn, segments, plays, terms] = await Promise.all([
  key === 'sell' ? admin.service.catalog().catch(() => []) : [],
  key === 'sell' ? admin.playbook.learnIndex().catch(() => null) : null,
  key === 'who' ? admin.playbook.market().catch(() => []) : [],
  key === 'how' ? admin.playbook.listAllVisible().catch(() => []) : [],
  key === 'terms' ? admin.commissions.myConditions().catch(() => null) : null,
]);
const sectors = segments.filter((s) => s.status !== 'archived').slice(0, 4);
// Con datos suficientes, las que más ganan (el orden ya viene de la evidencia); sin ellos, las fijadas por el líder.
const ranked = key === 'how' ? await admin.evidence.ranking().catch(() => []) : [];
const pinned = plays.filter((p) => p.pinned).sort((a, b) => (a.pinned ?? 9) - (b.pinned ?? 9));
const topPlays = ranked.length
  ? ranked.slice(0, 3).map((r) => plays.find((p) => p.id === r.play.id)).filter((p): p is (typeof plays)[number] => !!p)
  : (pinned.length ? pinned : [...plays].sort((a, b) => a.position - b.position)).slice(0, 3);
const href = (i: number) => `/admin/welcome?step=${i}`;
const sectorIcon = (i: string | null) => (i && i in ICONS ? i : 'target') as IconName;
const priceOf = new Map(catalog.map((c) => [c.moduleId, c]));
const offer = (learn?.modules ?? []).filter((x) => priceOf.has(x.moduleId)).slice(0, 4);
const tourSteps = learn?.tour.steps.filter((x) => x.image) ?? [];
const tourCover = tourSteps[Math.floor(tourSteps.length / 2)]?.image ?? null;
---
<AdminLayout title={m.title} bare>
  <div class="mx-auto mt-4 grid max-w-xl grid-cols-[minmax(0,1fr)] gap-6 sm:mt-10" data-testid="welcome" data-step={key}>
    <div class="flex items-center justify-between gap-3">
      <span><span class="co-wordmark">{BRAND.wordmark}</span> <span class="co-sidebar__app">· {tenant.name}</span></span>
      <form method="post"><input type="hidden" name="action" value="skip" /><button class="co-btn co-btn--quiet co-btn--sm" type="submit" data-testid="welcome-skip">{m.skip}</button></form>
    </div>
    <!-- Idioma: se elige aquí mismo y se guarda en la cuenta (por defecto, español). -->
    <form method="post" action="/admin/locale" class="co-chips !gap-1.5" data-testid="welcome-locale">
      <input type="hidden" name="back" value={Astro.url.pathname + Astro.url.search} />
      {LOCALES.map((l) => <button type="submit" name="locale" value={l} class="co-chip !min-h-[28px] !px-2.5 !text-xs" aria-pressed={l === locale ? 'true' : 'false'} lang={l} data-testid={`welcome-locale-${l}`}>{LOCALE_NAME[l]}</button>)}
    </form>

    <div class="grid gap-2">
      <span class="co-meta" data-testid="welcome-progress">{m.step(n, total)}</span>
      <div class="co-progress" role="progressbar" aria-valuemin={1} aria-valuemax={total} aria-valuenow={n}><span style={`width:${Math.round((n / total) * 100)}%`}></span></div>
    </div>

    <section class="co-card grid grid-cols-[minmax(0,1fr)] gap-5 !p-6 sm:!p-8">
      <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-[color:var(--co-signal-soft,#efe9ff)] text-[color:var(--co-signal)]" aria-hidden="true"><Icon name={ICON[key]} size={24} /></span>
      {error && <Alert kind="rejection" title={error} />}

      {key === 'hello' && <>
        <h1 class="co-page-title">{m.hello.title(first)}</h1>
        <p class="co-lede">{m.hello.lede(tenant.name)}</p>
      </>}

      {key === 'sell' && <>
        <h1 class="co-page-title">{m.sell.title}</h1>
        <p class="co-lede">{m.sell.lede}</p>
        {learn && learn.tour.steps.length > 0 && (
          <a href="/admin/learn/tour?from=welcome" class="learn-card min-h-[13rem]" data-testid="welcome-tour">
            {learn.kit.screen || learn.kit.phone ? <KitCover kit={learn.kit} /> : tourCover && <img src={tourCover} alt="" class="learn-card__bg co-img" decoding="async" />}
            <span class="learn-card__shade"></span>
            <span class="learn-card__body !p-5">
              <span class="text-2xl font-bold leading-tight">{m.sell.tour}</span>
              <span class="text-sm text-white/80">{m.sell.tourMeta(learn.tour.steps.length)}</span>
              <span class="learn-cta !mt-1 !py-2 text-sm">{m.sell.tourGo} <span aria-hidden="true">→</span></span>
            </span>
          </a>
        )}
        {offer.length === 0 ? (catalog.length === 0 && <p class="co-help">{m.sell.empty}</p>) : (
          <div class="grid grid-cols-2 gap-3">{offer.map((x) => {
            const c = priceOf.get(x.moduleId)!;
            return (
              <a href={`/admin/learn/preview/${x.moduleId}`} target="_blank" rel="noopener" class="learn-card min-h-[9rem]" data-testid="welcome-module">
                {isBlockType(x.blockType)
                  ? <Thumb blockType={x.blockType} props={x.props} price={partner ? null : x.price} small />
                  : x.cover
                  ? <img src={x.cover} alt="" class="learn-card__bg co-img" decoding="async" loading="lazy" />
                  : <iframe src={`/admin/learn/preview/${x.moduleId}`} title="" aria-hidden="true" tabindex="-1" loading="lazy" class="learn-card__bg learn-card__ui"></iframe>}
                <span class="learn-card__shade"></span>
                <span class="learn-card__body !gap-1 !p-4">
                  <span class="font-bold leading-tight">{x.name}</span>
                  {!partner && c.defaultPrice != null && <span class="text-xs text-white/80">{m.sell.from(f.money(c.defaultPrice, c.currency))}</span>}
                </span>
              </a>
            );
          })}</div>
        )}
      </>}

      {key === 'who' && <>
        <h1 class="co-page-title">{m.who.title}</h1>
        <p class="co-lede">{m.who.lede}</p>
        {sectors.length === 0 ? <p class="co-help">{m.who.empty}</p> : (
          <div class="grid grid-cols-2 gap-3">{sectors.map((s) => (
            <a class="learn-card min-h-[10rem]" href={`/admin/learn/sector/${s.key}?from=welcome`} data-testid="welcome-sector">
              {s.image ? <img src={s.image} alt="" class="learn-card__bg co-img" decoding="async" loading="lazy" /> : null}
              <span class="learn-card__shade"></span>
              <span class="learn-card__body !gap-1 !p-4">
                {!s.image && <Icon name={sectorIcon(s.icon)} size={22} />}
                <span class="text-lg font-bold leading-tight">{s.name}</span>
              </span>
            </a>))}
          </div>
        )}
        <p class="co-help">{m.who.tap}</p>
      </>}

      {key === 'how' && <>
        <h1 class="co-page-title">{m.how.title}</h1>
        <p class="co-lede">{m.how.lede}</p>
        {topPlays.length === 0 ? <p class="co-help">{m.how.empty}</p> : (
          <ul class="grid grid-cols-[minmax(0,1fr)] gap-3 p-0">{topPlays.map((p) => (
            <li class="list-none" data-testid="welcome-play">
              <a class="co-card co-card--link !grid gap-2 !p-4" href={`/admin/learn/${p.moduleId ?? 'general'}#play-${p.id}`}>
                {!ranked.length && p.pinned
                  ? <span class="co-badge co-badge--ink w-fit">{m.how.must}</span>
                  : p.evidence.won > 0
                  ? <span class="co-badge co-badge--signal w-fit">{m.how.proven(p.evidence.won)}</span>
                  : <span class="co-badge w-fit">{m.how.hypothesis}</span>}
                <span class="co-row-title">{p.title}</span>
                <span class="text-sm leading-relaxed text-muted">{summarize(p.body, 260)}</span>
                <span class="flex items-center gap-1 text-sm font-semibold">{m.how.read} <Icon name="chevron-right" size={14} /></span>
              </a>
            </li>))}
          </ul>
        )}
      </>}

      {key === 'terms' && <>
        {terms?.visible ? <>
          <h1 class="co-page-title">{m.terms.title}</h1>
          {terms.note && <p class="co-lede whitespace-pre-line" data-testid="welcome-terms">{terms.note}</p>}
          {terms.plan && terms.plan.rules.length > 0 && <ul class="grid gap-1">{terms.plan.rules.map((r) => <li class="co-row-title">{r.label}</li>)}</ul>}
          <span class="co-badge co-badge--signal w-fit">{m.terms.agreed}</span>
        </> : <>
          <h1 class="co-page-title">{m.terms.pendingTitle}</h1>
          <p class="co-lede" data-testid="welcome-terms-pending">{m.terms.pending}</p>
        </>}
        <p class="co-help">{m.terms.more}</p>
      </>}

      {key === 'first' && <>
        <h1 class="co-page-title">{m.first.title}</h1>
        {partner ? <>
          <p class="co-lede">{m.first.partner}</p>
          <form method="post"><input type="hidden" name="action" value="later" /><button class="co-btn co-btn--primary" type="submit" data-testid="welcome-finish">{m.first.partnerGo} <span aria-hidden="true">→</span></button></form>
        </> : <>
          <p class="co-lede">{m.first.lede}</p>
          <form method="post" class="grid gap-3" data-testid="welcome-create">
            <input type="hidden" name="action" value="create" />
            <label class="co-field">{m.first.company}<input class="co-input" name="company" required maxlength="100" placeholder={m.first.companyPlaceholder} autofocus /></label>
            <button class="co-btn co-btn--primary w-fit" type="submit">{m.first.create} <span aria-hidden="true">→</span></button>
          </form>
          <form method="post"><input type="hidden" name="action" value="later" /><button class="co-btn co-btn--quiet co-btn--sm" type="submit" data-testid="welcome-later">{m.first.later}</button></form>
        </>}
        <p class="co-help"><a class="underline" href="https://cofundo.io/tutorial" target="_blank" rel="noopener">{m.first.cerebro}</a></p>
      </>}
    </section>

    {key !== 'first' && (
      <div class="flex items-center justify-between gap-3">
        {n > 1 ? <a class="co-btn co-btn--ghost" href={href(n - 1)} data-testid="welcome-back"><Icon name="chevron-left" size={16} />{m.back}</a> : <span></span>}
        <a class="co-btn co-btn--primary" href={href(n + 1)} data-testid="welcome-next">{n === 1 ? m.start : m.next} <span aria-hidden="true">→</span></a>
      </div>
    )}
    {key === 'first' && n > 1 && <a class="co-btn co-btn--ghost w-fit" href={href(n - 1)} data-testid="welcome-back"><Icon name="chevron-left" size={16} />{m.back}</a>}
  </div>
</AdminLayout>
