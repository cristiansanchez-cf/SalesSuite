---
/**
 * Bienvenida paso a paso (docs/FOUNDATIONS.md §4.1 y §6): una idea por pantalla, poco texto, y se termina HACIENDO algo
 * (la primera propuesta). Admins y jefes/as tienen además un paso para preparar al equipo.
 * «Empieza aquí» (/admin/start) queda como resumen para volver a consultar.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Alert from '~/components/ui/Alert.astro';
import { BRAND } from '~/lib/site';
import { can } from '~/lib/admin/permissions';
import { AdminError } from '~/lib/admin/service';
import { createDossierSchema } from '~/lib/admin/ops';
import { markOnboarded } from '~/lib/onboarding';
import { i18n } from '~/lib/i18n';
import { welcomeMessages } from '~/lib/i18n/messages/welcome';
import type { IconName } from '~/lib/ui/icons';

const { admin, tenant } = Astro.locals;
if (!admin || !tenant) return Astro.redirect('/admin/login');
const { m, f } = i18n(Astro, welcomeMessages);
const partner = admin.session.role === 'partner';
const manager = can(admin.session.role).manageTeam;
const KEYS = ['hello', 'sell', 'who', 'how', 'terms', ...(manager ? ['team'] : []), 'first'] as const;
type Key = (typeof KEYS)[number];
const ICON: Record<Key, IconName> = { hello: 'sparkles', sell: 'boxes', who: 'target', how: 'book-open', terms: 'wallet', team: 'users', first: 'file-text' };
const total = KEYS.length;
const n = Math.min(total, Math.max(1, Number(Astro.url.searchParams.get('step') ?? '1') || 1));
const key = KEYS[n - 1] as Key;
const home = partner ? '/admin' : '/admin/inicio';

let error: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  if (action === 'skip' || action === 'later') {
    await markOnboarded(admin);
    return Astro.redirect(home, 303);
  }
  if (action === 'create') {
    const company = String(form.get('company') ?? '').trim();
    const parsed = createDossierSchema.safeParse({ title: company ? m.first.proposalTitle(company) : '', prospectCompany: company });
    if (!company || !parsed.success) error = m.first.company;
    else {
      try {
        const id = await admin.service.createDossier(parsed.data);
        await markOnboarded(admin);
        return Astro.redirect(`/admin/dossiers/${id}`, 303);
      } catch (e) {
        if (!(e instanceof AdminError)) throw e;
        error = e.message;
      }
    }
  }
}

const first = (admin.session.displayName || admin.session.email).split(/[\s@]/)[0];
const [catalog, segments, plays, terms] = await Promise.all([
  key === 'sell' ? admin.service.catalog().catch(() => []) : [],
  key === 'who' ? admin.playbook.market().catch(() => []) : [],
  key === 'how' ? admin.playbook.listAllVisible().catch(() => []) : [],
  key === 'terms' ? admin.commissions.myConditions().catch(() => null) : null,
]);
const sectors = segments.filter((s) => s.status !== 'archived').slice(0, 4);
const topPlays = [...plays].sort((a, b) => b.evidence.won - a.evidence.won || a.position - b.position).slice(0, 3);
const href = (i: number) => `/admin/welcome?step=${i}`;
const TEAM = [
  { label: m.team.catalog, href: '/admin/catalog', icon: 'boxes' as IconName },
  { label: m.team.market, href: '/admin/setup', icon: 'wand-sparkles' as IconName },
  { label: m.team.invite, href: '/admin/team', icon: 'user-plus' as IconName },
  { label: m.team.terms, href: '/admin/commissions/team?tab=plan', icon: 'wallet' as IconName },
];
---
<AdminLayout title={m.title} bare>
  <div class="mx-auto mt-4 grid max-w-xl gap-6 sm:mt-10" data-testid="welcome" data-step={key}>
    <div class="flex items-center justify-between gap-3">
      <span><span class="co-wordmark">{BRAND.wordmark}</span> <span class="co-sidebar__app">· {tenant.name}</span></span>
      <form method="post"><input type="hidden" name="action" value="skip" /><button class="co-btn co-btn--quiet co-btn--sm" type="submit" data-testid="welcome-skip">{m.skip}</button></form>
    </div>

    <div class="grid gap-2">
      <span class="co-meta" data-testid="welcome-progress">{m.step(n, total)}</span>
      <div class="co-progress" role="progressbar" aria-valuemin={1} aria-valuemax={total} aria-valuenow={n}><span style={`width:${Math.round((n / total) * 100)}%`}></span></div>
    </div>

    <section class="co-card grid gap-5 !p-6 sm:!p-8">
      <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-[color:var(--co-signal-soft,#efe9ff)] text-[color:var(--co-signal)]" aria-hidden="true"><Icon name={ICON[key]} size={24} /></span>
      {error && <Alert kind="rejection" title={error} />}

      {key === 'hello' && <>
        <h1 class="co-page-title">{m.hello.title(first)}</h1>
        <p class="co-lede">{m.hello.lede(tenant.name)}</p>
      </>}

      {key === 'sell' && <>
        <h1 class="co-page-title">{m.sell.title}</h1>
        <p class="co-lede">{m.sell.lede}</p>
        {catalog.length === 0 ? <p class="co-help">{m.sell.empty}</p> : (
          <ul class="co-rows">{catalog.slice(0, 6).map((c) => (
            <li><a class="co-row" href={`/admin/learn/preview/${c.moduleId}`} target="_blank" rel="noopener">
              <span class="co-row__main"><span class="co-row-title">{c.moduleName}</span>
                {(c.description || (!partner && c.defaultPrice != null)) && <span class="co-meta">{[c.description, !partner && c.defaultPrice != null ? m.sell.from(f.money(c.defaultPrice, c.currency)) : null].filter(Boolean).join(' · ')}</span>}</span>
              <span class="co-row__chevron"><Icon name="chevron-right" /></span></a></li>))}
          </ul>
        )}
      </>}

      {key === 'who' && <>
        <h1 class="co-page-title">{m.who.title}</h1>
        <p class="co-lede">{m.who.lede}</p>
        {sectors.length === 0 ? <p class="co-help">{m.who.empty}</p> : (
          <ul class="grid gap-3">{sectors.map((s) => (
            <li class="co-inset grid gap-1">
              <span class="co-row-title">{s.name}</span>
              {s.icp && <span class="co-help"><strong>{m.who.icp}:</strong> {s.icp}</span>}
              {s.disqualifiers && <span class="co-help"><strong>{m.who.avoid}:</strong> {s.disqualifiers}</span>}
            </li>))}
          </ul>
        )}
      </>}

      {key === 'how' && <>
        <h1 class="co-page-title">{m.how.title}</h1>
        <p class="co-lede">{m.how.lede}</p>
        {topPlays.length === 0 ? <p class="co-help">{m.how.empty}</p> : (
          <ul class="grid gap-3">{topPlays.map((p) => (
            <li class="co-inset grid gap-2" data-testid="welcome-play">
              <span class="co-row-title">{p.title}</span>
              {p.evidence.won > 0
                ? <span class="co-badge co-badge--signal w-fit">{m.how.proven(p.evidence.won)}</span>
                : <span class="co-badge w-fit">{m.how.hypothesis}</span>}
            </li>))}
          </ul>
        )}
      </>}

      {key === 'terms' && <>
        {terms?.visible ? <>
          <h1 class="co-page-title">{m.terms.title}</h1>
          {terms.note && <p class="co-lede whitespace-pre-line" data-testid="welcome-terms">{terms.note}</p>}
          {terms.plan && terms.plan.rules.length > 0 && <ul class="grid gap-1">{terms.plan.rules.map((r) => <li class="co-row-title">{r.label}</li>)}</ul>}
          <span class="co-badge co-badge--signal w-fit">{m.terms.agreed}</span>
        </> : <>
          <h1 class="co-page-title">{m.terms.pendingTitle}</h1>
          <p class="co-lede" data-testid="welcome-terms-pending">{m.terms.pending}</p>
        </>}
        <p class="co-help">{m.terms.more}</p>
      </>}

      {key === 'team' && <>
        <h1 class="co-page-title">{m.team.title}</h1>
        <p class="co-lede">{m.team.lede}</p>
        <ul class="co-rows">{TEAM.map((t) => (
          <li><a class="co-row" href={t.href} target="_blank" rel="noopener">
            <span class="co-row__lead"><Icon name={t.icon} /></span>
            <span class="co-row__main co-row-title">{t.label}</span>
            <span class="co-meta">{m.team.go}</span></a></li>))}
        </ul>
      </>}

      {key === 'first' && <>
        <h1 class="co-page-title">{m.first.title}</h1>
        {partner ? <>
          <p class="co-lede">{m.first.partner}</p>
          <form method="post"><input type="hidden" name="action" value="later" /><button class="co-btn co-btn--primary" type="submit" data-testid="welcome-finish">{m.first.partnerGo} <span aria-hidden="true">→</span></button></form>
        </> : <>
          <p class="co-lede">{m.first.lede}</p>
          <form method="post" class="grid gap-3" data-testid="welcome-create">
            <input type="hidden" name="action" value="create" />
            <label class="co-field">{m.first.company}<input class="co-input" name="company" required maxlength="100" placeholder={m.first.companyPlaceholder} autofocus /></label>
            <button class="co-btn co-btn--primary w-fit" type="submit">{m.first.create} <span aria-hidden="true">→</span></button>
          </form>
          <form method="post"><input type="hidden" name="action" value="later" /><button class="co-btn co-btn--quiet co-btn--sm" type="submit" data-testid="welcome-later">{m.first.later}</button></form>
        </>}
        <p class="co-help"><a class="underline" href="https://cofundo.io/tutorial" target="_blank" rel="noopener">{m.first.cerebro}</a></p>
      </>}
    </section>

    {key !== 'first' && (
      <div class="flex items-center justify-between gap-3">
        {n > 1 ? <a class="co-btn co-btn--ghost" href={href(n - 1)} data-testid="welcome-back"><Icon name="chevron-left" size={16} />{m.back}</a> : <span></span>}
        <a class="co-btn co-btn--primary" href={href(n + 1)} data-testid="welcome-next">{n === 1 ? m.start : m.next} <span aria-hidden="true">→</span></a>
      </div>
    )}
    {key === 'first' && n > 1 && <a class="co-btn co-btn--ghost w-fit" href={href(n - 1)} data-testid="welcome-back"><Icon name="chevron-left" size={16} />{m.back}</a>}
  </div>
</AdminLayout>
