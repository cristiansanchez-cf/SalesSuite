---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { demoDb } from '~/lib/data/store';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import { i18n, LOCALES, LOCALE_NAME, isLocale, LOCALE_COOKIE } from '~/lib/i18n';
import { shellMessages } from '~/lib/i18n/messages/shell';
import { TIMEZONES } from '~/lib/notify/service';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const setupParam = Astro.url.searchParams.get('setup');
const setup = setupParam === '1' || setupParam === 'recovery';
let { m, locale } = i18n(Astro, shellMessages);
// Colaboradores: siempre sin contraseña (código por email).
const showPassword = admin.session.role !== 'partner';

let error: string | null = null;
let ok: string | null = null;
let name = admin.session.displayName ?? '';
// Teléfono: lo ven los compañeros de zona para llamar o escribir por WhatsApp (docs/ACCOUNTS.md).
const readPhone = async () => (admin.mode === 'supabase' && admin.supabase
  ? ((await admin.supabase.from('users').select('phone').eq('id', admin.session.userId).maybeSingle()).data?.phone as string | null) ?? ''
  : demoDb().users.find((x) => x.id === admin.session.userId)?.phone ?? '');
let phone = await readPhone();

const form = Astro.request.method === 'POST' ? await Astro.request.formData() : null;
let notifyOk = false;
let localeOk = false;
if (form?.get('action') === 'locale') {
  const l = String(form.get('locale') ?? '');
  if (isLocale(l)) {
    await admin.notifications.setLocale(l);
    Astro.cookies.set(LOCALE_COOKIE, l, { path: '/', httpOnly: true, sameSite: 'lax', secure: Astro.url.protocol === 'https:', maxAge: 60 * 60 * 24 * 365 });
    Astro.locals.locale = l;
    ({ m, locale } = i18n(Astro, shellMessages));
    localeOk = true;
  }
} else if (form?.get('action') === 'notify') {
  await admin.notifications.setEmailPref(form.get('notifyEmail') === 'on');
  await admin.notifications.setDailyPref({ daily: form.get('daily') === 'on', timezone: String(form.get('timezone') ?? '') });
  notifyOk = true;
} else if (form) {
  name = String(form.get('name') ?? '').trim().slice(0, 80);
  phone = String(form.get('phone') ?? '').trim().slice(0, 40);
  const password = showPassword ? String(form.get('password') ?? '') : '';
  const confirm = String(form.get('confirm') ?? '');
  if (phone && !/^\+?[\d\s().-]{6,39}$/.test(phone)) error = m.account.errPhone;
  else if (password && password.length < 10) error = m.account.errShort;
  else if (password !== confirm) error = m.account.errMismatch;
  else if (admin.mode === 'supabase' && admin.supabase) {
    const sb = admin.supabase;
    const { error: e } = await sb.auth.updateUser({ ...(password ? { password } : {}), data: { name } });
    if (e) error = e.message.includes('should be different') ? m.account.errSame : m.account.errSave;
    else {
      await sb.from('users').update({ display_name: name || null, phone: phone || null }).eq('id', admin.session.userId);
      if (setup) return Astro.redirect(setupParam === '1' ? '/admin/start' : '/admin', 303);
      ok = m.account.saved;
    }
  } else {
    const u = demoDb().users.find((x) => x.id === admin.session.userId);
    if (u) { u.display_name = name; u.phone = phone || null; }
    ok = password ? m.account.savedDemo : m.account.saved;
  }
}
const emailOn = await admin.notifications.emailPref();
const dailyPref = await admin.notifications.dailyPref();
const tzLabel = (tz: string) => tz.split('/').at(-1)!.replace(/_/g, ' ');
---
<AdminLayout title={m.account.title}>
  <PageHeader eyebrow={m.account.eyebrow} title={setup ? m.account.welcome : m.account.title} lede={setup ? m.account.welcomeLede : admin.session.email} />
  <form method="post" class="co-card grid max-w-lg gap-4">
    {error && <Alert kind="rejection" title={error} />}
    {ok && <Alert kind="success" title={ok} />}
    <label class="co-field">{m.account.name}<input class="co-input" name="name" value={name} maxlength="80" autocomplete="name" /></label>
    {admin.session.role !== 'partner' && (
      <label class="co-field">{m.account.phone} <span class="co-help">{m.account.phoneHelp}</span>
        <input class="co-input" type="tel" name="phone" value={phone} maxlength="40" autocomplete="tel" placeholder="+34 600 000 000" data-testid="phone" /></label>
    )}
    {showPassword && <>
      <label class="co-field">{m.account.password} <span class="co-help">{m.account.passwordHelp}</span>
        <input class="co-input" type="password" name="password" minlength="10" autocomplete="new-password" />
      </label>
      <label class="co-field">{m.account.repeat}<input class="co-input" type="password" name="confirm" autocomplete="new-password" /></label>
    </>}
    <button class="co-btn co-btn--primary w-fit" type="submit">{m.account.save}</button>
  </form>
  {!setup && (
    <form method="post" id="avisos" class="co-card mt-6 grid max-w-lg gap-4" data-testid="notify-pref">
      <input type="hidden" name="action" value="notify" />
      <div><p class="text-eyebrow mb-1">{m.account.notifyEyebrow}</p><h2 class="co-entity">{m.account.notifyTitle}</h2></div>
      {notifyOk && <Alert kind="success" title={m.account.notifySaved} />}
      <label class="co-check">
        <input type="checkbox" name="notifyEmail" checked={emailOn} />
        <span>{m.account.notifyLabel}<span class="co-help block">{m.account.notifyHelp}</span></span>
      </label>
      <label class="co-check">
        <input type="checkbox" name="daily" checked={dailyPref.daily} data-testid="daily-pref" />
        <span>{m.account.dailyLabel}<span class="co-help block">{m.account.dailyHelp}</span></span>
      </label>
      <label class="co-field">{m.account.timezone}
        <select class="co-select" name="timezone" data-testid="timezone">
          {TIMEZONES.map((tz) => <option value={tz} selected={tz === dailyPref.timezone}>{tzLabel(tz)} · {tz}</option>)}
        </select>
      </label>
      <button class="co-btn co-btn--ghost w-fit" type="submit">{m.account.notifySave}</button>
    </form>
  )}
  {!setup && (
    <form method="post" id="idioma" class="co-card mt-6 grid max-w-lg gap-4" data-testid="locale-pref">
      <input type="hidden" name="action" value="locale" />
      <h2 class="co-entity">{m.account.language}</h2>
      {localeOk && <Alert kind="success" title={m.account.languageSaved} />}
      <div class="grid gap-2 sm:grid-cols-2">
        {LOCALES.map((l) => (
          <label class="co-option !flex-row !items-center !gap-3 !p-3" lang={l}>
            <input type="radio" name="locale" value={l} checked={l === locale} />
            <span class="co-row-title">{LOCALE_NAME[l]}</span>
          </label>
        ))}
      </div>
      <p class="co-help">{m.account.languageHelp}</p>
      <button class="co-btn co-btn--ghost w-fit" type="submit">{m.account.save}</button>
    </form>
  )}
</AdminLayout>
