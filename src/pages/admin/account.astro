---
import { testReminder } from '~/lib/assistant/server';
import { remindTestMessages } from '~/lib/i18n/messages/remindTest';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { demoDb } from '~/lib/data/store';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import { i18n, LOCALES, LOCALE_NAME, isLocale, LOCALE_COOKIE } from '~/lib/i18n';
import { shellMessages } from '~/lib/i18n/messages/shell';
import { TIMEZONES } from '~/lib/notify/service';
import { builderMessages } from '~/lib/i18n/messages/builder';
import { CONTACT_CHANNELS, CHANNEL_NAME, type ContactChannel } from '~/lib/contact';
import { contactError, readContact, saveContact } from '~/lib/admin/rep-contact';
import Icon from '~/components/ui/Icon.astro';
import { toE164 } from '~/lib/leads/normalize';
import { leadsRuntime } from '~/lib/leads/server';
import { appMode } from '~/lib/mode';
import { assistantContact, samePhone } from '~/lib/assistant/contact';
import { assistantSetupMessages } from '~/lib/i18n/messages/assistantSetup';
import { formatPhone, myAssistantPhones, setMyAssistantPhone } from '~/lib/assistant/phones';
import { dropCalendar, hasCalendar, myCalendarToken } from '~/lib/calendar/feed';
import { calendarMessages } from '~/lib/i18n/messages/calendar';
import { mcpMessages } from '~/lib/i18n/messages/mcp';
import { requestOrigin } from '~/lib/http';
import { deliveryStore, failureReason } from '~/lib/assistant/delivery';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const setupParam = Astro.url.searchParams.get('setup');
const setup = setupParam === '1' || setupParam === 'recovery';
let { m, locale } = i18n(Astro, shellMessages);
// Colaboradores: siempre sin contraseña (código por email).
const showPassword = admin.session.role !== 'partner';

let error: string | null = null;
let ok: string | null = null;
let name = admin.session.displayName ?? '';
// Teléfono: lo ven los compañeros de zona para llamar o escribir por WhatsApp (docs/ACCOUNTS.md).
const readPhone = async () => (admin.mode === 'supabase' && admin.supabase
  ? ((await admin.supabase.from('users').select('phone').eq('id', admin.session.userId).maybeSingle()).data?.phone as string | null) ?? ''
  : demoDb().users.find((x) => x.id === admin.session.userId)?.phone ?? '');
let phone = await readPhone();
// Recordatorios por WhatsApp de la mañana (docs/ASSISTANT.md §Recordatorios).
const readWaRemind = async () => (admin.mode === 'supabase' && admin.supabase
  ? !!(await admin.supabase.from('users').select('wa_reminders').eq('id', admin.session.userId).maybeSingle()).data?.wa_reminders
  : !!demoDb().users.find((x) => x.id === admin.session.userId)?.wa_reminders);
let waRemind = await readWaRemind();

const form = Astro.request.method === 'POST' ? await Astro.request.formData() : null;
let notifyOk = false;
let contactMsg: { ok?: string; error?: string } = {};
let phonesMsg: { ok?: string; error?: string } = {};
let localeOk = false;
let calMsg: { ok?: string; error?: string } = {};

let waTest: { ok?: string; info?: string; error?: string; hint?: string } | null = null;
if (form?.get('action') === 'locale') {
  const l = String(form.get('locale') ?? '');
  if (isLocale(l)) {
    await admin.notifications.setLocale(l);
    Astro.cookies.set(LOCALE_COOKIE, l, { path: '/', httpOnly: true, sameSite: 'lax', secure: Astro.url.protocol === 'https:', maxAge: 60 * 60 * 24 * 365 });
    Astro.locals.locale = l;
    ({ m, locale } = i18n(Astro, shellMessages));
    localeOk = true;
  }
} else if (form?.get('action') === 'contact') {
  // Contacto en sus propuestas (docs/PERSONALIZE.md §Contacto del comercial): el mismo que en el editor.
  const ch = String(form.get('channel') ?? '') as ContactChannel;
  const v = String(form.get('value') ?? '');
  const bad = (CONTACT_CHANNELS as readonly string[]).includes(ch) ? contactError(ch, v) : null;
  const CM = builderMessages[locale].page.contact;
  if (bad) contactMsg = { error: bad === 'phone' ? CM.errPhone : bad === 'linkedin' ? CM.errLinkedin : CM.errEmail };
  else { await saveContact(admin, ch, v); contactMsg = { ok: CM.saved }; }
} else if (form?.get('action') === 'password' && showPassword) {
  // La contraseña, en su ventana (Establecer / Cambiar). Se marca has_password para saber qué botón enseñar.
  const password = String(form.get('password') ?? '');
  if (password.length < 10) error = m.account.errShort;
  else if (password !== String(form.get('confirm') ?? '')) error = m.account.errMismatch;
  else if (admin.mode === 'supabase' && admin.supabase) {
    const { error: e } = await admin.supabase.auth.updateUser({ password, data: { has_password: true } });
    if (e) error = e.message.includes('should be different') ? m.account.errSame : m.account.errSave;
    else ok = m.account.passwordSaved;
  } else ok = m.account.savedDemo;
} else if (form?.get('action') === 'assistant-phones') {
  // Desde qué móvil escribe al asistente en cada empresa (vacío = el de arriba). Con prefijo, como el de arriba.
  for (const sp of await myAssistantPhones(admin)) {
    const raw = String(form.get(`ap_${sp.tenantId}`) ?? '').trim().slice(0, 40);
    const e164 = raw ? toE164(raw, { locale }) : null;
    if (raw && (!/^\+?[\d\s().-]{6,39}$/.test(raw) || !e164)) { phonesMsg = { error: m.account.phonesErr(sp.name) }; break; }
    await setMyAssistantPhone(admin, sp.tenantId, e164);
  }
  phonesMsg.error ??= undefined;
  if (!phonesMsg.error) phonesMsg = { ok: m.account.phonesSaved };
} else if (form?.get('action') === 'wa-test') {
  // «Probarlo ahora»: el recordatorio de la mañana ya, y qué ha pasado (docs/ASSISTANT.md §Recordatorios).
  const RT = remindTestMessages[locale];
  const o = await testReminder(admin).catch((e) => ({ status: 'failed' as const, error: e instanceof Error ? e.message : String(e) }));
  waTest = o.status === 'sent' ? { ok: RT.sent(o.items) } : o.status === 'empty' ? { info: o.told ? RT.emptyTold : RT.empty }
    : o.status === 'failed' ? { error: RT.failed(o.error), hint: RT.templateHint } : o.status === 'no-template' ? { error: RT.noTemplate, hint: RT.templateHint }
    : o.status === 'not-here' ? { info: RT.notHere }
    : { error: o.status === 'off' ? RT.off : o.status === 'no-number' ? RT.noNumber : o.status === 'no-phone' ? RT.noPhone : RT.skipped };
} else if (form?.get('action') === 'calendar') {
  // Calendario (docs/CALENDAR.md): conectar (crea el enlace), cambiarlo o desconectar.
  const CL = calendarMessages[locale];
  const what = String(form.get('do') ?? 'connect');
  if (what === 'drop') { await dropCalendar(admin); calMsg = { ok: CL.okDropped }; }
  else calMsg = (await myCalendarToken(admin, what === 'rotate')) ? { ok: what === 'rotate' ? CL.okRotated : CL.okConnected } : { error: CL.missing };
} else if (form?.get('action') === 'notify') {
  await admin.notifications.setEmailPref(form.get('notifyEmail') === 'on');
  await admin.notifications.setDailyPref({ daily: form.get('daily') === 'on', timezone: String(form.get('timezone') ?? '') });
  waRemind = form.get('waRemind') === 'on';
  if (admin.mode === 'supabase' && admin.supabase) await admin.supabase.from('users').update({ wa_reminders: waRemind }).eq('id', admin.session.userId);
  else { const u = demoDb().users.find((x) => x.id === admin.session.userId); if (u) u.wa_reminders = waRemind; }
  notifyOk = true;
} else if (form) {
  name = String(form.get('name') ?? '').trim().slice(0, 80);
  phone = String(form.get('phone') ?? '').trim().slice(0, 40);
  const password = showPassword ? String(form.get('password') ?? '') : '';
  const confirm = String(form.get('confirm') ?? '');
  // El móvil es obligatorio para quien vende (sin él, el asistente de WhatsApp no le reconoce); se guarda con prefijo.
  const e164 = phone ? toE164(phone, { locale }) : null;
  if (!phone && admin.session.role !== 'partner') error = m.account.errPhoneRequired;
  else if (phone && (!/^\+?[\d\s().-]{6,39}$/.test(phone) || !e164)) error = m.account.errPhone;
  else if (password && password.length < 10) error = m.account.errShort;
  else if (password !== confirm) error = m.account.errMismatch;
  if (!error && e164) phone = e164;
  if (error) { /* se enseña arriba, con lo escrito */ }
  else if (admin.mode === 'supabase' && admin.supabase) {
    const sb = admin.supabase;
    const { error: e } = await sb.auth.updateUser({ ...(password ? { password } : {}), data: { name, ...(password ? { has_password: true } : {}) } });
    if (e) error = e.message.includes('should be different') ? m.account.errSame : m.account.errSave;
    else {
      await sb.from('users').update({ display_name: name || null, phone: phone || null }).eq('id', admin.session.userId);
      if (setup) return Astro.redirect(setupParam === '1' ? '/admin/welcome' : '/admin', 303);
      ok = m.account.saved;
    }
  } else {
    const u = demoDb().users.find((x) => x.id === admin.session.userId);
    if (u) { u.display_name = name; u.phone = phone || null; }
    ok = password ? m.account.savedDemo : m.account.saved;
  }
}
// ¿Tiene contraseña? (la marca has_password la pone esta página al guardarla; sin marca, «Establecer»).
const hasPassword = showPassword && admin.mode === 'supabase' && admin.supabase
  ? !!(await admin.supabase.auth.getUser().catch(() => null))?.data?.user?.user_metadata?.has_password
  : false;
const C = builderMessages[locale].page.contact;
const contact = await readContact(admin, admin.session.userId).catch(() => ({ channel: null, value: '', name: '' }));
const channelName = (c: ContactChannel) => (c === 'phone' ? C.phone : c === 'email' ? C.email : CHANNEL_NAME[c]);
const emailOn = await admin.notifications.emailPref();
const dailyPref = await admin.notifications.dailyPref();
const tzLabel = (tz: string) => tz.split('/').at(-1)!.replace(/_/g, ' ');
// Tu asistente de WhatsApp: a qué número escribir y desde cuál (el de arriba). Los ajustes se leen con service role.
const A = i18n(Astro, assistantSetupMessages).m.card;
const showAssistant = !setup && admin.session.role !== 'partner';
const rt = showAssistant ? await leadsRuntime() : null;
const leadSettings = rt && !('error' in rt) ? await rt.db.settings(admin.session.tenantId).catch(() => null) : null;
const assistant = showAssistant ? await assistantContact(leadSettings, { demo: appMode() === 'demo' }) : null;
// Con más de una empresa: desde qué móvil escribe en cada una.
const spacePhones = assistant && assistant.mode !== 'off' ? await myAssistantPhones(admin).catch(() => []) : [];
// Calendario: el enlace de suscripción (si ya lo conectó).
const calToken = admin.session.role === 'partner' ? null : await hasCalendar(admin).catch(() => null);
const calUrl = calToken ? `${requestOrigin(Astro.request, Astro.url)}/cal/${calToken}.ics` : null;

// Qué pasó con el último recordatorio (Meta lo confirma por el webhook): entregado, leído o por qué no llegó.
const lastDelivery = waRemind && admin.session.role !== 'partner' ? await (await deliveryStore().catch(() => null))?.last(admin.session.userId, 'reminder').catch(() => null) ?? null : null;
---
<AdminLayout title={m.account.title}>
  <PageHeader eyebrow={m.account.eyebrow} title={setup ? m.account.welcome : m.account.title} lede={setup ? m.account.welcomeLede : admin.session.email} />
  <form method="post" class="co-card grid max-w-lg gap-4">
    {error && <Alert kind="rejection" title={error} />}
    {ok && <Alert kind="success" title={ok} />}
    <label class="co-field">{m.account.name}<input class="co-input" name="name" value={name} maxlength="80" autocomplete="name" /></label>
    {admin.session.role !== 'partner' && (
      <label class="co-field">{m.account.phone} <span class="co-help">{m.account.phoneHelp}</span>
        <input class="co-input" type="tel" name="phone" value={formatPhone(phone)} maxlength="40" autocomplete="tel" inputmode="tel" placeholder="+34 600 000 000" required data-testid="phone" data-phone-format /></label>
    )}
    {showPassword && setup && <>
      <label class="co-field">{m.account.password} <span class="co-help">{m.account.passwordHelp}</span>
        <input class="co-input" type="password" name="password" minlength="10" autocomplete="new-password" />
      </label>
      <label class="co-field">{m.account.repeat}<input class="co-input" type="password" name="confirm" autocomplete="new-password" /></label>
    </>}
    <button class="co-btn co-btn--primary w-fit" type="submit">{m.account.save}</button>
  </form>
  {showPassword && !setup && (
    <section class="co-card mt-6 grid max-w-lg gap-3" data-testid="account-password">
      <h2 class="co-entity">{m.account.password}</h2>
      <p class="co-meta">{hasPassword ? m.account.passwordSet : m.account.passwordNone}</p>
      <button type="button" class="co-btn co-btn--ghost w-fit" data-dialog-open="pw-dialog" data-testid="password-open">{hasPassword ? m.account.changePassword : m.account.setPassword}</button>
      <dialog id="pw-dialog" class="co-dialog" aria-labelledby="pw-dialog-title">
        <form method="post" class="grid gap-0">
          <input type="hidden" name="action" value="password" />
          <div class="co-dialog__body grid gap-4">
            <h2 id="pw-dialog-title" class="co-entity">{hasPassword ? m.account.changePassword : m.account.setPassword}</h2>
            <label class="co-field">{m.account.newPassword} <span class="co-help">{m.account.passwordHelp.replace(/^[^,]*,\s*/, '')}</span>
              <input class="co-input" type="password" name="password" minlength="10" required autocomplete="new-password" data-testid="pw-new" /></label>
            <label class="co-field">{m.account.repeat}<input class="co-input" type="password" name="confirm" minlength="10" required autocomplete="new-password" data-testid="pw-repeat" /></label>
          </div>
          <div class="co-dialog__foot">
            <button type="button" class="co-btn co-btn--ghost" data-dialog-close>{m.account.cancel}</button>
            <button type="submit" class="co-btn co-btn--primary" data-testid="pw-save">{m.account.save}</button>
          </div>
        </form>
      </dialog>
    </section>
  )}
  {assistant && (
    <section id="asistente" class="co-card mt-6 grid max-w-lg gap-3" data-testid="account-assistant" data-mode={assistant.mode}>
      <div class="flex items-center gap-2"><Icon name="whatsapp" size={20} /><h2 class="co-entity">{A.title}</h2></div>
      {assistant.mode === 'off'
        ? <p class="co-meta">{A.off}</p>
        : (
          <>
            <p class="co-meta">{A.lede}</p>
            <div class="co-inset flex flex-wrap items-center justify-between gap-3 !p-4">
              <div><p class="co-meta">{A.writeTo}</p><p class="text-2xl [font-family:var(--co-font-impact)] font-semibold" data-testid="account-assistant-number">{assistant.number ?? '—'}</p></div>
              {assistant.waLink && <a class="co-btn co-btn--primary" href={assistant.waLink} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={16} />{A.open}</a>}
            </div>
            {!phone
              ? <p class="flex items-start gap-2 text-sm" data-testid="account-assistant-nophone"><Icon name="triangle-alert" size={16} />{A.noPhone}</p>
              : samePhone(phone, assistant.number)
                ? <p class="co-inset flex items-start gap-2 !p-3 text-sm" data-testid="account-assistant-same"><Icon name="triangle-alert" size={16} />{A.same}</p>
                : <p class="flex items-start gap-2 text-sm" data-testid="account-assistant-from"><Icon name="circle-check" size={16} />{A.from(phone)}</p>}
            {spacePhones.length > 1 && (
              <form method="post" class="co-inset grid gap-3 !p-4" data-testid="account-space-phones">
                <input type="hidden" name="action" value="assistant-phones" />
                <div><p class="font-semibold">{m.account.phonesTitle}</p><p class="co-help">{m.account.phonesLede}</p></div>
                {phonesMsg.ok && <Alert kind="success" title={phonesMsg.ok} />}
                {phonesMsg.error && <Alert kind="rejection" title={phonesMsg.error} />}
                {spacePhones.map((sp) => (
                  <label class="grid gap-1 sm:grid-cols-[10rem_1fr] sm:items-center"><span class="text-sm font-semibold">{sp.name}</span>
                    <input class="co-input" type="tel" inputmode="tel" name={`ap_${sp.tenantId}`} value={sp.phone ? formatPhone(sp.phone) : ''} maxlength="40"
                      placeholder={phone ? m.account.phonesMain(formatPhone(phone)) : '+34 600 000 000'} data-phone-format data-testid="space-phone" data-space={sp.name} /></label>
                ))}
                <button class="co-btn co-btn--ghost w-fit" type="submit" data-testid="space-phones-save">{m.account.phonesSave}</button>
              </form>
            )}
            <div class="grid gap-1">
              <p class="co-meta">{A.tipsTitle}</p>
              <ul class="flex flex-wrap gap-2">{A.tips.map((t) => <li class="co-chip">{t}</li>)}</ul>
            </div>
          </>
        )}
    </section>
  )}
  {!setup && (
    <form method="post" id="contacto" class="co-card mt-6 grid max-w-lg gap-4" data-testid="account-contact">
      <input type="hidden" name="action" value="contact" />
      <h2 class="co-entity">{C.account}</h2>
      {contactMsg.ok && <Alert kind="success" title={contactMsg.ok} />}
      {contactMsg.error && <Alert kind="rejection" title={contactMsg.error} />}
      <label class="co-field">{C.channel}
        <select class="co-select" name="channel">
          <option value="">{C.noChannel}</option>
          {CONTACT_CHANNELS.map((c) => <option value={c} selected={contact.channel === c}>{channelName(c)}</option>)}
        </select></label>
      <label class="co-field">{C.value}<input class="co-input" name="value" maxlength="200" value={contact.value} placeholder={contact.channel ? C.ph[contact.channel] : ''} /></label>
      <p class="co-help">{!contact.channel ? C.none : !contact.value.trim() ? C.pending : C.help}</p>
      <button class="co-btn co-btn--ghost w-fit" type="submit">{C.save}</button>
    </form>
  )}
  {!setup && admin.session.role !== 'partner' && (() => {
    const CL = calendarMessages[locale];
    const feed = calUrl;
    return (
      <section id="calendario" class="co-card mt-6 grid max-w-lg gap-3" data-testid="account-calendar">
        <div><p class="text-eyebrow mb-1">{CL.title}</p><h2 class="co-entity">{CL.title}</h2></div>
        <p class="co-body m-0">{CL.lede}</p>
        {calMsg.ok && <Alert kind="success" title={calMsg.ok} />}
        {calMsg.error && <Alert kind="rejection" title={calMsg.error} />}
        {!feed ? (
          <form method="post"><input type="hidden" name="action" value="calendar" /><input type="hidden" name="do" value="connect" />
            <button class="co-btn co-btn--primary w-fit" data-testid="calendar-connect"><Icon name="calendar" size={16} />{CL.connect}</button></form>
        ) : (
          <>
            <p class="co-meta m-0">{CL.connected}</p>
            <div class="flex flex-wrap items-center gap-2">
              <input class="co-input min-w-0 flex-1 font-mono text-xs" readonly value={feed} data-calendar-url data-testid="calendar-url" />
              <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-calendar-copy data-copied={CL.copied}>{CL.copy}</button>
            </div>
            <div class="flex flex-wrap gap-2">
              <a class="co-btn co-btn--primary co-btn--sm" target="_blank" rel="noopener noreferrer" href={`https://outlook.office.com/calendar/0/addfromweb?url=${encodeURIComponent(feed)}&name=${encodeURIComponent(CL.calName)}`} data-testid="calendar-outlook">{CL.openOutlook}</a>
              <a class="co-btn co-btn--ghost co-btn--sm" target="_blank" rel="noopener noreferrer" href={`https://calendar.google.com/calendar/r?cid=${encodeURIComponent(feed.replace(/^https?:/, 'webcal:'))}`} data-testid="calendar-google">{CL.openGoogle}</a>
              <a class="co-btn co-btn--ghost co-btn--sm" href={feed.replace(/^https?:/, 'webcal:')}>{CL.openApple}</a>
            </div>
            <details class="co-meta"><summary class="cursor-pointer">{CL.stepsTitle}</summary>
              <ul class="mt-2 grid gap-1 pl-4"><li>{CL.outlook}</li><li>{CL.google}</li></ul></details>
            <p class="co-help m-0">{CL.refresh} {CL.secret}</p>
            <div class="flex flex-wrap gap-2">
              <form method="post"><input type="hidden" name="action" value="calendar" /><input type="hidden" name="do" value="rotate" /><button class="co-btn co-btn--quiet co-btn--sm" data-testid="calendar-rotate">{CL.rotate}</button></form>
              <form method="post"><input type="hidden" name="action" value="calendar" /><input type="hidden" name="do" value="drop" /><button class="co-btn co-btn--quiet co-btn--sm !text-[var(--console-danger)]" data-testid="calendar-drop">{CL.disconnect}</button></form>
            </div>
          </>
        )}
      </section>
    );
  })()}
  {!setup && admin.session.role !== 'partner' && (() => {
    const MP = mcpMessages[locale].page;
    return (
      <a href="/admin/ia" id="ia" class="co-card co-card--link mt-6 flex max-w-lg items-center gap-3" data-testid="account-mcp">
        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[color:var(--co-signal-soft)] text-[color:var(--co-signal)]"><Icon name="sparkles" size={18} /></span>
        <span class="grid min-w-0 flex-1"><strong>{MP.link}</strong><span class="co-meta text-sm">{MP.linkHelp}</span></span>
        <Icon name="chevron-right" />
      </a>
    );
  })()}
  {!setup && (
    <form method="post" id="avisos" class="co-card mt-6 grid max-w-lg gap-4" data-testid="notify-pref">
      <input type="hidden" name="action" value="notify" />
      <div><p class="text-eyebrow mb-1">{m.account.notifyEyebrow}</p><h2 class="co-entity">{m.account.notifyTitle}</h2></div>
      {notifyOk && <Alert kind="success" title={m.account.notifySaved} />}
      <label class="co-check">
        <input type="checkbox" name="notifyEmail" checked={emailOn} />
        <span>{m.account.notifyLabel}<span class="co-help block">{m.account.notifyHelp}</span></span>
      </label>
      <label class="co-check">
        <input type="checkbox" name="daily" checked={dailyPref.daily} data-testid="daily-pref" />
        <span>{m.account.dailyLabel}<span class="co-help block">{m.account.dailyHelp}</span></span>
      </label>
      {admin.session.role !== 'partner' && (
        <label class="co-check">
          <input type="checkbox" name="waRemind" checked={waRemind} data-testid="wa-remind-pref" />
          <span>{m.account.waRemindLabel}<span class="co-help block">{m.account.waRemindHelp}</span></span>
        </label>
      )}
      <label class="co-field">{m.account.timezone}
        <select class="co-select" name="timezone" data-testid="timezone">
          {TIMEZONES.map((tz) => <option value={tz} selected={tz === dailyPref.timezone}>{tzLabel(tz)} · {tz}</option>)}
        </select>
      </label>
      <button class="co-btn co-btn--ghost w-fit" type="submit">{m.account.notifySave}</button>
    </form>
  )}
  {!setup && admin.session.role !== 'partner' && waRemind && (() => {
    const RT = remindTestMessages[locale];
    return (
      <form method="post" id="wa-test" class="co-card mt-3 grid max-w-lg gap-2 scroll-mt-6" data-testid="wa-test">
        <input type="hidden" name="action" value="wa-test" />
        {waTest?.ok && <Alert kind="success" title={waTest.ok} />}
        {waTest?.info && <Alert kind="info" title={waTest.info} />}
        {waTest?.error && <Alert kind="rejection" title={waTest.error} details={waTest.hint ? [waTest.hint] : []} />}
        <div class="flex flex-wrap items-center gap-3">
          <button class="co-btn co-btn--ghost co-btn--sm" data-testid="wa-test-run"><Icon name="whatsapp" size={14} />{RT.button}</button>
          <span class="co-help">{RT.help}</span>
        </div>
        {lastDelivery && (
          <div class:list={['co-inset grid gap-1 !p-3 text-sm', lastDelivery.status === 'failed' && 'co-inset--warn']} data-testid="wa-delivery" data-status={lastDelivery.status}>
            <span class="co-meta">{RT.last(new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }).format(new Date(lastDelivery.at)))}</span>
            <strong>{lastDelivery.status === 'failed' ? RT.failed2(failureReason(lastDelivery.error, locale)) : RT.delivery[lastDelivery.status]}</strong>
            {lastDelivery.status !== 'read' && lastDelivery.status !== 'failed' && <a class="co-btn co-btn--ghost co-btn--sm w-fit" href="/admin/account#wa-test" data-testid="wa-delivery-refresh">{RT.refresh}</a>}
          </div>
        )}
      </form>
    );
  })()}
  {!setup && (
    <form method="post" id="idioma" class="co-card mt-6 grid max-w-lg gap-4" data-testid="locale-pref">
      <input type="hidden" name="action" value="locale" />
      <h2 class="co-entity">{m.account.language}</h2>
      {localeOk && <Alert kind="success" title={m.account.languageSaved} />}
      <div class="grid gap-2 sm:grid-cols-2">
        {LOCALES.map((l) => (
          <label class="co-option !flex-row !items-center !gap-3 !p-3" lang={l}>
            <input type="radio" name="locale" value={l} checked={l === locale} />
            <span class="co-row-title">{LOCALE_NAME[l]}</span>
          </label>
        ))}
      </div>
      <p class="co-help">{m.account.languageHelp}</p>
      <button class="co-btn co-btn--ghost w-fit" type="submit">{m.account.save}</button>
    </form>
  )}
</AdminLayout>

<script>
  document.querySelector('[data-calendar-copy]')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    const v = document.querySelector<HTMLInputElement>('[data-calendar-url]')?.value ?? '';
    try { await navigator.clipboard.writeText(v); b.textContent = b.dataset.copied ?? 'OK'; } catch { document.querySelector<HTMLInputElement>('[data-calendar-url]')?.select(); }
  });
</script>

<script>
  // Teléfonos: «+34 694 904 149» mientras se escribe (de 3 en 3; el prefijo del país aparte), sin pensar en espacios.
  import { formatPhone } from '~/lib/phone-format';
  document.querySelectorAll<HTMLInputElement>('input[data-phone-format]').forEach((el) => {
    el.addEventListener('input', () => {
      const atEnd = el.selectionStart === el.value.length;
      const next = formatPhone(el.value);
      if (next !== el.value) { el.value = next; if (atEnd) el.setSelectionRange(next.length, next.length); }
    });
  });
</script>
