---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { demoDb } from '~/lib/data/store';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const setup = Astro.url.searchParams.get('setup') === '1';
// Colaboradores: siempre sin contraseña (código por email).
const showPassword = admin.session.role !== 'partner';

let error: string | null = null;
let ok: string | null = null;
let name = admin.session.displayName ?? '';

const form = Astro.request.method === 'POST' ? await Astro.request.formData() : null;
let notifyOk = false;
if (form?.get('action') === 'notify') {
  await admin.notifications.setEmailPref(form.get('notifyEmail') === 'on');
  notifyOk = true;
} else if (form) {
  name = String(form.get('name') ?? '').trim().slice(0, 80);
  const password = showPassword ? String(form.get('password') ?? '') : '';
  const confirm = String(form.get('confirm') ?? '');
  if (password && password.length < 10) error = 'La contraseña debe tener al menos 10 caracteres';
  else if (password !== confirm) error = 'Las contraseñas no coinciden';
  else if (admin.mode === 'supabase' && admin.supabase) {
    const sb = admin.supabase;
    const { error: e } = await sb.auth.updateUser({ ...(password ? { password } : {}), data: { name } });
    if (e) error = e.message.includes('should be different') ? 'La nueva contraseña debe ser distinta de la anterior' : 'No se pudo guardar';
    else {
      await sb.from('users').update({ display_name: name || null }).eq('id', admin.session.userId);
      if (setup) return Astro.redirect('/admin', 303);
      ok = 'Guardado';
    }
  } else {
    const u = demoDb().users.find((x) => x.id === admin.session.userId);
    if (u) u.display_name = name;
    ok = password ? 'Guardado (en demo no hay contraseñas)' : 'Guardado';
  }
}
const emailOn = await admin.notifications.emailPref();
---
<AdminLayout title="Mi cuenta">
  <PageHeader eyebrow="Tu perfil" title={setup ? 'Bienvenido/a.' : 'Mi cuenta'} lede={setup ? 'Dinos cómo te llamas. La contraseña es opcional: siempre puedes entrar con un código por email.' : admin.session.email} />
  <form method="post" class="co-card grid max-w-lg gap-4">
    {error && <Alert kind="rejection" title={error} />}
    {ok && <Alert kind="success" title={ok} />}
    <label class="co-field">Nombre<input class="co-input" name="name" value={name} maxlength="80" autocomplete="name" /></label>
    {showPassword && <>
      <label class="co-field">Contraseña <span class="co-help">Opcional, mínimo 10 caracteres</span>
        <input class="co-input" type="password" name="password" minlength="10" autocomplete="new-password" />
      </label>
      <label class="co-field">Repite la contraseña<input class="co-input" type="password" name="confirm" autocomplete="new-password" /></label>
    </>}
    <button class="co-btn co-btn--primary w-fit" type="submit">Guardar</button>
  </form>
  {!setup && (
    <form method="post" id="avisos" class="co-card mt-6 grid max-w-lg gap-4" data-testid="notify-pref">
      <input type="hidden" name="action" value="notify" />
      <div><p class="text-eyebrow mb-1">Avisos</p><h2 class="co-entity">Emails</h2></div>
      {notifyOk && <Alert kind="success" title="Preferencia guardada." />}
      <label class="co-check">
        <input type="checkbox" name="notifyEmail" checked={emailOn} />
        <span>Avisarme por email<span class="co-help block">Solo cuando algo necesita tu acción (agrupado en un email) y, los lunes, un resumen de lo que sigue abierto. Lo informativo nunca llega suelto.</span></span>
      </label>
      <button class="co-btn co-btn--ghost w-fit" type="submit">Guardar preferencia</button>
    </form>
  )}
</AdminLayout>
