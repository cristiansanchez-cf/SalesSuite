---
/** Ficha de una persona (docs/CRM_DINAMICO.md fase 2): dónde está y con qué papel, sus datos, su ficha y sus listas. */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import Icon from '~/components/ui/Icon.astro';
import ConfirmDialog from '~/components/ui/ConfirmDialog.astro';
import FieldInput from '~/components/crm/FieldInput.astro';
import { can } from '~/lib/admin/permissions';
import { AdminError } from '~/lib/admin/service';
import { flash, formAction } from '~/lib/admin/forms';
import { fieldsFor, formatValue, valuesFromForm } from '~/lib/crm/fields';
import { i18n } from '~/lib/i18n';
import { peopleMessages } from '~/lib/i18n/messages/people';
import { crmMessages } from '~/lib/i18n/messages/crm';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const perms = can(admin.session.role);
if (!perms.useAccounts) return Astro.rewrite('/admin/forbidden');
const id = Astro.params.id ?? '';
const { m: P, f: fmt, locale } = i18n(Astro, peopleMessages);
const C = crmMessages[locale].card;
const Q = P.quick;

let result: { error: string | null; details: string[] } = { error: null, details: [] };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const str = (k: string) => String(f.get(k) ?? '');
  let to = `/admin/people/${id}`;
  result = await formAction(async () => {
    switch (str('action')) {
      case 'save': await admin.crm.updatePerson(id, { name: str('name'), email: str('email'), phone: str('phone'), instagram: str('instagram'), linkedin: str('linkedin'), city: str('city'), notes: str('notes') }); to += '?ok=saved'; break;
      case 'link': await admin.crm.link(id, { company: str('company'), role: str('role') }); to += '?ok=linked'; break;
      case 'unlink': await admin.crm.unlink(id, str('accountId')); to += '?ok=unlinked'; break;
      case 'fields': await admin.crm.setPersonFields(id, valuesFromForm(await admin.accounts.crmFields(), f)); to += '?ok=fields'; break;
      case 'tags': await admin.crm.setTags('contact', id, str('tags').split(',')); to += '?ok=tags'; break;
      case 'owner': await admin.crm.setOwner(id, str('userId') || null); to += '?ok=owner'; break;
      case 'delete': await admin.crm.deletePerson(id); to = '/admin/people'; break;
    }
  });
  if (!result.error) return Astro.redirect(to, 303);
}

let data;
try { data = await admin.crm.person(id); } catch (e) {
  if (e instanceof AdminError && e.status === 404) return Astro.rewrite('/404');
  throw e;
}
const { person: p, crmFields, canEdit, canDelete, companies, similar } = data;
const members = perms.manageAccounts ? await admin.tenantAdmin.listMembers().catch(() => []) : [];
const sheet = fieldsFor(crmFields, null, { target: 'contact', tags: p.tags });
const okMsg = flash(Astro.url, P.person.ok);
---
<AdminLayout title={p.name}>
  <PageHeader eyebrow={p.companies.map((c) => c.name).join(' · ') || P.people.noCompany} title={p.name} back={{ href: '/admin/people', label: P.person.back }}>
    {p.tags.map((t) => <a class="co-tag" href={`/admin/people?lista=${encodeURIComponent(t)}`}><Icon name="tag" size={12} />{t}</a>)}
  </PageHeader>
  {okMsg && <div class="mb-4"><Alert kind="success" title={okMsg} /></div>}
  {result.error && <div class="mb-4"><Alert kind="rejection" title={result.error} details={result.details} /></div>}
  {similar.length > 0 && (
    <div class="mb-4"><Alert kind="info" title={P.person.similar}>
      <ul class="m-0 flex flex-wrap gap-2 p-0">{similar.map((x) => <li class="list-none"><a class="co-tag" href={`/admin/people/${x.id}`}>{x.name}{x.email ? ` · ${x.email}` : ''}</a></li>)}</ul>
    </Alert></div>
  )}

  <div class="co-split">
    <div class="grid content-start gap-5">
      <section class="co-card grid gap-3" data-testid="person-companies">
        <h2 class="co-entity">{P.person.companies}</h2>
        {p.companies.length === 0 ? <p class="co-meta">{P.person.noCompanies}</p> : (
          <ul class="co-rows">
            {p.companies.map((c) => (
              <li class="co-row" data-name={c.name}>
                <span class="co-row__lead"><Icon name="store" /></span>
                <a class="co-row__main text-inherit !no-underline" href={`/admin/accounts/${c.accountId}`}>
                  <span class="co-row-title">{c.name}</span>
                  <span class="co-meta">{[c.role, c.groupName].filter(Boolean).join(' · ')}</span>
                </a>
                <form method="post"><input type="hidden" name="action" value="unlink" /><input type="hidden" name="accountId" value={c.accountId} />
                  <button class="co-btn co-btn--quiet co-btn--icon co-btn--sm" type="submit" aria-label={`${P.person.remove} ${c.name}`} title={P.person.remove}><Icon name="x" size={14} /></button></form>
              </li>
            ))}
          </ul>
        )}
        <form method="post" class="flex flex-wrap items-end gap-2" data-testid="person-link">
          <input type="hidden" name="action" value="link" />
          <label class="co-field min-w-[12rem] flex-1">{P.person.addCompany} <span class="co-help">{Q.whereHelp}</span>
            <input class="co-input" name="company" required maxlength="160" list="company-names" placeholder={Q.wherePh} autocomplete="off" /></label>
          <label class="co-field w-40">{Q.role}<input class="co-input" name="role" maxlength="80" placeholder={Q.rolePh} /></label>
          <datalist id="company-names">{companies.slice(0, 2000).map((c) => <option value={c.name} />)}</datalist>
          <button class="co-btn co-btn--ghost co-btn--sm" type="submit">{P.person.link}</button>
        </form>
      </section>

      <section class="co-card grid gap-4" data-testid="person-sheet">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="co-entity">{C.title}</h2>
          {perms.manageTenant && <a class="co-meta underline" href="/admin/team/fields">{C.manage}</a>}
        </div>
        {sheet.length === 0 ? <p class="co-meta">{C.noFields} {perms.manageTenant && C.noFieldsAdmin}</p>
        : canEdit ? (
          <form method="post" class="grid gap-4 sm:grid-cols-2" data-testid="person-sheet-form">
            <input type="hidden" name="action" value="fields" />
            {sheet.map((fd) => <div class:list={[(fd.type === 'long_text' || fd.type === 'multi_select') && 'sm:col-span-2']}><FieldInput field={fd} value={p.fields[fd.key]} labels={C} /></div>)}
            <button class="co-btn co-btn--primary w-fit sm:col-span-2" type="submit" data-testid="person-sheet-save">{C.save}</button>
          </form>
        ) : (
          <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
            {sheet.map((fd) => <div><dt class="co-meta">{fd.label}</dt><dd class="text-sm font-medium">{formatValue(fd, p.fields[fd.key], fmt.tag) || C.empty}</dd></div>)}
          </dl>
        )}
      </section>
    </div>

    <aside class="grid content-start gap-4">
      <form method="post" class="co-card grid gap-3" data-testid="person-info">
        <input type="hidden" name="action" value="save" />
        <h2 class="co-entity">{P.person.data}</h2>
        <fieldset class="grid gap-3" disabled={!canEdit}>
          <label class="co-field">{Q.name}<input class="co-input" name="name" value={p.name} required maxlength="160" /></label>
          <label class="co-field">{Q.email}<input class="co-input" type="email" name="email" value={p.email ?? ''} maxlength="200" /></label>
          <label class="co-field">{Q.phone}<input class="co-input" type="tel" name="phone" value={p.phone ?? ''} maxlength="40" /></label>
          <label class="co-field">{Q.instagram}<input class="co-input" name="instagram" value={p.instagram ?? ''} maxlength="300" /></label>
          <label class="co-field">{Q.linkedin}<input class="co-input" name="linkedin" value={p.linkedin ?? ''} maxlength="300" /></label>
          <label class="co-field">{Q.city}<input class="co-input" name="city" value={p.city ?? ''} maxlength="80" /></label>
          <label class="co-field">{Q.notes}<textarea class="co-textarea" name="notes" maxlength="4000">{p.notes ?? ''}</textarea></label>
          {canEdit && <button class="co-btn co-btn--ghost w-fit" type="submit">{P.person.save}</button>}
        </fieldset>
        {!canEdit && <p class="co-help">{P.person.editHint}</p>}
      </form>

      <form method="post" class="co-card grid gap-3" data-testid="person-tags">
        <input type="hidden" name="action" value="tags" />
        <label class="co-field">{P.person.lists} <span class="co-help">{P.person.listsHelp}</span>
          <input class="co-input" name="tags" value={p.tags.join(', ')} maxlength="400" disabled={!canEdit} /></label>
        {canEdit && <button class="co-btn co-btn--ghost co-btn--sm w-fit" type="submit">{P.person.saveLists}</button>}
      </form>

      {perms.manageAccounts && (
        <section class="co-card grid gap-3" data-testid="person-manage">
          <h2 class="co-entity">{P.person.manage}</h2>
          <form method="post" class="grid gap-2">
            <input type="hidden" name="action" value="owner" />
            <label class="co-field">{P.person.owner}
              <select class="co-select" name="userId"><option value="">{P.person.nobody}</option>{members.filter((m) => m.role !== 'partner').map((m) => <option value={m.userId} selected={m.userId === p.ownerId}>{m.displayName || m.email}</option>)}</select>
            </label>
            <button class="co-btn co-btn--ghost co-btn--sm w-fit" type="submit">{P.person.assign}</button>
          </form>
          {canDelete && <div class="co-actions">
            <button type="button" class="co-action" data-dialog-open="delete-person"><Icon name="trash2" /><span class="co-action__label">{P.person.delete}</span><Icon name="chevron-right" size={16} /></button>
          </div>}
        </section>
      )}
      {!perms.manageAccounts && p.ownerName && <p class="co-meta">{P.person.owner}: {p.ownerName}</p>}
    </aside>
  </div>

  <ConfirmDialog id="delete-person" title={P.person.deleteTitle(p.name)} confirmLabel={P.person.delete} danger
    does={P.person.deleteDoes} doesNot={P.person.deleteDoesNot}>
    <input type="hidden" name="action" value="delete" />
  </ConfirmDialog>
</AdminLayout>
