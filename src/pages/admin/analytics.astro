---
/** Analítica de las propuestas (docs/ANALYTICS.md). La de los decks, en /admin/decks/analitica (docs/DECKS.md). */
import AdminLayout from '~/layouts/AdminLayout.astro';
import AnalyticsOverview from '~/components/admin/AnalyticsOverview.astro';
import { i18n } from '~/lib/i18n';
import { analyticsMessages } from '~/lib/i18n/messages/analytics';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const { m } = i18n(Astro, analyticsMessages);
---
<AdminLayout title={m.title}>
  <AnalyticsOverview admin={admin} />
</AdminLayout>
