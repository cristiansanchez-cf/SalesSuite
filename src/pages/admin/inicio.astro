---
/**
 * Inicio (docs/UX_REVIEW.md #2). La cabecera sale al momento; el resto (lo siguiente, tu día, el equipo, quién mira)
 * llega en un bloque aparte con su shimmer (docs/UX_REVIEW.md §Carga).
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import Shimmer from '~/components/ui/Shimmer.astro';
import HomeBody from '~/components/admin/home/HomeBody.astro';
import { can } from '~/lib/admin/permissions';
import { i18n } from '~/lib/i18n';
import { sellMessages } from '~/lib/i18n/messages/sell';
import { needsCompanySetup } from '~/lib/onboarding';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
if (admin.session.role === 'partner') return Astro.redirect('/admin');
// Admin de un espacio vacío → preparar la empresa primero. Una vez preparado, no se vuelve a mirar (cookie de un día).
if (admin.session.role === 'admin' && Astro.cookies.get('ss_ready')?.value !== admin.session.tenantId) {
  if (await needsCompanySetup(admin)) return Astro.redirect('/admin/setup/ia?first=1');
  Astro.cookies.set('ss_ready', admin.session.tenantId, { path: '/admin', maxAge: 86_400, httpOnly: true, sameSite: 'lax', secure: Astro.url.protocol === 'https:' });
}
const manager = can(admin.session.role).manageTeam;
const { m } = i18n(Astro, sellMessages);
const first = (admin.session.displayName || admin.session.email).split(/[\s@]/)[0];
---
<AdminLayout title={m.home.title} wide>
  <div class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)] gap-12 pb-10">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div class="grid gap-2">
        <h1 class="co-page-title !text-5xl">{m.home.hello(first)}</h1>
        <p class="co-lede !text-lg">{manager ? m.home.tailManager : m.home.tailRep}</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="co-btn co-btn--ghost" href="/admin/compose"><Icon name="message-square-text" size={16} />{m.home.compose}</a>
        <a class="co-btn co-btn--primary" href="/admin#nuevo" data-testid="home-new">{m.home.newProposal} <span aria-hidden="true">→</span></a>
      </div>
    </header>

    <HomeBody server:defer>
      <Shimmer slot="fallback" variant="home" count={4} />
    </HomeBody>
  </div>
</AdminLayout>
