---
/** Todos los avisos de la persona (docs/NOTIFICATIONS.md). También recibe los formularios de la campana. */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import Icon from '~/components/ui/Icon.astro';
import { i18n } from '~/lib/i18n';
import { shellMessages } from '~/lib/i18n/messages/shell';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const n = admin.notifications;
const { m, f, locale } = i18n(Astro, shellMessages);

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = String(f.get('action') ?? '');
  if (action === 'dismiss') await n.dismiss(String(f.get('id') ?? ''));
  else if (action === 'read-all') await n.markAllRead();
  // Volver a donde estaba (solo rutas internas de la consola).
  const back = String(f.get('back') ?? '');
  return Astro.redirect(/^\/admin(\/|\?|$)/.test(back) && !back.startsWith('//') ? back : '/admin/notifications', 303);
}

const view = Astro.url.searchParams.get('ver') === 'todo' ? 'all' : 'open';
const feed = await n.feed({ limit: 100, onlyOpen: view === 'open', locale });
const emailOn = await n.emailPref();
---
<AdminLayout title={m.notifications.title}>
  <PageHeader eyebrow={m.notifications.eyebrow} title={m.notifications.title} lede={m.notifications.lede}>
    {feed.items.some((x) => !x.readAt) && (
      <form method="post"><input type="hidden" name="action" value="read-all" /><input type="hidden" name="back" value="/admin/notifications" />
        <button class="co-btn co-btn--ghost" type="submit">{m.bell.markAll}</button></form>
    )}
  </PageHeader>
  <nav class="co-tabs mb-5" aria-label={m.notifications.filter} data-scroll-x>
    <a class="co-tab" href="/admin/notifications" aria-current={view === 'open' ? 'page' : undefined}>{m.notifications.open}{feed.open ? ` · ${feed.open}` : ''}</a>
    <a class="co-tab" href="/admin/notifications?ver=todo" aria-current={view === 'all' ? 'page' : undefined}>{m.notifications.all}</a>
  </nav>
  {feed.items.length === 0
    ? <EmptyState kind="none" title={view === 'open' ? m.notifications.emptyOpen : m.notifications.emptyAll} because={m.notifications.emptyBecause} />
    : <ul class="co-rows" data-testid="notifications">
        {feed.items.map((x) => (
          <li class:list={['co-row', x.open && x.severity === 'action' && 'co-row--attention']} data-testid="notification" data-kind={x.kind}>
            <span class="co-row__lead"><Icon name={x.icon as never} /></span>
            <a class="co-row__main !no-underline text-inherit" href={`/admin/notifications/${x.id}`}>
              <span class:list={['co-row-title', !x.open && '!font-normal']}>{x.title}</span>
              <span class="co-meta">{[x.detail, x.open && x.severity === 'action' ? m.bell.needsAction : x.resolvedAt ? m.notifications.resolved : null, f.relative(x.createdAt)].filter(Boolean).join(' · ')}</span>
            </a>
            {!x.dismissedAt && (
              <form method="post">
                <input type="hidden" name="action" value="dismiss" /><input type="hidden" name="id" value={x.id} />
                <input type="hidden" name="back" value={view === 'all' ? '/admin/notifications?ver=todo' : '/admin/notifications'} />
                <button class="co-btn co-btn--quiet co-btn--sm" type="submit" aria-label={m.bell.dismissLabel(x.title)}>{m.bell.dismiss}</button>
              </form>
            )}
          </li>
        ))}
      </ul>}
  <p class="co-meta mt-6 flex items-center gap-2"><Icon name={emailOn ? 'mail' : 'bell-off'} size={14} />
    {emailOn ? m.notifications.emailOn : m.notifications.emailOff}
    <a class="underline" href="/admin/account#avisos">{m.notifications.change}</a>
  </p>
</AdminLayout>
