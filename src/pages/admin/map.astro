---
/**
 * Mapa del CRM (docs/CRM_DINAMICO.md §16): las empresas que ve cada uno, con los mismos filtros que la lista.
 * Punto = ubicación exacta (de su ficha de Google); burbuja = las que solo tienen ciudad (en el punto de su ciudad).
 * Color por estado o, para admin y gerentes, por el comercial que lleva la zona. Toca un punto: resumen y «Abrir ficha».
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Icon from '~/components/ui/Icon.astro';
import { can } from '~/lib/admin/permissions';
import { zonePath } from '~/lib/accounts/rules';
import { NO_ZONE } from '~/lib/accounts/service';
import type { AccountState as State } from '~/lib/accounts/types';
import { i18n } from '~/lib/i18n';
import { mapMessages } from '~/lib/i18n/messages/map';
import { accountsMessages } from '~/lib/i18n/messages/accounts';
import { priorityOf } from '~/lib/crm/priority';
import { buildMap, matchesTemp, temperature, zoneOwners, REP_COLORS, STATE_COLOR, type TempFilter } from '~/lib/crm/map';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const perms = can(admin.session.role);
if (!perms.useAccounts) return Astro.rewrite('/admin/forbidden');
const acc = admin.accounts;
const { m: M, locale } = i18n(Astro, mapMessages);
const A = accountsMessages[locale];

const q = Astro.url.searchParams;
const scope = (['zone', 'mine', 'all'].includes(q.get('ver') ?? '') ? q.get('ver') : 'zone') as 'zone' | 'mine' | 'all';
const stateF = (q.get('estado') ?? 'all') as State | 'all';
const zona = q.get('zona') ?? '';
const tempF = (['caliente', 'frio', 'sin'].includes(q.get('temp') ?? '') ? q.get('temp') : '') as TempFilter;
const byRep = perms.manageAccounts && q.get('color') === 'comercial';

const [{ items, scope: effective }, t, segments, weights, members] = await Promise.all([
  acc.list({ scope, zoneId: zona && zona !== NO_ZONE ? zona : undefined }), acc.territory(), admin.playbook.market(), admin.crm.weights(),
  perms.manageAccounts ? admin.tenantAdmin.listMembers() : Promise.resolve([]),
]);
const segKey = new Map(segments.map((sg) => [sg.id, sg.key]));
const prioOf = (a: (typeof items)[number]) => priorityOf(a.qualification, segKey.get(a.segmentId ?? '') ?? null, weights);
const byState = items.filter((a) => stateF === 'all' || a.state === stateF);
const cooling = await admin.crm.cooling(byState.map((a) => a.id));
const shown = byState.filter((a) => matchesTemp(temperature(prioOf(a), cooling.get(a.id)), tempF));

// Quién lleva cada zona (para colorear por comercial): la asignación más cercana subiendo por sus zonas.
const names = new Map(members.map((x) => [x.userId, x.displayName || x.email]));
const owners = zoneOwners(t.zones, t.assignments);
const repOf = (zoneId: string | null) => { const u = owners(zoneId)[0]; return u ? names.get(u) ?? null : null; };
const data = buildMap(shown, t.zones, { prio: prioOf, cooling, rep: repOf });
const reps = [...new Set([...data.points.map((p) => p.rep), ...data.cities.map((c) => c.rep)].filter((x): x is string => !!x))].sort((a, b) => a.localeCompare(b, locale));
const repColor = Object.fromEntries(reps.map((r, i) => [r, REP_COLORS[i % REP_COLORS.length]]));

const toLocate = perms.importCrm ? t.zones.filter((z) => z.lat == null || z.lng == null).length : 0;
const zoneOptions = t.zones.map((z) => ({ id: z.id, label: zonePath(t.zones, z.id) })).sort((a, b) => a.label.localeCompare(b.label, locale));
const STATES: Array<[State | 'all', string]> = (['all', 'mine', 'free', 'taken', 'my_customer', 'customer', 'blocked'] as const).map((k) => [k, A.list.states[k]]);
// En el resumen de un punto, el estado en singular («Libre», «Tuya»…).
const stateLabel: Record<State, string> = { free: A.state.free, mine: A.state.mine, taken: A.state.taken, my_customer: A.state.myCustomer, customer: A.state.customer, blocked: A.state.blocked };
const payload = {
  points: data.points, cities: data.cities, byRep, repColor, stateColor: STATE_COLOR,
  T: { stateLabel, open: M.open, score: M.score(Number.NaN).replace('NaN', '{n}'), cooling: M.cooling(Number.NaN).replace('NaN', '{n}'), next: M.next, rep: M.rep, noRep: M.noRep, owner: M.owner,
    reviews: M.reviews, city: M.city(2).replace('2', '{n}'), city1: M.city(1), cityHot: M.cityHot(Number.NaN).replace('NaN', '{n}'), cityHelp: M.cityHelp, seeList: M.seeList },
};
---
<AdminLayout title={M.title}>
  <PageHeader eyebrow={M.eyebrow} title={M.title} lede={M.lede} />

  <form method="get" class="co-card mb-3 flex flex-wrap items-end gap-3 !p-4" data-testid="map-toolbar" data-map-filters role="search">
    <label class="co-field min-w-[11rem] flex-1">{A.list.zoneFilter}
      <select class="co-select" name="zona" data-testid="map-zone"><option value="">{A.list.anyZone}</option>{zoneOptions.map((z) => <option value={z.id} selected={zona === z.id}>{z.label}</option>)}</select></label>
    <label class="co-field">{A.list.state}
      <select class="co-select" name="estado" data-testid="map-state">{STATES.map(([k, l]) => <option value={k} selected={stateF === k}>{l}</option>)}</select></label>
    <label class="co-field">{M.temp}
      <select class="co-select" name="temp" data-testid="map-temp"><option value="">{M.anyTemp}</option><option value="caliente" selected={tempF === 'caliente'}>{M.hot}</option>
        <option value="frio" selected={tempF === 'frio'}>{M.cold}</option><option value="sin" selected={tempF === 'sin'}>{M.unqualified}</option></select></label>
    <label class="co-field">{A.list.scope}
      <select class="co-select" name="ver" data-testid="map-scope">
        {t.myZoneIds.length > 0 && <option value="zone" selected={effective === 'zone'}>{A.list.myZone}</option>}
        <option value="all" selected={effective === 'all'}>{A.list.scopeAll}</option>
        <option value="mine" selected={effective === 'mine'}>{A.list.scopeMine}</option>
      </select></label>
    {perms.manageAccounts && (
      <label class="co-field">{M.color}
        <select class="co-select" name="color" data-testid="map-color"><option value="">{M.byState}</option><option value="comercial" selected={byRep}>{M.byRep}</option></select></label>
    )}
  </form>

  <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-2">
    <p class="co-meta" data-testid="map-summary">{M.summary(data.points.length, data.cities.reduce((n, c) => n + c.count, 0))}
      {data.unlocated > 0 && <> · {M.unlocated(data.unlocated)}</>}
      {data.noCity > 0 && <> · <a class="underline" href={`/admin/accounts?ver=all&zona=${NO_ZONE}`}>{M.noCity(data.noCity)}</a></>}</p>
    {toLocate > 0 && (admin.crm.hasGoogle()
      ? <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-locate data-testid="map-locate"><Icon name="map-pin" size={14} /><span>{M.locate(toLocate)}</span></button>
      : <span class="co-help">{M.noKeyLocate}</span>)}
  </div>

  <div class="co-card co-card--flush overflow-hidden">
    <div id="crm-map" class="crm-map" data-testid="map" data-points={data.points.length} data-cities={data.cities.length} role="region" aria-label={M.title}></div>
  </div>
  {data.points.length + data.cities.length === 0 && <p class="co-meta mt-3" data-testid="map-empty">{M.none}</p>}

  <details class="mt-3" data-testid="map-legend" open>
    <summary class="co-meta cursor-pointer">{M.legend}</summary>
    <div class="mt-2 grid gap-2">
      <ul class="m-0 flex flex-wrap gap-x-4 gap-y-1 p-0 text-sm">
        {byRep
          ? <>{reps.map((r) => <li class="flex list-none items-center gap-1.5"><span class="map-dot" style={`background:${repColor[r]}`}></span>{r}</li>)}<li class="flex list-none items-center gap-1.5"><span class="map-dot" style="background:#9ca3af"></span>{M.noRep}</li></>
          : STATES.filter(([k]) => k !== 'all').map(([k, l]) => <li class="flex list-none items-center gap-1.5"><span class="map-dot" style={`background:${STATE_COLOR[k as State]}`}></span>{l}</li>)}
      </ul>
      <p class="co-help">{M.hotRing} · {M.coldDash}</p>
      <p class="co-help">{M.exactHelp}</p>
    </div>
  </details>

  <script type="application/json" id="map-data" set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
  <script type="application/json" id="map-locate-text" set:html={JSON.stringify({ locating: M.locating('{n}'), located: M.located, failed: M.locateFailed }).replace(/</g, '\\u003c')} />
</AdminLayout>

<style>
  .crm-map { height: max(420px, calc(100vh - 330px)); width: 100%; background: #eef0ec; }
  .map-dot { display: inline-block; width: 12px; height: 12px; border-radius: 999px; border: 1.5px solid #fff; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15); }
  :global(.map-city) { display: flex; align-items: center; justify-content: center; border-radius: 999px; font: 700 12px/1 var(--co-font-sans, system-ui);
    color: #fff; border: 2px solid #fff; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25); opacity: 0.9; }
  :global(.map-pop) { display: grid; gap: 4px; min-width: 200px; font: 13px/1.4 var(--co-font-sans, system-ui); }
  :global(.map-pop strong) { font-size: 14px; }
  :global(.map-pop .muted) { color: #6b6b6b; }
  :global(.map-pop a.btn) { margin-top: 6px; display: inline-block; padding: 6px 12px; border-radius: 999px; background: #0a0a0a; color: #fff !important; text-decoration: none; width: fit-content; }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type Point = { id: string; name: string; lat: number; lng: number; state: string; zone: string; temp: string; score: number; cooling: number | null; next: string | null; rating: number | null; owner: string | null; rep: string | null };
  type City = { zoneId: string; name: string; path: string; lat: number; lng: number; count: number; hot: number; rep: string | null };
  const el = document.getElementById('crm-map');
  const raw = document.getElementById('map-data')?.textContent;
  if (el && raw) {
    const d = JSON.parse(raw) as { points: Point[]; cities: City[]; byRep: boolean; repColor: Record<string, string>; stateColor: Record<string, string>; T: Record<string, string> & { stateLabel: Record<string, string> } };
    const T = d.T;
    const map = L.map(el, { scrollWheelZoom: true, zoomControl: true }).setView([40.2, -3.7], 6);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      maxZoom: 19, subdomains: 'abcd',
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
    }).addTo(map);
    const colorOf = (state: string, rep: string | null) => (d.byRep ? (rep ? d.repColor[rep] : '#9ca3af') : d.stateColor[state] ?? '#6b7280');
    // Los textos van como texto (nunca como HTML): nombres y notas vienen de los datos.
    const node = (tag: string, text: string, cls?: string) => { const n = document.createElement(tag); n.textContent = text; if (cls) n.className = cls; return n; };
    const bounds: Array<[number, number]> = [];

    for (const c of d.cities) {
      const size = Math.round(Math.min(56, 24 + Math.sqrt(c.count) * 3));
      const icon = L.divIcon({ className: '', html: `<span class="map-city" data-testid="map-city" style="width:${size}px;height:${size}px;background:${d.byRep ? (c.rep ? d.repColor[c.rep] : '#9ca3af') : '#3f3f46'}">${Number(c.count)}</span>`, iconSize: [size, size] });
      const pop = document.createElement('div'); pop.className = 'map-pop';
      pop.append(node('strong', c.path || c.name), node('span', c.count === 1 ? T.city1 : T.city.replace('{n}', String(c.count))));
      if (c.hot) pop.append(node('span', T.cityHot.replace('{n}', String(c.hot))));
      if (d.byRep) pop.append(node('span', `${T.rep}: ${c.rep ?? T.noRep}`, 'muted'));
      pop.append(node('span', T.cityHelp, 'muted'));
      const a = node('a', T.seeList, 'btn') as HTMLAnchorElement; a.href = `/admin/accounts?ver=all&zona=${encodeURIComponent(c.zoneId)}`; pop.append(a);
      L.marker([c.lat, c.lng], { icon, title: c.name }).bindPopup(pop).addTo(map);
      bounds.push([c.lat, c.lng]);
    }
    for (const p of d.points) {
      const hot = p.temp === 'hot'; const cold = p.temp === 'cold';
      const m = L.circleMarker([p.lat, p.lng], {
        radius: 7, fillColor: colorOf(p.state, p.rep), fillOpacity: cold ? 0.35 : 0.95, color: hot ? '#f97316' : '#ffffff', weight: hot ? 3.5 : 1.5,
        dashArray: cold ? '3 3' : undefined, className: `map-point map-point--${p.temp}`,
      });
      const pop = document.createElement('div'); pop.className = 'map-pop'; pop.dataset.testid = 'map-popup';
      pop.append(node('strong', p.name));
      if (p.zone) pop.append(node('span', p.zone, 'muted'));
      pop.append(node('span', [T.stateLabel[p.state] ?? p.state, T.score.replace('{n}', String(p.score))].join(' · ')));
      if (p.cooling !== null) pop.append(node('span', T.cooling.replace('{n}', String(p.cooling))));
      if (p.rating !== null) pop.append(node('span', `★ ${p.rating.toLocaleString(document.documentElement.lang || 'es')} ${T.reviews}`, 'muted'));
      if (p.next) pop.append(node('span', `${T.next}: ${p.next}`));
      if (p.owner) pop.append(node('span', `${T.owner}: ${p.owner}`, 'muted'));
      if (d.byRep) pop.append(node('span', `${T.rep}: ${p.rep ?? T.noRep}`, 'muted'));
      const a = node('a', T.open, 'btn') as HTMLAnchorElement; a.href = `/admin/accounts/${encodeURIComponent(p.id)}`; pop.append(a);
      m.bindPopup(pop).bindTooltip(p.name).addTo(map);
      bounds.push([p.lat, p.lng]);
    }
    if (bounds.length) map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
    el.dataset.ready = '1';
  }

  // Filtros al momento (como en la lista de empresas).
  document.querySelectorAll<HTMLFormElement>('form[data-map-filters]').forEach((f) => {
    f.addEventListener('change', () => f.requestSubmit());
    f.addEventListener('formdata', (e) => { for (const [k, v] of [...e.formData]) if (!v || (k === 'estado' && v === 'all')) e.formData.delete(k); });
  });

  // Situar las ciudades (admin): tandas hasta acabar, con el progreso a la vista; al final, recargar.
  document.querySelector<HTMLButtonElement>('[data-locate]')?.addEventListener('click', async (ev) => {
    const btn = ev.currentTarget as HTMLButtonElement;
    const label = btn.querySelector('span');
    const T = JSON.parse(document.getElementById('map-locate-text')?.textContent ?? '{}') as { locating: string; located: string; failed: string };
    btn.disabled = true;
    for (let i = 0; i < 40; i++) {
      const res = await fetch('/admin/api/crm/zones-locate', { method: 'POST' }).catch(() => null);
      const j = res ? ((await res.json().catch(() => ({}))) as { located?: number; left?: number; error?: string }) : {};
      if (!res || !res.ok) { if (label) label.textContent = j.error || T.failed; btn.disabled = false; return; }
      if (label) label.textContent = T.locating.replace('{n}', String(j.left ?? 0));
      if (!j.left || !j.located) break;
    }
    if (label) label.textContent = T.located;
    location.reload();
  });
</script>
