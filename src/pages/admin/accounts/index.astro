---
import GroupPicker from '~/components/crm/GroupPicker.astro';
/**
 * Cuentas (docs/ACCOUNTS.md): los locales de tu zona y quién los trabaja, para no pisarse.
 * Primero lo tuyo; después lo libre; lo de otros y lo bloqueado al final.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import Icon from '~/components/ui/Icon.astro';
import AccountState from '~/components/accounts/AccountState.astro';
import ViewToggle from '~/components/crm/ViewToggle.astro';
import { rememberedFilters, saveFilters, myCountry } from '~/lib/ui/remember';
import { priorityFor } from '~/lib/crm/score';
import { profileOf } from '~/lib/accounts/types';
import { profilesMessages } from '~/lib/i18n/messages/profiles';
import PlaceFilter from '~/components/crm/PlaceFilter.astro';
import { can } from '~/lib/admin/permissions';
import { flash, formAction } from '~/lib/admin/forms';
import { zonePath } from '~/lib/accounts/rules';
import { NO_ZONE } from '~/lib/accounts/service';
import type { AccountState as State } from '~/lib/accounts/types';
import { i18n } from '~/lib/i18n';
import { accountsMessages } from '~/lib/i18n/messages/accounts';
import { shellMessages } from '~/lib/i18n/messages/shell';
import { crmMessages } from '~/lib/i18n/messages/crm';
import { cleanupMessages } from '~/lib/i18n/messages/cleanup';
import { formatValue } from '~/lib/crm/fields';
import { peopleMessages } from '~/lib/i18n/messages/people';
import { priorityMessages } from '~/lib/i18n/messages/priority';
import { routeMessages } from '~/lib/i18n/messages/route';
import { researchMessages } from '~/lib/i18n/messages/research';
import { prospectMessages } from '~/lib/i18n/messages/prospect';
import { mergeMessages } from '~/lib/i18n/messages/merge';
import { compareLeads, priorityOf } from '~/lib/crm/priority';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const perms = can(admin.session.role);
if (!perms.useAccounts) return Astro.rewrite('/admin/forbidden');
const acc = admin.accounts;
const { m: { list: M, detail: D }, f: fmt, locale } = i18n(Astro, accountsMessages);
const S = shellMessages[locale];
const CF = crmMessages[locale].filters;
const P = peopleMessages[locale];
const R = priorityMessages[locale];
const CL = cleanupMessages[locale];
const AI = researchMessages[locale];
const PR = prospectMessages[locale];
const MG = mergeMessages[locale];
/** «Investigar zona»: máximo por clic (cada una tarda y cuesta). */
const AI_MAX = 20;

let result: { error: string | null; details: string[] } = { error: null, details: [] };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const str = (k: string) => String(f.get(k) ?? '');
  let to = '';
  result = await formAction(async () => {
    if (str('action') === 'create') {
      const id = await acc.create({ name: str('name'), zoneId: str('zoneId'), segmentId: str('segmentId'), address: str('address'), notes: str('notes'), kind: str('kind') });
      // «¿Es de algún grupo?» (§26): el elegido o uno nuevo. Si fallara, la empresa ya está creada: se sigue a su ficha.
      if (str('groupId') || str('groupName').trim()) {
        await admin.crm.moveToGroup([id], { groupId: str('groupId') || null, groupName: str('groupId') ? null : str('groupName') })
          .catch((e) => console.warn('[alta] grupo', e instanceof Error ? e.message : e));
      }
      to = `/admin/accounts/${id}?ok=created`;
    } else if (f.getAll('action').includes('kind-many')) {
      // Cambiar tipo en bloque (§42): va antes que «mover» (mismo formulario de la barra).
      const n = await admin.crm.setKindMany(f.getAll('ids').map(String), str('newKind'));
      to = `/admin/accounts?ok=kinds&n=${n}`;
    } else if (f.getAll('action').includes('release-many')) {
      // Va antes que «mover»: el botón de soltar está en el mismo formulario de la barra.
      // «También las que no se ven»: todas las tuyas con los filtros de ahora (la lista solo enseña las primeras).
      const all = str('allMine') ? (await acc.list({ scope: 'mine', q: str('q') || undefined, zoneId: str('zona') || undefined, tag: str('lista') || undefined, view: str('view') || 'company' })).items
        .filter((a) => a.state === 'mine').map((a) => a.id) : [];
      const n = await acc.releaseMany([...f.getAll('ids').map(String), ...all]);
      to = `/admin/accounts?ok=released&n=${n}`;
    } else if (str('action') === 'move-group') {
      const ids = f.getAll('ids').map(String).filter(Boolean);
      const r = await admin.crm.moveToGroup(ids, { groupName: str('groupName') });
      to = `/admin/accounts?ok=moved&n=${r.moved}`;
    } else if (str('action') === 'claim') {
      const e = await acc.touch(str('id'), 'claim');
      to = `/admin/accounts/${str('id')}?ok=${e === 'eligible' ? 'claimed' : `not-${e}`}`;
    }
  });
  if (!result.error && to) return Astro.redirect(to, 303);
}

// Filtros recordados (§23): sin filtros en la URL, los de la última vez; la primera vez, tu país.
const t = await acc.territory();
const { q, fresh } = rememberedFilters(Astro.url, Astro.cookies, 'co_f_list');
// Con zona asignada, «Mi zona» ya acota (el país la pisaría); sin zona, tu país.
if (fresh && !t.myZoneIds.length) { const c = myCountry(Astro.cookies, t.zones, t.myZoneIds); if (c) q.set('zona', c); }
const scope = (['zone', 'mine', 'all'].includes(q.get('ver') ?? '') ? q.get('ver') : 'zone') as 'zone' | 'mine' | 'all';
const stateF = (q.get('estado') ?? 'all') as State | 'all';
const search = q.get('q') ?? '';
// Listas (fase 2): una vista por vertical, p. ej. «proveedores-bodas».
const lista = q.get('lista') ?? '';
// Ciudad o zona (con sus ciudades dentro).
const zona = q.get('zona') ?? '';
// Pestañas por tipo de cliente del espacio (§21: Empresas · DJs en Enjoy; Centros · ONGs en Oquea) y Descartadas.
const kindDefs = await acc.kinds();
const tipoQ = q.get('tipo') ?? '';
const tipo = tipoQ === 'descartadas' || kindDefs.some((k) => k.key === tipoQ && k.key !== 'company') ? tipoQ : '';
const listView = tipo === 'descartadas' ? 'discarded' : tipo || 'company';
const shownMax = Math.max(100, Math.min(Number(q.get('n')) || 100, 20000));
// Campos del CRM (docs/CRM_DINAMICO.md): los marcados salen como columna y los filtrables como filtro (?c.<clave>=valor).
const crm = (await acc.crmFields()).filter((x) => x.target === 'account' && (!x.tags.length || x.tags.includes(lista)));
const filterable = crm.filter((x) => x.filterable);
const fieldFilter: Record<string, string> = Object.fromEntries(filterable.map((x) => [x.key, q.get(`c.${x.key}`) ?? '']).filter(([, v]) => v));
const columns = crm.filter((x) => x.inList);
const [{ items, total, scope: effective, kinds }, colleagues, segments, lists, weights] = await Promise.all([
  acc.list({ scope, q: search, fields: fieldFilter, tag: lista, zoneId: zona || undefined, view: listView }), acc.colleagues(), admin.playbook.segmentList(), admin.crm.lists({ people: false }),
  admin.crm.weights(),
]);
const accountLists = lists.filter((l) => l.accounts > 0);
// Etapa de la lista: chips por opción (filtran por su campo).
const stage = lista ? crm.find((x) => x.isStage) : undefined;
// Prioridad (docs/CRM_DINAMICO.md §11): puntuación de cada empresa; ordenar por ella y filtrar sin cualificar / fuera / se enfrían.
const orden = q.get('orden') === 'prioridad' ? 'prioridad' : '';
const cual = (['sin', 'fuera', 'enfria', 'ia'].includes(q.get('cual') ?? '') ? q.get('cual') : '') as '' | 'sin' | 'fuera' | 'enfria' | 'ia';
const segKey = new Map(segments.map((sg) => [sg.id, sg.key]));
// La nota según la ficha de su tipo (§24): local, promotora o DJ.
const prio = new Map(items.map((a) => [a.id, priorityFor(a.qualification, profileOf(kindDefs, a.kind), segKey.get(a.segmentId ?? '') ?? null, weights)]));
const PRF = profilesMessages[locale];
const critLabel = (k: string) => (R.criteria as Record<string, string>)[k] ?? (PRF.q as unknown as Record<string, [string, unknown]>)[k]?.[0] ?? PRF.style;
const byState = items.filter((a) => stateF === 'all' || a.state === stateF);
const cooling = await admin.crm.cooling(cual === 'enfria' ? byState.map((a) => a.id) : byState.slice(0, shownMax).map((a) => a.id));
let shown = byState.filter((a) => {
  const p = prio.get(a.id)!;
  return cual === 'sin' ? !p.out && !p.qualified : cual === 'fuera' ? p.out : cual === 'enfria' ? cooling.has(a.id) : cual === 'ia' ? !!a.aiResearchAt : true;
});
// Investigadas por IA: las últimas primero (para repasar sus propuestas).
if (cual === 'ia' && orden !== 'prioridad') shown = [...shown].sort((x, y) => String(y.aiResearchAt).localeCompare(String(x.aiResearchAt)));
if (orden === 'prioridad') shown = [...shown].sort((x, y) => compareLeads(prio.get(x.id)!, prio.get(y.id)!) || x.name.localeCompare(y.name, 'es'));
// El nombre del grupo solo de las que se van a ver (no de todas las de la zona).
const groupNames = await admin.crm.names(shown.slice(0, shownMax).map((a) => a.parentId ?? ''));
const count = (s: State) => items.filter((a) => a.state === s).length;
const mineCount = count('mine');
const STATES: Array<[State | 'all', string]> = (['all', 'mine', 'free', 'taken', 'my_customer', 'customer', 'blocked'] as const).map((k) => [k, M.states[k]]);
const href = (p: Record<string, string>) => {
  const u = new URLSearchParams({ ...(scope !== 'zone' ? { ver: scope } : {}), ...(stateF !== 'all' ? { estado: stateF } : {}), ...(search ? { q: search } : {}), ...(lista ? { lista } : {}), ...(zona ? { zona } : {}), ...(tipo ? { tipo } : {}),
    ...(orden ? { orden } : {}), ...(cual ? { cual } : {}),
    ...Object.fromEntries(Object.entries(fieldFilter).map(([k, v]) => [`c.${k}`, v])), ...p });
  for (const [k, v] of [...u]) if (!v || (k === 'ver' && v === 'zone') || (k === 'estado' && v === 'all')) u.delete(k);
  // Sin nada: «todo, a propósito» (si no, se volverían a poner los filtros recordados).
  return `/admin/accounts?${u.size ? u : 'todo=1'}`;
};
saveFilters(Astro.cookies, 'co_f_list', new URL(href({}), Astro.url).searchParams, t.zones);
const myZones = t.myZoneIds.map((z) => t.zones.find((x) => x.id === z)?.name).filter(Boolean).join(', ');
const wa = (phone: string) => `https://wa.me/${phone.replace(/[^\d]/g, '')}`;
const okMsg = flash(Astro.url, { moved: P.bulk.ok(Number(q.get('n')) || 0), released: M.bulkReleased(Number(Astro.url.searchParams.get('n')) || 0), pickTwo: MG.pickTwo, kinds: CL.kindChanged(Number(q.get('n')) || 0) });
// Barra de filtros: ciudades (con su ruta si hay región), cualificación, y lo aplicado como chips quitables.
const zoneOptions = t.zones.map((z) => ({ id: z.id, label: zonePath(t.zones, z.id) })).sort((a, b) => a.label.localeCompare(b.label, locale));
const QUALITY: Array<[string, string]> = [['sin', R.list.unqualified], ['enfria', R.list.cooling], ['fuera', R.list.out], ['ia', AI.zone.filter]];
const fieldLabel = (k: string, v: string) => { const fd = filterable.find((x) => x.key === k); const o = fd?.options.find((x) => x.key === v);
  return `${fd?.label.replace(/^¿|\?$/g, '') ?? k}: ${fd?.type === 'checkbox' ? (v === 'yes' ? crmMessages[locale].card.yes : crmMessages[locale].card.no) : o?.label ?? v}`; };
const active = [
  ...(search ? [{ label: `«${search}»`, clear: href({ q: '' }) }] : []),
  ...(zona ? [{ label: zona === NO_ZONE ? M.noCity : zoneOptions.find((z) => z.id === zona)?.label ?? M.zoneFilter, clear: href({ zona: '' }) }] : []),
  ...(lista ? [{ label: lista, clear: href({ lista: '' }) }] : []),
  ...(stateF !== 'all' ? [{ label: M.states[stateF], clear: href({ estado: 'all' }) }] : []),
  ...(cual ? [{ label: QUALITY.find(([k]) => k === cual)?.[1] ?? cual, clear: href({ cual: '' }) }] : []),
  ...(orden ? [{ label: `↓ ${R.list.sort}`, clear: href({ orden: '' }) }] : []),
  ...Object.entries(fieldFilter).map(([k, v]) => ({ label: fieldLabel(k, v), clear: href({ [`c.${k}`]: '' }) })),
];
// El panel de filtros (lista, estado, cualificación, orden, campos) sale abierto si hay alguno aplicado.
const nFilters = [lista, stateF !== 'all' ? stateF : '', cual, orden, ...Object.values(fieldFilter)].filter(Boolean).length;
const panelOpen = nFilters > 0;
---
<AdminLayout title={M.title}>
  <PageHeader eyebrow={M.eyebrow} title={M.title} lede={M.lede(t.rules.claimDays)}>
    <ViewToggle current="list" />
    {/* Añadir: a mano, desde Google Maps o (admin) importando. «Apuntar» es el botón flotante ✨ de toda la consola. */}
    <details class="co-popover co-popover--down" data-testid="add-menu">
      <summary class="co-btn co-btn--primary" data-testid="add-open"><Icon name="plus" size={16} />{PR.add}<Icon name="chevron-down" size={14} /></summary>
      <div class="co-popover__menu">
        <div class="co-actions">
          <button type="button" class="co-action" data-dialog-open="new-account" data-testid="new-account"><Icon name="plus" /><span class="co-action__label">{M.newAccount}</span></button>
          <a class="co-action" href="/admin/accounts/buscar" data-testid="prospect-open"><Icon name="search" /><span class="co-action__label">{PR.fromGoogle}<small>{PR.fromGoogleHelp}</small></span></a>
          {perms.importCrm && <a class="co-action" href="/admin/import" data-testid="import-open"><Icon name="upload" /><span class="co-action__label">{M.import}<small>{PR.importHelp}</small></span></a>}
        </div>
      </div>
    </details>
  </PageHeader>
  {okMsg && <div class="mb-4"><Alert kind="success" title={okMsg} /></div>}
  {result.error && <div class="mb-4"><Alert kind="rejection" title={result.error} details={result.details} /></div>}

  {(myZones || colleagues.length > 0 || !perms.manageAccounts) && (
  <section class="co-card mb-6 grid gap-3" data-testid="my-zone">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="co-card-title flex items-center gap-2"><Icon name="map-pin" size={18} />{myZones ? M.yourZone(myZones) : M.noZone}</h2>
      {!myZones && <span class="co-meta">{M.seeAll} {M.askLead}</span>}
    </div>
    {colleagues.length > 0 && (
      <div class="grid gap-2" data-testid="colleagues">
        <p class="text-eyebrow">{M.colleagues}</p>
        <ul class="co-grid co-grid--3 m-0 p-0">
          {colleagues.map((c) => (
            <li class="co-inset flex list-none flex-wrap items-center gap-3 !p-3">
              <span class="min-w-0 flex-1"><span class="co-row-title block truncate">{c.name}</span><span class="co-meta">{c.zones.join(', ')}</span></span>
              {c.phone && <a class="co-btn co-btn--ghost co-btn--icon co-btn--sm" href={wa(c.phone)} target="_blank" rel="noopener noreferrer" aria-label={M.whatsappTo(c.name)} title={M.whatsapp}><Icon name="message-square-text" size={14} /></a>}
              {c.phone && <a class="co-btn co-btn--ghost co-btn--icon co-btn--sm" href={`tel:${c.phone}`} aria-label={M.callTo(c.name)} title={M.call}><Icon name="phone" size={14} /></a>}
              <a class="co-btn co-btn--ghost co-btn--icon co-btn--sm" href={`mailto:${c.email}`} aria-label={M.emailTo(c.name)} title={M.email}><Icon name="mail" size={14} /></a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
  )}

  {/* Una sola barra: buscar, ciudad y filtros. Cambiar cualquier cosa aplica al momento (sin botón «Filtrar»). */}
  <nav id="kind-tabs" class="co-segmented mb-3 w-fit max-w-full overflow-x-auto !px-1 [grid-auto-columns:max-content]" aria-label={CL.tabs.label} data-testid="kind-tabs" data-scroll-x>
    {[...kindDefs.map((k) => [k.key === 'company' ? '' : k.key, k.plural, kinds[k.key] ?? 0] as const), ['descartadas', CL.tabs.discarded, kinds.discarded ?? 0] as const].map(([k, l, n]) => (
      <a href={href({ tipo: k })} class="!px-4 whitespace-nowrap" aria-current={tipo === k ? 'page' : undefined} data-testid={`kind-tab-${k || 'company'}`}>{l} <span class="co-meta">{n}</span></a>
    ))}
  </nav>
  <form method="get" class="co-card mb-3 grid gap-3 !p-4" data-testid="acc-toolbar" data-autosubmit data-async-get="kind-tabs acc-results" role="search">
    {tipo && <input type="hidden" name="tipo" value={tipo} />}
    <div class="flex flex-wrap items-center gap-2">
      <label class="sr-only" for="acc-q">{M.search}</label>
      <input id="acc-q" class="co-input min-w-[12rem] flex-[2]" type="search" name="q" value={search} placeholder={M.search} />
      <PlaceFilter zones={t.zones} value={zona} />
      <label class="sr-only" for="acc-scope">{M.scope}</label>
      <select id="acc-scope" class="co-select w-auto" name="ver" data-testid="filter-scope">
        {t.myZoneIds.length > 0 && <option value="zone" selected={effective === 'zone'}>{M.myZone}</option>}
        <option value="all" selected={effective === 'all'}>{M.scopeAll}</option>
        <option value="mine" selected={effective === 'mine'}>{M.scopeMine}</option>
      </select>
      <button type="button" class="co-btn co-btn--ghost" data-filters-toggle aria-expanded={panelOpen ? 'true' : 'false'} aria-controls="acc-filters" data-testid="filters-toggle">
        <Icon name="settings" size={16} />{M.filters}{nFilters > 0 && ` · ${nFilters}`}
      </button>
    </div>
    <div id="acc-filters" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" hidden={!panelOpen} data-filters-panel>
      {accountLists.length > 0 && (
        <label class="co-field !gap-1 text-xs">{M.list}
          <select class="co-select" name="lista" data-testid="filter-list"><option value="">{M.anyList}</option>{accountLists.map((l) => <option value={l.tag} selected={lista === l.tag}>{l.tag} · {l.accounts}</option>)}</select></label>
      )}
      <label class="co-field !gap-1 text-xs">{M.state}
        <select class="co-select" name="estado" data-testid="filter-state">{STATES.filter(([k]) => k === 'all' || k === stateF || count(k as State) > 0).map(([k, l]) => <option value={k} selected={stateF === k}>{l}{k !== 'all' ? ` · ${count(k as State)}` : ''}</option>)}</select></label>
      <label class="co-field !gap-1 text-xs">{M.quality}
        <select class="co-select" name="cual" data-testid="filter-quality">
          <option value="">{M.anyQuality}</option>
          {QUALITY.map(([k, l]) => <option value={k} selected={cual === k}>{l}</option>)}
        </select></label>
      <label class="co-field !gap-1 text-xs">{M.order}
        <select class="co-select" name="orden" data-testid="filter-order"><option value="">{M.orderDefault}</option><option value="prioridad" selected={orden === 'prioridad'}>{R.list.sort}</option></select></label>
      {filterable.length > 0 && (
        <div class="contents" data-testid="crm-filters">
          {filterable.map((fd) => (
            <label class="co-field !gap-1 text-xs">{fd.label}
              {fd.type === 'checkbox' ? (
                <select class="co-select" name={`c.${fd.key}`} data-field={fd.key}><option value="">{CF.any}</option><option value="yes" selected={fieldFilter[fd.key] === 'yes'}>{crmMessages[locale].card.yes}</option><option value="no" selected={fieldFilter[fd.key] === 'no'}>{crmMessages[locale].card.no}</option></select>
              ) : fd.type === 'select' || fd.type === 'multi_select' ? (
                <select class="co-select" name={`c.${fd.key}`} data-field={fd.key}><option value="">{CF.any}</option>{fd.options.map((o) => <option value={o.key} selected={fieldFilter[fd.key] === o.key}>{o.label}</option>)}</select>
              ) : (
                <input class="co-input" name={`c.${fd.key}`} value={fieldFilter[fd.key] ?? ''} placeholder={CF.search} data-field={fd.key} />
              )}
            </label>
          ))}
        </div>
      )}
    </div>
    <noscript><button class="co-btn co-btn--ghost co-btn--sm w-fit" type="submit">{M.show}</button></noscript>
  </form>

  {/* Los resultados: se cambian sin recargar al filtrar (data-async-get). */}
  <div id="acc-results" class="co-swap">
  {/* Lo que está aplicado, a la vista y quitable de un clic; el número de empresas y las acciones sobre ellas. */}
  <div class="mb-5 flex flex-wrap items-center gap-2" data-testid="acc-active">
    <span class="co-meta font-semibold" data-testid="acc-count">{M.count(shown.length)}</span>
    {active.map((f) => <a class="co-chip" href={f.clear} data-testid="active-filter" title={M.clearAll}>{f.label} <Icon name="x" size={12} /></a>)}
    {active.length > 1 && <a class="co-meta underline" href={href({ zona: '', lista: '', estado: 'all', cual: '', orden: '', q: '', ...Object.fromEntries(Object.keys(fieldFilter).map((k) => [`c.${k}`, ''])) })} data-testid="clear-filters">{M.clearAll}</a>}
  </div>
  {stage && (
    <div class="co-chips mb-4" data-scroll-x data-testid="stage-chips" aria-label={P.lists.stage}>
      {stage.options.map((o) => { const n = items.filter((a) => a.fields[stage.key] === o.key).length; return (
        <a class="co-chip" href={href({ [`c.${stage.key}`]: fieldFilter[stage.key] === o.key ? '' : o.key })} aria-current={fieldFilter[stage.key] === o.key ? 'true' : undefined}>{o.label} · {n}</a>
      ); })}
    </div>
  )}
  <script>
    // Filtros al momento: cambiar un desplegable aplica; el texto, al pulsar Enter. «Filtros» abre y cierra el panel.
    document.querySelectorAll<HTMLFormElement>('form[data-autosubmit]').forEach((f) => {
      f.addEventListener('change', (e) => { if (e.target instanceof HTMLSelectElement) f.requestSubmit(); });
      // Mientras escribes, lo que ya se ve se filtra al momento; el resultado completo llega por detrás.
      const norm = (x: string) => x.toLowerCase().normalize('NFD').replace(/\p{M}/gu, '');
      f.querySelector<HTMLInputElement>('input[name=q]')?.addEventListener('input', (e) => {
        const q = norm((e.target as HTMLInputElement).value.trim());
        document.querySelectorAll<HTMLElement>('#acc-results [data-testid=account]').forEach((li) => { li.hidden = !!q && !norm(li.dataset.name ?? '').includes(q); });
      });
      // Lo vacío no va a la URL (queda limpia y compartible).
      f.addEventListener('formdata', (e) => { for (const [k, v] of [...e.formData]) if (!v || (k === 'estado' && v === 'all')) e.formData.delete(k); });
      const btn = f.querySelector<HTMLButtonElement>('[data-filters-toggle]');
      const panel = f.querySelector<HTMLElement>('[data-filters-panel]');
      btn?.addEventListener('click', () => { if (!panel) return; panel.hidden = !panel.hidden; btn.setAttribute('aria-expanded', String(!panel.hidden)); });
    });
  </script>

  {shown.length === 0
    ? (total === 0
        ? <EmptyState kind="create" title={effective === 'mine' ? M.emptyMine : M.emptyZone} detail={M.emptyDetail} action={{ dialog: 'new-account', label: M.newAccount }} />
        : <EmptyState kind="filter" title={M.emptyFilter} clearHref="/admin/accounts" />)
    : <>
      <label class="co-meta flex w-fit cursor-pointer items-center gap-2" data-testid="bulk-all-label">
        <input type="checkbox" class="h-4 w-4 accent-[var(--co-ink)]" data-bulk-all data-testid="bulk-all" />{M.selectAll(Math.min(shown.length, shownMax))}
      </label>
      <ul class="co-rows" data-testid="accounts">
        {shown.slice(0, shownMax).map((a) => (
          <li class:list={['co-row', a.state === 'mine' && 'co-row--attention']} data-testid="account" data-name={a.name}>
            <label class="co-row__lead cursor-pointer" title={P.bulk.select(a.name)}>
              <input type="checkbox" class="h-4 w-4 accent-[var(--co-ink)]" name="ids" value={a.id} form="bulk-group" data-bulk aria-label={P.bulk.select(a.name)} />
            </label>
            <a class="co-row__main text-inherit !no-underline" href={`/admin/accounts/${a.id}`}>
              <span class="co-row-title">{a.name}{a.discardReason && <span class="co-tag !py-0 text-[11px] ml-2" data-testid="discard-tag">{CL.reasons[a.discardReason]}</span>}</span>
              <span class="co-meta">{a.parentId && groupNames.get(a.parentId) ? <><Icon name="building2" size={12} /> {groupNames.get(a.parentId)} · </> : ''}{a.zonePath ? `${a.zonePath.split(' › ').slice(-2).join(' › ')} · ` : ''}<AccountState a={a} detail /></span>
              {columns.some((c) => formatValue(c, a.fields[c.key], locale)) && (
                <span class="mt-1 flex flex-wrap gap-1.5" data-testid="account-columns">
                  {columns.map((c) => { const v = formatValue(c, a.fields[c.key], locale); return v ? <span class="co-tag">{c.type === 'checkbox' ? c.label.replace(/^¿|\?$/g, '') : `${c.label}: ${v}`}</span> : null; })}
                </span>
              )}
            </a>
            {(() => { const p = prio.get(a.id)!; const c = cooling.get(a.id); return (
              <span class="flex flex-wrap items-center justify-end gap-1.5" data-testid="account-priority" data-score={p.score} data-out={p.out ? 'true' : 'false'}>
                {c !== undefined && <span class="co-tag co-tag--danger" title={R.coolingHelp}>{R.cooling(c)}</span>}
                {a.aiResearchAt && <span class="co-tag" title={AI.at(fmt.relative(a.aiResearchAt))} data-testid="account-ai"><Icon name="sparkles" size={12} />{AI.zone.badge}</span>}
                {p.out ? <span class="co-tag" title={p.kills.map((k) => R.kills[k]).join(' · ')}>{R.outBy(R.kills[p.kills[0]])}</span>
                  : <span class="co-tag" title={p.parts.map((x) => `${critLabel(x.key)}: ${x.points ?? R.unknown}/${x.weight}`).join('\n')}><strong>{p.score}</strong>{!p.qualified && <span class="co-meta">&nbsp;· {R.upTo(p.max)}</span>}</span>}
              </span>
            ); })()}
            <AccountState a={a} />
            {a.state === 'free' && (
              <form method="post"><input type="hidden" name="action" value="claim" /><input type="hidden" name="id" value={a.id} />
                <button class="co-btn co-btn--ghost co-btn--sm" type="submit" data-testid="claim">{M.claim}</button></form>
            )}
          </li>
        ))}
      </ul>
    </>}
  {shown.length > shownMax && (
    <p class="mt-4 flex items-center gap-3"><a class="co-btn co-btn--ghost co-btn--sm" href={href({ n: String(shownMax + 200) })} data-testid="more">{P.people.more}</a><span class="co-meta">{P.people.shown(shownMax, shown.length)}</span></p>
  )}
  </div>

  <form id="bulk-group" method="post" class="co-bulkbar" hidden data-testid="bulk-bar">
    <input type="hidden" name="action" value="move-group" />
    <span class="font-semibold" data-bulk-count></span>
    <button type="button" class="co-btn co-btn--primary co-btn--sm" data-dialog-open="move-group" data-testid="bulk-move"><Icon name="building2" size={14} /><span data-bulk-label></span></button>
    <button type="submit" class="co-btn co-btn--ghost co-btn--sm" formaction="/admin/route" formmethod="get" formnovalidate data-testid="bulk-route"><Icon name="map" size={14} />{routeMessages[locale].bulk}</button>
    {admin.crm.hasAi() && <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-bulk-ai data-testid="bulk-ai" title={AI.zone.max(AI_MAX)}><Icon name="sparkles" size={14} />{AI.zone.run}</button>}
    <button type="submit" class="co-btn co-btn--ghost co-btn--sm" formaction="/admin/accounts/unir" formmethod="get" formnovalidate hidden data-bulk-merge data-testid="bulk-merge"><Icon name="layers" size={14} />{MG.bulk}</button>
    {kindDefs.length > 1 && <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-dialog-open="bulk-kind" data-testid="bulk-kind"><Icon name="tag" size={14} />{CL.changeKind}</button>}
    <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-dialog-open="bulk-release" data-testid="bulk-release"><Icon name="log-out" size={14} />{M.bulkRelease}</button>
    <button type="button" class="co-btn co-btn--quiet co-btn--sm" data-bulk-clear>{P.bulk.clear}</button>
    {kindDefs.length > 1 && (
      <dialog id="bulk-kind" class="co-dialog" aria-labelledby="bulk-kind-title">
        <div class="co-dialog__body">
          <h2 id="bulk-kind-title" class="co-entity">{CL.changeKind}</h2>
          <p class="co-body">{CL.changeKindBody}</p>
          <div class="co-chips">{kindDefs.map((k, i) => <label class="co-chip" data-testid={`bulk-kind-${k.key}`}><input type="radio" name="newKind" value={k.key} checked={i === 0} />{k.label}</label>)}</div>
        </div>
        <div class="co-dialog__foot">
          <button type="button" class="co-btn co-btn--ghost" data-dialog-close>{S.ui.cancel}</button>
          <button class="co-btn co-btn--primary" type="submit" name="action" value="kind-many" formnovalidate data-testid="bulk-kind-confirm">{CL.changeKind}</button>
        </div>
      </dialog>
    )}
    <dialog id="bulk-release" class="co-dialog" aria-labelledby="bulk-release-title">
      <div class="co-dialog__body">
        <h2 id="bulk-release-title" class="co-entity">{M.bulkReleaseTitle}</h2>
        <p class="co-body">{D.releaseDoes}</p>
        <p class="co-meta">{D.releaseDoesNot} {M.bulkReleaseOnlyMine}</p>
        {mineCount > shownMax && (
          <label class="co-check mt-2 flex items-center gap-2" data-testid="bulk-release-all">
            <input type="checkbox" name="allMine" value="1" class="h-4 w-4 accent-[var(--co-ink)]" />{M.bulkReleaseAll(mineCount)}
            <input type="hidden" name="q" value={search} /><input type="hidden" name="zona" value={zona} /><input type="hidden" name="lista" value={lista} /><input type="hidden" name="view" value={listView} />
          </label>
        )}
      </div>
      <div class="co-dialog__foot">
        <button type="button" class="co-btn co-btn--ghost" data-dialog-close>{S.ui.cancel}</button>
        <button class="co-btn co-btn--primary" type="submit" name="action" value="release-many" formnovalidate data-testid="bulk-release-confirm">{D.releaseConfirm}</button>
      </div>
    </dialog>
    <dialog id="move-group" class="co-dialog" aria-labelledby="move-group-title">
      <div class="co-dialog__body">
        <h2 id="move-group-title" class="co-entity">{P.bulk.moveTitle}</h2>
        <p class="co-body">{P.bulk.moveBody}</p>
        <label class="co-field">{P.group.group}<input class="co-input" name="groupName" required maxlength="160" list="group-names" placeholder={P.group.putPh} data-testid="bulk-group-name" /></label>
        <datalist id="group-names">{[...new Set(items.filter((a) => !a.parentId).map((a) => a.name))].slice(0, 500).map((n) => <option value={n} />)}</datalist>
      </div>
      <div class="co-dialog__foot">
        <button type="button" class="co-btn co-btn--ghost" data-dialog-close>{S.ui.cancel}</button>
        <button class="co-btn co-btn--primary" type="submit" data-testid="bulk-move-confirm">{P.bulk.moveConfirm}</button>
      </div>
    </dialog>
    <p class="co-meta m-0 basis-full" role="status" hidden data-bulk-ai-status data-testid="bulk-ai-status"></p>
  </form>
  <script define:vars={{ label: P.bulk.move(0) }}>
    // Barra de selección: aparece al marcar alguna fila (mover a un grupo en bloque).
    const bar = document.getElementById('bulk-group');
    const boxes = () => [...document.querySelectorAll('[data-bulk]')];
    const sync = () => {
      const n = boxes().filter((b) => b.checked).length;
      bar.hidden = n === 0;
      // Unir: solo con dos marcadas (§41).
      bar.querySelector('[data-bulk-merge]').hidden = n !== 2;
      const all = document.querySelector('[data-bulk-all]');
      if (all) all.checked = n > 0 && n === boxes().length;
      bar.querySelector('[data-bulk-label]').textContent = label.replace('0', String(n));
    };
    document.addEventListener('change', (e) => { if (e.target instanceof HTMLInputElement && e.target.matches('[data-bulk]')) sync(); });
    bar.querySelector('[data-bulk-clear]').addEventListener('click', () => { boxes().forEach((b) => { b.checked = false; }); sync(); });
    // «Seleccionar las que se ven»: marca o desmarca todas las filas de la página.
    document.querySelector('[data-bulk-all]')?.addEventListener('change', (e) => { boxes().forEach((b) => { b.checked = e.target.checked; }); sync(); });
  </script>
  <script define:vars={{ max: AI_MAX, T: { bg: PR.bg } }}>
    // «Investigar zona»: las marcadas (hasta 20) se investigan en segundo plano (AdminLayout): se puede seguir usando la
    // app y el progreso sale abajo. Las ya investigadas en los últimos 30 días y las de otro se saltan.
    const btn = document.querySelector('[data-bulk-ai]');
    const status = document.querySelector('[data-bulk-ai-status]');
    btn?.addEventListener('click', () => {
      const ids = [...document.querySelectorAll('[data-bulk]')].filter((b) => b.checked).slice(0, max).map((b) => b.value);
      if (!ids.length || !window.coResearch) return;
      window.coResearch(ids);
      status.hidden = false; status.textContent = T.bg;
    });
  </script>

  <dialog id="new-account" class="co-dialog co-dialog--wide" aria-labelledby="new-account-title">
    <form method="post" data-testid="new-account-form">
      <input type="hidden" name="action" value="create" />
      <div class="co-dialog__body">
        <h2 id="new-account-title" class="co-entity">{M.newAccount}</h2>
        <p class="co-body">{M.newBody(t.rules.claimDays)}</p>
        <label class="co-field">{M.venueName}<input class="co-input" name="name" required maxlength="160" placeholder="Club Sol" /></label>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="co-field">{M.zone}
            <select class="co-select" name="zoneId"><option value="">{M.noZoneOption}</option>{t.zones.map((z) => <option value={z.id} selected={t.myZoneIds.length === 1 && z.id === t.myZoneIds[0]}>{zonePath(t.zones, z.id)}</option>)}</select>
          </label>
          <label class="co-field">{M.sector}
            <select class="co-select" name="segmentId"><option value="">{M.noSector}</option>{segments.map((sg) => <option value={sg.id}>{sg.name}</option>)}</select>
          </label>
        </div>
        {kindDefs.length > 1 && (
          <label class="co-field">{CL.kind}
            <select class="co-select" name="kind" data-testid="new-account-kind">{kindDefs.map((k) => <option value={k.key} selected={k.key === (tipo && tipo !== 'descartadas' ? tipo : 'company')}>{k.label}</option>)}</select>
          </label>
        )}
        <GroupPicker embedded />
        <label class="co-field">{M.address} <span class="co-help">{M.optional}</span><input class="co-input" name="address" maxlength="300" /></label>
        <label class="co-field">{M.notes} <span class="co-help">{M.optional}</span><textarea class="co-textarea !min-h-[64px]" name="notes" maxlength="2000" placeholder={M.notesPlaceholder}></textarea></label>
      </div>
      <div class="co-dialog__foot">
        <button type="button" class="co-btn co-btn--ghost" data-dialog-close>{S.ui.cancel}</button>
        <button class="co-btn co-btn--primary" type="submit">{M.create}</button>
      </div>
    </form>
  </dialog>
</AdminLayout>
