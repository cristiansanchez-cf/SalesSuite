---
/**
 * Apuntar con IA (docs/CRM_DINAMICO.md §20): escribir o dictar lo visto → la IA lo separa por sitio → cada sitio, con la
 * empresa que más se parece (o una nueva), su nota, lo que se marca en la cualificación y el próximo paso → se revisa
 * y se guarda todo de una vez. La IA no guarda nada.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import Icon from '~/components/ui/Icon.astro';
import { can } from '~/lib/admin/permissions';
import { flash, formAction } from '~/lib/admin/forms';
import { i18n } from '~/lib/i18n';
import { notesMessages } from '~/lib/i18n/messages/notes';
import { priorityMessages } from '~/lib/i18n/messages/priority';
import { followupMessages } from '~/lib/i18n/messages/followup';
import { cleanupContext } from '~/lib/crm/research-context';
import type { NoteItem } from '~/lib/crm/notes';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
if (!can(admin.session.role).useAccounts) return Astro.rewrite('/admin/forbidden');
const { m: M, locale } = i18n(Astro, notesMessages);
const PR = priorityMessages[locale];
const FU = followupMessages[locale];

type Item = Awaited<ReturnType<typeof admin.crm.notesSplit>>[number];
let result: { error: string | null; details: string[] } = { error: null, details: [] };
const box: { items: Item[] | null; text: string } = { items: null, text: '' };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const str = (k: string) => String(f.get(k) ?? '');
  let to = '';
  result = await formAction(async () => {
    if (str('action') === 'split') {
      box.text = str('text');
      box.items = await admin.crm.notesSplit(box.text, await cleanupContext(admin), str('accountId') || null);
      return;
    }
    // Guardar lo revisado: lo que dijo la IA (items) con lo que ha cambiado la persona en cada sitio.
    const items = (() => { try { return JSON.parse(str('items') || '[]') as NoteItem[]; } catch { return []; } })();
    const lines = (k: string) => str(k).split(/\r?\n/).map((x) => x.replace(/^\s*[•·★-]\s*/, '').trim()).filter(Boolean);
    const rows = items.map((it, i) => {
      const goes = str(`acc-${i}`);
      if (!goes || goes === 'skip') return null;
      const q = Object.fromEntries(f.getAll(`q-${i}`).map(String).map((x) => x.split(':')).filter((x) => x.length === 2));
      const days = str(`days-${i}`);
      const fieldsChosen = Object.fromEntries(f.getAll(`f-${i}`).map(String).filter((k) => k in it.fields).map((k) => [k, it.fields[k]]));
      return { accountId: goes === 'new' ? null : goes, create: goes === 'new' ? it.venue : null,
        interaction: f.get(`int-on-${i}`) ? str(`int-${i}`) || null : null,
        keyFacts: lines(`key-${i}`).slice(0, 5), facts: lines(`facts-${i}`).slice(0, 40),
        fit: str(`fit-${i}`) || null, fields: fieldsChosen,
        channel: it.channel, outcome: it.outcome, day: it.day,
        qualification: q, nextStep: str(`next-${i}`) || null, nextDays: days === '' ? null : Number(days) };
    }).filter(Boolean);
    const r = await admin.crm.notesApply(rows);
    const ok = r.filter((x) => x.ok && x.accountId);
    to = `/admin/accounts/apuntar?ok=saved&n=${ok.length}&f=${r.length - ok.length}&ids=${ok.map((x) => x.accountId).join(',')}`;
  });
  if (!result.error && to) return Astro.redirect(to, 303);
}
const q = Astro.url.searchParams;
const okMsg = flash(Astro.url, { saved: M.saved(Number(q.get('n')) || 0) + (Number(q.get('f')) ? M.failed(Number(q.get('f'))) : '') });
// Lo que se acaba de guardar, para ir a cada ficha.
const savedIds = okMsg ? (q.get('ids') ?? '').split(',').filter((x) => /^[0-9a-f-]{36}$/i.test(x)).slice(0, 40) : [];
const saved = savedIds.length ? (await Promise.all(savedIds.map((id) => admin.accounts.get(id).then((d) => d.account).catch(() => null)))).filter((a) => !!a) : [];
const items = box.items;
const fieldLabel = new Map(items ? (await admin.accounts.crmFields().catch(() => [])).map((x) => [x.key, x.label]) : []);
const hasAi = admin.crm.hasNotes();

/** «Pantallas: Sí», «Noches a la semana: 4 o más», «Sin cobertura móvil». */
const qualLabel = (k: string, v: string): string => {
  const o = PR.options as Record<string, Record<string, string>>;
  if (k === 'kind') return `${PR.kind}: ${(PR.kinds as Record<string, string>)[v] ?? v}`;
  if (k === 'nights') return `${PR.hints.recurrence.venue}: ${o.nights[v] ?? v}`;
  if (k === 'events') return `${PR.hints.recurrence.promoter}: ${o.events[v] ?? v}`;
  if (k === 'recurring') return `${PR.hints.recurrence.concert} ${o.recurring[v] ?? v}`;
  if (k in PR.kills && v === 'true') return (PR.kills as Record<string, string>)[k];
  return `${(PR.criteria as Record<string, string>)[k] ?? k}: ${o[k]?.[v] ?? v}`;
};
const best = (it: Item) => (it.candidates[0] && it.candidates[0].score >= 0.8 ? it.candidates[0].id : it.candidates.length ? '' : 'new');
---
<AdminLayout title={M.title}>
  <PageHeader eyebrow={M.eyebrow} title={M.title} lede={items ? M.reviewHelp : M.lede} />
  {okMsg && <div class="mb-4"><Alert kind="success" title={okMsg} /></div>}
  {result.error && <div class="mb-4"><Alert kind="rejection" title={result.error} details={result.details} /></div>}

  {saved.length > 0 && (
    <ul class="mb-6 flex flex-wrap gap-2 p-0" data-testid="notes-saved">
      {saved.map((a) => <li class="list-none"><a class="co-btn co-btn--ghost co-btn--sm" href={`/admin/accounts/${a!.id}`}><Icon name="building2" size={14} />{a!.name}</a></li>)}
    </ul>
  )}

  {!items ? (
    <form method="post" class="co-card grid max-w-3xl gap-3" data-testid="notes-form" data-notes-form data-no-progress>
      <input type="hidden" name="action" value="split" />
      {!hasAi && <Alert kind="info" title={M.noAi} />}
      <div class="co-field relative" data-who>
        <label for="who-q">{M.who}</label>
        <input type="hidden" name="accountId" data-who-id />
        <input id="who-q" class="co-input" type="search" autocomplete="off" placeholder={M.whoPh} data-who-q data-testid="notes-who" />
        <p class="co-chip m-0 w-fit" hidden data-who-chosen data-testid="notes-who-chosen"><Icon name="building2" size={14} /><span data-who-label></span><button type="button" class="ml-1 underline" data-who-clear>{M.whoClear}</button></p>
        <ul class="co-card absolute left-0 right-0 top-full z-20 m-0 mt-1 grid gap-0 !p-1" hidden data-who-list role="listbox" data-testid="notes-who-list"></ul>
        <span class="co-help">{M.whoHelp}</span>
      </div>
      <label class="co-field">{M.text}
        <textarea class="co-textarea !min-h-[220px]" name="text" required minlength="3" maxlength="12000" placeholder={M.placeholder} data-testid="notes-text">{box.text}</textarea>
      </label>
      <p class="co-help m-0"><Icon name="mic" size={14} /> {M.dictate}</p>
      <button class="co-btn co-btn--primary w-fit" type="submit" disabled={!hasAi} data-busy={M.running} data-testid="notes-run"><Icon name="sparkles" size={16} /><span>{M.run}</span></button>
    </form>
  ) : (
    <form method="post" class="grid gap-4" data-testid="notes-review" data-no-progress>
      <input type="hidden" name="action" value="apply" />
      <input type="hidden" name="items" value={JSON.stringify(items.map(({ candidates: _c, ...it }) => it))} />
      <h2 class="co-entity">{M.reviewTitle(items.length)}</h2>
      {items.length === 0 && <p class="co-meta" data-testid="notes-nothing">{M.nothing}</p>}
      {items.map((it, i) => (
        <section class="co-card grid gap-3 !p-4" data-testid="notes-item" data-venue={it.venue}>
          <div class="grid gap-1">
            <p class="co-meta m-0">{M.said(it.venue)} · {M.how(FU.channels[it.channel], FU.outcomes[it.outcome], it.day ?? M.today)}</p>
            <label class="co-field">{M.goes}
              <select class="co-select" name={`acc-${i}`} data-testid="notes-account">
                {it.candidates.map((c) => <option value={c.id} selected={best(it) === c.id}>{c.name}{c.zone ? ` · ${c.zone}` : ''}{c.discarded ? ` (${M.discarded})` : ''} — {M.match(c.score)}</option>)}
                <option value="new" selected={best(it) === 'new'}>{M.create(it.venue)}</option>
                <option value="skip" selected={best(it) === ''}>{M.skip}</option>
              </select>
            </label>
          </div>
          <fieldset class="grid gap-1 rounded-xl border border-[var(--co-line)] p-3">
            <legend class="co-field px-1"><label class="inline-flex items-center gap-2"><input type="checkbox" name={`int-on-${i}`} value="1" checked={!!it.interaction} class="h-4 w-4 accent-[var(--co-ink)]" data-testid="notes-int-on" />{M.interaction}</label></legend>
            <span class="co-help">{M.interactionHelp}</span>
            <textarea class="co-textarea !min-h-[64px]" name={`int-${i}`} maxlength="4000" data-testid="notes-interaction">{it.interaction ?? ''}</textarea>
          </fieldset>
          <label class="co-field">{M.keyFacts} <span class="co-help">{M.keyFactsHelp}</span>
            <textarea class="co-textarea !min-h-[64px] font-medium" name={`key-${i}`} maxlength="2000" data-testid="notes-key-facts">{(it.keyFacts ?? []).map((x) => `★ ${x}`).join('\n')}</textarea>
          </label>
          <label class="co-field">{M.facts} <span class="co-help">{M.factsHelp}</span>
            <textarea class="co-textarea !min-h-[140px]" name={`facts-${i}`} maxlength="16000" data-testid="notes-facts">{it.facts.map((x) => `• ${x}`).join('\n')}</textarea>
          </label>
          <label class="co-field">{M.fit}<input class="co-input" name={`fit-${i}`} maxlength="600" value={it.fit ?? ''} data-testid="notes-fit" /></label>
          {Object.keys(it.fields).length > 0 && (
            <fieldset class="grid gap-1">
              <legend class="co-field mb-1">{M.fieldsTitle}</legend>
              <div class="co-chips">
                {Object.entries(it.fields).map(([k, v]) => <label class="co-chip"><input type="checkbox" class="mr-1" name={`f-${i}`} value={k} checked data-testid="notes-field" />{fieldLabel.get(k) ?? k}: {v}</label>)}
              </div>
            </fieldset>
          )}
          {Object.keys(it.qualification).length > 0 && (
            <fieldset class="grid gap-1">
              <legend class="co-field mb-1">{M.qual}</legend>
              <div class="co-chips">
                {Object.entries(it.qualification).map(([k, v]) => (
                  <label class="co-chip"><input type="checkbox" class="mr-1" name={`q-${i}`} value={`${k}:${v}`} checked data-testid="notes-qual" />{qualLabel(k, v)}</label>
                ))}
              </div>
            </fieldset>
          )}
          <div class="grid gap-3 sm:grid-cols-[1fr_10rem]">
            <label class="co-field">{M.next}<input class="co-input" name={`next-${i}`} maxlength="300" value={it.nextStep ?? ''} data-testid="notes-next" /></label>
            <label class="co-field">&nbsp;
              <select class="co-select" name={`days-${i}`}>
                <option value="" selected={it.nextDays == null}>—</option>
                {[0, 1, 2, 3, 7, 14, 30].map((d) => <option value={d} selected={it.nextDays === d}>{M.inDays(d)}</option>)}
                {it.nextDays != null && ![0, 1, 2, 3, 7, 14, 30].includes(it.nextDays) && <option value={it.nextDays} selected>{M.inDays(it.nextDays)}</option>}
              </select>
            </label>
          </div>
        </section>
      ))}
      <div class="sticky bottom-0 flex flex-wrap gap-3 bg-[var(--co-bg)] py-3">
        {items.length > 0 && <button class="co-btn co-btn--primary" type="submit" data-testid="notes-save"><Icon name="check" size={16} />{M.save}</button>}
        <a class="co-btn co-btn--ghost" href="/admin/accounts/apuntar">{M.back}</a>
      </div>
    </form>
  )}
</AdminLayout>

<script define:vars={{ none: M.whoNone }}>
  // «¿De qué empresa vas a hablar?»: autocompletar sin IA (tolera el dictado). Al elegir, todo va a esa empresa.
  (() => {
    const box = document.querySelector('[data-who]');
    if (!box) return;
    const q = box.querySelector('[data-who-q]'), id = box.querySelector('[data-who-id]'), list = box.querySelector('[data-who-list]');
    const chosen = box.querySelector('[data-who-chosen]'), label = box.querySelector('[data-who-label]');
    let timer = 0, seq = 0;
    const pick = (it) => { id.value = it.id; label.textContent = it.zone ? `${it.name} · ${it.zone}` : it.name; chosen.hidden = false; q.hidden = true; list.hidden = true; };
    box.querySelector('[data-who-clear]').addEventListener('click', () => { id.value = ''; chosen.hidden = true; q.hidden = false; q.value = ''; q.focus(); });
    q.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(async () => {
        const mine = ++seq;
        if (q.value.trim().length < 2) { list.hidden = true; return; }
        const r = await fetch(`/admin/api/crm/account-search?q=${encodeURIComponent(q.value.trim())}`).then((x) => x.json()).catch(() => ({ items: [] }));
        if (mine !== seq) return;
        list.replaceChildren(...(r.items?.length ? r.items.map((it) => {
          const li = document.createElement('li'); li.className = 'list-none';
          const b = document.createElement('button'); b.type = 'button'; b.className = 'co-action w-full text-left'; b.dataset.testid = 'notes-who-option';
          const t = document.createElement('span'); t.className = 'co-action__label'; t.textContent = it.name;
          if (it.zone) { const s = document.createElement('small'); s.textContent = it.zone; t.append(s); }
          b.append(t); b.addEventListener('click', () => pick(it)); li.append(b); return li;
        }) : [Object.assign(document.createElement('li'), { className: 'list-none co-meta p-2', textContent: none })]));
        list.hidden = false;
      }, 200);
    });
    document.addEventListener('click', (e) => { if (!box.contains(e.target)) list.hidden = true; });
  })();
</script>

<script>
  // Entender: la IA tarda unos segundos; el botón lo dice.
  document.querySelector<HTMLFormElement>('[data-notes-form]')?.addEventListener('submit', (e) => {
    const b = (e.currentTarget as HTMLFormElement).querySelector<HTMLButtonElement>('[data-busy]');
    if (b) { b.disabled = true; b.querySelector('span')!.textContent = b.dataset.busy ?? ''; }
  });
</script>
