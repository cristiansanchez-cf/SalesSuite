---
/** Ficha de una cuenta (docs/ACCOUNTS.md): quién la trabaja, qué se ha hecho, y actuar en un clic. */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import Icon from '~/components/ui/Icon.astro';
import ConfirmDialog from '~/components/ui/ConfirmDialog.astro';
import AccountState from '~/components/accounts/AccountState.astro';
import { can } from '~/lib/admin/permissions';
import { AdminError } from '~/lib/admin/service';
import { flash, formAction } from '~/lib/admin/forms';
import { relativeTime, STATUS_CLASS, STATUS_LABEL } from '~/lib/admin/format';
import { ELIGIBILITY_LABEL, zonePath } from '~/lib/accounts/rules';
import type { TouchKind } from '~/lib/accounts/types';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const perms = can(admin.session.role);
if (!perms.useAccounts) return Astro.rewrite('/admin/forbidden');
const acc = admin.accounts;
const id = Astro.params.id ?? '';

let result: { error: string | null; details: string[] } = { error: null, details: [] };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const str = (k: string) => String(f.get(k) ?? '');
  let to = `/admin/accounts/${id}`;
  result = await formAction(async () => {
    switch (str('action')) {
      case 'contact': { const e = await acc.touch(id, 'contact', str('note')); to += `?ok=${e === 'eligible' ? 'contact' : `not-${e}`}`; break; }
      case 'claim': { const e = await acc.touch(id, 'claim'); to += `?ok=${e === 'eligible' ? 'claimed' : `not-${e}`}`; break; }
      case 'release': await acc.touch(id, 'release'); to += '?ok=released'; break;
      case 'save': await acc.update(id, { name: str('name'), zoneId: str('zoneId'), segmentId: str('segmentId'), address: str('address'), externalRef: str('externalRef'), notes: str('notes') }); to += '?ok=saved'; break;
      case 'assign': await acc.assign(id, str('userId') || null); to += '?ok=assigned'; break;
      case 'block': await acc.block(id, str('reason')); to += '?ok=blocked'; break;
      case 'unblock': await acc.unblock(id); to += '?ok=unblocked'; break;
      case 'delete': await acc.remove(id); to = '/admin/accounts'; break;
      case 'dossier': {
        const a = (await acc.get(id)).account;
        const d = await admin.service.createDossier({ title: a.name, prospectCompany: a.name, accountId: id });
        to = `/admin/dossiers/${d}`;
        break;
      }
    }
  });
  if (!result.error) return Astro.redirect(to, 303);
}

let data;
try { data = await acc.get(id); } catch (e) {
  if (e instanceof AdminError && e.status === 404) return Astro.rewrite('/404');
  throw e;
}
const { account: a, eligibility, touches, dossiers, canEdit, rules } = data;
const [t, segments, members] = await Promise.all([acc.territory(), admin.playbook.market(), perms.manageAccounts ? admin.tenantAdmin.listMembers().catch(() => []) : Promise.resolve([])]);
const day = (iso: string | null) => (iso ? new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long' }).format(new Date(iso)) : '');
const NOT = (e: string) => `No se ha reservado: ${ELIGIBILITY_LABEL[e as keyof typeof ELIGIBILITY_LABEL]?.toLowerCase() ?? e}.`;
const okKey = Astro.url.searchParams.get('ok') ?? '';
const okMsg = okKey.startsWith('not-') ? null : flash(Astro.url, {
  created: `Cuenta dada de alta y reservada para ti ${rules.claimDays} días.`, contact: `Contacto registrado. La tienes reservada hasta el ${day(a.claimedUntil)}.`,
  claimed: `Es tuya hasta el ${day(a.claimedUntil)}. Cada contacto renueva la reserva.`, released: 'La has soltado: ya puede trabajarla otra persona.',
  saved: 'Datos guardados.', assigned: 'Asignación guardada.', blocked: 'Cuenta bloqueada: nadie generará comisión con ella.', unblocked: 'Cuenta desbloqueada.',
});
const notMsg = okKey.startsWith('not-') ? NOT(okKey.slice(4)) : null;
const TOUCH: Record<TouchKind, string> = {
  created: 'Alta de la cuenta', contact: 'Contacto', dossier: 'Propuesta creada', won: 'Venta ganada', lost: 'Venta perdida', claim: 'Se la quedó',
  release: 'La soltó', block: 'Bloqueada', unblock: 'Desbloqueada', assign: 'Asignada a',
};
const STATE_ALERT = {
  free: { kind: 'info' as const, title: 'Libre', body: `Si la contactas, queda reservada para ti ${rules.claimDays} días.` },
  mine: { kind: 'success' as const, title: `Reservada para ti hasta el ${day(a.claimedUntil)}`, body: 'Cada contacto o propuesta renueva la reserva. Si la dejas, pasa a estar libre.' },
  taken: { kind: 'rejection' as const, title: `La trabaja ${a.ownerName ?? 'otra persona'} hasta el ${day(a.claimedUntil)}`, body: 'Si la vendes tú, la venta no generará comisión. Habla con tu compañero/a antes de contactarla.' },
  my_customer: { kind: 'success' as const, title: 'Es cliente tuyo', body: `Desde el ${day(a.wonAt)}.` },
  customer: { kind: 'info' as const, title: `Es cliente de ${a.wonByName ?? 'otra persona'}`, body: 'Una venta nueva aquí no generará comisión para ti.' },
  blocked: { kind: 'rejection' as const, title: 'Bloqueada: no se puede vender', body: a.blockedReason ?? 'La empresa no autoriza venderle. Ninguna venta aquí genera comisión.' },
}[a.state];
---
<AdminLayout title={a.name}>
  <PageHeader eyebrow={a.zonePath || 'Sin zona'} title={a.name} back={{ href: '/admin/accounts', label: 'Cuentas' }}>
    <AccountState a={a} />
    {(a.state === 'free' || a.state === 'mine' || a.state === 'my_customer') && (
      <form method="post"><input type="hidden" name="action" value="dossier" />
        <button class="co-btn co-btn--primary" type="submit" data-testid="account-dossier">Crear propuesta <span aria-hidden="true">→</span></button></form>
    )}
  </PageHeader>
  {okMsg && <div class="mb-4"><Alert kind="success" title={okMsg} /></div>}
  {notMsg && <div class="mb-4"><Alert kind="rejection" title={notMsg} /></div>}
  {result.error && <div class="mb-4"><Alert kind="rejection" title={result.error} details={result.details} /></div>}

  <div class="co-split">
    <div class="grid content-start gap-5">
      <div class:list={['co-alert', `co-alert--${STATE_ALERT.kind}`]} data-testid="account-status" data-state={a.state}>
        <Icon name={STATE_ALERT.kind === 'rejection' ? 'triangle-alert' : STATE_ALERT.kind === 'success' ? 'circle-check' : 'info'} size={18} />
        <div class="min-w-0"><p class="font-semibold">{STATE_ALERT.title}</p><p>{STATE_ALERT.body}</p></div>
      </div>

      {a.state !== 'blocked' && a.state !== 'taken' && a.state !== 'customer' && (
        <form method="post" class="co-card grid gap-3" data-testid="contact-form">
          <input type="hidden" name="action" value="contact" />
          <h2 class="co-card-title">Registrar un contacto</h2>
          <label class="co-field">Qué ha pasado <span class="co-help">Opcional: una línea</span>
            <input class="co-input" name="note" maxlength="500" placeholder="Visita: el dueño quiere verlo un viernes" /></label>
          <div class="flex flex-wrap gap-2">
            <button class="co-btn co-btn--primary w-fit" type="submit">Registrar contacto</button>
            {a.state === 'mine' && <button type="button" class="co-btn co-btn--quiet" data-dialog-open="release">Soltar la cuenta</button>}
          </div>
        </form>
      )}

      <section class="co-section">
        <div class="co-section__head"><h2 class="text-eyebrow">Propuestas · {dossiers.length}</h2></div>
        {dossiers.length === 0 ? <p class="co-meta">Todavía no hay propuestas para esta cuenta.</p> : (
          <ul class="co-rows">{dossiers.map((d) => (
            <li><a class="co-row" href={`/admin/dossiers/${d.id}`}>
              <span class="co-row__main"><span class="co-row-title">{d.title}</span><span class="co-meta">{d.authorName ?? 'Sin autor'} · {relativeTime(d.updatedAt)}{d.outcome === 'won' ? ' · Ganada' : d.outcome === 'lost' ? ' · Perdida' : ''}{d.accountEligibility && d.accountEligibility !== 'eligible' ? ` · ${ELIGIBILITY_LABEL[d.accountEligibility]}` : ''}</span></span>
              <span class={STATUS_CLASS[d.status]}>{STATUS_LABEL[d.status]}</span>
              <span class="co-row__chevron"><Icon name="chevron-right" /></span>
            </a></li>))}
          </ul>
        )}
      </section>

      <section class="co-section" data-testid="history">
        <div class="co-section__head"><h2 class="text-eyebrow">Historial</h2></div>
        <ol class="grid gap-2 p-0">
          {touches.map((x) => (
            <li class="flex list-none gap-3 text-sm">
              <span class="co-meta w-28 shrink-0">{relativeTime(x.createdAt)}</span>
              <span><strong>{TOUCH[x.kind]}{x.kind === 'assign' && x.note ? ` ${x.note}` : ''}</strong>{x.userName ? ` · ${x.userName}` : ''}{x.note && x.kind !== 'assign' ? <span class="co-body block">{x.note}</span> : null}</span>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <aside class="grid content-start gap-4">
      <form method="post" class="co-card grid gap-3" data-testid="account-info">
        <input type="hidden" name="action" value="save" />
        <h2 class="co-entity">Datos</h2>
        <fieldset class="grid gap-3" disabled={!canEdit}>
          <label class="co-field">Nombre<input class="co-input" name="name" value={a.name} required maxlength="160" /></label>
          <label class="co-field">Zona<select class="co-select" name="zoneId"><option value="">Sin zona</option>{t.zones.map((z) => <option value={z.id} selected={z.id === a.zoneId}>{zonePath(t.zones, z.id)}</option>)}</select></label>
          <label class="co-field">Sector<select class="co-select" name="segmentId"><option value="">Sin sector</option>{segments.map((sg) => <option value={sg.id} selected={sg.id === a.segmentId}>{sg.name}</option>)}</select></label>
          <label class="co-field">Dirección<input class="co-input" name="address" value={a.address ?? ''} maxlength="300" /></label>
          <label class="co-field">Referencia externa <span class="co-help">Id de Google Maps, del CRM…</span><input class="co-input" name="externalRef" value={a.externalRef ?? ''} maxlength="120" /></label>
          <label class="co-field">Notas<textarea class="co-textarea" name="notes" maxlength="2000">{a.notes ?? ''}</textarea></label>
          {canEdit && <button class="co-btn co-btn--ghost w-fit" type="submit">Guardar datos</button>}
        </fieldset>
        {!canEdit && <p class="co-help">Edita los datos quien la trabaja o un/a jefe/a de ventas.</p>}
      </form>

      {perms.manageAccounts && (
        <section class="co-card grid gap-3" data-testid="account-manage">
          <h2 class="co-entity">Gestión</h2>
          <form method="post" class="grid gap-2">
            <input type="hidden" name="action" value="assign" />
            <label class="co-field">Quién la trabaja
              <select class="co-select" name="userId"><option value="">Nadie (libre)</option>{members.filter((m) => m.role !== 'partner').map((m) => <option value={m.userId} selected={m.userId === a.ownerId}>{m.displayName || m.email}</option>)}</select>
            </label>
            <button class="co-btn co-btn--ghost co-btn--sm w-fit" type="submit">Asignar</button>
          </form>
          <div class="co-actions">
            {a.status === 'blocked'
              ? <form method="post"><input type="hidden" name="action" value="unblock" /><button class="co-action" type="submit"><Icon name="rotate-ccw" /><span class="co-action__label">Desbloquear</span><Icon name="chevron-right" size={16} /></button></form>
              : <button type="button" class="co-action" data-dialog-open="block" data-testid="block-open"><Icon name="ban" /><span class="co-action__label">Bloquear la cuenta<small>Nadie generará comisión con ella</small></span><Icon name="chevron-right" size={16} /></button>}
            <button type="button" class="co-action" data-dialog-open="delete-account"><Icon name="trash2" /><span class="co-action__label">Eliminar la cuenta</span><Icon name="chevron-right" size={16} /></button>
          </div>
        </section>
      )}
    </aside>
  </div>

  <ConfirmDialog id="release" title={`Soltar ${a.name}`} confirmLabel="Soltarla"
    does="Deja de estar reservada para ti: cualquiera de tu equipo podrá trabajarla."
    doesNot="No borra el historial ni tus propuestas, y no avisa a nadie.">
    <input type="hidden" name="action" value="release" />
  </ConfirmDialog>
  <ConfirmDialog id="block" title={`Bloquear ${a.name}`} confirmLabel="Bloquear" danger testid="block-dialog"
    does="Nadie podrá reservarla y ninguna venta aquí generará comisión. Quien la abra verá el motivo."
    doesNot="No borra el historial ni las propuestas, y no avisa al local.">
    <input type="hidden" name="action" value="block" />
    <label class="co-field">Motivo<input class="co-input" name="reason" required maxlength="300" placeholder="El dueño ha pedido no recibir más comerciales" /></label>
  </ConfirmDialog>
  <ConfirmDialog id="delete-account" title={`Eliminar ${a.name}`} confirmLabel="Eliminar" danger
    does="La cuenta y su historial desaparecen del CRM."
    doesNot="No borra las propuestas: se quedan sin cuenta vinculada.">
    <input type="hidden" name="action" value="delete" />
  </ConfirmDialog>
</AdminLayout>
