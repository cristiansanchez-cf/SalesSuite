---
/** Ficha de una cuenta (docs/ACCOUNTS.md): quién la trabaja, qué se ha hecho, y actuar en un clic. */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import Icon from '~/components/ui/Icon.astro';
import ConfirmDialog from '~/components/ui/ConfirmDialog.astro';
import AccountState from '~/components/accounts/AccountState.astro';
import { can } from '~/lib/admin/permissions';
import { AdminError } from '~/lib/admin/service';
import { flash, formAction } from '~/lib/admin/forms';
import { STATUS_CLASS } from '~/lib/admin/format';
import { ELIGIBILITY_LABELS, zonePath } from '~/lib/accounts/rules';
import type { TouchKind } from '~/lib/accounts/types';
import { i18n } from '~/lib/i18n';
import { accountsMessages } from '~/lib/i18n/messages/accounts';
import { crmMessages } from '~/lib/i18n/messages/crm';
import FieldInput from '~/components/crm/FieldInput.astro';
import { fieldsFor, formatValue, valuesFromForm } from '~/lib/crm/fields';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const perms = can(admin.session.role);
if (!perms.useAccounts) return Astro.rewrite('/admin/forbidden');
const acc = admin.accounts;
const id = Astro.params.id ?? '';
const { m: msg, f: fmt, locale } = i18n(Astro, accountsMessages);
const M = msg.detail;
const ELIGIBILITY_LABEL = ELIGIBILITY_LABELS[locale];
const C = crmMessages[locale].card;

let result: { error: string | null; details: string[] } = { error: null, details: [] };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const str = (k: string) => String(f.get(k) ?? '');
  let to = `/admin/accounts/${id}`;
  result = await formAction(async () => {
    switch (str('action')) {
      case 'contact': { const e = await acc.touch(id, 'contact', str('note')); to += `?ok=${e === 'eligible' ? 'contact' : `not-${e}`}`; break; }
      case 'claim': { const e = await acc.touch(id, 'claim'); to += `?ok=${e === 'eligible' ? 'claimed' : `not-${e}`}`; break; }
      case 'release': await acc.touch(id, 'release'); to += '?ok=released'; break;
      case 'save': await acc.update(id, { name: str('name'), zoneId: str('zoneId'), segmentId: str('segmentId'), address: str('address'), externalRef: str('externalRef'), notes: str('notes') }); to += '?ok=saved'; break;
      case 'assign': await acc.assign(id, str('userId') || null); to += '?ok=assigned'; break;
      case 'fields': await acc.setFields(id, valuesFromForm(await acc.crmFields(), f)); to += '?ok=fields'; break;
      case 'block': await acc.block(id, str('reason')); to += '?ok=blocked'; break;
      case 'unblock': await acc.unblock(id); to += '?ok=unblocked'; break;
      case 'delete': await acc.remove(id); to = '/admin/accounts'; break;
      case 'dossier': {
        const a = (await acc.get(id)).account;
        const d = await admin.service.createDossier({ title: a.name, prospectCompany: a.name, accountId: id });
        to = `/admin/dossiers/${d}`;
        break;
      }
    }
  });
  if (!result.error) return Astro.redirect(to, 303);
}

let data;
try { data = await acc.get(id); } catch (e) {
  if (e instanceof AdminError && e.status === 404) return Astro.rewrite('/404');
  throw e;
}
const { account: a, eligibility, touches, dossiers, canEdit, rules, crmFields } = data;
const [t, segments, members] = await Promise.all([acc.territory(), admin.playbook.market(), perms.manageAccounts ? admin.tenantAdmin.listMembers().catch(() => []) : Promise.resolve([])]);
// Ficha (campos del CRM): los de su sector, agrupados por sección.
const segKey = segments.find((sg) => sg.id === a.segmentId)?.key ?? null;
const sheet = fieldsFor(crmFields, segKey);
const sections = [...new Set(sheet.map((x) => x.group ?? ''))].map((g) => ({ title: g || (sheet.some((x) => x.group) ? C.other : ''), fields: sheet.filter((x) => (x.group ?? '') === g) }));
const day = (iso: string | null) => fmt.date(iso, { day: 'numeric', month: 'long' });
const NOT = (e: string) => M.notClaimed(ELIGIBILITY_LABEL[e as keyof typeof ELIGIBILITY_LABEL]?.toLowerCase() ?? e);
const okKey = Astro.url.searchParams.get('ok') ?? '';
const okMsg = okKey.startsWith('not-') ? null : flash(Astro.url, {
  created: M.okCreated(rules.claimDays), contact: M.okContact(day(a.claimedUntil)),
  claimed: M.okClaimed(day(a.claimedUntil)), released: M.okReleased,
  saved: M.okSaved, fields: C.okSaved, assigned: M.okAssigned, blocked: M.okBlocked, unblocked: M.okUnblocked,
});
const notMsg = okKey.startsWith('not-') ? NOT(okKey.slice(4)) : null;
const TOUCH: Record<TouchKind, string> = M.touch;
const STATE_ALERT = {
  free: { kind: 'info' as const, title: M.freeTitle, body: M.freeBody(rules.claimDays) },
  mine: { kind: 'success' as const, title: M.mineTitle(day(a.claimedUntil)), body: M.mineBody },
  taken: { kind: 'rejection' as const, title: M.takenTitle(a.ownerName ?? msg.state.someoneElse, day(a.claimedUntil)), body: M.takenBody },
  my_customer: { kind: 'success' as const, title: M.myCustomerTitle, body: M.myCustomerBody(day(a.wonAt)) },
  customer: { kind: 'info' as const, title: M.customerTitle(a.wonByName ?? msg.state.someoneElse), body: M.customerBody },
  blocked: { kind: 'rejection' as const, title: M.blockedTitle, body: a.blockedReason ?? M.blockedBody },
}[a.state];
---
<AdminLayout title={a.name}>
  <PageHeader eyebrow={a.zonePath || M.noZone} title={a.name} back={{ href: '/admin/accounts', label: M.back }}>
    <AccountState a={a} />
    {(a.state === 'free' || a.state === 'mine' || a.state === 'my_customer') && (
      <form method="post"><input type="hidden" name="action" value="dossier" />
        <button class="co-btn co-btn--primary" type="submit" data-testid="account-dossier">{M.createProposal} <span aria-hidden="true">→</span></button></form>
    )}
  </PageHeader>
  {okMsg && <div class="mb-4"><Alert kind="success" title={okMsg} /></div>}
  {notMsg && <div class="mb-4"><Alert kind="rejection" title={notMsg} /></div>}
  {result.error && <div class="mb-4"><Alert kind="rejection" title={result.error} details={result.details} /></div>}

  <div class="co-split">
    <div class="grid content-start gap-5">
      <div class:list={['co-alert', `co-alert--${STATE_ALERT.kind}`]} data-testid="account-status" data-state={a.state}>
        <Icon name={STATE_ALERT.kind === 'rejection' ? 'triangle-alert' : STATE_ALERT.kind === 'success' ? 'circle-check' : 'info'} size={18} />
        <div class="min-w-0"><p class="font-semibold">{STATE_ALERT.title}</p><p>{STATE_ALERT.body}</p></div>
      </div>

      {a.state !== 'blocked' && a.state !== 'taken' && a.state !== 'customer' && (
        <form method="post" class="co-card grid gap-3" data-testid="contact-form">
          <input type="hidden" name="action" value="contact" />
          <h2 class="co-card-title">{M.registerContact}</h2>
          <label class="co-field">{M.whatHappened} <span class="co-help">{M.oneLine}</span>
            <input class="co-input" name="note" maxlength="500" placeholder={M.notePlaceholder} /></label>
          <div class="flex flex-wrap gap-2">
            <button class="co-btn co-btn--primary w-fit" type="submit">{M.registerButton}</button>
            {a.state === 'mine' && <button type="button" class="co-btn co-btn--quiet" data-dialog-open="release">{M.release}</button>}
          </div>
        </form>
      )}

      <section class="co-card grid gap-4" data-testid="account-sheet">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="co-entity">{C.title}</h2>
          {perms.manageTenant && <a class="co-meta underline" href="/admin/team/fields">{C.manage}</a>}
        </div>
        {sheet.length === 0 ? <p class="co-meta">{C.noFields} {perms.manageTenant && C.noFieldsAdmin}</p>
        : canEdit ? (
          <form method="post" class="grid gap-5" data-testid="sheet-form">
            <input type="hidden" name="action" value="fields" />
            {sections.map((sec) => (
              <fieldset class="grid gap-4 sm:grid-cols-2">
                {sec.title && <legend class="text-eyebrow mb-1 sm:col-span-2">{sec.title}</legend>}
                {sec.fields.map((fd) => <div class:list={[(fd.type === 'long_text' || fd.type === 'multi_select') && 'sm:col-span-2']}><FieldInput field={fd} value={a.fields[fd.key]} labels={C} /></div>)}
              </fieldset>
            ))}
            <button class="co-btn co-btn--primary w-fit" type="submit" data-testid="sheet-save">{C.save}</button>
          </form>
        ) : (
          <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
            {sheet.map((fd) => <div><dt class="co-meta">{fd.label}</dt><dd class="text-sm font-medium">{formatValue(fd, a.fields[fd.key], fmt.tag) || C.empty}</dd></div>)}
          </dl>
        )}
      </section>

      <section class="co-section">
        <div class="co-section__head"><h2 class="text-eyebrow">{M.proposals(dossiers.length)}</h2></div>
        {dossiers.length === 0 ? <p class="co-meta">{M.noProposals}</p> : (
          <ul class="co-rows">{dossiers.map((d) => (
            <li><a class="co-row" href={`/admin/dossiers/${d.id}`}>
              <span class="co-row__main"><span class="co-row-title">{d.title}</span><span class="co-meta">{d.authorName ?? M.noAuthor} · {fmt.relative(d.updatedAt)}{d.outcome === 'won' ? ` · ${M.won}` : d.outcome === 'lost' ? ` · ${M.lost}` : ''}{d.accountEligibility && d.accountEligibility !== 'eligible' ? ` · ${ELIGIBILITY_LABEL[d.accountEligibility]}` : ''}</span></span>
              <span class={STATUS_CLASS[d.status]}>{msg.dossierStatus[d.status]}</span>
              <span class="co-row__chevron"><Icon name="chevron-right" /></span>
            </a></li>))}
          </ul>
        )}
      </section>

      <section class="co-section" data-testid="history">
        <div class="co-section__head"><h2 class="text-eyebrow">{M.history}</h2></div>
        <ol class="grid gap-2 p-0">
          {touches.map((x) => (
            <li class="flex list-none gap-3 text-sm">
              <span class="co-meta w-28 shrink-0">{fmt.relative(x.createdAt)}</span>
              <span><strong>{TOUCH[x.kind]}{x.kind === 'assign' && x.note ? ` ${x.note}` : ''}</strong>{x.userName ? ` · ${x.userName}` : ''}{x.note && x.kind !== 'assign' ? <span class="co-body block">{x.note}</span> : null}</span>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <aside class="grid content-start gap-4">
      <form method="post" class="co-card grid gap-3" data-testid="account-info">
        <input type="hidden" name="action" value="save" />
        <h2 class="co-entity">{M.data}</h2>
        <fieldset class="grid gap-3" disabled={!canEdit}>
          <label class="co-field">{M.name}<input class="co-input" name="name" value={a.name} required maxlength="160" /></label>
          <label class="co-field">{M.zone}<select class="co-select" name="zoneId"><option value="">{M.noZone}</option>{t.zones.map((z) => <option value={z.id} selected={z.id === a.zoneId}>{zonePath(t.zones, z.id)}</option>)}</select></label>
          <label class="co-field">{M.sector}<select class="co-select" name="segmentId"><option value="">{M.noSector}</option>{segments.map((sg) => <option value={sg.id} selected={sg.id === a.segmentId}>{sg.name}</option>)}</select></label>
          <label class="co-field">{M.address}<input class="co-input" name="address" value={a.address ?? ''} maxlength="300" /></label>
          <label class="co-field">{M.externalRef} <span class="co-help">{M.externalRefHelp}</span><input class="co-input" name="externalRef" value={a.externalRef ?? ''} maxlength="120" /></label>
          <label class="co-field">{M.notes}<textarea class="co-textarea" name="notes" maxlength="2000">{a.notes ?? ''}</textarea></label>
          {canEdit && <button class="co-btn co-btn--ghost w-fit" type="submit">{M.saveData}</button>}
        </fieldset>
        {!canEdit && <p class="co-help">{M.editHint}</p>}
      </form>

      {perms.manageAccounts && (
        <section class="co-card grid gap-3" data-testid="account-manage">
          <h2 class="co-entity">{M.manage}</h2>
          <form method="post" class="grid gap-2">
            <input type="hidden" name="action" value="assign" />
            <label class="co-field">{M.whoWorks}
              <select class="co-select" name="userId"><option value="">{M.nobody}</option>{members.filter((m) => m.role !== 'partner').map((m) => <option value={m.userId} selected={m.userId === a.ownerId}>{m.displayName || m.email}</option>)}</select>
            </label>
            <button class="co-btn co-btn--ghost co-btn--sm w-fit" type="submit">{M.assign}</button>
          </form>
          <div class="co-actions">
            {a.status === 'blocked'
              ? <form method="post"><input type="hidden" name="action" value="unblock" /><button class="co-action" type="submit"><Icon name="rotate-ccw" /><span class="co-action__label">{M.unblock}</span><Icon name="chevron-right" size={16} /></button></form>
              : <button type="button" class="co-action" data-dialog-open="block" data-testid="block-open"><Icon name="ban" /><span class="co-action__label">{M.block}<small>{M.blockHint}</small></span><Icon name="chevron-right" size={16} /></button>}
            <button type="button" class="co-action" data-dialog-open="delete-account"><Icon name="trash2" /><span class="co-action__label">{M.delete}</span><Icon name="chevron-right" size={16} /></button>
          </div>
        </section>
      )}
    </aside>
  </div>

  <ConfirmDialog id="release" title={M.releaseTitle(a.name)} confirmLabel={M.releaseConfirm}
    does={M.releaseDoes}
    doesNot={M.releaseDoesNot}>
    <input type="hidden" name="action" value="release" />
  </ConfirmDialog>
  <ConfirmDialog id="block" title={M.blockTitle(a.name)} confirmLabel={M.blockConfirm} danger testid="block-dialog"
    does={M.blockDoes}
    doesNot={M.blockDoesNot}>
    <input type="hidden" name="action" value="block" />
    <label class="co-field">{M.reason}<input class="co-input" name="reason" required maxlength="300" placeholder={M.reasonPlaceholder} /></label>
  </ConfirmDialog>
  <ConfirmDialog id="delete-account" title={M.deleteTitle(a.name)} confirmLabel={M.deleteConfirm} danger
    does={M.deleteDoes}
    doesNot={M.deleteDoesNot}>
    <input type="hidden" name="action" value="delete" />
  </ConfirmDialog>
</AdminLayout>
