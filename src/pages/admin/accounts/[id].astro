        <h2 id="add-person-title" class="co-entity">{P.group.addPerson} · {a.name}</h2>
        <label class="co-field">{P.quick.name}<input class="co-input" name="name" required maxlength="160" /></label>
        {profile === 'venue' && <p class="co-help m-0" data-testid="add-person-staff">{P.quick.staffOnly}</p>}
        {/* Su papel en el local, de una lista (§29); «Otro…» deja escribirlo. */}
        <label class="co-field">{P.quick.role} <span class="co-help">{P.quick.optional}</span>
          <select class="co-select" name="roleKey" data-role-select data-testid="add-person-role">
            <option value="">—</option>{P.quick.roles.map((r) => <option value={r}>{r}</option>)}<option value="__other">{P.quick.roleOther}</option>
          </select></label>
        <input class="co-input" name="roleOther" maxlength="80" placeholder={P.quick.roleOtherPh} hidden data-role-other data-testid="add-person-role-other" />
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="co-field">{P.quick.email} <span class="co-help">{P.quick.optional}</span><input class="co-input" type="email" name="email" maxlength="200" /></label>
          <label class="co-field">{P.quick.phone} <span class="co-help">{P.quick.optional}</span><input class="co-input" type="tel" name="phone" maxlength="40" /></label>
