        <button type="button" class="co-btn co-btn--ghost" data-dialog-close>{shellMessages[locale].ui.cancel}</button>
        <button class="co-btn co-btn--primary" type="submit">{P.quick.create}</button>
      </div>
    </form>
  </dialog>

  {/* Nueva interacción (§39): algo nuevo que ha pasado, en su propio modal y con su botón de guardar. */}
  {canLog && (
    <dialog id="log-dialog" class="co-dialog co-dialog--wide" aria-labelledby="log-dialog-title" data-testid="log-dialog">
      <form method="post" id="follow-log" data-testid="contact-form" data-follow-log data-pick={F.follow.pick} data-note-needed={F.follow.noteNeeded} data-visit-note={F.follow.visitNote}>
        <input type="hidden" name="action" value="contact" />
        <div class="co-dialog__body grid gap-3">
          <div>
            <h2 id="log-dialog-title" class="co-entity">{F.follow.addTitle}</h2>
            <p class="co-meta mt-1">{F.follow.addHelp}</p>
          </div>
          <p class="co-chip m-0 w-fit" hidden data-draft-note data-testid="log-draft">{F.follow.draft} <button type="button" class="ml-1 underline" data-draft-discard>{F.follow.discard}</button></p>
          <div class="grid gap-2 sm:grid-cols-3">
            <label class="co-field">{F.follow.day}<input class="co-input" type="date" name="day" value={TODAY} max={TODAY} data-testid="log-day" /></label>
            <label class="co-field">{F.follow.with}
              <select class="co-select" name="contactId" data-testid="log-with">
                {tl.actors.map((x) => <option value={x.id} selected={x.id === (tl.next?.contactId ?? sug.contactId)}>{x.name}{x.role ? ` · ${x.role}` : ''}</option>)}
                <option value="" selected={!tl.actors.length}>{F.follow.company}</option>
              </select></label>
            <label class="co-field">{F.follow.via}
              <select class="co-select" name="channel" data-testid="log-channel">{CHANNELS.map((c) => <option value={c} selected={c === (tl.next?.channel ?? sug.channel ?? 'other')}>{F.channels[c]}</option>)}</select></label>
          </div>
          <fieldset class="grid gap-2">
            <legend class="co-field mb-1">{F.follow.result}</legend>
            <div class="co-chips" role="radiogroup">
              {OUTCOMES.map((o) => (
                <label class="co-chip" data-testid={`outcome-${o}`}><input type="radio" name="outcome" value={o} />{F.outcomes[o]}</label>
              ))}
              <label class="co-chip co-chip--quiet" data-testid="outcome-visit"><input type="radio" name="outcome" value="note" data-quick-visit />{F.follow.quickVisit}</label>
            </div>
          </fieldset>
          <label class="co-field">{F.follow.note}
            <textarea class="co-textarea !min-h-[96px]" name="note" maxlength="4000" placeholder={F.follow.notePh} data-draft={`follow.${a.id}`} data-testid="log-note"></textarea></label>
          <p class="co-help m-0 text-[var(--co-danger)]" hidden data-log-hint role="alert"></p>
        </div>
        <div class="co-dialog__foot">
          <button type="button" class="co-btn co-btn--ghost" data-dialog-close>{shellMessages[locale].ui.cancel}</button>
          <button class="co-btn co-btn--primary" type="submit" data-testid="log-save"><Icon name="check" size={16} />{F.follow.saveLog}</button>
        </div>
      </form>
    </dialog>
  )}

  <script>
    // Seguimiento (§33). «Hecho»: baja a «¿Qué ha pasado?» con la nota lista. La nota se guarda como borrador en este
    // navegador mientras se escribe (si se cierra la página, al volver se recupera) y se borra al apuntar.
    // «Solo una nota» necesita texto; los demás resultados, no.
    const log = document.querySelector<HTMLFormElement>('[data-follow-log]');
    const note = log?.querySelector<HTMLTextAreaElement>('[data-draft]');
    const key = note ? `co.draft.${note.dataset.draft}` : '';
    const banner = log?.querySelector<HTMLElement>('[data-draft-note]');
    try { const d = key && localStorage.getItem(key); if (note && d) { note.value = d; if (banner) banner.hidden = false; } } catch { /* sin almacenamiento */ }
    note?.addEventListener('input', () => { try { if (note.value.trim()) localStorage.setItem(key, note.value); else localStorage.removeItem(key); } catch { /* */ } });
    banner?.querySelector('[data-draft-discard]')?.addEventListener('click', () => { if (note) note.value = ''; try { localStorage.removeItem(key); } catch { /* */ } banner.hidden = true; });
    const hint = log?.querySelector<HTMLElement>('[data-log-hint]');
    const say = (msg: string) => { if (hint) { hint.textContent = msg; hint.hidden = false; } };
    log?.addEventListener('submit', (e) => {
      const picked = log.querySelector<HTMLInputElement>('input[name=outcome]:checked');
      if (!picked) { e.preventDefault(); say(log.dataset.pick ?? ''); return; }
      if (picked.value === 'note' && !note?.value.trim()) { e.preventDefault(); say(log.dataset.noteNeeded ?? ''); note?.focus(); return; }
      try { localStorage.removeItem(key); } catch { /* */ }
    });
    // «Visita (solo mirar)»: por dónde = visita y, si no hay nota, una para empezar.
    log?.querySelector('[data-quick-visit]')?.addEventListener('change', () => {
      const ch = log.querySelector<HTMLSelectElement>('select[name=channel]');
      if (ch) ch.value = 'visit';
      if (note && !note.value.trim()) note.value = log.dataset.visitNote ?? '';
    });
    // «Hecho» y «Añadir interacción»: el modal, con la nota lista para escribir.
    const dlg = document.getElementById('log-dialog') as HTMLDialogElement | null;
    document.querySelector('[data-follow-done]')?.addEventListener('click', (e) => { e.preventDefault(); dlg?.showModal(); note?.focus(); });
    document.querySelector('[data-log-open]')?.addEventListener('click', () => setTimeout(() => note?.focus(), 0));
    document.querySelector('[data-more-show]')?.addEventListener('click', (e) => { document.querySelectorAll<HTMLElement>('[data-more-item]').forEach((x) => { x.hidden = false; }); (e.currentTarget as HTMLElement).remove(); });
  </script>

  <script>
    // «Otro…» en el papel: aparece el campo para escribirlo.
    document.querySelectorAll<HTMLSelectElement>('[data-role-select]').forEach((sel) => {
      const other = sel.closest('form')?.querySelector<HTMLInputElement>('[data-role-other]');
      sel.addEventListener('change', () => { if (other) { other.hidden = sel.value !== '__other'; if (!other.hidden) other.focus(); } });
    });
  </script>

  <ConfirmDialog id="release" title={M.releaseTitle(a.name)} confirmLabel={M.releaseConfirm}
    does={M.releaseDoes}
    doesNot={M.releaseDoesNot}>
    <input type="hidden" name="action" value="release" />
  </ConfirmDialog>
  {/* Siempre en la página: la ficha de Google se puede elegir sin recargar y entonces ya se puede quitar. */}
  <ConfirmDialog id="google-clear-dialog" title={G.clearTitle} confirmLabel={G.clear} danger testid="google-clear-dialog" does={G.clearDoes} doesNot={G.clearNot} action="#company-contact">
    <input type="hidden" name="action" value="google-clear" />
  </ConfirmDialog>
  <ConfirmDialog id="discard" title={CL.discardTitle(a.name)} confirmLabel={CL.discard} testid="discard-dialog" does={CL.discardBody} doesNot={CL.discardNot}>
    <input type="hidden" name="action" value="discard" />
    <fieldset class="grid gap-1.5"><legend class="co-field mb-1">{CL.reason}</legend>
      <div class="flex flex-wrap gap-2">
        {DISCARD_REASONS.map((r, i) => (
          <label class="co-chip discard-reason"><input type="radio" class="sr-only" name="reason" value={r} checked={i === 0} data-testid={`discard-reason-${r}`} />{CL.reasons[r]}</label>
        ))}
      </div>
    </fieldset>
    <label class="co-field">{CL.note}<input class="co-input" name="note" maxlength="500" placeholder={CL.notePh} data-testid="discard-note" /></label>
  </ConfirmDialog>
  <ConfirmDialog id="block" title={M.blockTitle(a.name)} confirmLabel={M.blockConfirm} danger testid="block-dialog"
    does={M.blockDoes}
    doesNot={M.blockDoesNot}>
    <input type="hidden" name="action" value="block" />
    <label class="co-field">{M.reason}<input class="co-input" name="reason" required maxlength="300" placeholder={M.reasonPlaceholder} /></label>
  </ConfirmDialog>
  <ConfirmDialog id="delete-account" title={M.deleteTitle(a.name)} confirmLabel={M.deleteConfirm} danger
    does={M.deleteDoes}
    doesNot={M.deleteDoesNot}>
    <input type="hidden" name="action" value="delete" />
  </ConfirmDialog>
</AdminLayout>


<style>
  /* «Lo más importante» de Lo que sabemos: tarjetas que se leen de un vistazo. */
  .discard-reason:has(input:checked) { background: var(--co-ink, #0a0a0a); color: var(--co-canvas, #fff); border-color: var(--co-ink, #0a0a0a); }
  .sum-fit-yes { background: #e7f6ec; color: #14532d; border-color: #b7e2c4; }
  .sum-fit-maybe { background: #fff6e0; color: #6b4a00; border-color: #f0dca6; }
  .facts-key { background: var(--co-signal-soft, #ece6fc); color: var(--co-signal-ink, #2a1066); }
  .facts-key [data-testid=fact-star][aria-pressed=true] { color: var(--co-signal, #6a2bd9); }
  .outcome:has(input:checked) { background: var(--co-ink, #0a0a0a); color: var(--co-canvas, #fff); border-color: var(--co-ink, #0a0a0a); }
</style>
