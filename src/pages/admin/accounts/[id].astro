              ? <form method="post"><input type="hidden" name="action" value="unblock" /><button class="co-action" type="submit"><Icon name="rotate-ccw" /><span class="co-action__label">{M.unblock}</span><Icon name="chevron-right" size={16} /></button></form>
              : <button type="button" class="co-action" data-dialog-open="block" data-testid="block-open"><Icon name="ban" /><span class="co-action__label">{M.block}<small>{M.blockHint}</small></span><Icon name="chevron-right" size={16} /></button>}
            <button type="button" class="co-action" data-dialog-open="delete-account"><Icon name="trash2" /><span class="co-action__label">{M.delete}</span><Icon name="chevron-right" size={16} /></button>
