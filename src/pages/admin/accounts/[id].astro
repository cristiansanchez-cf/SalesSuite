---
/** Ficha de una cuenta (docs/ACCOUNTS.md): quién la trabaja, qué se ha hecho, y actuar en un clic. */
import ZonePicker from '~/components/crm/ZonePicker.astro';
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import Icon from '~/components/ui/Icon.astro';
import type { IconName } from '~/lib/ui/icons';
import { safeHref } from '~/lib/safe-href';
import ConfirmDialog from '~/components/ui/ConfirmDialog.astro';
import AccountState from '~/components/accounts/AccountState.astro';
import { can } from '~/lib/admin/permissions';
import { AdminError } from '~/lib/admin/service';
import { flash, formAction } from '~/lib/admin/forms';
import { STATUS_CLASS } from '~/lib/admin/format';
import { ELIGIBILITY_LABELS, zonePath } from '~/lib/accounts/rules';
import { ACCOUNT_CONTACT_KEYS, DISCARD_REASONS, profileOf, type TouchKind } from '~/lib/accounts/types';
import { priorityFor } from '~/lib/crm/score';
import { profilesMessages } from '~/lib/i18n/messages/profiles';
import WorkLinks from '~/components/crm/WorkLinks.astro';
import GroupPicker from '~/components/crm/GroupPicker.astro';
import TagChips from '~/components/crm/TagChips.astro';
import ProfileCard from '~/components/crm/ProfileCard.astro';
import { i18n } from '~/lib/i18n';
import { accountsMessages } from '~/lib/i18n/messages/accounts';
import { crmMessages } from '~/lib/i18n/messages/crm';
import FieldInput from '~/components/crm/FieldInput.astro';
import { fieldsFor, formatValue, valuesFromForm } from '~/lib/crm/fields';
import { peopleMessages } from '~/lib/i18n/messages/people';
import { shellMessages } from '~/lib/i18n/messages/shell';
import { followupMessages } from '~/lib/i18n/messages/followup';
import ContactLinks from '~/components/crm/ContactLinks.astro';
import ChargeCard from '~/components/crm/ChargeCard.astro';
import { suggestTariff } from '~/lib/crm/charge';
import { chargeMessages } from '~/lib/i18n/messages/charge';
import { mergeMessages } from '~/lib/i18n/messages/merge';
import { SIZE_LIMITS, SIZES, formatsOf, sizeScaleOf } from '~/lib/crm/priority';
import QualificationCard from '~/components/crm/QualificationCard.astro';
import GroupLocalesCard from '~/components/crm/GroupLocalesCard.astro';
import AiResearchCard from '~/components/crm/AiResearchCard.astro';
import { notesMessages } from '~/lib/i18n/messages/notes';
import { researchContext } from '~/lib/crm/research-context';
import { cleanupMessages } from '~/lib/i18n/messages/cleanup';
import { researchMessages } from '~/lib/i18n/messages/research';
import { PACKAGES, PRESALE } from '~/lib/crm/priority';
import { priorityMessages } from '~/lib/i18n/messages/priority';
import { kindsMessages } from '~/lib/i18n/messages/kinds';
import { CHANNELS, OUTCOMES } from '~/lib/crm/followup';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const perms = can(admin.session.role);
if (!perms.useAccounts) return Astro.rewrite('/admin/forbidden');
const acc = admin.accounts;
const id = Astro.params.id ?? '';
const { m: msg, f: fmt, locale } = i18n(Astro, accountsMessages);
const M = msg.detail;
const ELIGIBILITY_LABEL = ELIGIBILITY_LABELS[locale];
const C = crmMessages[locale].card;
const P = peopleMessages[locale];
const F = followupMessages[locale];

let result: { error: string | null; details: string[] } = { error: null, details: [] };
const googleBox: { r: Awaited<ReturnType<typeof admin.crm.googleCandidates>> | null; q: string } = { r: null, q: '' };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const str = (k: string) => String(f.get(k) ?? '');
  let to = `/admin/accounts/${id}`;
  result = await formAction(async () => {
    // El botón pulsado puede traer su propia acción (p. ej. «Quitar próximo paso» dentro del formulario de cambiarlo).
    switch (String(f.getAll('action').pop() ?? '')) {
      case 'contact': {
        // Apuntar una interacción (cuenta como contacto) y dejar el próximo paso: el que diga el comercial o el de la regla.
        const custom = str('nextAt') || str('nextStep') ? { at: str('nextAt'), channel: str('nextChannel'), contactId: str('nextContactId'), step: str('nextStep') } : undefined;
        // Cuándo fue: hoy, ahora; otro día, a mediodía de ese día (para que el historial quede en orden).
        const day = /^\d{4}-\d{2}-\d{2}$/.test(str('day')) && str('day') < new Date().toISOString().slice(0, 10) ? `${str('day')}T12:00:00` : undefined;
        await admin.crm.logActivity(id, { contactId: str('contactId'), channel: str('channel') || 'other', outcome: str('outcome') || 'note', note: str('note'), happenedAt: day }, custom);
        to += str('outcome') === 'note' || !str('outcome') ? '?ok=noted' : '?ok=contact';
        break;
      }
      case 'google-search': googleBox.q = str('q'); googleBox.r = await admin.crm.googleCandidates(id, googleBox.q); to = ''; break;
      case 'google-apply': {
        // Qué se ha rellenado (y la ciudad), para decirlo en el aviso.
        const g = await admin.crm.googleApply(id, str('placeId'));
        to += `?ok=google&g=${g.filled.join('.')}${g.zone ? `&z=${encodeURIComponent(g.zone)}` : ''}#company-contact`;
        break;
      }
      case 'google-clear': await admin.crm.googleClear(id); to += '?ok=googleCleared#company-contact'; break;
      case 'ai-run': await admin.crm.aiRun(id, await researchContext(admin, (await acc.get(id)).account.segmentId)); to += '?ok=ai#ai'; break;
      case 'ai-accept': await admin.crm.aiDecide(id, str('sid'), true); to += '?ok=aiAccept#ai'; break;
      case 'ai-dismiss': await admin.crm.aiDecide(id, str('sid'), false); to += '?ok=aiDismiss#ai'; break;
      case 'qualify': await admin.crm.qualify(id, str('set')); to += '?ok=qualified#qual'; break;
      case 'charge-size': await admin.crm.qualify(id, str('set')); to += '?ok=qualified#charge'; break;
      case 'charge': {
        const custom = str('customLink') ? { label: str('customLabel'), amount: str('customAmount').replace(',', '.'), paymentLink: str('customLink') } : null;
        await admin.crm.charge(id, { priceOptionId: str('priceOptionId'), couponId: str('couponId'), custom });
        to += '?ok=charge#charge'; break;
      }
      case 'charge-cancel': await admin.crm.chargeCancel(str('chargeId')); to += '?ok=chargeCancelled#charge'; break;
      case 'charge-paid': await admin.crm.chargeMarkPaid(str('chargeId')); to += '?ok=paid#charge'; break;
      case 'mark-won': await admin.crm.markWon(id); to += '?ok=paid#charge'; break;
      case 'next': await admin.crm.setNextStep(id, { at: str('nextAt'), channel: str('nextChannel'), contactId: str('nextContactId'), step: str('nextStep') }); to += '?ok=next'; break;
      case 'next-clear': await admin.crm.setNextStep(id, null); to += '?ok=cleared'; break;
      case 'fact-add': await admin.crm.factAdd(id, str('text'), str('kind') === 'fit' ? 'fit' : str('kind') === 'key' ? 'key' : 'fact'); to += '?ok=fact#facts'; break;
      case 'fact-star': await admin.crm.factStar(id, str('factId')); to += '?ok=factStarred#facts'; break;
      case 'fact-remove': await admin.crm.factRemove(id, str('factId')); to += '?ok=factRemoved#facts'; break;
      case 'activity-delete': await admin.crm.deleteActivity(str('activityId')); to += '?ok=removed'; break;
      // Solo lo que trae el formulario (la ficha de una promotora no enseña Facebook: no se borra por no estar).
      case 'company-contact': await admin.crm.setCompanyContact(id, Object.fromEntries(ACCOUNT_CONTACT_KEYS.filter((k) => f.has(k)).map((k) => [k, str(k)]))); to += '?ok=companyContact'; break;
      case 'claim': { const e = await acc.touch(id, 'claim'); to += `?ok=${e === 'eligible' ? 'claimed' : `not-${e}`}`; break; }
      case 'release': await acc.touch(id, 'release'); to += '?ok=released'; break;
      case 'save': await acc.update(id, { name: str('name'), zoneId: await admin.crm.pickZone(str('zoneId')), segmentId: str('segmentId'), address: str('address'), externalRef: str('externalRef'), notes: str('notes') }); to += '?ok=saved'; break;
      case 'assign': await acc.assign(id, str('userId') || null); to += '?ok=assigned'; break;
      case 'fields': await acc.setFields(id, valuesFromForm(await acc.crmFields(), f)); to += '?ok=fields'; break;
      // Tipo y descartar (§17): cambiar el tipo no recupera una descartada.
      case 'kind': await admin.crm.classifyAccount(id, { kind: str('kind') }); to += '?ok=kind'; break;
      case 'discard': await admin.crm.classifyAccount(id, { reason: str('reason'), note: str('note') }); to += '?ok=discarded'; break;
      case 'restore': await admin.crm.classifyAccount(id, { reason: null }); to += '?ok=restored'; break;
      case 'group': await admin.crm.moveToGroup([id], str('leave') ? {} : { groupId: str('groupId') || null, groupName: str('groupId') ? null : str('groupName') }); to += '?ok=group#acc-group'; break;
      case 'group-owner': {
        // Lo que se junta se calcula aquí otra vez (no se fía de lo que llegue en el formulario).
        const og = (await admin.crm.company(id)).ownerGroup;
        if (og) await admin.crm.moveToGroup(og.move, og.groupId ? { groupId: og.groupId } : { groupName: og.name });
        to += '?ok=owner#acc-group'; break;
      }
      case 'tags': await admin.crm.setTags('account', id, str('tags').split(',')); to += '?ok=tags'; break;
      case 'add-person': {
        const role = str('roleKey') === '__other' ? str('roleOther') : str('roleKey') || str('role');
        await admin.crm.quickAdd({ name: str('name'), role, email: str('email'), phone: str('phone'), accountId: id }); to += '?ok=person'; break;
      }
      case 'unlink': await admin.crm.unlink(str('contactId'), id); to += '?ok=unlinked'; break;
      case 'work-add': {
        const r = await admin.crm.workLinkAdd(id, { otherId: str('otherId'), name: str('workName'), kind: str('workKind'), ...(str('workNote') || str('otherId') ? { note: str('workNote') } : {}),
          days: f.getAll('days').map(String), ...(f.has('freq') ? { freq: str('freq') } : {}), ...(f.has('role') ? { role: str('role') } : {}) });
        to += `?ok=${r.created ? 'workNew' : 'work'}#work`; break;
      }
      case 'work-remove': await admin.crm.workLinkRemove(str('linkId')); to += '?ok=workRemoved#work'; break;
      case 'block': await acc.block(id, str('reason')); to += '?ok=blocked'; break;
      case 'unblock': await acc.unblock(id); to += '?ok=unblocked'; break;
      case 'delete': await acc.remove(id); to = '/admin/accounts'; break;
      case 'dossier': {
        const a = (await acc.get(id)).account;
        const d = await admin.service.createDossier({ title: a.name, prospectCompany: a.name, accountId: id });
        to = `/admin/dossiers/${d}`;
        break;
      }
    }
  });
  if (!result.error && to) return Astro.redirect(to, 303);
}

let data;
try { data = await acc.get(id); } catch (e) {
  if (e instanceof AdminError && e.status === 404) return Astro.rewrite('/404');
  throw e;
}
const { account: a, touches, dossiers, canEdit, rules, crmFields } = data;
// Todo lo que pinta la ficha, a la vez (cada servicio lee lo suyo; lo repetido sale de la caché de la petición).
const [t, segments, members, co, tl, weights, coolingMap, aiR, kindDefs, work, googleQ, listsAll, chargeList, chargeOpts, coupons] = await Promise.all([
  acc.territory(), admin.playbook.segmentList(), perms.manageAccounts ? admin.tenantAdmin.listMembers().catch(() => []) : Promise.resolve([]), admin.crm.company(id), admin.crm.timeline(id),
  admin.crm.weights(), admin.crm.cooling([id]), admin.crm.aiResearch(id), acc.kinds(), admin.crm.workLinks(id),
  googleBox.q ? Promise.resolve(googleBox.q) : admin.crm.hasGoogle() ? admin.crm.googleQuery(id) : Promise.resolve(''),
  admin.crm.lists({ people: false }),
  admin.crm.charges(id), admin.crm.chargeOptions(), admin.commissions.coupons().catch(() => []),
]);
const accountLists = listsAll.filter((l) => l.accounts > 0).map((l) => l.tag);
// Contacto: el de la empresa y, de respaldo, el de su persona principal (empresa pequeña: el móvil del dueño).
const primary = tl.actors[0];
const fallback = primary ? { name: primary.name, phone: primary.phone, email: primary.email, instagram: primary.instagram, linkedin: primary.linkedin } : undefined;
const sug = tl.suggestion;
const nextAt = tl.next?.at ? new Date(tl.next.at) : null;
const googleResults = googleBox.r;
const G = priorityMessages[locale].google;
const PS = priorityMessages[locale];
const CL = cleanupMessages[locale];
const NT = notesMessages[locale];
const KN = kindsMessages[locale];
const photoSrc = (n: string | null | undefined) => (n ? `/admin/api/crm/place-photo?n=${encodeURIComponent(n)}` : null);
const hostOf = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
const googleApplied = () => {
  const keys = (Astro.url.searchParams.get('g') ?? '').split('.').filter((k): k is keyof typeof G.fields => k in G.fields);
  return G.applied(keys.map((k) => G.fields[k]).join(', '), Astro.url.searchParams.get('z') ?? '');
};
// La ficha de su tipo (§24): local, promotora o DJ; cada una con sus preguntas y su nota.
const profile = profileOf(kindDefs, a.kind);
const PRF = profilesMessages[locale];
const segKey = segments.find((sg) => sg.id === a.segmentId)?.key ?? null;
const prio = priorityFor(a.qualification, profile, segKey, weights);
// Un grupo (§37) no se cualifica: sus locales, cada uno con su tipo, tamaño y nota.
const isGroup = co.locales.length > 0;
const groupLocals = isGroup
  ? (await admin.crm.groupLocales(a.id)).map((l) => ({ id: l.id, name: l.name, zone: l.zoneId ? zonePath(t.zones, l.zoneId) : null, q: l.qualification,
      owner: l.ownerId ? (members.find((x) => x.userId === l.ownerId)?.displayName ?? null) : null,
      p: priorityFor(l.qualification, profileOf(kindDefs, l.kind), segments.find((sg) => sg.id === l.segmentId)?.key ?? null, weights) }))
  : [];
const groupBest = groupLocals.filter((l) => !l.p.out && l.p.qualified).sort((x, y) => y.p.score - x.p.score)[0] ?? null;
// Qué se enseña como «le encaja» en cada ficha (a una promotora o un DJ no les aplica la fidelización).
const fitKeys = (profile === 'venue' ? PACKAGES : profile === 'promoter' ? (['requests', 'screen', 'photos'] as const) : (['requests'] as const)) as readonly (keyof typeof prio.fit)[];
const fitLabel = (k: keyof typeof prio.fit) => (profile === 'venue' ? PS.packages[k] : (PRF.packages as Record<string, string>)[k] ?? PS.packages[k]);
const canQualify = perms.manageAccounts || !a.ownerId || a.ownerId === admin.session.userId;
// Apuntar en el seguimiento: como antes, salvo en las bloqueadas, las de otro y las ya clientes.
const TODAY = new Date().toISOString().slice(0, 10);
const canLog = a.state !== 'blocked' && a.state !== 'taken' && a.state !== 'customer';
const actorName = (cid: string | null) => (cid ? tl.actors.find((x) => x.id === cid)?.name ?? F.follow.company : F.follow.company);
// Ficha (campos del CRM): los de su sector, agrupados por sección.
const sheet = fieldsFor(crmFields, segKey, { target: 'account', tags: a.tags });
const sections = [...new Set(sheet.map((x) => x.group ?? ''))].map((g) => ({ title: g || (sheet.some((x) => x.group) ? C.other : ''), fields: sheet.filter((x) => (x.group ?? '') === g) }));
const day = (iso: string | null) => fmt.date(iso, { day: 'numeric', month: 'long' });
const NOT = (e: string) => M.notClaimed(ELIGIBILITY_LABEL[e as keyof typeof ELIGIBILITY_LABEL]?.toLowerCase() ?? e);
const okKey = Astro.url.searchParams.get('ok') ?? '';
const okMsg = okKey.startsWith('not-') ? null : flash(Astro.url, {
  created: M.okCreated(rules.claimDays), contact: `${F.follow.ok.logged} ${M.okContact(day(a.claimedUntil))}`,
  claimed: M.okClaimed(day(a.claimedUntil)), released: M.okReleased,
  qualified: priorityMessages[locale].ok, ai: researchMessages[locale].ok.run, aiAccept: researchMessages[locale].ok.accept, aiDismiss: researchMessages[locale].ok.dismiss, google: googleApplied(), googleCleared: G.cleared, fact: NT.factSaved, factRemoved: NT.factRemoved, factStarred: NT.factStarred, kind: CL.ok.kind, discarded: CL.ok.discarded, restored: CL.ok.restored,
  noted: F.follow.ok.noted, next: F.follow.ok.next, cleared: F.follow.ok.cleared, removed: F.follow.ok.removed, companyContact: F.follow.ok.contact,
  owner: P.group.ok.owner, group: P.group.ok.group, tags: P.group.ok.tags, person: P.group.ok.person, unlinked: P.group.ok.unlinked,
  saved: M.okSaved, fields: C.okSaved, work: KN.work.ok, workNew: KN.work.okNew, workRemoved: KN.work.removed, assigned: M.okAssigned, blocked: M.okBlocked, unblocked: M.okUnblocked,
  charge: chargeMessages[locale].ok, chargeCancelled: chargeMessages[locale].okCancelled, paid: chargeMessages[locale].okPaid, merged: mergeMessages[locale].ok,
});
// Cobrar (§35): los tramos del tamaño según lo que es y quién generó cada enlace.
const sizeRangeOf = (q: typeof a.qualification) => {
  const lim = SIZE_LIMITS[sizeScaleOf(formatsOf(q))];
  const num = (n: number) => n.toLocaleString('es-ES');
  return Object.fromEntries(SIZES.map((k, i) => [k, PS.sizeRange(i ? num(lim[i - 1]) : '', i < 3 ? num(lim[i]) : '')]));
};
const chargeNames = new Map([...members.map((x) => [x.userId, x.displayName || x.email] as const), [admin.session.userId, admin.session.displayName || admin.session.email]]);
const notMsg = okKey.startsWith('not-') ? NOT(okKey.slice(4)) : null;
const TOUCH: Record<TouchKind, string> = M.touch;
const STATE_ALERT = {
  free: { kind: 'info' as const, title: M.freeTitle, body: M.freeBody(rules.claimDays) },
  mine: { kind: 'success' as const, title: M.mineTitle(day(a.claimedUntil)), body: M.mineBody },
  taken: { kind: 'rejection' as const, title: M.takenTitle(a.ownerName ?? msg.state.someoneElse, day(a.claimedUntil)), body: M.takenBody },
  my_customer: { kind: 'success' as const, title: M.myCustomerTitle, body: M.myCustomerBody(day(a.wonAt)) },
  customer: { kind: 'info' as const, title: M.customerTitle(a.wonByName ?? msg.state.someoneElse), body: M.customerBody },
  blocked: { kind: 'rejection' as const, title: M.blockedTitle, body: a.blockedReason ?? M.blockedBody },
}[a.state];
---
<AdminLayout title={a.name}>
  <div id="acc-head"><PageHeader eyebrow={a.zonePath || M.noZone} title={a.name} back={{ href: '/admin/accounts', label: M.back }}>
    <AccountState a={a} />
    {(a.state === 'free' || a.state === 'mine' || a.state === 'my_customer') && (
      <form method="post"><input type="hidden" name="action" value="dossier" />
        <button class="co-btn co-btn--primary" type="submit" data-testid="account-dossier">{M.createProposal} <span aria-hidden="true">→</span></button></form>
    )}
    {/* Qué es (§42): local/empresa, promotora o DJ, a un toque (cambia su ficha). */}
    {kindDefs.length > 1 && (
      <form method="post" slot="below" class="mt-3 flex flex-wrap items-center gap-2" data-testid="kind-switch">
        <input type="hidden" name="action" value="kind" />
        <span class="co-meta text-sm">{CL.isA}:</span>
        <div class="co-segmented w-fit !px-1">
          {kindDefs.map((k) => (
            <button type="submit" name="kind" value={k.key} class="!px-3" aria-current={(kindDefs.some((x) => x.key === a.kind) ? a.kind : kindDefs[0].key) === k.key ? 'page' : undefined}
              disabled={!canQualify} data-testid={`kind-switch-${k.key}`}><Icon name={k.icon as IconName} size={14} />{k.label}</button>
          ))}
        </div>
      </form>
    )}
    {a.discardedAt && a.discardReason && (
      <p slot="below" class="co-tag co-tag--danger mt-3 w-fit" data-testid="discarded-banner">{CL.discarded(CL.reasons[a.discardReason])}{a.discardNote && <span class="font-normal"> — {a.discardNote}</span>}</p>
    )}
  </PageHeader></div>
  {okMsg && <div class="mb-4"><Alert kind="success" title={okMsg} /></div>}
  {notMsg && <div class="mb-4"><Alert kind="rejection" title={notMsg} /></div>}
  {result.error && <div class="mb-4"><Alert kind="rejection" title={result.error} details={result.details} /></div>}

  <div class="co-split">
    <div class="grid content-start gap-5">
      <div class:list={['co-alert', `co-alert--${STATE_ALERT.kind}`]} data-testid="account-status" data-state={a.state}>
        <Icon name={STATE_ALERT.kind === 'rejection' ? 'triangle-alert' : STATE_ALERT.kind === 'success' ? 'circle-check' : 'info'} size={18} />
        <div class="min-w-0"><p class="font-semibold">{STATE_ALERT.title}</p><p>{STATE_ALERT.body}</p></div>
      </div>

      {/* Resumen (§22): lo que hace falta de un vistazo en la puerta del local; y saltos a cada parte (en el móvil la ficha es larga). */}
      <section id="account-summary" class="co-card grid gap-3 !p-4" data-testid="account-summary">
        <div class="grid gap-2">
          {isGroup ? (
            <span class="inline-flex items-baseline gap-1" data-testid="summary-group">{groupBest
              ? <><span class="co-figure text-3xl">{groupBest.p.score}</span><span class="co-meta">/ 100 · {PS.group.score}: {groupBest.name}</span></>
              : <span class="co-meta">{PS.group.title(groupLocals.length)} · {PS.group.pending(groupLocals.filter((l) => !l.p.qualified).length)}</span>}</span>
          ) : a.state !== 'customer' && (prio.out
            ? <span class="co-tag co-tag--danger">{PS.outBy(prio.kills.map((k) => PS.kills[k]).join(' · '))}</span>
            : <span class="inline-flex items-baseline gap-1"><span class="co-figure text-3xl" data-testid="summary-score">{prio.score}</span><span class="co-meta">/ 100{!prio.qualified && ` · ${PS.unqualified}`}</span></span>)}
          {!isGroup && <div class="flex min-w-0 flex-wrap items-center gap-1.5" data-testid="summary-fit">
            {(() => { const fits = fitKeys.filter((k) => prio.fit[k] === 'yes' || prio.fit[k] === 'maybe'); return fits.length
              ? <><span class="co-meta">{PS.summary.fits}:</span>{fits.map((k) => <span class:list={['co-tag', prio.fit[k] === 'yes' ? 'sum-fit-yes' : 'sum-fit-maybe']}>{fitLabel(k)}{PRESALE.includes(k) ? ` (${PS.presale})` : ''}</span>)}</>
              : <span class="co-meta">{PS.summary.noFit}</span>; })()}
          </div>}
        </div>
        {/* En la puerta del local: apuntar sobre este sitio, llegar, llamar o escribir (lo que hay, sin buscarlo). */}
        <div class="flex flex-wrap gap-2" data-testid="summary-actions">
          {canQualify && <a class="co-btn co-btn--primary co-btn--sm" href={`/admin/accounts/apuntar?empresa=${a.id}`} data-testid="summary-note"><Icon name="sparkles" size={14} />{PS.summary.act.note}</a>}
          {profile === 'venue' && <a class="co-btn co-btn--ghost co-btn--sm" href={a.mapsUrl || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent([a.name, a.address, a.zonePath].filter(Boolean).join(', '))}`} target="_blank" rel="noopener" data-testid="summary-directions"><Icon name="route" size={14} />{PS.summary.act.directions}</a>}
          {a.phone && <a class="co-btn co-btn--ghost co-btn--sm" href={`tel:${a.phone.replace(/\s/g, '')}`}><Icon name="phone" size={14} />{PS.summary.act.call}</a>}
          {a.phone && <a class="co-btn co-btn--ghost co-btn--sm" href={`https://wa.me/${a.phone.replace(/[^\d]/g, '')}`} target="_blank" rel="noopener"><Icon name="whatsapp" size={14} />{PS.summary.act.whatsapp}</a>}
          {a.instagram && <a class="co-btn co-btn--ghost co-btn--sm" href={a.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={14} />{PS.summary.act.instagram}</a>}
          {a.tiktok && <a class="co-btn co-btn--ghost co-btn--sm" href={a.tiktok} target="_blank" rel="noopener" data-testid="summary-tiktok"><Icon name="music" size={14} />{PRF.contact.tiktok}</a>}
          {a.musicUrl && <a class="co-btn co-btn--ghost co-btn--sm" href={a.musicUrl} target="_blank" rel="noopener"><Icon name="speaker" size={14} />{PRF.contact.music}</a>}
        </div>
        {co.people[0] && <p class="co-meta m-0 flex flex-wrap items-center gap-1" data-testid="summary-ask"><Icon name="user" size={14} />{PS.summary.askFor} <a class="font-semibold underline" href={`/admin/people/${co.people[0].id}`}>{co.people[0].name}</a>{co.people[0].role ? ` · ${co.people[0].role}` : ''}</p>}
        <a class="co-inset flex items-center gap-2 !p-3 text-inherit !no-underline" href="#follow" data-testid="summary-next">
          <Icon name="calendar" size={16} />
          <span class="min-w-0 flex-1"><span class="co-meta">{PS.summary.next}: </span>{tl.next ? <>{nextAt && fmt.date(tl.next.at, { weekday: 'short', day: 'numeric', month: 'short' })}{tl.next.step && ` · ${tl.next.step}`}</> : PS.summary.noNext}</span>
          <Icon name="chevron-right" size={14} />
        </a>
        <nav class="flex gap-2 overflow-x-auto" aria-label={PS.summary.title} data-scroll-x data-testid="summary-jump">
          {([['facts', '#facts'], ['qual', '#qual'], ['follow', '#follow'], ['people', '#acc-people'], ['data', '#company-contact']] as const).map(([k, h]) => (
            <a class="co-chip whitespace-nowrap !no-underline" href={h}>{k === 'qual' && isGroup ? PS.group.jump : PS.summary.jump[k]}</a>))}
        </nav>
        {canQualify && !a.discardedAt && a.state !== 'customer' && a.state !== 'my_customer' && (
          <button type="button" class="co-btn co-btn--quiet co-btn--sm w-fit justify-self-end" data-dialog-open="discard" data-testid="summary-discard"><Icon name="archive" size={14} />{CL.quickDiscard}</button>
        )}
      </section>

      {/* Promotora o DJ (§24): lo primero es dónde trabaja, con qué días y frecuencia. */}
      {profile !== 'venue' && <WorkLinks work={work} kinds={kindDefs} profile={profile} canEdit={canQualify} selfId={a.id} card />}

      {/* «Lo que sabemos» (§20): lo más valioso del comercial, arriba. Lo que le encaja primero; luego cómo es el sitio. */}
      <section id="facts" class="co-card grid gap-3" data-testid="facts-card">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="co-entity">{NT.factsTitle}</h2>
          <a class="co-meta underline" href={`/admin/accounts/apuntar`} data-testid="facts-note">{NT.factsNote}</a>
        </div>
        {a.facts.length === 0 && <p class="co-meta" data-testid="facts-empty">{NT.factsEmpty}</p>}
        {(() => {
          // Lo importante, en tarjetas grandes; lo que le encaja; el resto en lista corta (lo demás, plegado).
          const keyF = a.facts.filter((x) => x.key);
          const fitF = a.facts.filter((x) => !x.key && x.kind === 'fit');
          const rest = a.facts.filter((x) => !x.key && x.kind !== 'fit');
          const tools = (x: (typeof a.facts)[number]) => canQualify && (
            <span class="flex shrink-0 items-center gap-1 opacity-60 transition group-hover:opacity-100 focus-within:opacity-100">
              <form method="post" action="#facts" data-async="facts" data-async-quiet>
                <input type="hidden" name="action" value="fact-star" /><input type="hidden" name="factId" value={x.id} />
                <button type="submit" class={`co-btn co-btn--quiet co-btn--icon co-btn--sm ${x.key ? '' : 'opacity-0 group-hover:opacity-100 focus:opacity-100'}`} aria-pressed={x.key ? 'true' : 'false'} aria-label={x.key ? NT.factUnstar : NT.factStar} title={x.key ? NT.factUnstar : NT.factStar} data-testid="fact-star"><Icon name="star" size={14} /></button>
              </form>
              <form method="post" action="#facts" data-async="facts" data-async-quiet>
                <input type="hidden" name="action" value="fact-remove" /><input type="hidden" name="factId" value={x.id} />
                <button type="submit" class="co-btn co-btn--quiet co-btn--icon co-btn--sm opacity-0 group-hover:opacity-100 focus:opacity-100" aria-label={NT.factRemove} title={NT.factRemove} data-testid="fact-remove"><Icon name="x" size={14} /></button>
              </form>
            </span>
          );
          const when = (x: (typeof a.facts)[number]) => <span class="co-meta whitespace-nowrap">· {fmt.date(x.at, { day: 'numeric', month: 'short' })}</span>;
          const item = (x: (typeof a.facts)[number]) => (
            <li class="group flex list-none items-start gap-2 text-sm" data-testid="fact" data-kind={x.kind}>
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--co-ink-dim)]"></span>
              <span class="min-w-0 flex-1">{x.text} {when(x)}</span>
              {tools(x)}
            </li>
          );
          return (
            <>
              {keyF.length > 0 && (
                <ul class="m-0 grid gap-2 p-0 sm:grid-cols-2" data-testid="facts-key">
                  {keyF.map((x) => (
                    <li class="group facts-key flex list-none items-start gap-2 rounded-2xl p-4" data-testid="fact" data-kind={x.kind} data-key="true">
                      <span class="min-w-0 flex-1 text-base font-medium leading-snug">{x.text} <span class="block pt-1 text-xs font-normal">{when(x)}</span></span>
                      {tools(x)}
                    </li>
                  ))}
                </ul>
              )}
              {fitF.length > 0 && (
                <div class="grid gap-1" data-testid="facts-fit">
                  <p class="text-eyebrow m-0">{NT.fit}</p>
                  <ul class="m-0 grid gap-1 p-0">{fitF.map((x) => (
                    <li class="group flex list-none items-start gap-2 text-sm font-medium" data-testid="fact" data-kind={x.kind}>
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--co-signal,#6a2bd9)]"></span>
                      <span class="min-w-0 flex-1">{x.text} {when(x)}</span>
                      {tools(x)}
                    </li>
                  ))}</ul>
                </div>
              )}
              {rest.length > 0 && <ul class="m-0 grid gap-1 p-0">{rest.slice(0, 5).map(item)}</ul>}
              {rest.length > 5 && (
                <details class="grid gap-1" data-testid="facts-more">
                  <summary class="co-meta cursor-pointer underline">{NT.moreFacts(rest.length - 5)}</summary>
                  <ul class="m-0 mt-1 grid gap-1 p-0">{rest.slice(5).map(item)}</ul>
                </details>
              )}
            </>
          );
        })()}
        {canQualify && (
          <form method="post" action="#facts" class="flex flex-wrap gap-2" data-async="facts" data-async-quiet data-testid="fact-form">
            <input type="hidden" name="action" value="fact-add" />
            <label class="sr-only" for="fact-text">{NT.factAdd}</label>
            <input id="fact-text" class="co-input min-w-0 flex-1 basis-full sm:basis-auto" name="text" maxlength="600" required placeholder={NT.factPh} data-testid="fact-text" />
            <select class="co-select w-auto" name="kind" aria-label={NT.factKind}><option value="fact">{NT.factKindFact}</option><option value="key">{NT.factKindKey}</option><option value="fit">{NT.fit}</option></select>
            <button class="co-btn co-btn--ghost co-btn--sm" type="submit" data-testid="fact-add"><Icon name="plus" size={14} /><span>{NT.factAdd}</span></button>
          </form>
        )}
      </section>

      {profile === 'venue' && a.state !== 'customer' && a.state !== 'blocked' && <AiResearchCard research={aiR} canEdit={canQualify && a.state !== 'taken'} hasAi={admin.crm.hasAi()} />}

      {isGroup ? <GroupLocalesCard locales={groupLocals} /> : a.state !== 'customer' && (profile === 'venue'
        ? <QualificationCard q={a.qualification} p={prio} canEdit={canQualify} cooling={coolingMap.get(id) ?? null} />
        : <ProfileCard profile={profile} q={a.qualification as Record<string, unknown>} p={prio} canEdit={canQualify} />)}

      <section id="follow" class="co-card grid gap-4" data-testid="follow">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="co-entity">{F.follow.title}</h2>
          {a.state === 'mine' && <button type="button" class="co-btn co-btn--quiet co-btn--sm" data-dialog-open="release">{M.release}</button>}
        </div>
        {/* Seguimiento (§33): arriba, el próximo paso (Hecho / Cambiar); debajo, «¿Qué ha pasado?»: un toque lo apunta. */}
        <div class:list={['co-inset grid gap-2 !p-4', tl.next?.bucket === 'overdue' && 'co-row--attention']} data-testid="next-step" data-bucket={tl.next?.bucket ?? ''}>
          <p class="text-eyebrow">{F.follow.next}</p>
          {tl.next ? (
            <>
              <p class="co-row-title">
                {tl.next.bucket && <span class="co-tag mr-2">{F.follow[tl.next.bucket]}</span>}
                {nextAt && fmt.date(tl.next.at, { weekday: 'short', day: 'numeric', month: 'short' })}
                {tl.next.channel && ` · ${F.channels[tl.next.channel]}`}
                {` · ${actorName(tl.next.contactId)}`}
              </p>
              {tl.next.step && <p class="co-body">{tl.next.step}</p>}
            </>
          ) : <p class="co-meta">{F.follow.noNext}</p>}
          {sug.reason !== 'closed' && (!tl.next || tl.next.channel !== sug.channel || tl.next.contactId !== sug.contactId) && (
            <p class="co-meta" data-testid="suggestion">{F.follow.suggested}: {sug.reason === 'retry' ? F.reasons.retry(sug.attempt) : F.reasons[sug.reason]}{sug.channel ? ` · ${F.channels[sug.channel]}` : ''}{sug.contactId ? ` · ${actorName(sug.contactId)}` : ''}</p>
          )}
          {canLog && (
            <div class="flex flex-wrap items-center gap-2 pt-1">
              {tl.next && canLog && <a class="co-btn co-btn--primary co-btn--sm" href="#log-dialog" data-follow-done data-testid="next-done"><Icon name="check" size={14} />{F.follow.done}</a>}
              <details class="w-full sm:w-auto" data-testid="next-edit" open={!tl.next && !tl.items.length ? undefined : undefined}>
                <summary class="co-btn co-btn--ghost co-btn--sm cursor-pointer list-none"><Icon name="calendar" size={14} />{tl.next ? F.follow.edit : F.follow.saveNext}</summary>
                <form method="post" class="mt-3 grid gap-3 sm:grid-cols-3" data-testid="next-form">
                  <input type="hidden" name="action" value="next" />
                  <label class="co-field">{F.follow.when}<input class="co-input" type="date" name="nextAt" value={tl.next?.at ? tl.next.at.slice(0, 10) : ''} /></label>
                  <label class="co-field">{F.follow.via}<select class="co-select" name="nextChannel"><option value=""></option>{CHANNELS.map((c) => <option value={c} selected={c === tl.next?.channel}>{F.channels[c]}</option>)}</select></label>
                  <label class="co-field">{F.follow.with}<select class="co-select" name="nextContactId"><option value="">{F.follow.company}</option>{tl.actors.map((x) => <option value={x.id} selected={x.id === tl.next?.contactId}>{x.name}</option>)}</select></label>
                  <label class="co-field sm:col-span-3">{F.follow.what}<input class="co-input" name="nextStep" maxlength="300" value={tl.next?.step ?? ''} placeholder={F.follow.whatPh} /></label>
                  <div class="flex flex-wrap items-center gap-3 sm:col-span-3">
                    <button class="co-btn co-btn--primary co-btn--sm w-fit" type="submit" data-testid="next-save">{F.follow.saveNext}</button>
                    {tl.next && <button class="co-meta underline" type="submit" name="action" value="next-clear" formnovalidate data-testid="next-clear">{F.follow.clear} {F.follow.next.toLowerCase()}</button>}
                  </div>
                  <p class="co-help m-0 sm:col-span-3">{F.follow.nextHelp}</p>
                </form>
              </details>
            </div>
          )}
        </div>

        <div class="grid gap-2" data-testid="interactions">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-eyebrow m-0">{F.follow.history(tl.items.length)}</p>
            {canLog && <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-dialog-open="log-dialog" data-log-open data-testid="log-open"><Icon name="plus" size={14} />{F.follow.add}</button>}
          </div>
          {tl.items.length === 0 ? <p class="co-meta">{F.follow.empty}</p> : (
            <ol class="grid gap-2 p-0">
              {tl.items.slice(0, 30).map((x, i) => (
                <li class="flex list-none items-start gap-3 text-sm" data-outcome={x.outcome} hidden={i >= 5 ? true : undefined} data-more-item={i >= 5 ? '' : undefined}>
                  <span class="co-meta w-24 shrink-0">{fmt.relative(x.happenedAt)}</span>
                  <span class="min-w-0 flex-1">
                    <strong>{x.outcome === 'note' ? F.outcomes.note : `${F.channels[x.channel]} · ${F.outcomes[x.outcome]}`}</strong>
                    <span class="co-meta">{x.contactName ? ` · ${x.contactName}` : ''}{x.userName ? ` · ${x.userName}` : ''}</span>
                    {x.note && <span class="co-body block whitespace-pre-line">{x.note}</span>}
                  </span>
                  {(x.userId === admin.session.userId || perms.manageAccounts) && (
                    <form method="post"><input type="hidden" name="action" value="activity-delete" /><input type="hidden" name="activityId" value={x.id} />
                      <button class="co-btn co-btn--quiet co-btn--icon co-btn--sm" type="submit" aria-label={F.follow.remove} title={F.follow.remove}><Icon name="x" size={12} /></button></form>
                  )}
                </li>
              ))}
            </ol>
          )}
          {tl.items.length > 5 && <button type="button" class="co-meta w-fit underline" data-more-show data-testid="interactions-more">{F.follow.more(Math.min(tl.items.length, 30))}</button>}
          <p class="co-help">{F.follow.rule}</p>
        </div>
      </section>


      {/* Cobrar (§35): la tarifa de su tamaño, cupón y el enlace de pago. */}
      {a.state !== 'blocked' && (
        <ChargeCard name={a.name} size={(a.qualification?.size as string | undefined) ?? null} sizeRange={sizeRangeOf(a.qualification)} options={chargeOpts}
          suggestedId={suggestTariff(chargeOpts, { size: (a.qualification?.size as string | undefined) ?? null, segmentId: a.segmentId })?.id ?? null}
          coupons={coupons} charges={chargeList} canCharge={perms.manageAccounts || !a.ownerId || a.ownerId === admin.session.userId}
          canCustom={perms.manageTenant} canManage={perms.manageAccounts} won={!!a.wonAt} names={chargeNames} phone={a.phone ?? fallback?.phone ?? null} />
      )}

      {/* Tres tarjetas (§26): el grupo, las personas y con quién trabaja; cada una con lo suyo. */}
      <section class="co-card grid gap-4" id="acc-group" data-testid="account-group" hidden={profile !== 'venue'}>
        <h2 class="co-entity flex items-center gap-2"><Icon name="building2" size={18} />{P.group.group}</h2>
        <div class="grid gap-2">
          {co.group ? (
            <form method="post" class="flex flex-wrap items-center gap-2">
              <input type="hidden" name="action" value="group" /><input type="hidden" name="leave" value="1" />
              <a class="co-tag" href={`/admin/accounts/${co.group.id}`}><Icon name="building2" size={12} />{co.group.name}</a>
              {canEdit && <button class="co-btn co-btn--quiet co-btn--sm" type="submit">{P.group.leave}</button>}
            </form>
          ) : co.locales.length > 0 ? <p class="co-meta">{P.group.isGroup}</p> : (
            <>
              <p class="co-meta">{P.group.none}</p>
              {canEdit && <GroupPicker selfId={a.id} nearby={co.nearby} zone={co.nearbyZone} />}
            </>
          )}
        </div>
        {co.sameOwner.length > 0 && (
          // Mismo titular (§25): misma sociedad en su web. Se propone el grupo; juntarlas es decisión de quien vende.
          <div class="co-inset grid gap-2 !p-3" data-testid="same-owner">
            <p class="co-row-title flex items-center gap-2"><Icon name="building2" size={14} />{P.group.sameOwner(a.legalName ?? a.taxId ?? '')}</p>
            <ul class="flex flex-wrap gap-2 p-0">{co.sameOwner.map((x) => <li class="list-none"><a class="co-tag" href={`/admin/accounts/${x.id}`}>{x.name}</a></li>)}</ul>
            <p class="co-help">{P.group.sameOwnerHelp}</p>
            {canEdit && co.ownerGroup && (
              <form method="post" action="#acc-group"><input type="hidden" name="action" value="group-owner" />
                <button class="co-btn co-btn--ghost co-btn--sm" type="submit" data-testid="same-owner-join"><Icon name="check" size={14} />{P.group.joinOwner(co.ownerGroup.name)}</button></form>
            )}
          </div>
        )}
        {co.locales.length > 0 && (
          <div class="grid gap-2" data-testid="group-locales">
            <p class="text-eyebrow">{P.group.locales(co.locales.length)}</p>
            <ul class="flex flex-wrap gap-2 p-0">{co.locales.map((l) => <li class="list-none"><a class="co-tag" href={`/admin/accounts/${l.id}`}><Icon name="store" size={12} />{l.name}</a></li>)}</ul>
          </div>
        )}
      </section>

      <section class="co-card grid gap-4" id="acc-people" data-testid="account-people">
        <div class="grid gap-2">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="co-entity flex items-center gap-2"><Icon name="users" size={18} />{P.group.people(co.people.length)}</h2>
            <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-dialog-open="add-person" data-testid="account-add-person"><Icon name="user-plus" size={14} />{P.group.addPerson}</button>
          </div>
          {co.people.length === 0 ? <p class="co-meta">{P.group.noPeople}</p> : (
            <ul class="co-rows" data-testid="account-people-list">
              {co.people.map((pp) => (
                <li class="co-row" data-name={pp.name}>
                  <span class="co-row__lead"><Icon name="user" /></span>
                  <a class="co-row__main text-inherit !no-underline" href={`/admin/people/${pp.id}`}>
                    <span class="co-row-title">{pp.name}</span>
                    <span class="co-meta">{[pp.role, pp.email, pp.phone].filter(Boolean).join(' · ')}</span>
                  </a>
                  {pp.phone && <a class="co-btn co-btn--ghost co-btn--icon co-btn--sm" href={`tel:${pp.phone}`} aria-label={pp.phone}><Icon name="phone" size={14} /></a>}
                  {pp.email && <a class="co-btn co-btn--ghost co-btn--icon co-btn--sm" href={`mailto:${pp.email}`} aria-label={pp.email}><Icon name="mail" size={14} /></a>}
                  <form method="post"><input type="hidden" name="action" value="unlink" /><input type="hidden" name="contactId" value={pp.id} />
                    <button class="co-btn co-btn--quiet co-btn--icon co-btn--sm" type="submit" aria-label={`${P.person.remove} ${pp.name}`} title={P.person.remove}><Icon name="x" size={14} /></button></form>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
      {profile === 'venue' && <WorkLinks work={work} kinds={kindDefs} profile={profile} canEdit={canQualify} selfId={a.id} card />}

      {/* Los campos del espacio son de locales (aforo…): una promotora o un DJ no los enseña (§24). */}
      {/* Sin campos activos (en Enjoy, el aforo pasó a «Tamaño» en tramos, §30), la tarjeta no sale. */}
      <section class="co-card grid gap-4" data-testid="account-sheet" hidden={profile !== 'venue' || sheet.length === 0}>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="co-entity">{C.title}</h2>
          {perms.manageTenant && <a class="co-meta underline" href="/admin/team/fields">{C.manage}</a>}
        </div>
        {sheet.length === 0 ? <p class="co-meta">{C.noFields} {perms.manageTenant && C.noFieldsAdmin}</p>
        : canEdit ? (
          <form method="post" class="grid gap-5" data-testid="sheet-form" id="sheet-form" data-async="" data-autosave>
            <span class="co-meta text-xs" aria-live="polite" data-autosave-status></span>
            <input type="hidden" name="action" value="fields" />
            {sections.map((sec) => (
              <fieldset class="grid gap-4 sm:grid-cols-2">
                {sec.title && <legend class="text-eyebrow mb-1 sm:col-span-2">{sec.title}</legend>}
                {sec.fields.map((fd) => <div class:list={[(fd.type === 'long_text' || fd.type === 'multi_select') && 'sm:col-span-2']}><FieldInput field={fd} value={a.fields[fd.key]} labels={C} /></div>)}
              </fieldset>
            ))}
            <button class="co-btn co-btn--primary w-fit" type="submit" data-testid="sheet-save" data-autosave-btn>{C.save}</button>
          </form>
        ) : (
          <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
            {sheet.map((fd) => <div><dt class="co-meta">{fd.label}</dt><dd class="text-sm font-medium">{formatValue(fd, a.fields[fd.key], fmt.tag) || C.empty}</dd></div>)}
          </dl>
        )}
      </section>

      <section class="co-section">
        <div class="co-section__head"><h2 class="text-eyebrow">{M.proposals(dossiers.length)}</h2></div>
        {dossiers.length === 0 ? <p class="co-meta">{M.noProposals}</p> : (
          <ul class="co-rows">{dossiers.map((d) => (
            <li><a class="co-row" href={`/admin/dossiers/${d.id}`}>
              <span class="co-row__main"><span class="co-row-title">{d.title}</span><span class="co-meta">{d.authorName ?? M.noAuthor} · {fmt.relative(d.updatedAt)}{d.outcome === 'won' ? ` · ${M.won}` : d.outcome === 'lost' ? ` · ${M.lost}` : ''}{d.accountEligibility && d.accountEligibility !== 'eligible' ? ` · ${ELIGIBILITY_LABEL[d.accountEligibility]}` : ''}</span></span>
              <span class={STATUS_CLASS[d.status]}>{msg.dossierStatus[d.status]}</span>
              <span class="co-row__chevron"><Icon name="chevron-right" /></span>
            </a></li>))}
          </ul>
        )}
