---
/**
 * Ajustes de leads (docs/LEADS.md §Ajustes): marca, webs permitidas, remitente y firma, a quién avisar, enlace de
 * reserva, WhatsApp (número de Meta y plantillas aprobadas) y horario. Solo admin. Las claves viven en el servidor.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import { can } from '~/lib/admin/permissions';
import { formAction } from '~/lib/admin/forms';
import { env } from '~/lib/env';
import { requestOrigin } from '~/lib/http';
import { appMode } from '~/lib/mode';
import { i18n } from '~/lib/i18n';
import { leadsMessages } from '~/lib/i18n/messages/leads';
import { leadsFor } from '~/lib/leads/service';
import { ownDomains, setResendKey } from '~/lib/leads/resend-key';
import { flash } from '~/lib/admin/forms';
import { DEFAULT_TEXTS, autoreplyEmail, waParams, waPreview } from '~/lib/leads/templates';
import { claudeDrafter, fixtureDrafter } from '~/lib/leads/draft-texts';
import { cleanupContext } from '~/lib/crm/research-context';
import type { LeadSettings, LeadTemplates, QuestionKey } from '~/lib/leads/types';
import Icon from '~/components/ui/Icon.astro';

const { admin, tenant } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
if (!can(admin.session.role).manageTenant) return Astro.rewrite('/admin/forbidden');
const { m: L, locale } = i18n(Astro, leadsMessages);
const S = L.set;
const svc = await leadsFor(admin);

const lines = (v: FormDataEntryValue | null) => String(v ?? '').split(/[\n,]+/).map((x) => x.trim()).filter(Boolean);
const orNull = (v: FormDataEntryValue | null) => String(v ?? '').trim() || null;
let result: { error: string | null; details: string[] } = { error: null, details: [] };
const LOCS = ['es', 'en', 'fr'] as const;
const QKEYS: QuestionKey[] = ['venue', 'dj', 'festival', 'wedding', 'general'];
type Domains = Awaited<ReturnType<typeof ownDomains>>;
/** Lo obligatorio para activar: cómo sale el email (cuenta y dominio), quién recibe las respuestas y a quién avisar. */
function readiness(st: LeadSettings, doms: Domains | null) {
  const fromDomain = st.fromEmail?.split('@')[1]?.toLowerCase() ?? null;
  const covers = (d: { name: string; status: string }) => d.status === 'verified' && !!fromDomain && (fromDomain === d.name || fromDomain.endsWith(`.${d.name}`));
  const resend = appMode() === 'demo' || (st.resendKeyHint ? !!doms && !!st.fromEmail && doms.some(covers) : !!(env('RESEND_API_KEY') && env('RESEND_FROM')));
  const sender = !!st.replyTo && (!st.resendKeyHint || !!st.fromEmail);
  const notify = st.notifyEmails.length > 0;
  return { resend, sender, notify, ready: resend && sender && notify };
}
let draft: LeadTemplates | null = null;
let posted: LeadTemplates | null = null;
let postedSig: Record<string, string> | null = null;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = String(f.get('action') ?? '');
  // Qué vende y a quién: lo usa la clasificación de cada lead (se guarda con los ajustes y con los mensajes).
  const aiContext = async () => { const c = await cleanupContext(admin).catch(() => null); return c ? [c.seller, c.clients.length ? `Clientes: ${c.clients.join('; ')}` : ''].filter(Boolean).join('\n').slice(0, 4000) || null : undefined; };
  const readTexts = (): LeadTemplates => Object.fromEntries(LOCS.map((l) => [l, {
    subject: String(f.get(`t_${l}_subject`) ?? ''), body: String(f.get(`t_${l}_body`) ?? ''), wa1: String(f.get(`t_${l}_wa1`) ?? ''), wa2: String(f.get(`t_${l}_wa2`) ?? ''),
    questions: Object.fromEntries(QKEYS.map((k) => [k, String(f.get(`t_${l}_q_${k}`) ?? '')])),
  }]));
  if (action === 'save-signature') {
    const sig = Object.fromEntries(['name', 'title', 'phone', 'address', 'email', 'website', 'logoUrl', 'legal'].map((k) => [k, String(f.get(`sig_${k}`) ?? '')]));
    result = await formAction(async () => { await svc.saveSignature(sig); });
    if (!result.error) return Astro.redirect('/admin/leads/ajustes?ok=sigSaved#signature', 303);
    postedSig = sig;
  } else if (action === 'save-texts' || action === 'reset-texts') {
    result = await formAction(async () => { await svc.saveTexts(action === 'reset-texts' ? {} : readTexts(), await aiContext()); });
    if (!result.error) return Astro.redirect(`/admin/leads/ajustes?ok=${action === 'reset-texts' ? 'textsReset' : 'textsSaved'}#texts`, 303);
    posted = readTexts();
  } else if (action === 'ai-draft') {
    const drafter = env('AI_RESEARCH_FIXTURE') === '1' ? fixtureDrafter : env('ANTHROPIC_API_KEY') ? claudeDrafter(env('ANTHROPIC_API_KEY')!) : null;
    if (!drafter) result = { error: S.aiOff, details: [] };
    else {
      const c = await cleanupContext(admin).catch(() => ({ seller: '', clients: [] as string[] }));
      const cur = await svc.settings();
      draft = await drafter({ brand: tenant?.name ?? cur?.brand ?? '', signer: cur?.signerName ?? tenant?.name ?? '', seller: c.seller, clients: c.clients }).catch(() => null);
      if (!draft) result = { error: S.aiOff, details: [] };
    }
  } else if (action === 'resend-key' || action === 'resend-key-clear') {
    result = await formAction(async () => { await setResendKey(admin, action === 'resend-key' ? String(f.get('resendKey') ?? '') : null); });
    if (!result.error) return Astro.redirect(`/admin/leads/ajustes?ok=${action === 'resend-key' ? 'resendSaved' : 'resendCleared'}`, 303);
  } else if (action === 'toggle') {
    const on = f.get('on') === '1';
    const cur = await svc.settings();
    const doms = cur?.resendKeyHint ? await ownDomains(admin) : null;
    if (on && cur && !readiness(cur, doms).ready) result = { error: S.activateBlocked, details: [] };
    else {
      result = await formAction(async () => { await svc.setEnabled(on); });
      if (!result.error) return Astro.redirect(`/admin/leads/ajustes?ok=${on ? 'live' : 'paused'}`, 303);
    }
  } else result = await formAction(async () => {
    const ctx = await aiContext();
    const cur = await svc.settings();
    const tpl = (step: string) => Object.fromEntries(['es', 'en', 'fr'].map((l) => [l, String(f.get(`tpl_${step}_${l}`) ?? '').trim()]).filter(([, v]) => v));
    await svc.saveSettings({
      // Activar/pausar va aparte (botón de arriba): guardar no lo cambia.
      enabled: cur?.enabled ?? false, brand: String(f.get('brand') ?? ''), allowedOrigins: lines(f.get('origins')),
      fromEmail: orNull(f.get('fromEmail')), fromName: orNull(f.get('fromName')), replyTo: orNull(f.get('replyTo')), signerName: orNull(f.get('signerName')),
      notifyEmails: lines(f.get('notify')), bookingUrl: orNull(f.get('bookingUrl')), videoUrl: orNull(f.get('videoUrl')),
      whatsappPhoneId: orNull(f.get('waPhone')), whatsappEnabled: f.get('waEnabled') === 'on', whatsappTemplates: { wa1: tpl('wa1'), wa2: tpl('wa2') },
      sendFromHour: Number(f.get('fromHour') ?? 8), sendToHour: Number(f.get('toHour') ?? 22), holidays: lines(f.get('holidays')),
    }, ctx);
  });
  if (!result.error && action === 'save') {
    const at = String(f.get('at') ?? '');
    return Astro.redirect(`/admin/leads/ajustes?ok=saved${/^[a-z]{1,20}$/.test(at) ? `#${at}` : ''}`, 303);
  }
}
const s = (await svc.settings()) ?? {
  tenantId: admin.session.tenantId, enabled: false, brand: tenant?.slug ?? '', allowedOrigins: [], fromEmail: null, fromName: null, replyTo: null, signerName: null,
  notifyEmails: [admin.session.email], bookingUrl: null, videoUrl: null, whatsappPhoneId: null, whatsappEnabled: false, whatsappTemplates: {}, timezone: 'Europe/Madrid',
  sendFromHour: 8, sendToHour: 22, holidays: [],
};
const demo = appMode() === 'demo';
const okMsg = flash(Astro.url, { saved: L.ok.saved, live: L.ok.live, paused: L.ok.paused, resendSaved: L.ok.resendSaved, resendCleared: L.ok.resendCleared, textsSaved: L.ok.textsSaved, textsReset: L.ok.textsReset, sigSaved: L.ok.sigSaved });
// La firma: la guardada o, la primera vez, lo que ya se sabe (firma, responder a, web y logo de la marca si es PNG/JPG).
const brandLogo = tenant?.brand?.logoUrl && /^https:/.test(tenant.brand.logoUrl) && !/\.svg(\?|$)/i.test(tenant.brand.logoUrl) ? tenant.brand.logoUrl : '';
const sigSaved = s.emailSignature && Object.keys(s.emailSignature).length ? s.emailSignature : null;
const sig: Record<string, string> = postedSig ?? (sigSaved as Record<string, string> | null) ?? { name: s.signerName ?? '', email: s.replyTo ?? '', website: tenant?.brand?.contact?.website ?? '', logoUrl: brandLogo };
// Lo que se enseña en el editor: la propuesta de la IA, lo que se envió con error, o lo guardado sobre lo de por defecto.
const custom: LeadTemplates = draft ?? posted ?? s.templates ?? {};
const textOf = (l: 'es' | 'en' | 'fr', k: 'subject' | 'body' | 'wa1' | 'wa2') => custom[l]?.[k]?.trim() || DEFAULT_TEXTS[l][k];
const qOf = (l: 'es' | 'en' | 'fr', k: QuestionKey) => custom[l]?.questions?.[k]?.trim() || DEFAULT_TEXTS[l].questions[k];
const domains = s.resendKeyHint ? await ownDomains(admin) : null;
const fromDomain = s.fromEmail?.split('@')[1]?.toLowerCase() ?? null;
const fromVerified = !domains || !fromDomain || domains.some((d) => d.status === 'verified' && (fromDomain === d.name || fromDomain.endsWith(`.${d.name}`)));
const mailReady = demo || !!s.resendKeyHint || !!(env('RESEND_API_KEY') && env('RESEND_FROM'));
const waReady = demo || !!env('WHATSAPP_TOKEN');
const ready = readiness(s, domains);
const last = await svc.lastSubmission().catch(() => null);
const fmt = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: s.timezone });
const ownTexts = !!s.templates && Object.keys(s.templates).length > 0;
const waOn = waReady && !!s.whatsappPhoneId && s.whatsappEnabled;
// La lista de arriba: qué está listo y adónde ir para lo que falta.
const checks = [
  { key: 'resend', ok: ready.resend, req: true, at: 'email', note: '' },
  { key: 'sender', ok: ready.sender, req: true, at: 'email', note: s.fromEmail ?? '' },
  { key: 'notify', ok: ready.notify, req: true, at: 'email', note: s.notifyEmails.join(', ') },
  { key: 'signature', ok: !!sigSaved, req: false, at: 'signature', note: '' },
  { key: 'texts', ok: ownTexts, req: false, at: 'texts', note: ownTexts ? S.textsOwn : S.textsDefault },
  { key: 'web', ok: !!last, req: false, at: 'connection', note: last ? S.webLast(fmt.format(new Date(last.at)), last.test) : S.webNone },
  { key: 'whatsapp', ok: waOn, req: false, at: 'whatsapp', note: waOn ? S.waOn : S.waPending },
] as const;
const SECTIONS = ['connection', 'email', 'signature', 'texts', 'whatsapp', 'preview'] as const;
const endpoint = `${requestOrigin(Astro.request, Astro.url)}/api/v1/leads`;
// Vista previa con un lead de ejemplo.
const brandName = tenant?.name ?? s.brand;
const signer = s.signerName ?? brandName;
const sample = { name: 'Laura Gómez', type: 'venue' as const, fields: { venue_name: 'Sala Ejemplo', city: 'Valencia' } };
const previews = (['es', 'en', 'fr'] as const).map((loc) => ({
  loc,
  wa1: waPreview('wa1', loc, signer, brandName, waParams('wa1', { ...sample, locale: loc, bookingUrl: s.bookingUrl, videoUrl: s.videoUrl, custom }), custom),
  wa2: waPreview('wa2', loc, signer, brandName, waParams('wa2', { ...sample, locale: loc, bookingUrl: s.bookingUrl ?? 'https://…', videoUrl: s.videoUrl, custom }), custom),
  mail: autoreplyEmail({ ...sample, locale: loc, signer, brand: brandName, channel: 'whatsapp', eta: 'minutes', bookingUrl: s.bookingUrl, unsubscribeUrl: null, custom, signature: s.emailSignature }),
  neutral: autoreplyEmail({ name: 'Marta Ruiz', type: 'general', fields: { event_type: 'other' }, locale: loc, signer, brand: brandName, channel: 'email', eta: 'minutes', bookingUrl: s.bookingUrl, unsubscribeUrl: null, specific: false, custom }),
}));
---
<AdminLayout title={S.title}>
  <PageHeader eyebrow={L.title} title={S.title} lede={S.lede} back={{ href: '/admin/leads', label: L.title }}>
    {/* Lo más importante de la página: si entran leads reales o solo pruebas, y el botón para cambiarlo. */}
    <div class="grid gap-1 sm:justify-items-end" data-testid="leads-status">
      <div class="flex items-center gap-2">
        <span class={`co-badge ${s.enabled ? 'co-badge--signal' : 'co-badge--attention'}`} data-testid="leads-status-badge">{s.enabled ? S.live : S.paused}</span>
        <form method="post">
          <input type="hidden" name="action" value="toggle" />
          <input type="hidden" name="on" value={s.enabled ? '0' : '1'} />
          <button class={`co-btn ${s.enabled ? 'co-btn--ghost' : 'co-btn--primary'}`} disabled={!s.enabled && !ready.ready} data-testid="leads-toggle">{s.enabled ? S.pause : S.activate}</button>
        </form>
      </div>
      <p class="co-meta max-w-[18rem] sm:text-right">{s.enabled ? S.liveHelp : ready.ready ? S.pausedHelp : S.activateBlocked}</p>
    </div>
  </PageHeader>
  {okMsg && <div class="mb-4"><Alert kind="success" title={okMsg} /></div>}
  {result.error && <div class="mb-4"><Alert kind="rejection" title={result.error} details={result.details} /></div>}

  <nav class="co-chips mb-5 max-w-3xl" aria-label={S.title} data-testid="leads-sections">
    {SECTIONS.map((k) => <a class="co-chip" href={`#${k}`}>{S.sections[k]}</a>)}
  </nav>

  <section class="co-card mb-5 grid max-w-3xl gap-2 !p-6" data-testid="leads-checklist">
    <h2 class="co-entity !text-lg">{S.checklist}</h2>
    <ul class="grid gap-1">
      {checks.map((c) => (
        <li class="flex flex-wrap items-center gap-2" data-testid={`leads-check-${c.key}`} data-ok={c.ok ? '1' : '0'}>
          <Icon name={c.ok ? 'circle-check' : c.req ? 'circle-x' : 'circle-help'} size={16} />
          <a class="hover:underline" href={`#${c.at}`}>{S.chk[c.key]}</a>
          <span class="co-meta">· {c.req ? S.required : S.optional}{c.note && ` · ${c.note}`}</span>
        </li>
      ))}
    </ul>
  </section>

  {/* Los campos de los ajustes están repartidos por secciones; todos van a este formulario (atributo form). */}
  <form method="post" id="lead-settings" data-testid="leads-settings-form"><input type="hidden" name="action" value="save" /></form>

  <section id="connection" class="co-card mb-5 grid max-w-3xl scroll-mt-6 gap-3 !p-6">
    <h2 class="co-entity !text-lg">{S.connection}</h2>
    <p class="co-meta">{S.endpoint}</p>
    <code class="co-inset break-all !p-3" data-testid="leads-endpoint">{endpoint}</code>
    <p class="co-meta">{S.endpointHelp}</p>
    <label class="co-field">{S.brand}<input form="lead-settings" class="co-input" name="brand" value={s.brand} required pattern="[a-z0-9][a-z0-9\-]{1,39}" /></label>
    <label class="co-field">{S.origins}<textarea form="lead-settings" class="co-textarea h-28" name="origins">{s.allowedOrigins.join('\n')}</textarea><span class="co-meta">{S.originsHelp}</span></label>
    <button form="lead-settings" class="co-btn co-btn--primary w-fit" name="at" value="connection" data-testid="leads-settings-save">{S.save}</button>
  </section>

  <section id="email" class="co-card mb-5 grid max-w-3xl scroll-mt-6 gap-3 !p-6">
    <h2 class="co-entity !text-lg">{S.email}</h2>
    <div class="co-inset grid gap-3 !p-4" data-testid="leads-resend">
      <h3 class="font-semibold">{S.resend}</h3>
      <p class="co-meta">{S.resendHelp}</p>
      <p data-testid="leads-resend-status">{s.resendKeyHint ? S.resendOwn(s.resendKeyHint) : S.resendShared}</p>
      {domains && domains.length > 0 && (
        <p class="co-meta">{S.domains}: {domains.map((d, i) => <>{i > 0 && ' · '}{d.name} ({d.status === 'verified' ? S.domainOk : S.domainPending})</>)}</p>
      )}
      {!fromVerified && fromDomain && <Alert kind="info" title={S.fromNotVerified(fromDomain)} />}
      <form method="post" class="flex flex-wrap items-end gap-2" autocomplete="off">
        <input type="hidden" name="action" value="resend-key" />
        <label class="co-field min-w-[16rem] flex-1">{S.resendKey}<input class="co-input" type="password" name="resendKey" required autocomplete="off" spellcheck="false" data-testid="leads-resend-key" /></label>
        <button class="co-btn co-btn--primary" data-testid="leads-resend-save">{S.resendSave}</button>
      </form>
      {s.resendKeyHint && <form method="post"><button class="co-btn co-btn--ghost co-btn--sm" name="action" value="resend-key-clear" data-testid="leads-resend-clear">{S.resendClear}</button></form>}
    </div>
    <Alert kind={mailReady ? 'success' : 'info'} title={mailReady ? S.mailReady : S.mailMissing} />
    <label class="co-field">{S.fromEmail}<input form="lead-settings" class="co-input" type="email" name="fromEmail" value={s.fromEmail ?? ''} /><span class="co-meta">{S.fromEmailHelp}</span></label>
    <label class="co-field">{S.fromName}<input form="lead-settings" class="co-input" name="fromName" value={s.fromName ?? ''} maxlength="80" /></label>
    <label class="co-field">{S.replyTo}<input form="lead-settings" class="co-input" type="email" name="replyTo" value={s.replyTo ?? ''} /><span class="co-meta">{S.replyToHelp}</span></label>
    <label class="co-field">{S.signer}<input form="lead-settings" class="co-input" name="signerName" value={s.signerName ?? ''} maxlength="80" /><span class="co-meta">{S.signerHelp}</span></label>
    <label class="co-field">{S.notify}<textarea form="lead-settings" class="co-textarea h-20" name="notify">{s.notifyEmails.join('\n')}</textarea><span class="co-meta">{S.notifyHelp}</span></label>
    <label class="co-field">{S.booking}<input form="lead-settings" class="co-input" type="url" name="bookingUrl" value={s.bookingUrl ?? ''} placeholder="https://" /></label>
    <label class="co-field">{S.video}<input form="lead-settings" class="co-input" type="url" name="videoUrl" value={s.videoUrl ?? ''} placeholder="https://" /></label>
    <button form="lead-settings" class="co-btn co-btn--primary w-fit" name="at" value="email">{S.save}</button>
  </section>

  <form method="post" id="signature" class="co-card mb-5 grid max-w-3xl scroll-mt-6 gap-3 !p-6" data-testid="leads-signature">
    <h2 class="co-entity !text-lg">{S.sig}</h2>
    <p class="co-meta">{S.sigHelp}</p>
    <input type="hidden" name="action" value="save-signature" />
    <div class="grid gap-3 sm:grid-cols-2">
      <label class="co-field">{S.sigName}<input class="co-input" name="sig_name" value={sig.name ?? ''} maxlength="120" data-testid="leads-sig-name" /></label>
      <label class="co-field">{S.sigTitle}<input class="co-input" name="sig_title" value={sig.title ?? ''} maxlength="160" /></label>
      <label class="co-field">{S.sigPhone}<input class="co-input" name="sig_phone" value={sig.phone ?? ''} maxlength="40" /></label>
      <label class="co-field">{S.sigEmail}<input class="co-input" type="email" name="sig_email" value={sig.email ?? ''} maxlength="200" /></label>
      <label class="co-field sm:col-span-2">{S.sigAddress}<input class="co-input" name="sig_address" value={sig.address ?? ''} maxlength="200" /></label>
      <label class="co-field">{S.sigWebsite}<input class="co-input" type="url" name="sig_website" value={sig.website ?? ''} placeholder="https://" /></label>
      <label class="co-field">{S.sigLogo}<input class="co-input" type="url" name="sig_logoUrl" value={sig.logoUrl ?? ''} placeholder="https://…/logo.png" data-testid="leads-sig-logo" /><span class="co-meta">{S.sigLogoHelp}</span></label>
    </div>
    <label class="co-field">{S.sigLegal}<textarea class="co-textarea h-28" name="sig_legal" maxlength="2000">{sig.legal ?? ''}</textarea></label>
    <button class="co-btn co-btn--primary w-fit" data-testid="leads-sig-save">{S.saveSig}</button>
  </form>

  <form method="post" id="texts" class="co-card mb-5 grid max-w-3xl scroll-mt-6 gap-4 !p-6" data-testid="leads-texts">
    <h2 class="co-entity !text-lg">{S.texts}</h2>
    <p class="co-meta">{S.textsHelp}</p>
    <p class="co-meta">{S.waNote}</p>
    {draft && <Alert kind="info" title={S.aiDrafted} />}
    {LOCS.map((l) => (
      <details class="co-inset !p-4" open={l === 'es' || undefined} data-testid={`leads-texts-${l}`}>
        <summary class="cursor-pointer font-semibold">{l.toUpperCase()}</summary>
        <div class="mt-3 grid gap-3">
          <label class="co-field">{S.subject}<input class="co-input" name={`t_${l}_subject`} value={textOf(l, 'subject')} maxlength="200" /></label>
          <label class="co-field">{S.body}<textarea class="co-textarea h-56" name={`t_${l}_body`} maxlength="4000">{textOf(l, 'body')}</textarea></label>
          <label class="co-field">{S.wa1}<textarea class="co-textarea h-36" name={`t_${l}_wa1`} maxlength="1024" data-testid={`leads-texts-${l}-wa1`}>{textOf(l, 'wa1')}</textarea></label>
          <label class="co-field">{S.wa2}<textarea class="co-textarea h-32" name={`t_${l}_wa2`} maxlength="1024">{textOf(l, 'wa2')}</textarea></label>
          <p class="co-meta">{S.questions}</p>
          <div class="grid gap-2 sm:grid-cols-2">
            {QKEYS.map((k) => <label class="co-field text-xs">{S.qKeys[k]}<input class="co-input" name={`t_${l}_q_${k}`} value={qOf(l, k)} maxlength="300" data-testid={`leads-texts-${l}-q-${k}`} /></label>)}
          </div>
        </div>
      </details>
    ))}
    <div class="flex flex-wrap gap-2">
      <button class="co-btn co-btn--primary" name="action" value="save-texts" data-testid="leads-texts-save">{S.saveTexts}</button>
      <button class="co-btn co-btn--ghost" name="action" value="ai-draft" formnovalidate data-testid="leads-texts-ai">{S.aiDraft}</button>
      <button class="co-btn co-btn--ghost" name="action" value="reset-texts" formnovalidate data-testid="leads-texts-reset">{S.resetTexts}</button>
    </div>
  </form>

  <section id="whatsapp" class="co-card mb-5 grid max-w-3xl scroll-mt-6 gap-3 !p-6">
    <h2 class="co-entity !text-lg">{S.whatsapp}</h2>
    <Alert kind={waReady ? 'success' : 'info'} title={waReady ? S.waReady : S.waMissing} />
    <label class="co-check"><input form="lead-settings" type="checkbox" name="waEnabled" checked={s.whatsappEnabled} /> {S.waEnabled}</label>
    <label class="co-field">{S.waPhone}<input form="lead-settings" class="co-input" name="waPhone" value={s.whatsappPhoneId ?? ''} inputmode="numeric" pattern="[0-9]{5,30}" /></label>
    <p class="co-meta">{S.templates}</p>
    <div class="grid gap-2 sm:grid-cols-3">
      {(['wa1', 'wa2'] as const).flatMap((step) => (['es', 'en', 'fr'] as const).map((loc) => (
        <label class="co-field text-xs">{L.steps[step]} · {loc}<input form="lead-settings" class="co-input" name={`tpl_${step}_${loc}`} value={s.whatsappTemplates?.[step]?.[loc] ?? ''} pattern="[a-z0-9_]{1,512}" placeholder={`lead_${step}_${loc}`} /></label>
      )))}
    </div>
    <div class="flex flex-wrap gap-3">
      <label class="co-field">{S.hours} · {S.from}<input form="lead-settings" class="co-input w-24" type="number" name="fromHour" min="0" max="23" value={s.sendFromHour} /></label>
      <label class="co-field">{S.to}<input form="lead-settings" class="co-input w-24" type="number" name="toHour" min="1" max="24" value={s.sendToHour} /></label>
    </div>
    <label class="co-field">{S.holidays}<textarea form="lead-settings" class="co-textarea h-24" name="holidays" placeholder="2026-12-08">{s.holidays.join('\n')}</textarea><span class="co-meta">{S.holidaysHelp}</span></label>
    <button form="lead-settings" class="co-btn co-btn--primary w-fit" name="at" value="whatsapp">{S.save}</button>
  </section>

  <section id="preview" class="grid max-w-3xl scroll-mt-6 gap-3" data-testid="leads-preview">
    <h2 class="co-entity !text-lg">{S.preview}</h2>
    <p class="co-meta">{S.previewHelp}</p>
    {previews.map((p) => (
      <details class="co-card !p-5">
        <summary class="cursor-pointer font-semibold">{p.loc.toUpperCase()}</summary>
        <div class="mt-3 grid gap-3">
          <div><p class="co-meta">{L.steps.wa1}</p><pre class="co-inset whitespace-pre-wrap !p-3 text-sm">{p.wa1}</pre></div>
          <div><p class="co-meta">{L.steps.wa2}</p><pre class="co-inset whitespace-pre-wrap !p-3 text-sm">{p.wa2}</pre></div>
          <div><p class="co-meta">{S.htmlPreview} · {p.mail.subject}</p><div class="rounded-xl border border-[var(--co-line,#e5e5e5)] bg-white !p-4 text-black" data-testid="leads-preview-html" set:html={p.mail.html} /></div>
          <div><p class="co-meta">{S.neutral} · {p.neutral.subject}</p><pre class="co-inset whitespace-pre-wrap !p-3 text-sm" data-testid="leads-preview-neutral">{p.neutral.text}</pre></div>
        </div>
      </details>
    ))}
  </section>
</AdminLayout>
