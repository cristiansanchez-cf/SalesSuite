---
/**
 * Leads entrantes (docs/PLAN_AJUSTES.md): los pasos para que la web o la app manden leads y se les conteste, cada uno
 * como una tarjeta (sin empezar, a medias, hecho). Arriba, si entran leads reales o solo pruebas. Solo admin.
 * Las tarjetas con paso guiado abren su modal (conectar la web, el email, los mensajes); las demás llevan a su sección de los ajustes.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import SetupCard from '~/components/ui/SetupCard.astro';
import ConnectDialog from '~/components/admin/leads/ConnectDialog.astro';
import EmailDialog from '~/components/admin/leads/EmailDialog.astro';
import MessagesDialog from '~/components/admin/leads/MessagesDialog.astro';
import { claudeDrafter, fixtureDrafter } from '~/lib/leads/draft-texts';
import { cleanupContext } from '~/lib/crm/research-context';
import { mediaFor, msgLocale } from '~/lib/leads/templates';
import { SAMPLE_LEAD, type PreviewLocale } from '~/lib/leads/message-preview';
import { randomUUID } from 'node:crypto';
import { requestOrigin } from '~/lib/http';
import { CONSOLE_TEST_PREFIX } from '~/lib/leads/db';
import { intake } from '~/lib/leads/intake';
import { leadsRuntime } from '~/lib/leads/server';
import { connectPrompt, connectSnippet } from '~/lib/leads/connect-guide';
import { can } from '~/lib/admin/permissions';
import { flash, formAction } from '~/lib/admin/forms';
import { AdminError } from '~/lib/admin/service';
import { env } from '~/lib/env';
import { appMode } from '~/lib/mode';
import { i18n } from '~/lib/i18n';
import { leadsMessages } from '~/lib/i18n/messages/leads';
import { leadsSetupMessages } from '~/lib/i18n/messages/leadsSetup';
import { leadsFor } from '~/lib/leads/service';
import { ownDomainDetails, ownDomains, setResendKey, verifyOwnDomain, type DomainDetail } from '~/lib/leads/resend-key';
import { retentionOf } from '~/lib/leads/privacy';
import { leadSetupSteps, readiness, requiredProgress, type StepKey } from '~/lib/leads/setup-steps';
import type { LeadSettings, LeadTemplates, QuestionKey } from '~/lib/leads/types';
import type { IconName } from '~/lib/ui/icons';

const { admin, tenant } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
if (!can(admin.session.role).manageTenant) return Astro.rewrite('/admin/forbidden');
const { m: L, locale } = i18n(Astro, leadsMessages);
const { m: T } = i18n(Astro, leadsSetupMessages);
const S = L.set;
const svc = await leadsFor(admin);
const demo = appMode() === 'demo';
const platformMail = !!(env('RESEND_API_KEY') && env('RESEND_FROM'));

let error: string | null = null;
let errorDetails: string[] = [];
let errorPart = 2;
/** Qué modal enseña el error (el de la parte en la que estaba). */
let errorIn: 'connect' | 'email' | 'messages' | null = null;
/** Mensajes: la propuesta de la IA o lo enviado con error, para enseñarlo en el editor sin guardar. */
let textsShown: LeadTemplates | null = null;
let aiDrafted = false;
const MSG_LOCS = ['es', 'en', 'fr'] as const;
const MSG_Q: QuestionKey[] = ['venue', 'dj', 'festival', 'wedding', 'general', 'trial_ended', 'extra_venue'];
const slug = tenant?.slug ?? 'empresa';
let action = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  action = String(f.get('action') ?? '');
  if (action === 'add-origin' || action === 'remove-origin') {
    // Conecta tu web → Tus webs: se guarda al momento y se vuelve a la misma parte del paso.
    const cur = (await svc.settings())?.allowedOrigins ?? [];
    const o = String(f.get('origin') ?? '');
    const next = action === 'add-origin' ? [...cur, o] : cur.filter((x) => x !== o);
    const r = await formAction(async () => { await svc.saveOrigins(next, slug); });
    if (!r.error) return Astro.redirect('/admin/leads/configurar?abrir=connect&p=2&ok=webs', 303);
    error = r.error; errorDetails = r.details; errorIn = 'connect';
  } else if (action === 'test-lead') {
    // Un lead de prueba como los de la web, sin pasar por el navegador: se guarda en Pruebas y no se envía nada.
    const r = await formAction(async () => {
      const rt = await leadsRuntime();
      if ('error' in rt || !tenant) throw new AdminError(503, T.connect.test.failed);
      let st = await rt.db.settings(tenant.id);
      if (!st) { await svc.saveOrigins([], slug); st = await rt.db.settings(tenant.id); }
      if (!st) throw new AdminError(503, T.connect.test.failed);
      const res = await intake({
        db: rt.db, tenant: { id: tenant.id, name: tenant.name }, settings: st, now: new Date(), origin: null, ip: null, secret: rt.secret,
        baseUrl: requestOrigin(Astro.request, Astro.url), whatsappReady: false, turnstile: null,
      }, {
        schema: 'enjoy.lead.v2', idempotency_key: `${CONSOLE_TEST_PREFIX}${randomUUID()}`, brand: st.brand, type: 'general', test: true,
        contact: { name: 'Prueba de conexión', email: 'prueba-conexion@example.com' }, fields: { event_type: 'other' },
        consent: { marketing: false }, context: { locale, form_version: 'console-test', time_to_submit_ms: 10_000 },
      });
      if (res.status >= 300) throw new AdminError(422, T.connect.test.failed, [JSON.stringify(res.body).slice(0, 200)]);
    });
    if (!r.error) return Astro.redirect('/admin/leads/configurar?abrir=connect&p=4&ok=test', 303);
    error = r.error; errorDetails = r.details; errorPart = 4; errorIn = 'connect';
  } else if (['resend-key', 'resend-key-clear', 'verify-domain', 'save-sender', 'notify-add', 'notify-remove'].includes(action)) {
    // Email de respuesta: cada parte se guarda sola y se vuelve a ella.
    const cur = await svc.settings();
    const base = { fromEmail: cur?.fromEmail ?? null, fromName: cur?.fromName ?? null, replyTo: cur?.replyTo ?? null, notifyEmails: cur?.notifyEmails ?? [] };
    let to = 2, ok = 'key';
    const r = await formAction(async () => {
      if (action === 'resend-key') { await setResendKey(admin, String(f.get('resendKey') ?? '')); to = 3; ok = 'key'; }
      else if (action === 'resend-key-clear') { await setResendKey(admin, null); to = 2; ok = 'keyCleared'; }
      else if (action === 'verify-domain') { await verifyOwnDomain(admin, String(f.get('domainId') ?? '')); to = 3; ok = 'verify'; }
      else {
        const email = String(f.get('email') ?? '');
        const notify = action === 'notify-add' ? [...base.notifyEmails, email] : action === 'notify-remove' ? base.notifyEmails.filter((x) => x !== email) : base.notifyEmails;
        const fields = action === 'save-sender'
          ? { fromEmail: f.has('fromEmail') ? String(f.get('fromEmail') ?? '') : base.fromEmail, fromName: String(f.get('fromName') ?? ''), replyTo: String(f.get('replyTo') ?? '') }
          : {};
        await svc.saveSender({ ...base, ...fields, notifyEmails: notify }, slug);
        to = 4; ok = 'sender';
      }
    });
    if (!r.error) return Astro.redirect(`/admin/leads/configurar?abrir=email&p=${to}&ok=${ok}`, 303);
    error = r.error; errorDetails = r.details; errorIn = 'email';
    errorPart = action.startsWith('resend-key') ? 2 : action === 'verify-domain' ? 3 : 4;
  } else if (['save-texts', 'reset-texts', 'ai-draft', 'save-signer', 'save-signature-paste', 'save-signature-fields', 'clear-signature'].includes(action)) {
    // Tus mensajes y tu firma. Qué vende y a quién: lo usa la clasificación de cada lead (va con los textos).
    const aiContext = async () => { const c = await cleanupContext(admin).catch(() => null); return c ? [c.seller, c.clients.length ? `Clientes: ${c.clients.join('; ')}` : ''].filter(Boolean).join('\n').slice(0, 4000) || null : null; };
    // Solo los idiomas activos: los quitados no llegan (su fieldset va desactivado) y vuelven a nuestros textos.
    const readTexts = (): LeadTemplates => Object.fromEntries(MSG_LOCS.filter((l) => f.has(`t_${l}_subject`)).map((l) => [l, {
      subject: String(f.get(`t_${l}_subject`) ?? ''), body: String(f.get(`t_${l}_body`) ?? ''), wa1: String(f.get(`t_${l}_wa1`) ?? ''), wa2: String(f.get(`t_${l}_wa2`) ?? ''),
      questions: Object.fromEntries(MSG_Q.map((k) => [k, String(f.get(`t_${l}_q_${k}`) ?? '')])),
    }]));
    let to = 2, ok = 'texts', extra = '';
    const r = await formAction(async () => {
      if (action === 'save-texts') { await svc.saveTexts(readTexts(), await aiContext()); }
      else if (action === 'reset-texts') { await svc.saveTexts({}, await aiContext()); ok = 'reset'; }
      else if (action === 'ai-draft') {
        const drafter = env('AI_RESEARCH_FIXTURE') === '1' ? fixtureDrafter : env('ANTHROPIC_API_KEY') ? claudeDrafter(env('ANTHROPIC_API_KEY')!) : null;
        if (!drafter) throw new AdminError(503, S.aiOff);
        const c = await cleanupContext(admin).catch(() => ({ seller: '', clients: [] as string[] }));
        const cur = await svc.settings();
        const d = await drafter({ brand: tenant?.name ?? cur?.brand ?? '', signer: cur?.signerName ?? tenant?.name ?? '', seller: c.seller, clients: c.clients }).catch(() => null);
        if (!d) throw new AdminError(503, S.aiOff);
        textsShown = d; aiDrafted = true;
      }
      else if (action === 'save-signer') { await svc.saveSignerName(String(f.get('signerName') ?? '')); to = 3; ok = 'signer'; }
      else if (action === 'save-signature-paste') {
        const res = await svc.saveSignature({ html: String(f.get('html') ?? '') });
        to = 3; ok = 'sig'; if (res.droppedImages) extra = `&caidas=${Math.min(res.droppedImages, 99)}`;
      }
      else if (action === 'save-signature-fields') {
        await svc.saveSignature(Object.fromEntries(['name', 'title', 'phone', 'address', 'email', 'website', 'logoUrl', 'legal'].map((k) => [k, String(f.get(`sig_${k}`) ?? '')])));
        to = 3; ok = 'sig';
      }
      else if (action === 'clear-signature') { await svc.clearPastedSignature(); to = 3; ok = 'sigCleared'; }
    });
    if (!r.error && !aiDrafted) return Astro.redirect(`/admin/leads/configurar?abrir=messages&p=${to}&ok=${ok}${extra}`, 303);
    if (r.error) {
      error = r.error; errorDetails = r.details; errorIn = 'messages'; errorPart = action.startsWith('save-sig') || action === 'clear-signature' || action === 'save-signer' ? 3 : 2;
      if (action === 'save-texts') textsShown = readTexts();
    }
  } else if (action === 'toggle') {
    const on = f.get('on') === '1';
    const cur = await svc.settings();
    const doms = cur?.resendKeyHint ? await ownDomains(admin) : null;
    if (on && (!cur || !readiness(cur, doms, { demo, platformMail }).ready)) error = S.activateBlocked;
    else {
      const r = await formAction(async () => { await svc.setEnabled(on); });
      if (!r.error) return Astro.redirect(`/admin/leads/configurar?ok=${on ? 'live' : 'paused'}`, 303);
      error = r.error;
    }
  }
}

const s: LeadSettings = (await svc.settings()) ?? {
  tenantId: admin.session.tenantId, enabled: false, brand: '', allowedOrigins: [], fromEmail: null, fromName: null, replyTo: null, signerName: null,
  notifyEmails: [admin.session.email], bookingUrl: null, videoUrl: null, whatsappPhoneId: null, whatsappEnabled: false, whatsappTemplates: {}, timezone: 'Europe/Madrid',
  sendFromHour: 8, sendToHour: 22, holidays: [],
};
const domains = s.resendKeyHint ? await ownDomains(admin).catch(() => null) : null;
const last = await svc.lastSubmission({ external: true }).catch(() => null);
const steps = leadSetupSteps({ settings: s, domains, received: !!last, demo, platformMail, platformWa: !!env('WHATSAPP_TOKEN') });
const ready = readiness(s, domains, { demo, platformMail }).ready;
const progress = requiredProgress(steps);
const okMsg = flash(Astro.url, { live: L.ok.live, paused: L.ok.paused, webs: T.connect.ok.webs, test: T.connect.ok.test, ...T.email.ok, ...T.messages.ok });
const fmt = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: s.timezone });

// Las que tienen paso guiado abren su modal; las demás, su sección de los ajustes.
const META: Record<StepKey, { icon: IconName; href: string }> = {
  connect: { icon: 'globe', href: '/admin/leads/configurar?abrir=connect' },
  email: { icon: 'mail', href: '/admin/leads/configurar?abrir=email' },
  messages: { icon: 'message-square-text', href: '/admin/leads/configurar?abrir=messages' },
  whatsapp: { icon: 'whatsapp', href: '/admin/leads/ajustes#whatsapp' },
  extras: { icon: 'link', href: '/admin/leads/ajustes#media' },
  privacy: { icon: 'shield-check', href: '/admin/leads/ajustes#privacy' },
};
const summary = (k: StepKey): string[] => {
  switch (k) {
    case 'connect': return [last ? T.done.connect(fmt.format(new Date(last.at))) : '', s.allowedOrigins.length ? T.done.origins(s.allowedOrigins.length) : ''].filter(Boolean);
    case 'email': return [s.fromEmail ? T.done.email(s.fromEmail) : T.done.emailPlatform, s.notifyEmails.length ? T.done.notify(s.notifyEmails.length) : ''].filter(Boolean);
    case 'messages': return [T.done.messages];
    case 'whatsapp': return [T.done.whatsapp];
    case 'extras': return [T.done.extras];
    case 'privacy': return [T.done.privacy(retentionOf(s).leadMonths)];
  }
};
// El paso guiado de conectar: con qué parte se abre (sin empezar → qué ganas; a medias → pásaselo; hecho → tus webs).
const connect = steps.find((x) => x.key === 'connect')!;
const openParam = Astro.url.searchParams.get('abrir');
const pParam = Number(Astro.url.searchParams.get('p'));
const connectPart = pParam >= 1 && pParam <= 4 ? pParam : connect.status === 'todo' ? 1 : connect.status === 'partial' ? 3 : 2;
const guideLocale = locale === 'es' ? 'es' : 'en';
const endpoint = `${requestOrigin(Astro.request, Astro.url)}/api/v1/leads`;
const brand = s.brand || slug;
// El email: con qué parte se abre según lo que falte, y los registros DNS (solo si hace falta verlos: son llamadas a Resend).
const emailStep = steps.find((x) => x.key === 'email')!;
const emailPart = openParam === 'email' && pParam >= 1 && pParam <= 4 ? pParam
  : emailStep.status === 'todo' ? 1 : emailStep.missing.includes('resend') ? (s.resendKeyHint ? 3 : 2) : 4;
const needDetails = demo || openParam === 'email' || emailStep.status !== 'done' || errorIn === 'email';
const emailDomains: DomainDetail[] | null = !s.resendKeyHint ? null
  : needDetails ? await ownDomainDetails(admin).catch(() => null)
  : (domains?.map((d) => ({ id: d.id ?? '', name: d.name, status: d.status, records: [] })) ?? null);
// Mensajes: el idioma del espacio siempre; los demás, si tienen textos propios (o se añaden en el modal).
const msgStep = steps.find((x) => x.key === 'messages')!;
const msgBase = msgLocale((tenant?.defaultLocale ?? locale).slice(0, 2).toLowerCase()) as PreviewLocale;
const msgCustom: LeadTemplates = textsShown ?? s.templates ?? {};
const msgActive = [msgBase, ...MSG_LOCS.filter((l) => l !== msgBase && !!s.templates?.[l] && Object.keys(s.templates[l] ?? {}).length > 0)] as PreviewLocale[];
const msgPart = aiDrafted ? 2 : openParam === 'messages' && pParam >= 1 && pParam <= 3 ? pParam
  : msgStep.status === 'todo' ? 1 : msgStep.missing.includes('texts') ? 2 : msgStep.missing.includes('signature') ? 3 : 2;
const brandName = tenant?.name ?? s.brand;
const msgCtx = {
  signer: s.signerName ?? brandName, brand: brandName, signature: s.emailSignature,
  media: Object.fromEntries(MSG_LOCS.map((l) => { const m = mediaFor(s, SAMPLE_LEAD.type, SAMPLE_LEAD.fields, l); return [l, { booking: m.booking ?? null, video: m.video ?? null }]; })) as Record<PreviewLocale, { booking: string | null; video: string | null }>,
};
const dropped = Math.max(0, Math.min(99, Number(Astro.url.searchParams.get('caidas')) || 0));
const main = steps.filter((x) => x.key !== 'extras' && x.key !== 'privacy');
const extras = steps.filter((x) => x.key === 'extras' || x.key === 'privacy');
const pct = progress.total ? Math.round((progress.done / progress.total) * 100) : 0;
---
<AdminLayout title={T.title}>
  <PageHeader eyebrow={T.eyebrow} title={T.title} lede={T.lede}>
    <div class="grid gap-1 sm:justify-items-end" data-testid="leads-status">
      <div class="flex items-center gap-2">
        <span class={`co-badge ${s.enabled ? 'co-badge--signal' : 'co-badge--attention'}`} data-testid="leads-status-badge">{s.enabled ? S.live : S.paused}</span>
        <form method="post" action="/admin/leads/configurar">
          <input type="hidden" name="action" value="toggle" />
          <input type="hidden" name="on" value={s.enabled ? '0' : '1'} />
          <button class={`co-btn ${s.enabled ? 'co-btn--ghost' : 'co-btn--primary'}`} disabled={!s.enabled && !ready} data-testid="leads-toggle">{s.enabled ? S.pause : S.activate}</button>
        </form>
      </div>
      <p class="co-meta max-w-[18rem] sm:text-right">{s.enabled ? S.liveHelp : ready ? S.pausedHelp : S.activateBlocked}</p>
    </div>
  </PageHeader>
  {okMsg && !['connect', 'email', 'messages'].includes(openParam ?? '') && <div class="mb-4"><Alert kind="success" title={okMsg} /></div>}
  {error && !errorIn && <div class="mb-4"><Alert kind="rejection" title={error} details={errorDetails} /></div>}

  <section class="mb-6 grid max-w-3xl gap-2" data-testid="leads-setup-progress" data-done={progress.done} data-total={progress.total}>
    <p class="co-meta font-semibold">{T.progress(progress.done, progress.total)}</p>
    <div class="h-1.5 overflow-hidden rounded-full bg-[var(--console-progress-track)]" role="progressbar" aria-valuemin={0} aria-valuemax={progress.total} aria-valuenow={progress.done}>
      <span class="block h-full rounded-full bg-[var(--co-ink)]" style={`width:${pct}%`}></span>
    </div>
  </section>

  <section class="mb-8 grid max-w-3xl gap-3" data-testid="leads-setup-steps">
    <h2 class="text-eyebrow">{T.stepsTitle}</h2>
    {main.map((x, i) => (
      <SetupCard
        icon={META[x.key].icon} href={META[x.key].href} title={T.steps[x.key].title} lede={T.steps[x.key].lede}
        status={x.status} need={x.need} step={T.stepN(i + 1)}
        labels={{ need: T.need[x.need], status: T.status[x.status], cta: T.cta[x.status], missing: T.missing }}
        missing={x.missing.map((k) => T.miss[k])} summary={summary(x.key)} testid={`setup-card-${x.key}`}
        dialog={x.key === 'connect' ? 'setup-connect' : x.key === 'email' ? 'setup-email' : x.key === 'messages' ? 'setup-messages' : undefined}
      />
    ))}
  </section>

  <section class="mb-8 grid max-w-3xl gap-3" data-testid="leads-setup-extras">
    <div><h2 class="text-eyebrow">{T.extrasTitle}</h2><p class="co-meta mt-1">{T.extrasLede}</p></div>
    {extras.map((x) => (
      <SetupCard
        icon={META[x.key].icon} href={META[x.key].href} title={T.steps[x.key].title} lede={T.steps[x.key].lede}
        status={x.status} need={x.need}
        labels={{ need: T.need[x.need], status: T.status[x.status], cta: T.cta[x.status], missing: T.missing }}
        summary={summary(x.key)} testid={`setup-card-${x.key}`}
      />
    ))}
  </section>

  <p class="flex max-w-3xl flex-wrap gap-2">
    <a class="co-btn co-btn--ghost" href="/admin/leads/ajustes" data-testid="leads-all-settings">{T.allSettings}</a>
    <a class="co-btn co-btn--ghost" href="/admin/leads" data-testid="leads-go-inbox">{T.inbox}</a>
  </p>

  <ConnectDialog
    id="setup-connect" open={openParam === 'connect' || errorIn === 'connect'} part={errorIn === 'connect' ? errorPart : connectPart}
    origins={s.allowedOrigins} prompt={connectPrompt({ endpoint, brand, origins: s.allowedOrigins, locale: guideLocale })}
    snippet={connectSnippet({ endpoint, brand })} received={last ? fmt.format(new Date(last.at)) : null}
    testSent={Astro.url.searchParams.get('ok') === 'test'} T={T.connect}
    notice={openParam === 'connect' && Astro.url.searchParams.get('ok') === 'webs' ? T.connect.ok.webs : null}
    error={error && errorIn === 'connect' ? { title: error, details: errorDetails } : null}
  />
  <EmailDialog
    id="setup-email" open={openParam === 'email' || errorIn === 'email'} part={errorIn === 'email' ? errorPart : emailPart} T={T.email}
    ownKey={s.resendKeyHint ?? null} platform={platformMail} domains={emailDomains}
    sender={{ fromEmail: s.fromEmail, fromName: s.fromName, replyTo: s.replyTo, notifyEmails: s.notifyEmails }}
    notice={openParam === 'email' ? okMsg : null}
    error={error && errorIn === 'email' ? { title: error, details: errorDetails } : null}
  />
  <MessagesDialog
    id="setup-messages" open={openParam === 'messages' || errorIn === 'messages' || aiDrafted} part={errorIn === 'messages' ? errorPart : msgPart}
    T={T.messages} S={S} base={msgBase} active={msgActive} custom={msgCustom} ctx={msgCtx}
    signature={s.emailSignature && Object.keys(s.emailSignature).length ? s.emailSignature : null} signerName={s.signerName ?? ''} dropped={dropped}
    notice={aiDrafted ? T.messages.ok.ai : openParam === 'messages' ? okMsg : null}
    error={error && errorIn === 'messages' ? { title: error, details: errorDetails } : null}
  />
</AdminLayout>
