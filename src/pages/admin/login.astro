---
/**
 * Entrar sin contraseña: email → código de 6 dígitos (o el enlace del mismo correo).
 * Contraseña opcional para quien la prefiera. Colaboradores: solo código (docs/PARTNERS.md).
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import { authMode, demoLogin, safeNext, supabaseServerClient } from '~/lib/admin/auth';
import { demoSendCode, demoVerifyCode } from '~/lib/admin/otp-demo';
import { demoDb } from '~/lib/data/store';
import { requestOrigin } from '~/lib/http';
import Alert from '~/components/ui/Alert.astro';
import { BRAND } from '~/lib/site';

const { tenant } = Astro.locals;
if (!tenant) return Astro.rewrite('/404');

const mode = authMode();
const next = safeNext(Astro.url.searchParams.get('next'));
let error: string | null = Astro.url.searchParams.get('error') === 'link' ? 'El enlace ha caducado o ya se usó. Pide un código nuevo.' : null;
let info: string | null = null;
/** Paso 2 del acceso por código: email al que se envió. */
let codeEmail: string | null = null;
let demoCode: string | null = null;
const origin = requestOrigin(Astro.request, Astro.url);
const SENT = 'Si el email tiene acceso, te hemos enviado un código de 6 dígitos (y un enlace) para entrar.';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const email = String(form.get('email') ?? '').trim().toLowerCase();
  const code = String(form.get('code') ?? '').replace(/\s/g, '');

  if (action === 'demo' && mode === 'demo') {
    if (demoLogin(Astro, String(form.get('userId') ?? ''))) return Astro.redirect(next, 303);
    error = 'Usuario de demo no válido';
  } else if (action === 'code-send') {
    if (!/^\S+@\S+\.\S+$/.test(email)) error = 'Escribe un email válido';
    else if (mode === 'demo') {
      demoCode = demoSendCode(email);
      codeEmail = email;
      info = SENT;
    } else {
      const sb = supabaseServerClient(Astro);
      const redirectTo = `${origin}/admin/auth/confirm?next=${encodeURIComponent(next)}`;
      const { error: e } = await sb.auth.signInWithOtp({ email, options: { emailRedirectTo: redirectTo, shouldCreateUser: false } });
      // Mismo mensaje exista o no la cuenta (no enumerar usuarios).
      if (e && e.status !== 400 && e.status !== 422) error = e.status === 429 ? 'Has pedido varios códigos seguidos. Espera un minuto.' : 'No se pudo enviar el código. Inténtalo de nuevo.';
      else { codeEmail = email; info = SENT; }
    }
  } else if (action === 'code-verify') {
    codeEmail = email;
    if (!/^\d{6,10}$/.test(code)) error = 'El código son los números del correo';
    else if (mode === 'demo') {
      const userId = demoVerifyCode(email, code);
      if (userId && demoLogin(Astro, userId)) return Astro.redirect(next, 303);
      error = 'Código incorrecto o caducado';
    } else {
      const { error: e } = await supabaseServerClient(Astro).auth.verifyOtp({ email, token: code, type: 'email' });
      if (!e) return Astro.redirect(next, 303);
      error = 'Código incorrecto o caducado';
    }
  } else if (action === 'password' && mode === 'supabase') {
    const { error: e } = await supabaseServerClient(Astro).auth.signInWithPassword({ email, password: String(form.get('password') ?? '') });
    if (!e) return Astro.redirect(next, 303);
    error = 'Email o contraseña incorrectos';
  } else if (action === 'reset' && mode === 'supabase') {
    await supabaseServerClient(Astro).auth.resetPasswordForEmail(email, { redirectTo: `${origin}/admin/auth/confirm?next=/admin/account` });
    info = 'Si el email tiene acceso, recibirás un enlace para elegir una contraseña nueva.';
  }
}

const tenantName = (id: string) => demoDb().tenant.find((t) => t.id === id)?.name ?? id;
const roleName = { admin: 'admin', lead: 'jefe/a de ventas', rep: 'comercial', partner: 'colaborador' } as const;
---
<AdminLayout title="Entrar" bare>
  <div class="mx-auto mt-4 grid max-w-sm gap-6 sm:mt-14">
    <p class="text-center"><span class="co-wordmark">{BRAND.wordmark}</span> <span class="co-sidebar__app">· {BRAND.app}</span></p>
    <div class="co-card grid gap-4 !p-6">
      <div>
        <p class="text-eyebrow mb-2">{tenant.name}</p>
        <h1 class="co-page-title">Entrar.</h1>
        <p class="co-lede mt-2">Sin contraseña: te llega un código al correo y entras.</p>
      </div>
      {error && <Alert kind="rejection" title={error} />}
      {info && <Alert kind="success" title={info} />}
      {demoCode && <p class="co-alert co-alert--info" data-testid="demo-code">Modo demo (sin correo): tu código es <strong>{demoCode}</strong></p>}

      {codeEmail ? (
        <form method="post" class="grid gap-3" data-testid="code-verify">
          <input type="hidden" name="action" value="code-verify" />
          <input type="hidden" name="email" value={codeEmail} />
          <p class="co-body">Código enviado a <strong class="text-ink">{codeEmail}</strong></p>
          <label class="co-field">Código
            <input class="co-input text-center !text-2xl tracking-[0.4em]" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,12}" maxlength="12" required autofocus />
          </label>
          <button class="co-btn co-btn--primary co-btn--block" type="submit">Entrar <span aria-hidden="true">→</span></button>
          <a class="co-btn co-btn--quiet" href={`/admin/login?next=${encodeURIComponent(next)}`}>Usar otro email</a>
        </form>
      ) : (
        <form method="post" class="grid gap-3" data-testid="code-send">
          <input type="hidden" name="action" value="code-send" />
          <label class="co-field">Email<input class="co-input" type="email" name="email" required autocomplete="email" /></label>
          <button class="co-btn co-btn--primary co-btn--block" type="submit">Enviarme un código <span aria-hidden="true">→</span></button>
        </form>
      )}
    </div>

    {mode === 'demo' ? (
      <details class="co-card" open={!codeEmail}>
        <summary class="cursor-pointer co-row-title">Modo demo: entrar como…</summary>
        <div class="mt-3 grid gap-2">
          {demoDb().users.map((u) => (
            <form method="post">
              <input type="hidden" name="action" value="demo" />
              <input type="hidden" name="userId" value={u.id} />
              <button type="submit" class="co-action !min-h-[56px]" data-testid={`demo-${u.email}`}>
                <span class="co-action__label">{u.display_name}<small>{u.email} · {u.memberships.map((m) => `${roleName[m.role]} en ${tenantName(m.tenant_id)}`).join(', ') || 'sin acceso'}</small></span>
              </button>
            </form>
          ))}
        </div>
      </details>
    ) : !codeEmail && (
      <details class="co-card">
        <summary class="cursor-pointer co-row-title">Entrar con contraseña</summary>
        <form method="post" class="mt-3 grid gap-3">
          <input type="hidden" name="action" value="password" />
          <label class="co-field">Email<input class="co-input" type="email" name="email" required autocomplete="email" /></label>
          <label class="co-field">Contraseña<input class="co-input" type="password" name="password" required autocomplete="current-password" /></label>
          <button class="co-btn co-btn--ghost co-btn--block" type="submit">Entrar</button>
        </form>
        <form method="post" class="mt-4 grid gap-2">
          <input type="hidden" name="action" value="reset" />
          <p class="co-help">¿No la recuerdas? Entra con un código o pide un enlace para elegir otra:</p>
          <label class="co-field">Email<input class="co-input" type="email" name="email" required autocomplete="email" /></label>
          <button class="co-btn co-btn--ghost co-btn--block" type="submit">Enviarme enlace de recuperación</button>
        </form>
      </details>
    )}
  </div>
</AdminLayout>
