---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { createDossierSchema } from '~/lib/admin/ops';
import { AdminError } from '~/lib/admin/service';
import { relativeTime, STATUS_CLASS, STATUS_LABEL } from '~/lib/admin/format';
import type { DossierStatus } from '~/lib/types';
import PartnerHome from '~/components/admin/PartnerHome.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import Alert from '~/components/ui/Alert.astro';
import Icon from '~/components/ui/Icon.astro';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const { service, session } = admin;

let error: string | null = null;
let errorAccount: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  errorAccount = String(form.get('partnerAccountId') ?? '') || null;
  const parsed = createDossierSchema.safeParse({
    title: form.get('title') ?? '',
    prospectName: form.get('prospectName') ?? '',
    prospectCompany: form.get('prospectCompany') ?? '',
    fromDossierId: form.get('fromDossierId') || undefined,
    partnerAccountId: errorAccount ?? undefined,
  });
  if (!parsed.success) error = parsed.error.issues[0]?.message ?? 'Datos no válidos';
  else {
    try {
      const id = await service.createDossier(parsed.data);
      return Astro.redirect(`/admin/dossiers/${id}`, 303);
    } catch (e) {
      if (!(e instanceof AdminError)) throw e;
      error = e.message;
    }
  }
}

const isPartner = session.role === 'partner';
const all = isPartner ? [] : await service.listDossiers();
const status = Astro.url.searchParams.get('status') as DossierStatus | null;
const mine = Astro.url.searchParams.get('mine') === '1';
const follow = Astro.url.searchParams.get('follow') === '1';
const nowMs = Date.now();
const isOverdue = (iso: string | null) => !!iso && new Date(iso).getTime() < nowMs;
const myFollowups = all.filter((d) => d.nextStepAt && d.authorId === session.userId);
const myOverdue = myFollowups.filter((d) => isOverdue(d.nextStepAt)).length;
const q = (Astro.url.searchParams.get('q') ?? '').trim().toLowerCase();
const list = all.filter((d) =>
  (!follow || !!d.nextStepAt)
  && (!status || d.status === status)
  && (!mine || d.authorId === session.userId)
  && (!q || [d.title, d.prospectName, d.prospectCompany].some((x) => x?.toLowerCase().includes(q))));
if (follow) list.sort((a, b) => (a.nextStepAt ?? '').localeCompare(b.nextStepAt ?? ''));
const when = (iso: string) => new Intl.DateTimeFormat('es-ES', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }).format(new Date(iso));

const filterHref = (p: Record<string, string | null>) => {
  const u = new URL(Astro.url);
  for (const [k, v] of Object.entries(p)) v == null ? u.searchParams.delete(k) : u.searchParams.set(k, v);
  return u.pathname + u.search;
};
const filtered = !!(status || mine || follow || q);
const published = all.filter((d) => d.status === 'published').length;
---
<AdminLayout title={isPartner ? 'Mis cuentas' : 'Dossiers'}>
  {isPartner ? <PartnerHome admin={admin} error={error} errorAccount={errorAccount} /> : (
  <>
    <PageHeader eyebrow="Vender" title="Dossiers" lede={`${all.length} en total · ${published} publicados. Un dossier es la propuesta viva que envías a cada prospecto.`}>
      <form method="get" class="relative" role="search">
        {status && <input type="hidden" name="status" value={status} />}
        {mine && <input type="hidden" name="mine" value="1" />}
        {follow && <input type="hidden" name="follow" value="1" />}
        <label class="sr-only" for="q">Buscar prospecto</label>
        <input id="q" class="co-input w-64 pl-9" type="search" name="q" value={q} placeholder="Buscar prospecto" />
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[var(--co-ink-dim)]"><Icon name="search" size={16} /></span>
      </form>
    </PageHeader>

    <div class="co-split">
      <section>
        {myOverdue > 0 && !follow && (
          <a href="?follow=1&mine=1" class="co-row co-row--attention mb-3" data-testid="overdue-banner">
            <span class="co-row__lead"><Icon name="clock" /></span>
            <span class="co-row__main"><span class="co-row-title">Tienes {myOverdue} {myOverdue === 1 ? 'seguimiento vencido' : 'seguimientos vencidos'}</span><span class="co-meta">Ver tus seguimientos, del más antiguo al más reciente</span></span>
            <span class="co-row__chevron"><Icon name="chevron-right" /></span>
          </a>
        )}
        <nav class="co-chips mb-4" aria-label="Filtros">
          <a href={filterHref({ status: null })} class="co-chip" aria-current={!status ? 'true' : undefined}>Todos</a>
          {(['draft', 'published', 'archived'] as const).map((s) => <a href={filterHref({ status: s })} class="co-chip" aria-current={status === s ? 'true' : undefined}>{STATUS_LABEL[s]}</a>)}
          <a href={filterHref({ mine: mine ? null : '1' })} class="co-chip" aria-current={mine ? 'true' : undefined}>Solo míos</a>
          <a href={filterHref({ follow: follow ? null : '1' })} class="co-chip" aria-current={follow ? 'true' : undefined} data-testid="filter-follow"><Icon name="clock" size={14} />Seguimientos{myOverdue ? ` · ${myOverdue} vencidos` : ''}</a>
        </nav>

        {list.length === 0 ? (
          filtered
            ? <EmptyState kind="filter" title="Ningún dossier coincide con estos filtros" clearHref="/admin" />
            : <EmptyState kind="create" title="Todavía no hay dossiers" detail="Crea el primero con el formulario «Nuevo dossier»: eliges los módulos, lo publicas y envías el enlace." action={{ href: '#create-title', label: 'Crear el primero' }} />
        ) : (
          <ul class="co-rows" data-testid="dossier-list">
            {list.map((d) => {
              const late = isOverdue(d.nextStepAt);
              return (
                <li>
                  <a href={`/admin/dossiers/${d.id}`} class:list={['co-row', late && 'co-row--attention']}>
                    <span class="co-row__main">
                      <span class="co-row-title">{d.title}</span>
                      <span class="co-meta">
                        {[d.prospectCompany, d.prospectName].filter(Boolean).join(' · ') || 'Sin prospecto'}
                        {' · '}{d.itemCount} {d.itemCount === 1 ? 'módulo' : 'módulos'}{d.activeLinks ? ` · ${d.activeLinks} ${d.activeLinks > 1 ? 'enlaces' : 'enlace'}` : ''}
                        {' · '}{d.authorName ?? 'Sin autor'} · {relativeTime(d.updatedAt)}
                      </span>
                      {d.nextStepAt && (
                        <span class="co-meta mt-1 !text-[var(--co-ink)]" title={d.nextStep ?? ''} data-testid="next-step-chip">
                          {late ? 'Seguimiento vencido' : 'Próximo paso'}: {when(d.nextStepAt)}{d.nextStep ? ` · ${d.nextStep}` : ''}
                        </span>
                      )}
                    </span>
                    <span class={STATUS_CLASS[d.status]}>{STATUS_LABEL[d.status]}</span>
                    <span class="co-row__chevron"><Icon name="chevron-right" /></span>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </section>

      <aside class="co-split__aside--sticky">
        <form method="post" class="co-card grid gap-3" data-testid="create-form">
          <p class="text-eyebrow">Nuevo</p>
          <h2 class="co-entity">Nuevo dossier</h2>
          {error && <Alert kind="rejection" title={error} />}
          <label class="co-field">Título<input id="create-title" class="co-input" name="title" required maxlength="140" placeholder="Sala X · Bodas 2027" /></label>
          <label class="co-field">Empresa del prospecto<input class="co-input" name="prospectCompany" maxlength="120" /></label>
          <label class="co-field">Persona de contacto<input class="co-input" name="prospectName" maxlength="120" /></label>
          <label class="co-field">Partir de
            <select class="co-select" name="fromDossierId">
              <option value="">Dossier vacío</option>
              {all.filter((d) => d.itemCount > 0).map((d) => <option value={d.id}>{d.title}</option>)}
            </select>
          </label>
          <button class="co-btn co-btn--primary co-btn--block" type="submit">Crear y editar <span aria-hidden="true">→</span></button>
        </form>
      </aside>
    </div>
  </>
  )}
</AdminLayout>
