---
/**
 * Dossiers: tus propuestas como tarjetas, agrupadas por lo que piden (atención → enviadas → borradores → archivadas),
 * con las aperturas y el próximo paso a la vista. «Nueva propuesta» abre el formulario en una ventana (#nuevo).
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import { createDossierSchema } from '~/lib/admin/ops';
import { dossierFromAccount } from '~/lib/admin/from-account';
import { AdminError } from '~/lib/admin/service';
import { relativeTime, STATUS_CLASS, STATUS_LABELS } from '~/lib/admin/format';
import type { DossierStatus } from '~/lib/types';
import PartnerHome from '~/components/admin/PartnerHome.astro';
import { requestOrigin } from '~/lib/http';
import EmptyState from '~/components/ui/EmptyState.astro';
import Alert from '~/components/ui/Alert.astro';
import Icon from '~/components/ui/Icon.astro';
import { analyticsMessages } from '~/lib/i18n/messages/analytics';
import { i18n } from '~/lib/i18n';
import { sellMessages } from '~/lib/i18n/messages/sell';
import { welcomeMessages } from '~/lib/i18n/messages/welcome';
import { newProposalMessages } from '~/lib/i18n/messages/newProposal';
import { liteOf } from '~/lib/proposal/preset';
import { can } from '~/lib/admin/permissions';
import { HOME, HOME_COOKIE, homePath } from '~/lib/admin/home';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
// La primera vez en esta sesión del navegador, escribiendo la dirección del espacio o desde un marcador (sin página de
// origen): a su inicio, el CRM (lib/admin/home.ts). Desde el menú («Propuestas»), al recargar o ya dentro, se queda aquí.
{
  const h = Astro.request.headers;
  if (Astro.request.method === 'GET' && !Astro.url.search && !Astro.cookies.get(HOME_COOKIE)?.value && !h.get('referer')
    && (h.get('sec-fetch-site') ?? 'none') === 'none' && homePath(admin.session.role) !== '/admin') {
    return Astro.redirect(HOME, 302);
  }
}
const { service, session } = admin;
const { m, f, locale } = i18n(Astro, sellMessages);
const STATUS_LABEL = STATUS_LABELS[locale];

let error: string | null = null;
let errorAccount: string | null = null;
let inviteMsg: string | null = null;
if (Astro.request.method === 'POST' && (await Astro.request.clone().formData()).get('action') === 'invite-colleague') {
  const form = await Astro.request.formData();
  try {
    const r = await admin.tenantAdmin.partnerInvite({ email: form.get('email') }, `${requestOrigin(Astro.request, Astro.url)}/admin/auth/confirm?next=/admin`);
    return Astro.redirect(`/admin?ok=${r.invited ? 'invited' : 'added'}`, 303);
  } catch (e) {
    if (!(e instanceof AdminError)) throw e;
    inviteMsg = e.message;
  }
} else if (Astro.request.method === 'POST' && (await Astro.request.clone().formData()).get('action') === 'bulk') {
  // Varias a la vez (cambiar responsable, archivar, sacar del archivo, borrar): vuelve a la misma lista con el resultado.
  const form = await Astro.request.formData();
  const back = String(form.get('back') ?? '/admin');
  const to = new URL(back.startsWith('/admin') ? back : '/admin', Astro.url);
  try {
    const act = String(form.get('do') ?? '') as 'assign' | 'archive' | 'unarchive' | 'delete';
    if (!['assign', 'archive', 'unarchive', 'delete'].includes(act)) throw new AdminError(422, 'Datos no válidos');
    const r = await service.bulkDossiers(form.getAll('ids').map(String), act, String(form.get('to') ?? '') || undefined);
    to.searchParams.set('bulk', `${r.done}.${r.skipped}`); to.searchParams.delete('bulkError');
  } catch (e) {
    if (!(e instanceof AdminError)) throw e;
    to.searchParams.set('bulkError', e.message); to.searchParams.delete('bulk');
  }
  return Astro.redirect(to.pathname + to.search, 303);
} else if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  errorAccount = String(form.get('partnerAccountId') ?? '') || null;
  const parsed = createDossierSchema.safeParse({
    title: form.get('title') ?? '',
    prospectName: form.get('prospectName') ?? '',
    prospectCompany: form.get('prospectCompany') ?? '',
    fromDossierId: form.get('fromDossierId') || undefined,
    partnerAccountId: errorAccount ?? undefined,
  });
  // Empresa elegida del CRM: la propuesta nace vinculada y con lo que ya sabe su ficha (sector, receta, estilo).
  const crmAccountId = String(form.get('accountId') ?? '').trim();
  if (!parsed.success) error = parsed.error.issues[0]?.message ?? m.dossiers.invalid;
  else {
    try {
      const id = crmAccountId && can(session.role).useAccounts
        ? await dossierFromAccount(admin, crmAccountId, { title: parsed.data.title, prospectName: parsed.data.prospectName ?? undefined, fromDossierId: parsed.data.fromDossierId })
        : await service.createDossier(parsed.data);
      // Lo que ha contestado en «Nueva propuesta» paso a paso: el tipo de cliente y cómo la quiere (la receta).
      const segmentId = String(form.get('segmentId') ?? '').trim();
      const wizard = form.get('wizard') === '1' && !parsed.data.fromDossierId;
      if (wizard && /^[0-9a-f-]{36}$/i.test(segmentId)) {
        const answers = form.getAll('answers').map(String).filter((a) => /^[a-z0-9][a-z0-9-]{0,62}(:[a-z0-9][a-z0-9-]{0,62})?$/.test(a)).slice(0, 20);
        const mode = form.get('presetMode') === 'visual' ? 'visual' : 'full';
        await service.apply(id, { op: 'setSegment', segmentId }).catch(() => null);
        if (form.get('hasRecipe') === '1') await service.apply(id, { op: 'applyPreset', mode, answers }).catch(() => null);
      }
      return Astro.redirect(`/admin/dossiers/${id}${wizard ? '?nueva=1' : ''}`, 303);
    } catch (e) {
      if (!(e instanceof AdminError)) throw e;
      error = e.message;
    }
  }
}

const isPartner = session.role === 'partner';
// «Nueva propuesta» paso a paso: los tipos de cliente (sectores) con su receta, para preguntar cómo la quiere.
const NP = newProposalMessages[locale];
const wizardSegments = await admin.playbook.market().then((ms) => ms.filter((x) => x.status !== 'archived')
  .map((x) => ({ id: x.id, name: x.name, recipe: liteOf(x.proposal) }))
  .sort((a, b) => Number(!!b.recipe) - Number(!!a.recipe) || a.name.localeCompare(b.name, locale))).catch(() => [] as Array<{ id: string; name: string; recipe: ReturnType<typeof liteOf> }>);
// En «Nueva propuesta», la empresa se puede elegir del CRM (quien trabaja con cuentas; los colaboradores, no).
const crmPick = can(session.role).useAccounts;
const team = isPartner ? [] : await service.listDossiers();
// Cada uno ve sus propuestas. Admin y gerentes eligen de quién (por defecto, las suyas): todo el equipo, un comercial
// o las que no tienen autor. Así a nadie le salen arriba las de otros (docs/ORG.md).
const manager = can(session.role).editAllDossiers;
const autorQ = Astro.url.searchParams.get('autor') ?? '';
const autor = !manager || Astro.url.searchParams.get('mine') === '1' ? '' : autorQ;
const byAuthor = (d: (typeof team)[number]) => autor === 'todos' ? true : autor === 'ninguno' ? !d.authorId : autor ? d.authorId === autor : d.authorId === session.userId;
const all = team.filter(byAuthor);
const members = manager ? await admin.tenantAdmin.listMembers().catch(() => []) : [];
const authorOptions = manager ? members.filter((x) => x.userId !== session.userId && x.role !== 'partner')
  .map((x) => ({ id: x.userId, label: x.displayName || x.email, n: team.filter((d) => d.authorId === x.userId).length }))
  .sort((a, b) => b.n - a.n || a.label.localeCompare(b.label, locale)) : [];
const noAuthor = team.filter((d) => !d.authorId).length;
const status = Astro.url.searchParams.get('status') as DossierStatus | null;
const follow = Astro.url.searchParams.get('follow') === '1';
const nowMs = Date.now();
const isOverdue = (iso: string | null) => !!iso && new Date(iso).getTime() < nowMs;
const myFollowups = all.filter((d) => d.nextStepAt && d.authorId === session.userId);
const myOverdue = myFollowups.filter((d) => isOverdue(d.nextStepAt)).length;
const q = (Astro.url.searchParams.get('q') ?? '').trim().toLowerCase();
const list = all.filter((d) =>
  (!follow || !!d.nextStepAt)
  && (!status || d.status === status)
  && (!q || [d.title, d.prospectName, d.prospectCompany].some((x) => x?.toLowerCase().includes(q))));
// Aperturas del enlace público (docs/ANALYTICS.md).
const opens = list.some((d) => d.status === 'published')
  ? await Astro.locals.admin!.analytics.statsFor(list.filter((d) => d.status === 'published').map((d) => d.id)).catch(() => new Map())
  : new Map();
const am = analyticsMessages[locale];
if (follow) list.sort((a, b) => (a.nextStepAt ?? '').localeCompare(b.nextStepAt ?? ''));
const when = (iso: string) => f.date(iso, { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

const filterHref = (p: Record<string, string | null>) => {
  const u = new URL(Astro.url);
  for (const [k, v] of Object.entries(p)) v == null ? u.searchParams.delete(k) : u.searchParams.set(k, v);
  return u.pathname + u.search;
};
// Si la empresa de la propuesta ya tiene un próximo paso (p. ej. «hablar en enero»), la propuesta no pide atención.
const accountStep = crmPick && list.some((d) => d.accountId)
  ? await admin.crm.nextSteps(list.flatMap((d) => (d.accountId ? [d.accountId] : []))).catch(() => new Map<string, string>())
  : new Map<string, string>();
const planned = (d: (typeof list)[number]) => {
  const a = d.accountId ? accountStep.get(d.accountId) : undefined;
  return (!!d.nextStepAt && !isOverdue(d.nextStepAt)) || (!!a && !isOverdue(a));
};
const filtered = !!(status || follow || q);
const published = all.filter((d) => d.status === 'published').length;
const groups = filtered
  ? [{ key: 'all', title: '', items: list }]
  : [
      { key: 'attention', title: m.dossiers.groups.attention, items: list.filter((d) => d.status === 'published' && !planned(d)) },
      { key: 'sent', title: m.dossiers.groups.sent, items: list.filter((d) => d.status === 'published' && planned(d)) },
      { key: 'drafts', title: m.dossiers.groups.drafts, items: list.filter((d) => d.status === 'draft') },
      { key: 'archived', title: m.dossiers.groups.archived, items: list.filter((d) => d.status === 'archived') },
    ].filter((g) => g.items.length);
// Varias a la vez: quién puede cambiar el responsable (admin) y a quién; el resultado de la última acción.
const B = m.dossiers.bulk;
const canAssign = can(session.role).manageTenant;
const owners = canAssign ? members.filter((x) => x.role !== 'partner').map((x) => ({ id: x.userId, label: x.displayName || x.email })).sort((a, b) => a.label.localeCompare(b.label, locale)) : [];
const bulkRes = (Astro.url.searchParams.get('bulk') ?? '').split('.').map(Number);
const bulkError = Astro.url.searchParams.get('bulkError');
const backUrl = (() => { const u = new URL(Astro.url); u.searchParams.delete('bulk'); u.searchParams.delete('bulkError'); return u.pathname + u.search; })();
const initial = (d: { prospectCompany: string | null; title: string }) => (d.prospectCompany || d.title).trim().charAt(0).toUpperCase();
---
<AdminLayout title={isPartner ? m.dossiers.partnerTitle : m.dossiers.title} wide>
  {isPartner ? <PartnerHome admin={admin} error={error} errorAccount={errorAccount} inviteError={inviteMsg} /> : (
  <div class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)] gap-10 pb-10">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div class="grid gap-2">
        <h1 class="co-page-title !text-5xl">{m.dossiers.title}</h1>
        <p class="co-lede !text-lg">{m.dossiers.count(all.length, published)}</p>
      </div>
      <button type="button" class="co-btn co-btn--primary" data-open-new data-testid="new-dossier">{m.home.newProposal} <span aria-hidden="true">→</span></button>
    </header>

    {bulkRes.length === 2 && !Number.isNaN(bulkRes[0]) && <Alert kind="success" title={B.done(bulkRes[0]!, bulkRes[1]!)} />}
    {bulkError && <Alert kind="rejection" title={bulkError} />}

    {myOverdue > 0 && !follow && (
      <a href="?follow=1" class="co-row co-row--attention" data-testid="overdue-banner">
        <span class="co-row__lead"><Icon name="clock" /></span>
        <span class="co-row__main"><span class="co-row-title">{m.common.youHaveOverdue(myOverdue)}</span><span class="co-meta">{m.dossiers.overdueHint}</span></span>
        <span class="co-row__chevron"><Icon name="chevron-right" /></span>
      </a>
    )}

    <div class="flex flex-wrap items-center justify-between gap-3">
      <nav class="co-chips" aria-label={m.dossiers.filters}>
        <a href={filterHref({ status: null })} class="co-chip" aria-current={!status ? 'true' : undefined}>{m.common.all}</a>
        {(['draft', 'published', 'archived'] as const).map((s) => <a href={filterHref({ status: s })} class="co-chip" aria-current={status === s ? 'true' : undefined}>{STATUS_LABEL[s]}</a>)}
        <a href={filterHref({ follow: follow ? null : '1' })} class="co-chip" aria-current={follow ? 'true' : undefined} data-testid="filter-follow"><Icon name="clock" size={14} />{m.dossiers.followups}{myOverdue ? m.common.overdueN(myOverdue) : ''}</a>
      </nav>
      {manager && (
        <form method="get" class="flex items-center gap-2" data-testid="author-filter">
          {status && <input type="hidden" name="status" value={status} />}
          {follow && <input type="hidden" name="follow" value="1" />}
          <label class="sr-only" for="autor">{m.dossiers.author}</label>
          <select id="autor" class="co-select w-auto" name="autor" onchange="this.form.requestSubmit()" data-testid="author-select">
            <option value="" selected={!autor}>{m.dossiers.authorMine(team.filter((d) => d.authorId === session.userId).length)}</option>
            <option value="todos" selected={autor === 'todos'}>{m.dossiers.authorAll(team.length)}</option>
            {authorOptions.map((o) => <option value={o.id} selected={autor === o.id}>{o.label} · {o.n}</option>)}
            {noAuthor > 0 && <option value="ninguno" selected={autor === 'ninguno'}>{m.dossiers.authorNone(noAuthor)}</option>}
          </select>
          <noscript><button class="co-btn co-btn--ghost co-btn--sm" type="submit">OK</button></noscript>
        </form>
      )}
      {list.length > 0 && <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-bulk-start data-testid="bulk-start"><Icon name="check" size={14} />{B.select}</button>}
      <form method="get" class="relative" role="search">
        {status && <input type="hidden" name="status" value={status} />}
        {autor && <input type="hidden" name="autor" value={autor} />}
        {follow && <input type="hidden" name="follow" value="1" />}
        <label class="sr-only" for="q">{m.dossiers.search}</label>
        <input id="q" class="co-input w-64 pl-9" type="search" name="q" value={q} placeholder={m.dossiers.search} />
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[var(--co-ink-dim)]"><Icon name="search" size={16} /></span>
      </form>
    </div>

    {list.length === 0 ? (
      filtered
        ? <EmptyState kind="filter" title={m.dossiers.emptyFiltered} clearHref="/admin" />
        : <EmptyState kind="create" title={m.dossiers.emptyTitle} detail={m.dossiers.emptyDetail} action={{ href: '#nuevo', label: m.dossiers.emptyAction }} />
    ) : (
      <div class="grid grid-cols-[minmax(0,1fr)] gap-10" data-testid="dossier-list" data-bulk-list>
        {groups.map((g) => (
          <section class="grid grid-cols-[minmax(0,1fr)] gap-4" data-group={g.key}>
            {(g.title || groups.length > 1) && (
              <div class="flex items-center gap-3">
                {g.title && <h2 class="text-eyebrow">{g.title} · {g.items.length}</h2>}
                <button type="button" class="co-btn co-btn--quiet co-btn--sm bulk-only" data-bulk-group={g.key} data-testid="bulk-group">{B.group}</button>
              </div>
            )}
            <ul class="grid grid-cols-[minmax(0,1fr)] gap-3 p-0 md:grid-cols-2">
              {g.items.map((d) => {
                const late = isOverdue(d.nextStepAt);
                const o = opens.get(d.id)?.opens ?? 0;
                return (
                  <li class="relative list-none">
                    <label class="bulk-only bulk-check" title={B.pick(d.title)}>
                      <input type="checkbox" name="ids" value={d.id} form="bulk-form" class="h-5 w-5 accent-[var(--co-ink)]" aria-label={B.pick(d.title)} data-bulk-id data-status={d.status} data-testid="bulk-check" />
                    </label>
                    <a href={`/admin/dossiers/${d.id}`} class:list={['co-card co-card--link !grid h-full grid-cols-[minmax(0,1fr)] content-start gap-3 !p-5', late && 'dossier-card--late']}>
                      <span class="flex items-start gap-4">
                        <span class:list={['inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl text-xl font-bold', d.status === 'published' ? 'bg-[color:var(--co-signal-soft)] text-[color:var(--co-signal)]' : 'bg-[var(--console-chip-bg)]']} aria-hidden="true">{initial(d)}</span>
                        <span class="grid min-w-0 flex-1 gap-0.5">
                          <span class="co-entity text-lg leading-snug" data-ugc>{d.title}</span>
                          <span class="co-meta truncate">{[d.prospectCompany, d.prospectName].filter(Boolean).join(' · ') || m.dossiers.noProspect}</span>
                        </span>
                        <span class={STATUS_CLASS[d.status]}>{STATUS_LABEL[d.status]}</span>
                      </span>
                      {d.nextStepAt && (
                        <span class:list={['flex items-center gap-2 text-sm', late ? 'font-semibold text-[color:var(--console-attention,#b42318)]' : '']} title={d.nextStep ?? ''} data-testid="next-step-chip">
                          <Icon name="clock" size={14} />
                          <span class="truncate">{late ? m.common.overdueFollowup : m.common.nextStep}: {when(d.nextStepAt)}{d.nextStep && <> · <span data-ugc>{d.nextStep}</span></>}</span>
                        </span>
                      )}
                      <span class="flex flex-wrap items-center gap-2">
                        {d.status === 'published' && <span class={o ? 'co-badge co-badge--signal' : 'co-badge'} data-testid="opens-badge">{am.badge(o)}</span>}
                        <span class="co-meta">{m.dossiers.modules(d.itemCount)} · {d.authorName ?? m.dossiers.noAuthor} · {relativeTime(d.updatedAt, undefined, locale)}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    )}

    {list.length > 0 && (
      <form method="post" id="bulk-form" class="bulk-bar co-card" hidden data-bulk-bar data-testid="bulk-bar">
        <input type="hidden" name="action" value="bulk" />
        <input type="hidden" name="back" value={backUrl} />
        <div class="flex flex-wrap items-center gap-2">
          <strong class="mr-1" data-bulk-count data-testid="bulk-count" data-one={B.n(1)} data-many={B.n(999)}>{B.n(0)}</strong>
          <button type="button" class="co-btn co-btn--quiet co-btn--sm" data-bulk-all data-testid="bulk-all">{B.all}</button>
          <button type="button" class="co-btn co-btn--quiet co-btn--sm" data-bulk-none>{B.none}</button>
          <span class="flex-1"></span>
          <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-bulk-cancel data-testid="bulk-cancel">{B.cancel}</button>
        </div>
        <div class="flex flex-wrap items-center gap-2" data-bulk-actions>
          {canAssign && (
            <span class="flex flex-wrap items-center gap-2">
              <label class="sr-only" for="bulk-to">{B.owner}</label>
              <select id="bulk-to" name="to" class="co-select !h-9 w-auto" data-testid="bulk-owner">
                <option value="">{B.owner}: {B.ownerPick}</option>
                {owners.map((o) => <option value={o.id}>{o.label}</option>)}
              </select>
              <button class="co-btn co-btn--primary co-btn--sm" name="do" value="assign" data-needs-owner data-testid="bulk-assign"><Icon name="users" size={14} />{B.apply}</button>
            </span>
          )}
          <button class="co-btn co-btn--ghost co-btn--sm" name="do" value="archive" data-testid="bulk-archive">{B.archive}</button>
          <button class="co-btn co-btn--ghost co-btn--sm" name="do" value="unarchive" data-testid="bulk-unarchive">{B.unarchive}</button>
          <button class="co-btn co-btn--ghost co-btn--sm !text-[color:var(--console-attention,#b42318)]" name="do" value="delete" data-confirm-delete={B.delConfirm(999)} data-testid="bulk-delete">{B.del}</button>
        </div>
      </form>
    )}

    <dialog class="new-dossier" data-new {...(error ? { 'data-open': '' } : {})}>
      <form method="post" id="nuevo" class="grid gap-4 p-7" data-testid="create-form">
        <div class="flex items-start justify-between gap-3">
          <h2 class="co-page-title !text-3xl">{m.home.newProposal}</h2>
          <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-close-new>{m.dossiers.close}</button>
        </div>
        {error && <Alert kind="rejection" title={error} />}
        <input type="hidden" name="wizard" value="0" data-np-wizard />
        <input type="hidden" name="segmentId" value="" data-np-segment />
        <input type="hidden" name="presetMode" value="full" data-np-mode />
        <input type="hidden" name="hasRecipe" value="0" data-np-has-recipe />
        <div data-np-answers hidden></div>
        <p class="co-meta -mb-2" data-np-progress data-of="4" data-template={NP.step(9, 8).replace('9', '{n}').replace('8', '{of}')}>{NP.step(1, 4)}</p>
        <section class="grid gap-4" data-np-step="1">
          <div><h3 class="co-entity !text-xl m-0">{NP.whoTitle}</h3><p class="co-meta m-0">{NP.whoLede}</p></div>
        <div class="co-field relative">
          <label for="create-company">{m.dossiers.company}</label>
          <input id="create-company" class="co-input" name="prospectCompany" maxlength="120" autofocus autocomplete="off" data-company data-testid="create-company"
            {...(crmPick ? { 'data-search': '1', placeholder: m.dossiers.companySearch } : {})} />
          <input type="hidden" name="accountId" value="" data-account-id />
          {crmPick && <span class="co-help" data-company-help>{m.dossiers.companyHelp}</span>}
          {crmPick && <p class="co-tag w-fit" hidden data-company-linked data-testid="create-company-linked"><Icon name="link" size={12} /><span data-company-linked-name></span>
            <button type="button" class="co-btn co-btn--quiet co-btn--sm !py-0" data-company-unlink>{m.dossiers.companyUnlink}</button></p>}
          <ul class="m-0 grid max-h-64 gap-1 overflow-y-auto p-0" hidden data-company-list data-testid="create-company-list"></ul>
        </div>
        <label class="co-field">{m.common.contactPerson}<input class="co-input" name="prospectName" maxlength="120" /></label>
        <label class="co-field">{m.common.title}<input id="create-title" class="co-input" name="title" required maxlength="140" placeholder={m.dossiers.titlePlaceholder} data-title data-template={welcomeMessages[locale].first.proposalTitle('{c}')} /></label>
        {(manager ? team : all).some((d) => d.itemCount > 0) && (
          <label class="co-field">{m.common.startFrom}
            <select class="co-select" name="fromDossierId" data-np-from>
              <option value="">{m.dossiers.emptyDossier}</option>
              {(manager ? team : all).filter((d) => d.itemCount > 0).map((d) => <option value={d.id}>{d.title}{manager && d.authorId !== session.userId ? ` · ${d.authorName ?? m.dossiers.noAuthor}` : ''}</option>)}
            </select>
          </label>
        )}
          <p class="co-alert co-alert--rejection m-0" hidden data-np-need>{NP.needCompany}</p>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <button class="co-btn co-btn--ghost co-btn--sm" type="submit" data-np-skip>{m.common.createEdit}</button>
            <button class="co-btn co-btn--primary" type="button" data-np-next data-testid="np-next-1">{NP.next} <span aria-hidden="true">→</span></button>
          </div>
        </section>
        <section class="grid gap-3" data-np-step="2" hidden>
          <div><h3 class="co-entity !text-xl m-0">{NP.kindTitle}</h3><p class="co-meta m-0">{NP.kindLede}</p></div>
          <div class="grid max-h-[50vh] gap-2 overflow-y-auto sm:grid-cols-2" data-np-kinds>
            {wizardSegments.map((sg) => (
              <button type="button" class="co-inset grid gap-0.5 text-left" data-np-kind={sg.id} data-name={sg.name} data-testid="np-kind"><span class="font-semibold">{sg.name}</span></button>
            ))}
            <button type="button" class="co-inset grid gap-0.5 text-left" data-np-kind="" data-name={NP.kindOther} data-testid="np-kind-other"><span class="font-semibold">{NP.kindOther}</span><span class="co-meta">{NP.kindOtherHint}</span></button>
          </div>
          <div class="flex items-center justify-between gap-2">
            <button class="co-btn co-btn--ghost" type="button" data-np-back>{NP.back}</button>
            <button class="co-btn co-btn--primary" type="button" data-np-next disabled data-testid="np-next-2">{NP.next} <span aria-hidden="true">→</span></button>
          </div>
        </section>
        <section class="grid gap-3" data-np-step="3" hidden>
          <div><h3 class="co-entity !text-xl m-0">{NP.howTitle}</h3><p class="co-meta m-0">{NP.howLede}</p></div>
          <div class="grid max-h-[55vh] gap-3 overflow-y-auto" data-np-how data-none={NP.howNone} data-mode={NP.mode} data-full={NP.full} data-full-hint={NP.fullHint} data-visual={NP.visual} data-visual-hint={NP.visualHint} data-questions={NP.questions}></div>
          <div class="flex items-center justify-between gap-2">
            <button class="co-btn co-btn--ghost" type="button" data-np-back>{NP.back}</button>
            <button class="co-btn co-btn--primary" type="button" data-np-next data-testid="np-next-3">{NP.next} <span aria-hidden="true">→</span></button>
          </div>
        </section>
        <section class="grid gap-3" data-np-step="4" hidden>
          <div><h3 class="co-entity !text-xl m-0">{NP.doneTitle}</h3><p class="co-meta m-0">{NP.doneLede}</p></div>
          <dl class="co-inset grid gap-1 !p-4 text-sm" data-np-summary data-for={NP.sumFor} data-kind={NP.sumKind} data-how={NP.sumHow} data-copy={NP.sumCopy}></dl>
          <div class="flex items-center justify-between gap-2">
            <button class="co-btn co-btn--ghost" type="button" data-np-back>{NP.back}</button>
            <button class="co-btn co-btn--primary" type="submit" data-np-create data-testid="np-create">{NP.create} <span aria-hidden="true">→</span></button>
          </div>
        </section>
        <script type="application/json" data-np-recipes set:html={JSON.stringify(Object.fromEntries(wizardSegments.map((sg) => [sg.id, sg.recipe])))} />

      </form>
    </dialog>
  </div>
  )}
</AdminLayout>

<style>
  /* Varias a la vez: las casillas y lo de «Todas» solo al seleccionar; la barra, abajo y siempre a la vista. */
  .bulk-only { display: none; }
  [data-selecting] .bulk-only { display: inline-flex; }
  .bulk-check { position: absolute; z-index: 2; left: 0.6rem; top: 0.6rem; align-items: center; justify-content: center; width: 2rem; height: 2rem; border-radius: 0.6rem; background: var(--console-surface, #fff); box-shadow: 0 1px 3px rgba(0,0,0,.15); cursor: pointer; }
  [data-selecting] li:has([data-bulk-id]:checked) > a { outline: 2px solid var(--co-ink); outline-offset: -2px; }
  .bulk-bar { position: fixed; z-index: 40; left: 50%; bottom: 1rem; transform: translateX(-50%); width: min(56rem, calc(100vw - 2rem)); display: grid; gap: 0.6rem; padding: 0.9rem 1rem !important; box-shadow: 0 10px 30px rgba(0,0,0,.18); }
  .bulk-bar[hidden] { display: none; }
  /* Al seleccionar: sitio abajo para que la barra no tape las últimas, y fuera los botones flotantes. */
  [data-selecting] { padding-bottom: 9rem; }
  :global(body:has([data-selecting]) .co-fab), :global(body:has([data-selecting]) [data-ugc-ui]) { display: none !important; }
  .dossier-card--late { border-color: var(--console-attention, #b42318); }
  .new-dossier { width: min(520px, 94vw); padding: 0; border: 0; border-radius: 1.25rem; background: var(--console-surface, #fff); color: inherit; }
  .new-dossier::backdrop { background: rgba(0,0,0,.55); backdrop-filter: blur(4px); }
</style>

<script>
  // Varias a la vez: «Seleccionar» enseña las casillas y la barra; en modo selección, pulsar una tarjeta la marca (no
  // la abre). Sin nada marcado, los botones de la barra no hacen nada.
  {
    const root = document.querySelector<HTMLElement>('[data-bulk-list]');
    const bar = document.querySelector<HTMLFormElement>('[data-bulk-bar]');
    if (root && bar) {
      const boxes = () => [...document.querySelectorAll<HTMLInputElement>('[data-bulk-id]')];
      const count = bar.querySelector<HTMLElement>('[data-bulk-count]')!;
      const acts = bar.querySelectorAll<HTMLButtonElement>('[data-bulk-actions] button');
      const owner = bar.querySelector<HTMLSelectElement>('[name=to]');
      const refresh = () => {
        const n = boxes().filter((b) => b.checked).length;
        count.textContent = n === 1 ? count.dataset.one! : count.dataset.many!.replace('999', String(n));
        acts.forEach((b) => { b.disabled = n === 0 || (b.hasAttribute('data-needs-owner') && !owner?.value); });
      };
      const on = (v: boolean) => {
        root.toggleAttribute('data-selecting', v); bar.hidden = !v;
        if (!v) boxes().forEach((b) => { b.checked = false; });
        refresh();
      };
      document.querySelector('[data-bulk-start]')?.addEventListener('click', () => on(!root.hasAttribute('data-selecting')));
      bar.querySelector('[data-bulk-cancel]')?.addEventListener('click', () => on(false));
      bar.querySelector('[data-bulk-all]')?.addEventListener('click', () => { boxes().forEach((b) => { b.checked = true; }); refresh(); });
      bar.querySelector('[data-bulk-none]')?.addEventListener('click', () => { boxes().forEach((b) => { b.checked = false; }); refresh(); });
      root.querySelectorAll<HTMLButtonElement>('[data-bulk-group]').forEach((g) => g.addEventListener('click', () => {
        const mine = [...(g.closest('section')?.querySelectorAll<HTMLInputElement>('[data-bulk-id]') ?? [])];
        const all = mine.every((b) => b.checked);
        mine.forEach((b) => { b.checked = !all; }); refresh();
      }));
      root.addEventListener('change', refresh);
      owner?.addEventListener('change', refresh);
      root.addEventListener('click', (e) => {
        if (!root.hasAttribute('data-selecting')) return;
        const a = (e.target as Element).closest('a');
        const box = a?.parentElement?.querySelector<HTMLInputElement>('[data-bulk-id]');
        if (!a || !box) return;
        e.preventDefault(); box.checked = !box.checked; refresh();
      });
      bar.addEventListener('submit', (e) => {
        const btn = (e as SubmitEvent).submitter as HTMLButtonElement | null;
        const n = boxes().filter((b) => b.checked).length;
        if (!n) { e.preventDefault(); return; }
        if (btn?.dataset.confirmDelete && !confirm(btn.dataset.confirmDelete.replace('999', String(n)))) e.preventDefault();
      });
      refresh();
    }
  }
  const dlg = document.querySelector<HTMLDialogElement>('[data-new]');
  if (dlg) {
    const open = () => { if (!dlg.open) dlg.showModal(); };
    document.querySelectorAll('[data-open-new]').forEach((b) => b.addEventListener('click', open));
    document.querySelectorAll('a[href="#nuevo"]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); open(); }));
    dlg.querySelector('[data-close-new]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    if (location.hash === '#nuevo' || dlg.hasAttribute('data-open')) open();
    // El título se propone solo a partir de la empresa (se puede cambiar).
    const company = dlg.querySelector<HTMLInputElement>('[data-company]');
    const title = dlg.querySelector<HTMLInputElement>('[data-title]');
    let touched = false;
    title?.addEventListener('input', () => { touched = true; });
    const setTitle = () => { if (title && company && !touched) title.value = company.value.trim() ? (title.dataset.template ?? '{c}').replace('{c}', company.value.trim()) : ''; };
    company?.addEventListener('input', setTitle);
    // Empresa del CRM: se busca mientras se escribe; si se elige una, la propuesta nace vinculada a su ficha. Si no, el
    // nombre escrito vale tal cual.
    const list = dlg.querySelector<HTMLUListElement>('[data-company-list]');
    const accountId = dlg.querySelector<HTMLInputElement>('[data-account-id]');
    const linked = dlg.querySelector<HTMLElement>('[data-company-linked]');
    const linkedName = dlg.querySelector<HTMLElement>('[data-company-linked-name]');
    const help = dlg.querySelector<HTMLElement>('[data-company-help]');
    if (company?.dataset.search && list && accountId && linked && linkedName) {
      let timer = 0; let seq = 0;
      const unlink = () => { accountId.value = ''; linked.hidden = true; if (help) help.hidden = false; };
      const pick = (id: string, name: string) => {
        accountId.value = id; company.value = name; linkedName.textContent = name; linked.hidden = false; if (help) help.hidden = true;
        list.hidden = true; setTitle();
      };
      company.addEventListener('input', () => {
        if (accountId.value) unlink();
        window.clearTimeout(timer);
        const q = company.value.trim();
        if (q.length < 2) { list.hidden = true; return; }
        const my = ++seq;
        timer = window.setTimeout(async () => {
          let items: Array<{ id: string; name: string; zone: string; discarded: boolean }> = [];
          try { const r = await fetch(`/admin/api/crm/account-search?q=${encodeURIComponent(q)}`, { credentials: 'same-origin' }); if (r.ok) items = (await r.json()).items ?? []; } catch { /* sin red: vale el nombre escrito */ }
          if (my !== seq) return;
          list.replaceChildren(...items.filter((x) => !x.discarded).slice(0, 6).map((x) => {
            const li = document.createElement('li'); li.className = 'list-none';
            const b = document.createElement('button'); b.type = 'button'; b.className = 'co-action w-full text-left'; b.dataset.testid = 'create-company-option';
            const t = document.createElement('span'); t.className = 'co-action__label'; t.textContent = x.name;
            if (x.zone) { const s = document.createElement('small'); s.textContent = x.zone; t.append(s); }
            b.append(t); b.addEventListener('click', () => pick(x.id, x.name)); li.append(b); return li;
          }));
          list.hidden = !list.children.length;
        }, 250);
      });
      dlg.querySelector('[data-company-unlink]')?.addEventListener('click', () => { unlink(); company.focus(); });
    }
  }

  // «Nueva propuesta» paso a paso (criterio de Cristian, 26-nov-2026): para quién → qué tipo de cliente → cómo la
  // quiere (la receta del sector) → resumen. Sale montada; «Crear y editar» del primer paso la crea vacía, como antes.
  {
    const form = document.querySelector<HTMLFormElement>('[data-testid=create-form]');
    if (form) {
      const steps = [...form.querySelectorAll<HTMLElement>('[data-np-step]')];
      const progress = form.querySelector<HTMLElement>('[data-np-progress]')!;
      const recipes = JSON.parse(form.querySelector('[data-np-recipes]')?.textContent || '{}') as Record<string, null | {
        hasVisual: boolean; choices: Array<{ key: string; label: string; hint?: string; default: string; when?: string[]; options: Array<{ key: string; label: string; hint?: string }> }>;
        questions: Array<{ key: string; label: string; hint?: string; when?: string[] }> }>;
      const seg = form.querySelector<HTMLInputElement>('[data-np-segment]')!;
      const modeIn = form.querySelector<HTMLInputElement>('[data-np-mode]')!;
      const hasRecipe = form.querySelector<HTMLInputElement>('[data-np-has-recipe]')!;
      const ansBox = form.querySelector<HTMLElement>('[data-np-answers]')!;
      const how = form.querySelector<HTMLElement>('[data-np-how]')!;
      const from = form.querySelector<HTMLSelectElement>('[data-np-from]');
      let cur = 1; let kindName = ''; let answers: string[] = []; let mode: 'full' | 'visual' = 'full';
      const esc = (x: string) => x.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
      const show = (n: number) => {
        cur = n;
        steps.forEach((x) => { x.hidden = x.dataset.npStep !== String(n); });
        progress.textContent = (progress.dataset.template ?? '{n}/{of}').replace('{n}', String(n)).replace('{of}', progress.dataset.of ?? '4');
        if (n === 3) renderHow();
        if (n === 4) renderSummary();
      };
      // Lo que cuenta de la receta: cada elección con su opción (o la de por defecto) si aplica; las preguntas marcadas.
      const effective = () => {
        const r = recipes[seg.value]; if (!r) return [] as string[];
        const out: string[] = []; const applies = (w?: string[]) => !w?.length || w.some((a) => out.includes(a));
        for (const ch of r.choices) { if (!applies(ch.when)) continue; const pk = answers.find((a) => a.startsWith(`${ch.key}:`))?.slice(ch.key.length + 1); out.push(`${ch.key}:${ch.options.some((o) => o.key === pk) ? pk : ch.default}`); }
        for (const q of r.questions) if (answers.includes(q.key) && applies(q.when)) out.push(q.key);
        return out;
      };
      const card = (on: boolean, attrs: string, title: string, hint?: string) => `<button type="button" class="co-inset grid gap-0.5 text-left ${on ? '!border-[color:var(--co-signal)] ring-2 ring-[color:var(--co-signal)]' : ''}" aria-pressed="${on}" ${attrs}><span class="font-semibold">${esc(title)}</span>${hint ? `<span class="co-meta">${esc(hint)}</span>` : ''}</button>`;
      function renderHow() {
        const r = recipes[seg.value]; const d = how.dataset;
        if (!r || (!r.hasVisual && !r.choices.length && !r.questions.length)) { how.innerHTML = `<p class="co-meta">${esc(d.none ?? '')}</p>`; return; }
        const on = effective(); const shows = (w?: string[]) => !w?.length || w.some((a) => on.includes(a));
        let h = '';
        if (r.hasVisual) h += `<div class="grid gap-1.5"><p class="text-sm font-semibold">${esc(d.mode ?? '')}</p><div class="grid gap-2 sm:grid-cols-2">${card(mode === 'full', 'data-np-m="full"', d.full ?? '', d.fullHint)}${card(mode === 'visual', 'data-np-m="visual"', d.visual ?? '', d.visualHint)}</div></div>`;
        for (const ch of r.choices.filter((c) => shows(c.when))) {
          const picked = on.find((a) => a.startsWith(`${ch.key}:`))?.slice(ch.key.length + 1);
          h += `<div class="grid gap-1.5" data-testid="np-choice-${esc(ch.key)}"><p class="text-sm font-semibold">${esc(ch.label)}</p>${ch.hint ? `<p class="co-meta -mt-1">${esc(ch.hint)}</p>` : ''}<div class="grid gap-2 sm:grid-cols-2">${ch.options.map((o) => card(picked === o.key, `data-np-ch="${esc(ch.key)}" data-np-opt="${esc(o.key)}"`, o.label, o.hint)).join('')}</div></div>`;
        }
        const qs = r.questions.filter((q) => shows(q.when));
        if (qs.length) h += `<div class="grid gap-1.5"><p class="text-sm font-semibold">${esc(d.questions ?? '')}</p><ul class="grid gap-1.5 p-0">${qs.map((q) => `<li class="list-none"><label class="flex items-start gap-2 text-sm"><input type="checkbox" class="mt-0.5" data-np-q="${esc(q.key)}" ${answers.includes(q.key) ? 'checked' : ''} /><span><span class="font-semibold">${esc(q.label)}</span>${q.hint ? `<span class="co-meta block">${esc(q.hint)}</span>` : ''}</span></label></li>`).join('')}</ul></div>`;
        how.innerHTML = h;
      }
      how.addEventListener('click', (e) => {
        const b = (e.target as Element).closest<HTMLElement>('[data-np-m],[data-np-ch]'); if (!b) return;
        if (b.dataset.npM) mode = b.dataset.npM as 'full' | 'visual';
        else { const ch = b.dataset.npCh!; answers = [...answers.filter((a) => !a.startsWith(`${ch}:`)), `${ch}:${b.dataset.npOpt}`]; }
        renderHow();
      });
      how.addEventListener('change', (e) => {
        const q = (e.target as HTMLInputElement).dataset.npQ; if (!q) return;
        answers = (e.target as HTMLInputElement).checked ? [...answers, q] : answers.filter((a) => a !== q);
        renderHow();
      });
      function renderSummary() {
        const sum = form!.querySelector<HTMLElement>('[data-np-summary]')!; const d = sum.dataset;
        const company = form!.querySelector<HTMLInputElement>('[name=prospectCompany]')?.value.trim() || form!.querySelector<HTMLInputElement>('[name=title]')?.value.trim() || '—';
        const row = (k: string, v: string) => `<div class="flex gap-2"><dt class="co-meta w-24 shrink-0">${esc(k)}</dt><dd class="m-0 font-semibold">${esc(v)}</dd></div>`;
        const copyFrom = from?.value ? from.selectedOptions[0]?.textContent ?? '' : '';
        const r = recipes[seg.value];
        const labels = r ? effective().map((a) => { const [k, o] = a.split(':'); const ch = r.choices.find((c) => c.key === k); return o ? ch?.options.find((x) => x.key === o)?.label ?? '' : r.questions.find((q) => q.key === k)?.label ?? ''; }).filter(Boolean) : [];
        sum.innerHTML = row(d.for ?? '', company) + (copyFrom ? row(d.copy ?? '', copyFrom) : row(d.kind ?? '', kindName || '—') + (labels.length ? row(d.how ?? '', labels.join(' · ')) : ''));
      }
      form.querySelectorAll<HTMLButtonElement>('[data-np-kind]').forEach((b) => b.addEventListener('click', () => {
        seg.value = b.dataset.npKind ?? ''; kindName = b.dataset.name ?? ''; answers = []; mode = 'full';
        form.querySelectorAll<HTMLButtonElement>('[data-np-kind]').forEach((x) => { const on = x === b; x.setAttribute('aria-pressed', String(on)); x.classList.toggle('ring-2', on); x.classList.toggle('ring-[color:var(--co-signal)]', on); x.classList.toggle('!border-[color:var(--co-signal)]', on); });
        form.querySelector<HTMLButtonElement>('[data-np-step="2"] [data-np-next]')!.disabled = false;
      }));
      form.addEventListener('click', (e) => {
        const t = e.target as Element;
        if (t.closest('[data-np-back]')) show(cur === 4 && from?.value ? 1 : cur === 4 && !seg.value ? 2 : cur - 1);
        if (!t.closest('[data-np-next]')) return;
        if (cur === 1) {
          const need = form.querySelector<HTMLElement>('[data-np-need]')!;
          const has = !!(form.querySelector<HTMLInputElement>('[name=prospectCompany]')?.value.trim() || form.querySelector<HTMLInputElement>('[name=title]')?.value.trim());
          need.hidden = has; if (!has) return;
          const title = form.querySelector<HTMLInputElement>('[name=title]')!;
          if (!title.value.trim()) title.value = form.querySelector<HTMLInputElement>('[name=prospectCompany]')!.value.trim();
          show(from?.value ? 4 : 2);
        } else if (cur === 2) show(seg.value ? 3 : 4);
        else show(cur + 1);
      });
      // Enter no crea a medias: avanza.
      form.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' || (e.target as Element).tagName === 'TEXTAREA' || cur === 4) return;
        if ((e.target as Element).closest('[data-company-list]')) return;
        e.preventDefault(); form.querySelector<HTMLButtonElement>(`[data-np-step="${cur}"] [data-np-next]`)?.click();
      });
      form.querySelector('[data-np-create]')?.addEventListener('click', () => {
        form.querySelector<HTMLInputElement>('[data-np-wizard]')!.value = '1';
        modeIn.value = mode; hasRecipe.value = recipes[seg.value] ? '1' : '0';
        ansBox.innerHTML = effective().map((a) => `<input type="hidden" name="answers" value="${esc(a)}" />`).join('');
      });
    }
  }
</script>
