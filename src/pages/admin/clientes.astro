---
/**
 * Clientes (docs/CLIENTS.md): los que ya han cerrado, por pago o con acuerdo. Primero los que toca escribir (el próximo
 * paso vencido) y los que llevan más tiempo sin hablar; con su acuerdo vigente y quién los lleva.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import Icon from '~/components/ui/Icon.astro';
import { can } from '~/lib/admin/permissions';
import { i18n } from '~/lib/i18n';
import { clientsMessages } from '~/lib/i18n/messages/clients';
import { trialMessages } from '~/lib/i18n/messages/trial';
import { trialStatus } from '~/lib/crm/trial';
import { localDay } from '~/lib/crm/when';
import { cleanPicks, discountPct, extraTerms } from '~/lib/crm/packages';
import { packagesMessages } from '~/lib/i18n/messages/packages';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const perms = can(admin.session.role);
if (!perms.useAccounts) return Astro.rewrite('/admin/forbidden');
const { m: C, f: fmt, locale } = i18n(Astro, clientsMessages);
const all = perms.manageAccounts && Astro.url.searchParams.get('ver') !== 'mios';
// En prueba arriba (docs/CLIENTS.md §En prueba): las que están probando, la que acaba antes primero. Las que ya son
// clientes y siguen en prueba por un trato (Tnsi) salen aquí y no abajo, para no verlas dos veces.
const [allClients, trials] = await Promise.all([admin.crm.clients({ all }), admin.crm.inTrial({ all })]);
const inTrial = new Set(trials.map((x) => x.id));
const list = allClients.filter((c) => !inTrial.has(c.id));
// Qué tiene contratado (docs/PAQUETES.md): sus paquetes y su precio, de un vistazo.
const catalog = await admin.crm.products({ all: true }).catch(() => []);
const PK = packagesMessages[locale];
const pkgNames = (keys: string[]) => cleanPicks(keys, catalog.map((p) => ({ ...p, active: true }))).map((x) => `${catalog.find((p) => p.key === x.key)?.name ?? x.key}${x.free ? ` (${PK.freeCheck})` : ''}`);
const eur = (n: number) => fmt.money(Math.round(n * 100), catalog[0]?.currency ?? 'EUR');
const T = trialMessages[locale];
const todayTz = localDay(new Date());
const day = (d: string) => fmt.date(`${d}T12:00:00Z`, { day: 'numeric', month: 'short', timeZone: 'UTC' });
const date = (iso: string | null) => fmt.date(iso, { day: 'numeric', month: 'short', year: 'numeric' });
const clip = (s: string, n = 220) => (s.length > n ? `${s.slice(0, n - 1)}…` : s);
---
<AdminLayout title={C.title}>
  <PageHeader eyebrow={C.count(list.length)} title={C.title} lede={C.lede}>
    {perms.manageAccounts && (
      <div class="co-tabs" role="tablist">
        <a class="co-tab" href="/admin/clientes" aria-current={all ? 'page' : undefined}>{C.all}</a>
        <a class="co-tab" href="/admin/clientes?ver=mios" aria-current={!all ? 'page' : undefined} data-testid="clients-mine">{C.mine}</a>
      </div>
    )}
  </PageHeader>
  {trials.length > 0 && (
    <section class="co-section mb-6" data-testid="clients-trials">
      <div class="co-section__head"><h2 class="text-eyebrow">{T.clientsTitle(trials.length)}</h2><p class="co-meta">{T.clientsLede}</p></div>
      <ul class="co-rows">
        {trials.map((c) => { const st = trialStatus(c.trial, todayTz); const hot = st.tone !== 'running'; return (
          <li>
            <a class:list={['co-row items-start', hot && 'co-row--attention']} href={`/admin/accounts/${c.id}#trial`} data-testid="trial-row" data-name={c.name} data-tone={st.tone}>
              <span class="co-anchor__avatar co-anchor__avatar--soft"><Icon name="clock" size={16} /></span>
              <span class="co-row__main min-w-0">
                <span class="co-row-title">{c.name}</span>
                {c.trial.note && <span class="co-body block text-sm" data-ugc>{clip(c.trial.note)}</span>}
                <span class="co-meta">{[T.range(day(c.trial.startsOn), day(c.trial.endsOn)), all && c.ownerName ? C.owner(c.ownerName) : null].filter(Boolean).join(' · ')}</span>
                <span class="mt-1 block h-1.5 max-w-xs overflow-hidden rounded-full bg-[var(--console-divider)]" aria-hidden="true"><span class:list={['block h-full rounded-full', hot ? 'bg-[var(--console-attention)]' : 'bg-[var(--co-ink)]']} style={`width:${Math.round((st.elapsed / st.length) * 100)}%`} /></span>
              </span>
              <span class:list={['co-badge', hot ? 'co-badge--attention' : 'co-badge--ink']}>{T.badge(st.daysLeft)}</span>
            </a>
          </li>
        ); })}
      </ul>
    </section>
  )}
  {list.length === 0 ? (trials.length ? null : <EmptyState kind="none" title={C.title} because={C.empty} />) : (
    <ul class="co-rows" data-testid="clients">
      {list.map((c) => (
        <li>
          <a class:list={['co-row items-start', c.due && 'co-row--attention']} href={`/admin/accounts/${c.id}#agreement`} data-testid="client-row" data-name={c.name}>
            <span class="co-anchor__avatar co-anchor__avatar--soft"><Icon name="handshake" size={16} /></span>
            <span class="co-row__main min-w-0">
              <span class="co-row-title">{c.name}</span>
              {c.agreement?.packages.length ? (
                <span class="flex flex-wrap items-center gap-1 py-0.5" data-testid="client-packages">
                  {pkgNames(c.agreement.packages).map((x) => <span class="co-badge co-badge--ink !py-0 text-[11px]">{x}</span>)}
                  {c.agreement.price != null && <span class="co-meta text-sm font-semibold">{c.agreement.price === 0 ? PK.freeCheck : `${eur(c.agreement.price)}/${PK.periods.month}`}{discountPct(c.agreement.price, c.agreement.listPrice) != null && ` · ${PK.discount(discountPct(c.agreement.price, c.agreement.listPrice)!)}`}</span>}
                </span>
              ) : c.agreement && <span class="co-body block text-sm" data-ugc>{clip(c.agreement.terms)}</span>}
              {c.agreement?.packages.length ? (() => { const t = extraTerms(c.agreement.terms, cleanPicks(c.agreement.packages, catalog.map((p) => ({ ...p, active: true }))), catalog, { price: c.agreement.price, list: c.agreement.listPrice }); return t && <span class="co-body block text-sm" data-ugc>{clip(t)}</span>; })() : null}
              <span class="co-meta">{[c.wonAt ? C.clientSince(date(c.wonAt)) : null, c.quietDays == null ? C.never : C.quiet(c.quietDays), all && c.ownerName ? C.owner(c.ownerName) : null].filter(Boolean).join(' · ')}</span>
              <span class="co-meta">{C.next}: {c.nextStepAt ? `${date(c.nextStepAt)}${c.nextStep ? ` · ${c.nextStep}` : ''}` : C.noNext}</span>
            </span>
            <span class="flex flex-col items-end gap-1">
              {c.due && <span class="co-badge co-badge--attention" data-testid="client-due">{C.due}</span>}
              {c.pending && <span class="co-badge" data-testid="client-pending">{C.pendingBadge}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
</AdminLayout>
