---
import AdminLayout from '~/layouts/AdminLayout.astro';
Astro.response.status = 403;
const email = Astro.locals.forbiddenEmail;
const reason = Astro.locals.forbiddenReason;
const date = (iso: string) => new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso));
---
<AdminLayout title="Sin acceso">
  <div class="mx-auto mt-16 max-w-md rounded-2xl border border-line bg-bg p-6 text-center">
    <h1 class="text-2xl font-extrabold">Sin acceso</h1>
    {reason?.kind === 'partner-expired' ? (
      <p class="mt-2 text-muted" data-testid="partner-expired">Tu acceso como colaborador de {Astro.locals.tenant?.name ?? 'este espacio'} terminó{reason.expiresAt ? ` el ${date(reason.expiresAt)}` : ''}. Tus propuestas siguen guardadas: pide a tu contacto en la empresa que lo renueve.</p>
    ) : (
      <p class="mt-2 text-muted">{email ? `${email} no pertenece` : 'Tu cuenta no pertenece'} a {Astro.locals.tenant?.name ?? 'este espacio'}.</p>
    )}
    <form method="post" action="/admin/logout" class="mt-6"><button class="rounded-lg border border-line px-4 py-2 font-semibold" type="submit">Cambiar de cuenta</button></form>
  </div>
</AdminLayout>
