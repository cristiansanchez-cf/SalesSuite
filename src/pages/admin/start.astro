---
/**
 * Empieza aquí (docs/FOUNDATIONS.md §4.1): al llegar, el vendedor sabe qué vendemos, a quién, cómo se vende
 * (con humildad: comprobado frente a hipótesis) y, solo si ya están acordadas, sus condiciones.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Icon from '~/components/ui/Icon.astro';
import { i18n } from '~/lib/i18n';
import { startMessages } from '~/lib/i18n/messages/start';
import { demoDb } from '~/lib/data/store';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const { m, f } = i18n(Astro, startMessages);
const partner = admin.session.role === 'partner';
const first = (admin.session.displayName || admin.session.email).split(/[\s@]/)[0];

const [catalog, segments, plays, terms, dossiers] = await Promise.all([
  admin.service.catalog().catch(() => []),
  admin.playbook.market().catch(() => []),
  admin.playbook.listAllVisible().catch(() => []),
  admin.commissions.myConditions().catch(() => ({ visible: false, note: null, agreedAt: null, plan: null })),
  admin.service.listDossiers().catch(() => []),
]);
const history = terms.visible ? await admin.commissions.myConditionsHistory().catch(() => []) : [];
const day = (iso: string) => f.date(iso, { day: 'numeric', month: 'long', year: 'numeric' });
const sectors = segments.filter((s) => s.status !== 'archived').slice(0, 4);
// Lo comprobado primero; del resto, unas pocas hipótesis para empezar.
const ranked = [...plays].sort((a, b) => b.evidence.won - a.evidence.won || a.position - b.position).slice(0, 5);

const phone = admin.mode === 'supabase' && admin.supabase
  ? ((await admin.supabase.from('users').select('phone').eq('id', admin.session.userId).maybeSingle()).data?.phone as string | null)
  : demoDb().users.find((x) => x.id === admin.session.userId)?.phone ?? null;
const mine = dossiers.filter((d) => d.authorId === admin.session.userId);
const steps = [
  { key: 'profile', label: m.steps.profile, done: !!admin.session.displayName && (partner || !!phone), href: '/admin/account' },
  { key: 'dossier', label: m.steps.firstDossier, done: mine.length > 0, href: '/admin' },
  { key: 'publish', label: m.steps.publish, done: mine.some((d) => d.publishedAt), href: '/admin' },
  { key: 'cerebro', label: m.steps.cerebro, done: false, href: 'https://cerebro.cofundo.io', external: true },
];
---
<AdminLayout title={m.title}>
  <PageHeader eyebrow={m.eyebrow} title={m.hello(first)} lede={m.lede} />

  <div class="grid gap-6 lg:grid-cols-2">
    <section class="co-card grid content-start gap-4" data-testid="start-what">
      <h2 class="co-entity flex items-center gap-2"><Icon name="boxes" size={18} />{m.what.title}</h2>
      {catalog.length === 0 ? <p class="co-help">{m.what.empty}</p> : (
        <ul class="grid gap-3">
          {catalog.map((c) => (
            <li>
              <a class="co-row-title hover:underline" href={`/admin/learn/preview/${c.moduleId}`}>{c.moduleName}</a>
              {!partner && c.defaultPrice != null && <span class="co-meta"> · {m.what.from(f.money(c.defaultPrice, c.currency))}</span>}
              {c.description && <p class="co-help">{c.description}</p>}
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="co-card grid content-start gap-4" data-testid="start-who">
      <h2 class="co-entity flex items-center gap-2"><Icon name="target" size={18} />{m.who.title}</h2>
      {sectors.length === 0 ? <p class="co-help">{m.who.empty}</p> : (
        <ul class="grid gap-4">
          {sectors.map((s) => (
            <li class="grid gap-1">
              <a class="co-row-title hover:underline" href={`/admin/learn/sector/${s.key}`}>{s.name}</a>
              {s.icp && <p class="co-help"><strong>{m.who.icp}:</strong> {s.icp}</p>}
              {s.disqualifiers && <p class="co-help"><strong>{m.who.avoid}:</strong> {s.disqualifiers}</p>}
              {s.personas.length > 0 && <p class="co-meta">{m.who.people}: {s.personas.map((p) => p.name).join(' · ')}</p>}
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="co-card grid content-start gap-4" data-testid="start-how">
      <h2 class="co-entity flex items-center gap-2"><Icon name="book-open" size={18} />{m.how.title}</h2>
      {ranked.length === 0 ? <p class="co-help">{m.how.empty}</p> : <>
        <p class="co-help">{m.how.honest}</p>
        <ul class="grid gap-3">
          {ranked.map((p) => (
            <li class="grid gap-1" data-testid="start-play">
              <span class="co-row-title">{p.title}</span>
              {p.evidence.won > 0
                ? <span class="co-badge co-badge--signal w-fit" data-testid="proven">{m.how.proven(p.evidence.won)}</span>
                : <span class="co-badge w-fit" data-testid="hypothesis">{m.how.hypothesis}</span>}
            </li>
          ))}
        </ul>
        <a class="co-btn co-btn--ghost w-fit" href="/admin/learn">{m.how.more}</a>
      </>}
    </section>

    <section class="co-card grid content-start gap-4" data-testid="start-terms">
      <h2 class="co-entity flex items-center gap-2"><Icon name="wallet" size={18} />{m.terms.title}</h2>
      {!terms.visible ? <p class="co-help" data-testid="terms-pending">{m.terms.pending}</p> : <>
        {terms.note && <p class="whitespace-pre-line" data-testid="terms-note">{terms.note}</p>}
        {terms.plan && terms.plan.rules.length > 0 && (
          <ul class="grid gap-1">{terms.plan.rules.map((r) => <li class="co-row-title">{r.label}</li>)}</ul>
        )}
        {terms.plan?.referral && <p class="co-help">{m.terms.referral(String(terms.plan.referral.bps / 100), terms.plan.referral.months)}</p>}
        {terms.agreedAt && <p class="co-meta">{m.terms.agreed(f.date(terms.agreedAt, { day: 'numeric', month: 'long', year: 'numeric' }))}</p>}
        {history.length > 1 && (
          <details data-testid="terms-history">
            <summary class="co-meta cursor-pointer underline">{m.terms.history}</summary>
            <ol class="mt-2 grid gap-2">
              {history.map((h) => (
                <li class="co-inset !py-2 text-sm">
                  <span class="co-meta block">{m.terms.since(day(h.changedAt))}</span>
                  {h.note && <span class="block whitespace-pre-line">{h.note}</span>}
                  {h.plan && <span class="co-meta block">{h.plan.name}: {h.plan.rules.map((r) => r.label).join(' · ')}</span>}
                </li>
              ))}
            </ol>
          </details>
        )}
        <a class="co-btn co-btn--ghost w-fit" href="/admin/commissions">{m.terms.see}</a>
      </>}
    </section>
  </div>

  <section class="co-card mt-6 grid gap-3" data-testid="start-steps">
    <h2 class="co-entity flex items-center gap-2"><Icon name="list-checks" size={18} />{m.steps.title}</h2>
    <ul class="grid gap-2">
      {steps.map((s) => (
        <li>
          <a class="co-row" href={s.href} data-testid={`step-${s.key}`} data-done={s.done ? '1' : '0'} {...(s.external ? { target: '_blank', rel: 'noopener' } : {})}>
            <Icon name={s.done ? 'circle-check' : 'chevron-right'} size={18} />
            <span class="min-w-0 flex-1 co-row-title">{s.label}</span>
            <span class="co-meta">{s.done ? m.steps.done : m.steps.todo}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</AdminLayout>
