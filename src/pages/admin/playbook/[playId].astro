---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { can } from '~/lib/admin/permissions';
import { formAction } from '~/lib/admin/forms';
import { AdminError } from '~/lib/admin/service';
import { AUDIENCES, OBJECTIONS, PLAY_KINDS, STAGES, type PlayView, type TechniqueRef } from '~/lib/playbook/types';
import { i18n } from '~/lib/i18n';
import { playbookMessages } from '~/lib/i18n/messages/playbook';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
if (!can(admin.session.role).managePlaybook) return Astro.rewrite('/admin/forbidden');
const pb = admin.playbook;
const { m: msg, f: fmt } = i18n(Astro, playbookMessages);
const id = Astro.params.playId ?? '';
const isNew = id === 'new';

const all = await pb.listAll();
const current: PlayView | undefined = isNew ? undefined : all.plays.find((p) => p.id === id);
if (!isNew && !current) return Astro.rewrite('/404');

/** "707 | Título | Creador | https://…" por línea → TechniqueRef[] */
function parseRefs(src: string): TechniqueRef[] {
  return src.split('\n').map((l) => l.trim()).filter(Boolean).map((l) => {
    const [num, title, creator, url] = l.split('|').map((x) => x.trim());
    const n = Number(num);
    if (!Number.isInteger(n) || n <= 0 || !title) throw new AdminError(422, msg.play.invalidRef(l));
    return { source: 'cerebro' as const, id: n, title, ...(creator ? { creator } : {}), ...(url ? { url } : {}) };
  });
}
const refsText = (refs: TechniqueRef[]) => refs.map((r) => [r.id, r.title, r.creator ?? '', r.url ?? ''].join(' | ').replace(/( \| )+$/, '')).join('\n');

let result: { error: string | null; details: string[] } = { error: null, details: [] };
let draft: Record<string, string> | null = null;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const str = (k: string) => String(f.get(k) ?? '');
  draft = Object.fromEntries([...f.entries()].map(([k, v]) => [k, String(v)]));
  const action = str('action');
  let to = '';
  result = await formAction(async () => {
    if (action === 'archive' || action === 'restore') {
      await pb.setPlayStatus(id, action === 'archive' ? 'archived' : 'official');
      to = `/admin/playbook/${id}`;
      return;
    }
    const input = {
      moduleId: str('moduleId') || null, kind: str('kind'), stage: str('stage') || null, objection: str('objection') || null,
      segments: str('segments').split(',').map((x) => x.trim()).filter(Boolean),
      personas: str('personas').split(',').map((x) => x.trim()).filter(Boolean),
      audience: str('audience') || 'all',
      title: str('title'), body: str('body'), whenToUse: str('whenToUse'), whyItWorks: str('whyItWorks'),
      techniqueRefs: parseRefs(str('refs')), status: str('status') || 'official', key: str('key') || null,
    };
    if (isNew) { to = `/admin/playbook/${await pb.createPlay(input, str('note') || undefined)}?ok=created`; }
    else {
      if (!str('note').trim()) throw new AdminError(422, msg.play.noteRequired);
      await pb.updatePlay(id, input, str('note'));
      to = `/admin/playbook/${id}?ok=saved`;
    }
  });
  if (!result.error) return Astro.redirect(to, 303);
}

const v = (k: string, fallback: string) => draft?.[k] ?? fallback;
const cur = current;
const history = cur ? await pb.history(cur.id) : [];
const saved = Astro.url.searchParams.get('ok');
const field = 'co-input';
const date = (iso: string) => fmt.date(iso, { dateStyle: 'medium', timeStyle: 'short' });
---
<AdminLayout title={isNew ? msg.play.newPlay : cur!.title} wide>
  <a href="/admin/playbook?tab=plays" class="text-sm text-muted hover:text-ink">{msg.common.backPlaybook}</a>
  <p class="text-eyebrow mb-3">{msg.play.eyebrow}</p>
  <h1 class="co-page-title">{isNew ? msg.play.newPlay : cur!.title}</h1>
  {cur && <p class="text-sm text-muted">v{cur.version} · {cur.status === 'official' ? msg.common.official : cur.status === 'draft' ? msg.common.draft : msg.common.archivedF} · {msg.play.usedIn(cur.evidence.used, cur.evidence.won)}</p>}
  {saved && <p class="mt-3 co-alert co-alert--success" role="status">{saved === 'created' ? msg.play.created : msg.play.savedVersion}</p>}
  {result.error && (
    <div class="mt-3 co-alert co-alert--rejection" role="alert" data-testid="error">
      <p class="font-semibold">{result.error}</p>
      {result.details.length > 0 && <ul class="list-disc pl-5">{result.details.map((d) => <li>{d}</li>)}</ul>}
    </div>
  )}

  <div class="mt-5 grid gap-6 xl:grid-cols-[minmax(0,44rem)_minmax(0,1fr)]">
    <form method="post" class="space-y-4 co-card" data-testid="play-form">
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="text-sm font-medium">{msg.play.module}
          <select class={field} name="moduleId">
            <option value="">{msg.common.general}</option>
            {all.modules.map((m) => <option value={m.id} selected={v('moduleId', cur?.moduleId ?? '') === m.id}>{m.name}</option>)}
          </select>
        </label>
        <label class="text-sm font-medium">{msg.play.type}
          <select class={field} name="kind">{PLAY_KINDS.map((k) => <option value={k} selected={v('kind', cur?.kind ?? 'pitch') === k}>{msg.kind[k]}</option>)}</select>
        </label>
        <label class="text-sm font-medium">{msg.play.stage} <span class="font-normal text-muted">{msg.play.stageHint}</span>
          <select class={field} name="stage"><option value="">—</option>{STAGES.map((k) => <option value={k} selected={v('stage', cur?.stage ?? '') === k}>{msg.stage[k]}</option>)}</select>
        </label>
        <label class="text-sm font-medium">{msg.play.objection}
          <select class={field} name="objection"><option value="">—</option>{OBJECTIONS.map((k) => <option value={k} selected={v('objection', cur?.objection ?? '') === k}>{msg.objection[k]}</option>)}</select>
        </label>
      </div>
      <label class="block text-sm font-medium">{msg.play.title}<input class={field} name="title" required maxlength="200" value={v('title', cur?.title ?? '')} /></label>
      <label class="block text-sm font-medium">{msg.play.text} <span class="font-normal text-muted">{msg.play.textHint}</span>
        <textarea class={`${field} h-48`} name="body" maxlength="8000">{v('body', cur?.body ?? '')}</textarea>
      </label>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="text-sm font-medium">{msg.playCard.whenToUse}<textarea class={`${field} h-24`} name="whenToUse" maxlength="1000">{v('whenToUse', cur?.whenToUse ?? '')}</textarea></label>
        <label class="text-sm font-medium">{msg.playCard.whyItWorks}<textarea class={`${field} h-24`} name="whyItWorks" maxlength="2000">{v('whyItWorks', cur?.whyItWorks ?? '')}</textarea></label>
      </div>
      <label class="block text-sm font-medium">{msg.play.refs} <span class="font-normal text-muted">{msg.play.refsHint}</span>
        <textarea class={`${field} h-20 font-mono text-xs`} name="refs" placeholder={msg.play.refsPlaceholder}>{v('refs', refsText(cur?.techniqueRefs ?? []))}</textarea>
      </label>
      <p class="text-xs text-muted">{msg.play.refsNote}</p>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="text-sm font-medium">{msg.play.actors} <span class="font-normal text-muted">{msg.play.actorsHint}</span><input class={field} name="personas" value={v('personas', (cur?.personas ?? []).join(', '))} placeholder={msg.play.actorsPlaceholder} /></label>
        <label class="text-sm font-medium">{msg.play.audience}
          <select class={field} name="audience" data-testid="play-audience">
            {AUDIENCES.map((a) => <option value={a} selected={v('audience', cur?.audience ?? 'all') === a}>{msg.audience[a]}</option>)}
          </select>
          <span class="text-xs font-normal text-muted">{msg.play.audienceNote}</span>
        </label>
      </div>
      <div class="grid gap-3 sm:grid-cols-3">
        <label class="text-sm font-medium">{msg.play.segments}<input class={field} name="segments" value={v('segments', (cur?.segments ?? []).join(', '))} placeholder={msg.play.segmentsPlaceholder} /></label>
        <label class="text-sm font-medium">{msg.play.keyImport}<input class={field} name="key" value={v('key', cur?.key ?? '')} placeholder={msg.common.optional} /></label>
        <label class="text-sm font-medium">{msg.common.status}
          <select class={field} name="status"><option value="official" selected={v('status', cur?.status ?? 'official') === 'official'}>{msg.common.official}</option><option value="draft" selected={v('status', cur?.status ?? '') === 'draft'}>{msg.common.draft}</option></select>
        </label>
      </div>
      <label class="block text-sm font-medium">{msg.play.note} {!isNew && <span class="font-normal text-muted">{msg.play.noteHint}</span>}
        <input class={field} name="note" maxlength="500" value={v('note', '')} placeholder={isNew ? msg.common.optional : msg.play.notePlaceholder} />
      </label>
      <div class="flex flex-wrap gap-2">
        <button class="co-btn co-btn--primary" type="submit" name="action" value="save">{isNew ? msg.play.create : msg.play.saveVersion}</button>
        {cur && cur.status !== 'archived' && <button class="rounded-lg border border-line px-4 py-2 font-semibold" type="submit" name="action" value="archive" formnovalidate>{msg.play.archive}</button>}
        {cur && cur.status === 'archived' && <button class="rounded-lg border border-line px-4 py-2 font-semibold" type="submit" name="action" value="restore" formnovalidate>{msg.play.restore}</button>}
      </div>
    </form>

    {cur && (
      <aside class="space-y-4">
        <a href={`/admin/learn/${cur.moduleId ?? 'general'}#play-${cur.id}`} class="block text-sm underline">{msg.play.viewAsTeam}</a>
        <section class="co-card" data-testid="history">
          <h2 class="font-bold">{msg.play.history}</h2>
          <ol class="mt-3 space-y-3 p-0">
            {history.map((h) => (
              <li class="list-none border-l-2 border-line pl-3 text-sm">
                <p><strong>v{h.version}</strong> · {date(h.createdAt)} · {h.changedByName ?? '—'}</p>
                {h.changeNote && <p class="text-muted">{h.changeNote}</p>}
                {h.contributionId && <p class="text-xs text-violet-800">{msg.play.fromProposal}</p>}
              </li>
            ))}
          </ol>
          {history.length === 0 && <p class="text-sm text-muted">{msg.play.noHistory}</p>}
        </section>
      </aside>
    )}
  </div>
</AdminLayout>
