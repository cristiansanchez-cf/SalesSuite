---
/**
 * Configurar → Asistente de WhatsApp (docs/PLAN_AJUSTES.md, paso 5). Qué hace, a qué número escribe el equipo, quién
 * tiene ya el teléfono puesto (sin él no le reconoce), un mensaje para pasar al equipo y cómo van los recordatorios.
 * Solo admin.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Icon from '~/components/ui/Icon.astro';
import { can } from '~/lib/admin/permissions';
import { i18n } from '~/lib/i18n';
import { assistantSetupMessages } from '~/lib/i18n/messages/assistantSetup';
import { requestOrigin } from '~/lib/http';
import { appMode } from '~/lib/mode';
import { leadsFor } from '~/lib/leads/service';
import { assistantContact } from '~/lib/assistant/contact';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
if (!can(admin.session.role).manageTenant) return Astro.rewrite('/admin/forbidden');
const { m: T } = i18n(Astro, assistantSetupMessages);
const settings = await (await leadsFor(admin)).settings().catch(() => null);
const contact = await assistantContact(settings, { demo: appMode() === 'demo' });
const members = await admin.tenantAdmin.listMembers().catch(() => []);
const withPhone = members.filter((x) => (x.phone ?? '').replace(/\D/g, '').length >= 6);
const accountUrl = `${requestOrigin(Astro.request, Astro.url)}/admin/account`;
const teamMessage = contact.number ? T.team.message(contact.number, accountUrl) : null;
---
<AdminLayout title={T.title}>
  <PageHeader eyebrow={T.eyebrow} title={T.title} lede={T.lede} />

  <div class="grid max-w-5xl gap-6 lg:grid-cols-[1fr_22rem]">
    <div class="grid content-start gap-6">
      <section class="co-card grid gap-3 !p-6" data-testid="assistant-status" data-mode={contact.mode}>
        <p class="flex items-start gap-2"><Icon name={contact.mode === 'off' ? 'circle-dashed' : 'circle-check'} size={18} />{T.status[contact.mode]}</p>
        {contact.mode !== 'off' && (
          <div class="co-inset flex flex-wrap items-center justify-between gap-3 !p-4">
            <div>
              <p class="co-meta">{T.status.number}</p>
              <p class="text-3xl [font-family:var(--co-font-impact)] font-semibold" data-testid="assistant-number">{contact.number ?? '—'}</p>
              {!contact.number && <p class="co-meta">{T.status.unknown}</p>}
            </div>
            {contact.waLink && <a class="co-btn co-btn--primary" href={contact.waLink} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={16} />{T.status.open}</a>}
          </div>
        )}
      </section>

      <section class="co-card grid gap-3 !p-6" data-testid="assistant-team">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="co-entity !text-lg">{T.team.title}</h2>
          {members.length > 0 && <span class="co-meta" data-testid="assistant-team-count">{T.team.count(withPhone.length, members.length)}</span>}
        </div>
        <p class="co-meta">{T.team.lede}</p>
        {members.length === 0
          ? <p class="co-meta">{T.team.empty}</p>
          : (
            <ul class="grid gap-2">
              {members.map((x) => {
                const ok = withPhone.includes(x);
                return (
                  <li class="co-inset flex flex-wrap items-center justify-between gap-2 !px-4 !py-2" data-testid="assistant-member" data-ok={ok ? '1' : '0'}>
                    <span class="grid min-w-0"><span class="truncate font-semibold">{x.displayName || x.email}</span>{x.displayName && <span class="co-meta truncate">{x.email}</span>}</span>
                    <span class={`co-badge ${ok ? 'co-badge--signal' : 'co-badge--attention'}`}>{ok ? T.team.ready : T.team.missing}</span>
                  </li>
                );
              })}
            </ul>
          )}
        {teamMessage && (
          <div class="grid gap-2 border-t border-[var(--console-divider)] pt-4">
            <p class="font-semibold">{T.team.copyTitle}</p>
            <p class="co-meta">{T.team.copyHelp}</p>
            <textarea class="co-textarea h-32 text-sm" readonly data-testid="assistant-team-message">{teamMessage}</textarea>
            <button type="button" class="co-btn co-btn--ghost w-fit" data-copy-team data-copied={T.team.copied}><Icon name="copy" size={16} /><span>{T.team.copy}</span></button>
          </div>
        )}
      </section>

      <section class="co-card grid gap-2 !p-6" data-testid="assistant-reminders">
        <h2 class="co-entity !text-lg">{T.reminders.title}</h2>
        <p class="co-meta">{T.reminders.lede}</p>
        <p class="flex items-start gap-2">
          <Icon name={contact.reminder.template ? 'circle-check' : 'circle-dashed'} size={18} />
          {contact.reminder.byPlatform && contact.reminder.template ? T.reminders.platform(contact.reminder.template)
            : contact.reminder.template ? T.reminders.own(contact.reminder.template) : T.reminders.missing}
        </p>
      </section>
    </div>

    <aside class="grid content-start gap-4">
      <section class="co-card grid gap-3 !p-6">
        <h2 class="co-entity !text-lg">{T.how.title}</h2>
        <ol class="grid list-decimal gap-2 pl-5 text-sm">{T.how.items.map((x) => <li>{x}</li>)}</ol>
      </section>
      <section class="grid gap-2 rounded-2xl bg-[#efeae2] p-4" aria-hidden="true">
        <p class="ml-auto max-w-[85%] rounded-lg bg-[#d9fdd3] px-3 py-2 text-sm text-[#111b21] shadow-sm">{T.chat.me}</p>
        <p class="max-w-[85%] rounded-lg bg-white px-3 py-2 text-sm text-[#111b21] shadow-sm">{T.chat.bot}</p>
        <p class="ml-auto rounded-lg bg-[#d9fdd3] px-3 py-2 text-sm text-[#111b21] shadow-sm">{T.chat.yes}</p>
        <p class="max-w-[85%] rounded-lg bg-white px-3 py-2 text-sm text-[#111b21] shadow-sm">✓ {T.chat.saved}</p>
      </section>
    </aside>
  </div>
</AdminLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-team]').forEach((b) => b.addEventListener('click', async () => {
    const t = b.parentElement!.querySelector('textarea')!;
    try { await navigator.clipboard.writeText(t.value); } catch { t.select(); }
    const label = b.querySelector('span')!;
    const before = label.textContent;
    label.textContent = b.dataset.copied ?? before;
    setTimeout(() => { label.textContent = before; }, 1600);
  }));
</script>
