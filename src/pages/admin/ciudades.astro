---
/**
 * Ciudades (docs/CRM_DINAMICO.md §14). Arriba, lo pendiente (cada fila con ✓ o con su botón); abajo, el árbol de lo que ya
 * hay, con «Revisar con IA» y «Ajustar». Ordenar: la IA clasifica cada texto del campo «Ciudad» (por trozos, desde el
 * navegador), el admin revisa la vista previa (desmarca lo que no le convence) y aplica. Se puede deshacer; al final,
 * borrar las ciudades vacías.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import Icon from '~/components/ui/Icon.astro';
import ConfirmDialog from '~/components/ui/ConfirmDialog.astro';
import { can } from '~/lib/admin/permissions';
import { flash, formAction } from '~/lib/admin/forms';
import { i18n } from '~/lib/i18n';
import { zonesMessages } from '~/lib/i18n/messages/zones';
import { REVIEW_TAG, ZONE_KINDS, type ZoneFix, type ZonePlan } from '~/lib/crm/zones-normalize';
import { accountsMessages } from '~/lib/i18n/messages/accounts';
import { NO_ZONE } from '~/lib/accounts/service';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
if (!can(admin.session.role).importCrm) return Astro.rewrite('/admin/forbidden');
const { m: M, f: fmt } = i18n(Astro, zonesMessages);

let result: { error: string | null; details: string[] } = { error: null, details: [] };
const box: { plan: ZonePlan | null; classes: string; fixes: ZoneFix[] | null } = { plan: null, classes: '', fixes: null };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const str = (k: string) => String(f.get(k) ?? '');
  const json = () => { try { return JSON.parse(str('classes') || '[]') as unknown; } catch { return []; } };
  let to = '';
  result = await formAction(async () => {
    switch (str('action')) {
      case 'preview': box.plan = await admin.crm.zonesPlan(json()); box.classes = str('classes'); break;
      case 'apply': {
        // Lo desmarcado en la vista previa se queda como está.
        const all = f.getAll('all').map(String);
        const keep = new Set(f.getAll('keep').map(String));
        const r = await admin.crm.zonesApply(json(), all.filter((id) => !keep.has(id)));
        to = `/admin/ciudades?ok=applied&m=${r.moved}&r=${r.review}`;
        break;
      }
      case 'undo': await admin.crm.zonesUndo(str('id')); to = '/admin/ciudades?ok=undone'; break;
      case 'review': box.fixes = await admin.crm.zonesReview(); break;
      case 'fix': {
        // Lo que la IA propuso y sigue marcado.
        const all = (() => { try { return JSON.parse(str('fixes') || '[]') as ZoneFix[]; } catch { return []; } })();
        const keep = new Set(f.getAll('keep').map(String));
        const r = await admin.crm.zonesFix(all.filter((_, i) => keep.has(String(i))));
        to = `/admin/ciudades?ok=fixed&n=${r.applied}#terminar`;
        break;
      }
      case 'fix-one': {
        // A mano: juntar, o cambiar nombre, tipo y sitio (solo lo que cambia).
        const id = str('id');
        const ops: unknown[] = str('merge') ? [{ op: 'merge', id, target: str('merge') }]
          : [{ op: 'rename', id, name: str('name') }, { op: 'kind', id, kind: str('kind') }, { op: 'move', id, target: str('parent') || null }];
        const r = await admin.crm.zonesFix(ops);
        to = `/admin/ciudades?ok=fixed&n=${r.applied}#terminar`;
        break;
      }
      case 'cleanup': to = `/admin/ciudades?ok=cleaned&n=${await admin.crm.zonesCleanup()}`; break;
    }
  });
  if (!result.error && to) return Astro.redirect(to, 303);
}
const o = await admin.crm.zonesOverview();
const q = Astro.url.searchParams;
const okMsg = flash(Astro.url, { fixed: M.finish.applied(Number(q.get('n')) || 0), applied: M.applied(Number(q.get('m')) || 0, Number(q.get('r')) || 0), undone: M.undone, cleaned: M.cleaned(Number(q.get('n')) || 0) });
const plan = box.plan;
const fixes = box.fixes;
const AM = accountsMessages[i18n(Astro, accountsMessages).locale];
const KIND = AM.territory.kind;
const tree = plan ? [] : await admin.crm.zonesTree();
const nameOf = (id: string | null) => (id ? tree.find((z) => z.id === id)?.path ?? '' : M.finish.top);
const fixLabel = (x: ZoneFix) => {
  const z = nameOf(x.id);
  return x.op === 'merge' ? M.finish.ops.merge(z, nameOf(x.target)) : x.op === 'rename' ? M.finish.ops.rename(z, x.name)
    : x.op === 'kind' ? M.finish.ops.kind(z, KIND[x.kind].toLowerCase()) : M.finish.ops.move(z, nameOf(x.target));
};
---
<AdminLayout title={M.title}>
  <PageHeader eyebrow={M.eyebrow} title={M.title} lede={M.lede} />
  {okMsg && <div class="mb-4"><Alert kind="success" title={okMsg} /></div>}
  {okMsg && Number(q.get('r')) > 0 && <p class="mb-4"><a class="co-btn co-btn--ghost co-btn--sm" href={`/admin/accounts?ver=all&lista=${REVIEW_TAG}`} data-testid="zones-see-review">{M.seeReview}</a></p>}
  {result.error && <div class="mb-4"><Alert kind="rejection" title={result.error} details={result.details} /></div>}

  {!plan ? (
    <section class="co-section max-w-3xl" data-testid="zones-start">
      <div class="co-section__head"><h2 class="co-entity">{M.todo.title}</h2></div>
      {/* Cada fila: ✓ si está hecho; si no, qué falta y el botón para hacerlo. */}
      <ul class="co-card co-card--flush m-0 p-0">
        <li class="zones-todo" data-testid="zones-todo-raws" data-done={o.raws.length === 0 ? '' : undefined}>
          <span class="zones-todo__icon"><Icon name={o.raws.length ? 'triangle-alert' : 'check'} size={16} /></span>
          <span class="flex-1">
            <span class="co-row-title block">{o.raws.length ? M.todo.raws(o.raws.length) : M.todo.rawsDone}</span>
            {o.raws.length > 0 && <span class="co-meta block">{M.todo.rawsHelp}</span>}
            <span class="co-meta block" role="status" hidden data-zones-status data-testid="zones-status"></span>
          </span>
          {o.raws.length > 0 && o.hasAi && (
            <button type="button" class="co-btn co-btn--primary co-btn--sm" data-zones-analyze data-testid="zones-analyze"><Icon name="sparkles" size={14} />{M.analyze}</button>
          )}
        </li>
        <li class="zones-todo" data-done={o.review === 0 ? '' : undefined}>
          <span class="zones-todo__icon"><Icon name={o.review ? 'triangle-alert' : 'check'} size={16} /></span>
          <span class="flex-1">
            <span class="co-row-title block">{o.review ? M.todo.review(o.review) : M.todo.reviewDone}</span>
            {o.review > 0 && <span class="co-meta block">{M.todo.reviewHelp}</span>}
          </span>
          {o.review > 0 && <a class="co-btn co-btn--ghost co-btn--sm" href={`/admin/accounts?ver=all&lista=${REVIEW_TAG}`} data-testid="zones-todo-review">{M.todo.see}</a>}
        </li>
        <li class="zones-todo" data-done={o.noCity === 0 ? '' : undefined}>
          <span class="zones-todo__icon"><Icon name={o.noCity ? 'triangle-alert' : 'check'} size={16} /></span>
          <span class="flex-1">
            <span class="co-row-title block">{o.noCity ? M.todo.noCity(o.noCity) : M.todo.noCityDone}</span>
            {o.noCity > 0 && <span class="co-meta block">{M.todo.noCityHelp}</span>}
          </span>
          {o.noCity > 0 && <a class="co-btn co-btn--ghost co-btn--sm" href={`/admin/accounts?ver=all&zona=${NO_ZONE}`} data-testid="zones-todo-nocity">{M.todo.see}</a>}
        </li>
        <li class="zones-todo" data-done={o.empty === 0 ? '' : undefined}>
          <span class="zones-todo__icon"><Icon name={o.empty ? 'triangle-alert' : 'check'} size={16} /></span>
          <span class="co-row-title flex-1">{o.empty ? M.todo.empty(o.empty) : M.todo.emptyDone}</span>
          {o.empty > 0 && <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-dialog-open="zones-cleanup" data-testid="zones-cleanup"><Icon name="archive" size={14} />{M.cleanup(o.empty)}</button>}
        </li>
      </ul>
      {o.last && (
        <form method="post" class="mt-3 flex flex-wrap items-center gap-3" data-testid="zones-last">
          <input type="hidden" name="action" value="undo" /><input type="hidden" name="id" value={o.last.id} />
          <span class="co-meta">{M.last(Number(o.last.summary.moved) || 0, fmt.relative(o.last.createdAt))}</span>
          <button class="co-btn co-btn--quiet co-btn--sm" type="submit" data-testid="zones-undo"><Icon name="rotate-ccw" size={14} />{M.undo}</button>
        </form>
      )}
      <form method="post" hidden data-zones-preview><input type="hidden" name="action" value="preview" /><input type="hidden" name="classes" /></form>
    </section>
  ) : null}

  {!plan && tree.length > 0 && (
    <section id="terminar" class="co-section mt-8" data-testid="zones-finish">
      <div class="co-section__head"><h2 class="co-entity">{M.finish.title}</h2></div>
      <p class="co-body mb-3 max-w-3xl">{M.finish.help}</p>
      {o.hasAi && admin.crm.hasZoneFixAi() && !fixes && (
        <form method="post" action="#terminar" class="mb-4" data-zones-busy>
          <input type="hidden" name="action" value="review" />
          <button class="co-btn co-btn--primary" type="submit" data-testid="zones-review" data-busy-label={M.finish.reviewing}><Icon name="sparkles" size={16} /><span>{M.finish.review}</span></button>
        </form>
      )}
      {fixes && (fixes.length === 0 ? <p class="co-row-title mb-4 flex items-center gap-2" data-testid="zones-fixes-none"><Icon name="check" size={16} />{M.finish.none}</p> : (
        <form method="post" action="#terminar" class="co-card mb-4 grid gap-3 !p-4" data-testid="zones-fixes">
          <input type="hidden" name="action" value="fix" />
          <input type="hidden" name="fixes" value={JSON.stringify(fixes)} />
          <p class="co-row-title">{M.finish.proposals(fixes.length)}</p>
          <ul class="m-0 grid gap-1.5 p-0">
            {fixes.map((x, i) => (
              <li class="list-none text-sm">
                <label class="flex items-baseline gap-2"><input type="checkbox" name="keep" value={String(i)} checked class="h-4 w-4 accent-[var(--co-ink)]" data-testid="zones-fix" data-op={x.op} />
                  <span><strong>{fixLabel(x)}</strong>{x.reason && <span class="co-meta"> · {x.reason}</span>}</span></label>
              </li>
            ))}
          </ul>
          <p class="co-help">{M.finish.noUndo}</p>
          <button class="co-btn co-btn--primary w-fit" type="submit" data-testid="zones-fixes-apply"><Icon name="check" size={16} />{M.finish.apply}</button>
        </form>
      ))}
      <ul class="co-card co-card--flush m-0 p-0" data-testid="zones-tree">
        {tree.map((z) => (
          <li class="flex list-none flex-wrap items-center gap-2 border-b border-line px-4 py-2 last:border-b-0" style={`padding-left:${16 + z.depth * 22}px`} data-testid="zones-node" data-name={z.name} data-kind={z.kind}>
            <span class="co-row-title">{z.name}</span><span class="co-meta">{KIND[z.kind]}</span>
            <span class="co-meta ml-auto">{M.finish.counts(z.direct, z.total)}</span>
            <button type="button" class="co-btn co-btn--quiet co-btn--sm" data-adjust={z.id} data-name={z.name} data-kind={z.kind} data-parent={z.parentId ?? ''} data-testid="zones-adjust">{M.finish.adjust}</button>
          </li>
        ))}
      </ul>
      <dialog id="zone-adjust" class="co-dialog" aria-labelledby="zone-adjust-title">
        <form method="post" action="#terminar" data-testid="zone-adjust-form">
          <input type="hidden" name="action" value="fix-one" /><input type="hidden" name="id" />
          <div class="co-dialog__body grid gap-3">
            <h2 id="zone-adjust-title" class="co-entity" data-adjust-title></h2>
            <label class="co-field">{M.finish.name}<input class="co-input" name="name" required maxlength="80" /></label>
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="co-field">{M.finish.kind}<select class="co-select" name="kind">{ZONE_KINDS.map((k) => <option value={k}>{KIND[k]}</option>)}</select></label>
              <label class="co-field">{M.finish.inside}<select class="co-select" name="parent"><option value="">{M.finish.top}</option>{tree.map((z) => <option value={z.id}>{z.path}</option>)}</select></label>
            </div>
            <label class="co-field">{M.finish.mergeInto}
              <select class="co-select" name="merge" data-testid="zone-adjust-merge"><option value="">{M.finish.mergeNone}</option>{tree.map((z) => <option value={z.id}>{z.path}</option>)}</select>
              <span class="co-help">{M.finish.mergeHelp}</span></label>
          </div>
          <div class="co-dialog__foot">
            <button type="button" class="co-btn co-btn--ghost" data-dialog-close>{M.finish.cancel}</button>
            <button type="submit" class="co-btn co-btn--primary" data-testid="zone-adjust-save">{M.finish.save}</button>
          </div>
        </form>
      </dialog>
    </section>
  )}

  {plan && (
    <form method="post" class="grid gap-4" data-testid="zones-preview">
      <input type="hidden" name="action" value="apply" />
      <input type="hidden" name="classes" value={box.classes} />
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="co-entity">{M.previewTitle}</h2>
        <p class="co-meta">{M.same(plan.same)}</p>
      </div>
      <p class="co-body max-w-3xl">{M.previewHelp}</p>
      <ul class="m-0 grid gap-3 p-0">
        {plan.groups.map((g) => (
          <li class="co-card grid list-none gap-2 !p-4" data-testid="zones-group" data-label={g.label}>
            <p class="co-row-title flex flex-wrap items-center gap-1">
              <Icon name="map-pin" size={14} />
              {g.path.map((p, i) => <>{i > 0 && <span class="co-meta">›</span>}<span>{p.name}</span>{!p.existingId && <span class="co-tag !py-0 text-[11px]">{M.newZone}</span>}</>)}
            </p>
            <ul class="m-0 grid gap-1 p-0">
              {g.sources.map((x) => (
                <li class="flex list-none flex-wrap items-baseline gap-2 text-sm">
                  <input type="hidden" name="all" value={x.zoneId} />
                  <label class="flex items-baseline gap-2">
                    <input type="checkbox" name="keep" value={x.zoneId} checked class="h-4 w-4 accent-[var(--co-ink)]" data-testid="zones-keep" />
                    <span>«{x.raw}»</span>
                  </label>
                  <span class="co-meta">{M.accounts(x.accounts)}</span>
                  {x.review && <span class="co-tag co-tag--danger !py-0 text-[11px]" data-testid="zones-review">⚠ {M.review}</span>}
                  {x.note && <span class="co-meta">· {M.note}: {x.note}</span>}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      {plan.junk.length > 0 && (
        <section class="co-card grid gap-2 !p-4" data-testid="zones-junk">
          <h3 class="co-row-title">{M.junkTitle}</h3>
          <p class="co-meta">{M.junkHelp}</p>
          <ul class="m-0 grid gap-1 p-0">
            {plan.junk.map((x) => (
              <li class="flex list-none flex-wrap items-baseline gap-2 text-sm">
                <input type="hidden" name="all" value={x.zoneId} />
                <label class="flex items-baseline gap-2"><input type="checkbox" name="keep" value={x.zoneId} checked class="h-4 w-4 accent-[var(--co-ink)]" /><span>«{x.raw}»</span></label>
                <span class="co-meta">{M.accounts(x.accounts)}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
      <div class="sticky bottom-0 flex flex-wrap gap-3 bg-[var(--co-bg)] py-3">
        <button class="co-btn co-btn--primary" type="submit" data-testid="zones-apply"><Icon name="check" size={16} />{M.apply}</button>
        <a class="co-btn co-btn--ghost" href="/admin/ciudades">{M.cancel}</a>
      </div>
    </form>
  )}

  <ConfirmDialog id="zones-cleanup" title={M.cleanupTitle} does={M.cleanupBody} doesNot={M.cleanupNot} confirmLabel={M.cleanup(o.empty)} danger testid="zones-cleanup-dialog">
    <input type="hidden" name="action" value="cleanup" />
  </ConfirmDialog>
</AdminLayout>

<style>
  .zones-todo { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; list-style: none; border-bottom: 1px solid var(--co-rule); }
  .zones-todo:last-child { border-bottom: 0; }
  .zones-todo__icon { display: inline-flex; width: 1.75rem; height: 1.75rem; flex: none; align-items: center; justify-content: center; border-radius: 999px; background: #fff4e0; color: #a15c00; }
  .zones-todo[data-done] .zones-todo__icon { background: #e6f4ea; color: #1e7b34; }
  .zones-todo[data-done] .co-row-title { color: var(--co-ink-soft); font-weight: 500; }
</style>

<script define:vars={{ raws: o.raws, chunk: o.chunk, T: { analyzing: M.analyzing('{i}', '{n}'), stay: M.stay, failed: M.failed } }}>
  // Analizar: los textos van a la IA por trozos (cada trozo es una petición corta) y, al acabar, a la vista previa.
  document.querySelector('[data-zones-analyze]')?.addEventListener('click', async (ev) => {
    const btn = ev.currentTarget;
    const status = document.querySelector('[data-zones-status]');
    const form = document.querySelector('[data-zones-preview]');
    btn.disabled = true; status.hidden = false;
    const parts = [];
    for (let i = 0; i < raws.length; i += chunk) parts.push(raws.slice(i, i + chunk));
    const places = [];
    for (const [i, part] of parts.entries()) {
      status.textContent = `${T.analyzing.replace('{i}', String(i + 1)).replace('{n}', String(parts.length))} ${T.stay}`;
      const res = await fetch('/admin/api/crm/zones-classify', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ raws: part }) }).catch(() => null);
      const j = res ? await res.json().catch(() => ({})) : {};
      if (!res || !res.ok || !Array.isArray(j.places)) { status.textContent = j.error || T.failed; btn.disabled = false; return; }
      places.push(...j.places);
    }
    form.querySelector('[name=classes]').value = JSON.stringify(places);
    form.submit();
  });
</script>

<script define:vars={{ title: M.finish.dialog('{name}') }}>
  // «Ajustar»: un solo diálogo para todas las zonas; se rellena con la que se pulsa.
  const dlg = document.getElementById('zone-adjust');
  document.querySelectorAll('[data-adjust]').forEach((b) => b.addEventListener('click', () => {
    if (!dlg) return;
    const field = (n) => dlg.querySelector(`[name="${n}"]`);
    field('id').value = b.dataset.adjust; field('name').value = b.dataset.name; field('kind').value = b.dataset.kind;
    field('parent').value = b.dataset.parent; field('merge').value = '';
    // No se puede meter dentro de sí misma ni juntarse consigo misma.
    for (const sel of [field('parent'), field('merge')]) for (const o of sel.options) o.disabled = o.value === b.dataset.adjust;
    dlg.querySelector('[data-adjust-title]').textContent = title.replace('{name}', b.dataset.name);
    dlg.showModal();
  }));
  // Revisar con IA tarda: el botón lo dice y no se pulsa dos veces.
  document.querySelectorAll('form[data-zones-busy]').forEach((f) => f.addEventListener('submit', () => {
    const b = f.querySelector('button'); if (!b) return;
    b.disabled = true; const sp = b.querySelector('span'); if (sp) sp.textContent = b.dataset.busyLabel ?? '';
  }));
</script>
