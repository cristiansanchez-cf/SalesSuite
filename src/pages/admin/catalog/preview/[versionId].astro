---
import DossierView from '~/components/dossier/DossierView.astro';
import { AdminError } from '~/lib/admin/service';
import { i18n } from '~/lib/i18n';
import { teamMessages } from '~/lib/i18n/messages/team';

const { admin, tenant } = Astro.locals;
if (!admin || !tenant) return Astro.redirect('/admin/login');
let dossier;
try {
  dossier = await admin.tenantAdmin.previewVersion(Astro.params.versionId ?? '', tenant.defaultLocale);
} catch (e) {
  if (e instanceof AdminError && (e.status === 404 || e.status === 403)) return Astro.rewrite('/404');
  throw e;
}
---
<DossierView tenant={tenant} dossier={dossier} banner={i18n(Astro, teamMessages).m.catalog.previewBanner(dossier.title)} />
