---
/**
 * Catálogo con tu IA (docs/CATALOG_AI.md): copiar el prompt → contestar con su ChatGPT o Claude (con su presentación de
 * ahora adjunta) → pegar lo que devuelva → revisar → crear BORRADORES (nunca publica solo). Solo el admin del espacio.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import { formAction } from '~/lib/admin/forms';
import { AdminError } from '~/lib/admin/service';
import { REGISTRY, isBlockType } from '~/modules/registry';
import { i18n } from '~/lib/i18n';
import { teamMessages } from '~/lib/i18n/messages/team';
import { catalogAiMessages } from '~/lib/i18n/messages/catalogAi';
import { applyKit, kitPrompt, planKit, readKit, type Kit, type KitRow } from '~/lib/catalog/ai-kit';

const { admin, tenant } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
if (admin.session.role !== 'admin') return Astro.rewrite('/admin/forbidden');
const t = admin.tenantAdmin;
const { m } = i18n(Astro, catalogAiMessages);
const { m: { catalog: C } } = i18n(Astro, teamMessages);

const catalogOf = async () => (await t.listCatalog()).map((x) => {
  const last = [...x.versions].sort((a, b) => b.version - a.version)[0];
  return { key: x.key, blockType: x.blockType, name: x.name, description: x.description, props: last?.defaultProps ?? {} };
});

let answer = '';
const st: { kit: Kit | null; rows: KitRow[] | null; redirect: string | null } = { kit: null, rows: null, redirect: null };
let result: { error: string | null; details: string[] } = { error: null, details: [] };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  answer = String(f.get('answer') ?? '');
  result = await formAction(async () => {
    const { kit, errors } = readKit(answer);
    if (!kit) throw new AdminError(422, errors[0] ?? 'No encuentro el JSON: pega el bloque de código que te ha devuelto', errors.slice(1));
    const rows = planKit(kit, await catalogOf());
    if (f.get('action') === 'import') {
      const made = await applyKit(kit, rows, t);
      st.redirect = `/admin/catalog?ok=kit&n=${made.length}`;
      return;
    }
    st.kit = kit; st.rows = rows;
  });
  if (st.redirect) return Astro.redirect(st.redirect, 303);
}

const who = (admin.session.displayName || admin.session.email.split('@')[0]).split(' ')[0];
const prompt = kitPrompt({ company: tenant?.name ?? 'nuestra empresa', person: who, locale: tenant?.defaultLocale ?? 'es-ES', catalog: await catalogOf() });
const rows = st.rows;
const toCreate = rows?.filter((r) => r.action === 'new' || r.action === 'update').length ?? 0;
const BADGE: Record<string, string> = { new: 'co-badge co-badge--ink', update: 'co-badge', same: 'co-badge co-badge--soft', invalid: 'co-badge co-badge--attention' };
const typeLabel = (k: string) => (isBlockType(k) ? C.blockTypes[k] ?? REGISTRY[k].label : k);
---
<AdminLayout title={m.title}>
  <a href="/admin/catalog" class="text-sm text-muted hover:text-ink">← {m.back}</a>
  <p class="text-eyebrow mb-3 mt-2">{C.eyebrow}</p>
  <h1 class="co-page-title">{m.title}</h1>
  <p class="co-lede max-w-3xl">{m.lede}</p>

  {result.error && (
    <div class="mt-4 co-alert co-alert--rejection" role="alert" data-testid="kit-error">
      <p class="font-semibold">{result.error}</p>
      {result.details.length > 0 && <ul class="list-disc pl-5">{result.details.map((d) => <li>{d}</li>)}</ul>}
    </div>
  )}

  {rows ? (
    <section class="mt-5 co-card grid gap-4" data-testid="kit-review">
      <h2 class="co-card-title">{m.reviewTitle}</h2>
      <table class="w-full text-sm">
        <thead><tr class="text-left text-xs text-muted"><th class="py-1">{m.colModule}</th><th>{m.colType}</th><th>{m.colWhat}</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-t border-line align-top" data-testid="kit-row" data-key={r.key} data-action={r.action}>
              <td class="py-2"><b>{r.name}</b><span class="block text-xs text-muted"><code>{r.key}</code></span></td>
              <td class="py-2">{typeLabel(r.blockType)}</td>
              <td class="py-2"><span class={BADGE[r.action]}>{m.actions[r.action]}</span>
                {r.errors.length > 0 && <ul class="mt-1 list-disc pl-4 text-xs text-red-700">{r.errors.map((e) => <li>{e}</li>)}</ul>}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {rows.some((r) => r.action === 'invalid') && <p class="co-help">{m.invalidHelp}</p>}
      {st.kit && st.kit.peticiones.length > 0 && (
        <div class="co-inset grid gap-1" data-testid="kit-requests">
          <p class="font-semibold">{m.requests}</p>
          <p class="co-help">{m.requestsHelp}</p>
          <ul class="list-disc pl-5 text-sm">{st.kit.peticiones.map((p) => <li>{p}</li>)}</ul>
        </div>
      )}
      <form method="post" class="flex flex-wrap items-center gap-3">
        <textarea name="answer" hidden>{answer}</textarea>
        {toCreate > 0
          ? <button class="co-btn co-btn--primary" name="action" value="import" type="submit" data-testid="kit-import">{m.create(toCreate)}</button>
          : <p class="co-help">{m.nothing}</p>}
        <a class="co-btn co-btn--ghost" href="/admin/catalog/ia">{m.review}…</a>
      </form>
    </section>
  ) : (
    <div class="mt-5 grid gap-5 lg:grid-cols-2">
      <section class="co-card grid gap-3 content-start">
        <h2 class="co-card-title">{m.step1}</h2>
        <p class="co-help">{m.step1Help}</p>
        <textarea class="co-input h-64 font-mono text-xs" readonly data-kit-prompt data-testid="kit-prompt">{prompt}</textarea>
        <div><button type="button" class="co-btn co-btn--primary co-btn--sm" data-kit-copy data-done={m.copied}>{m.copy}</button></div>
        <p class="co-help">{m.tipAttach}</p>
        <p class="co-help">{m.tipInteractive}</p>
      </section>
      <form method="post" class="co-card grid gap-3 content-start">
        <h2 class="co-card-title">{m.step2}</h2>
        <p class="co-help">{m.step2Help}</p>
        <textarea class="co-input h-64 font-mono text-xs" name="answer" required spellcheck="false" data-testid="kit-answer">{answer}</textarea>
        <div><button class="co-btn co-btn--primary" name="action" value="review" type="submit" data-testid="kit-review-btn">{m.review}</button></div>
      </form>
    </div>
  )}
</AdminLayout>

<script>
  document.querySelector<HTMLButtonElement>('[data-kit-copy]')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    const ta = document.querySelector<HTMLTextAreaElement>('[data-kit-prompt]');
    if (!ta) return;
    try { await navigator.clipboard.writeText(ta.value); } catch { ta.select(); return; }
    const txt = b.textContent; b.textContent = b.dataset.done ?? txt; setTimeout(() => { b.textContent = txt; }, 1800);
  });
</script>
