---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { flash, formAction } from '~/lib/admin/forms';
import { AdminError } from '~/lib/admin/service';
import { REGISTRY, isBlockType } from '~/modules/registry';
import { i18n } from '~/lib/i18n';
import { teamMessages } from '~/lib/i18n/messages/team';
import { catalogAiMessages } from '~/lib/i18n/messages/catalogAi';
import { catalogEditAi, changedTexts, MAX_INSTRUCTION } from '~/lib/catalog/ai-edit';
import { env } from '~/lib/env';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
if (admin.session.role !== 'admin') return Astro.rewrite('/admin/forbidden');
const t = admin.tenantAdmin;
const { m: { catalog: M } } = i18n(Astro, teamMessages);
const { m: AI } = i18n(Astro, catalogAiMessages);
const editAi = catalogEditAi(env);
// Tras un cambio con IA en una versión publicada, la página sigue en el borrador nuevo.
let versionId = Astro.params.versionId ?? '';
const aiDone: { summary: string; changes: Array<{ path: string; before: string; after: string }>; prev: string | null } = { summary: '', changes: [], prev: null };
let undone = false;
let instruction = '';

let result: { error: string | null; details: string[] } = { error: null, details: [] };
let draftJson: string | null = null;
let draftPrice: string | null = null;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = String(f.get('action'));
  if (f.has('defaultProps')) { draftJson = String(f.get('defaultProps') ?? ''); draftPrice = String(f.get('defaultPrice') ?? ''); }
  let ok = 'saved';
  result = await formAction(async () => {
    if (action === 'ai') {
      instruction = String(f.get('instruction') ?? '').trim();
      if (!instruction) throw new AdminError(422, AI.askEmpty);
      if (instruction.length > MAX_INSTRUCTION) throw new AdminError(422, AI.askTooLong(MAX_INSTRUCTION));
      if (!editAi) throw new AdminError(503, AI.askNoAi);
      const cat = await t.listCatalog();
      const m0 = cat.find((x) => x.versions.some((y) => y.id === versionId));
      const v0 = m0?.versions.find((y) => y.id === versionId);
      if (!m0 || !v0 || v0.status === 'archived') throw new AdminError(404, 'Versión no encontrada');
      await admin.crm.aiQuota();
      let out;
      try {
        out = await editAi.edit({ blockType: m0.blockType, name: m0.name, props: v0.defaultProps as Record<string, unknown>, instruction, locale: Astro.locals.tenant?.defaultLocale ?? 'es-ES' });
      } catch (e) { console.warn('[catalog-ai]', e instanceof Error ? e.message : e); throw new AdminError(503, AI.askDown); }
      if (!out) throw new AdminError(422, AI.askFailed);
      const changes = changedTexts(v0.defaultProps, out.props);
      aiDone.summary = out.summary;
      if (!changes.length && JSON.stringify(v0.defaultProps) === JSON.stringify(out.props)) { aiDone.summary = `${AI.askNoChange}: ${out.summary}`; ok = 'none'; return; }
      // Siempre en un borrador: el que haya o uno nuevo desde esta versión.
      const draftId = v0.status === 'draft' ? v0.id : await t.newDraft(m0.id, v0.id);
      const draft = (await t.listCatalog()).flatMap((x) => x.versions).find((y) => y.id === draftId)!;
      aiDone.prev = JSON.stringify(draft.defaultProps);
      await t.saveDraft(draftId, { defaultProps: out.props, defaultPrice: draft.defaultPrice, currency: draft.currency });
      aiDone.changes = changedTexts(draft.defaultProps, out.props).slice(0, 12);
      versionId = draftId;
      instruction = '';
      ok = 'ai';
      return;
    }
    if (action === 'undo') {
      let prev: unknown;
      try { prev = JSON.parse(String(f.get('prev') ?? '')); } catch { throw new AdminError(422, M.errJson); }
      const cur = (await t.listCatalog()).flatMap((x) => x.versions).find((y) => y.id === versionId);
      if (!cur) throw new AdminError(404, 'Versión no encontrada');
      await t.saveDraft(versionId, { defaultProps: prev, defaultPrice: cur.defaultPrice, currency: cur.currency });
      ok = 'undone';
      return;
    }
    if (action === 'save' || action === 'publish') {
      let props: unknown;
      try { props = JSON.parse(draftJson || '{}'); } catch { throw new AdminError(422, M.errJson); }
      const p = draftPrice!.trim().replace(',', '.');
      await t.saveDraft(versionId, { defaultProps: props, defaultPrice: p === '' ? null : Number(p), currency: String(f.get('currency') ?? 'EUR') });
      if (action === 'publish') { await t.publish(versionId); ok = 'published'; }
    }
  });
  if (ok === 'undone') undone = true;
  else if (!result.error && ok !== 'ai' && ok !== 'none') return Astro.redirect(ok === 'published' ? '/admin/catalog?ok=published' : `/admin/catalog/${versionId}?ok=saved`, 303);
}

const catalog = await t.listCatalog();
const mod = catalog.find((m) => m.versions.some((v) => v.id === versionId));
if (!mod) return Astro.rewrite('/404');
const v = mod.versions.find((x) => x.id === versionId)!;
const editable = v.status === 'draft';
const example = isBlockType(mod.blockType) ? REGISTRY[mod.blockType].example : {};
const okMsg = flash(Astro.url, { saved: M.okSaved, created: M.okCreated });
const field = 'co-input disabled:bg-surface';
---
<AdminLayout title={`${mod.name} · v${v.version}`} wide>
  <a href="/admin/catalog" class="text-sm text-muted hover:text-ink">← {M.title}</a>
  <p class="text-eyebrow mb-3">{M.versionEyebrow}</p>
  <h1 class="co-page-title">{mod.name} · v{v.version}</h1>
  <p class="text-sm text-muted"><code>{mod.key}</code> · {M.blockTypes[mod.blockType] ?? mod.blockLabel} · {editable ? M.draft : v.status === 'published' ? M.publishedReadOnly : M.archivedReadOnly}</p>
  {okMsg && <p class="mt-3 co-alert co-alert--success" role="status">{okMsg}</p>}
  {result.error && (
    <div class="mt-3 co-alert co-alert--rejection" role="alert" data-testid="error">
      <p class="font-semibold">{result.error}</p>
      {result.details.length > 0 && <ul class="list-disc pl-5">{result.details.map((d) => <li>{d}</li>)}</ul>}
    </div>
  )}

  {(aiDone.summary || undone) && (
    <div class="mt-3 co-alert co-alert--success grid gap-2" role="status" data-testid="ai-result">
      <p class="font-semibold">{undone ? AI.undone : aiDone.changes.length ? `${AI.askDone}: ${aiDone.summary}` : aiDone.summary}</p>
      {aiDone.changes.length > 0 && (
        <details open><summary class="cursor-pointer text-sm">{AI.changed}</summary>
          <ul class="mt-1 grid gap-1 text-sm">{aiDone.changes.map((c) => <li><code class="text-xs">{c.path}</code>: <s class="text-muted">{c.before}</s> → <b>{c.after}</b></li>)}</ul>
        </details>
      )}
      {aiDone.prev && (
        <form method="post" action={`/admin/catalog/${versionId}`}>
          <input type="hidden" name="prev" value={aiDone.prev} />
          <button class="co-btn co-btn--ghost co-btn--sm" name="action" value="undo" type="submit" data-testid="ai-undo">{AI.undo}</button>
        </form>
      )}
    </div>
  )}
  {v.status !== 'archived' && editAi && (
    <form method="post" action={`/admin/catalog/${versionId}`} class="mt-4 co-card grid gap-2" data-testid="ai-ask">
      <h2 class="co-card-title">{AI.askTitle}</h2>
      <p class="co-help">{AI.askHelp} {!editable && AI.askPublished}</p>
      <textarea class="co-input h-20" name="instruction" required maxlength={MAX_INSTRUCTION} placeholder={AI.askPlaceholder} data-testid="ai-instruction">{instruction}</textarea>
      <div class="flex flex-wrap items-center gap-3">
        <button class="co-btn co-btn--primary co-btn--sm" name="action" value="ai" type="submit" data-testid="ai-ask-btn">{AI.askButton}</button>
        <span class="co-meta">{AI.askQuota}</span>
      </div>
    </form>
  )}

  <div class="mt-5 grid gap-5 xl:grid-cols-[minmax(0,34rem)_minmax(0,1fr)]">
    <form method="post" action={`/admin/catalog/${versionId}`} class="space-y-3 co-card">
      <label class="block text-sm font-medium">{M.content}
        <textarea class={`${field} h-[26rem] font-mono text-xs`} name="defaultProps" spellcheck="false" disabled={!editable} data-testid="props">{draftJson ?? JSON.stringify(v.defaultProps, null, 2)}</textarea>
      </label>
      <div class="grid grid-cols-2 gap-3">
        <label class="text-sm font-medium">{M.defaultPrice}<input class={field} name="defaultPrice" inputmode="decimal" value={draftPrice ?? (v.defaultPrice ?? '')} disabled={!editable} placeholder={M.noPrice} /></label>
        <label class="text-sm font-medium">{M.currency}
          <select class={field} name="currency" disabled={!editable}>{['EUR', 'USD', 'GBP', 'MXN'].map((c) => <option selected={c === v.currency}>{c}</option>)}</select>
        </label>
      </div>
      <p class="text-xs text-muted">{M.placeholdersA}<code>{'{company}'}</code>{M.placeholdersAnd}<code>{'{prospect}'}</code>{M.placeholdersB}</p>
      {editable && (
        <div class="flex gap-2">
          <button class="co-btn co-btn--ghost co-btn--sm" name="action" value="save" type="submit">{M.saveDraft}</button>
          <button class="co-btn co-btn--primary" name="action" value="publish" type="submit" data-testid="publish-version">{M.saveAndPublish}</button>
        </div>
      )}
      <details class="text-xs"><summary class="cursor-pointer text-muted">{M.example}</summary><pre class="mt-1 overflow-auto rounded-lg bg-surface p-2">{JSON.stringify(example, null, 2)}</pre></details>
    </form>
    <div>
      <p class="mb-2 text-sm font-bold">{M.preview} {editable && <span class="font-normal text-muted">{M.previewLastSaved}</span>}</p>
      <iframe title={M.previewTitle} src={`/admin/catalog/preview/${v.id}?t=${Date.now()}`} class="h-[75vh] w-full co-card" data-testid="version-preview"></iframe>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ to: `/admin/catalog/${versionId}` }}>
  // Tras pedir un cambio en una versión publicada, la página enseña el borrador nuevo: que la dirección lo diga.
  if (location.pathname !== to) history.replaceState(null, '', to);
</script>
