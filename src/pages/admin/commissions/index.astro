---
/** Mis comisiones: cuánto llevo, de dónde sale cada euro y qué me han pagado (docs/COMMISSIONS.md). */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import EntryRow from '~/components/commissions/EntryRow.astro';
import { i18n } from '~/lib/i18n';
import { commissionsMessages } from '~/lib/i18n/messages/commissions';
import { startMessages } from '~/lib/i18n/messages/start';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const { m, f } = i18n(Astro, commissionsMessages);
const [{ entries, payouts, totals }, terms] = await Promise.all([
  admin.commissions.mine(),
  admin.commissions.myConditions().catch(() => ({ visible: false, note: null, agreedAt: null, plan: null, team: false })),
]);
// Tus condiciones arriba: es lo primero que mira un comercial (las acordadas contigo o, si no hay, las del equipo).
const { m: sm } = i18n(Astro, startMessages);
// El data-testid va con un id fijo (en español), no con la etiqueta traducida: los smoke tests lo usan.
const F = [
  { id: 'Pendiente de aprobar', label: m.mine.pending, value: totals.pending, hint: m.mine.pendingHint },
  { id: 'Aprobado', label: m.mine.approved, value: totals.approved + totals.settled, hint: m.mine.approvedHint },
  { id: 'Pagado', label: m.mine.paid, value: totals.paid, hint: m.mine.paidHint },
];
---
<AdminLayout title={m.mine.title}>
  <PageHeader eyebrow={m.mine.eyebrow} title={m.mine.title} lede={m.mine.lede} />
  {terms.visible && (terms.note || terms.plan?.rules.length) && (
    <section class="co-card mb-6 grid gap-3 !p-6" data-testid="my-terms">
      <h2 class="text-eyebrow">{sm.terms.title}</h2>
      {terms.note && <p class="whitespace-pre-line text-lg font-semibold leading-snug">{terms.note}</p>}
      {terms.plan && terms.plan.rules.length > 0 && <ul class="flex flex-wrap gap-2 p-0">{terms.plan.rules.map((r) => <li class="co-chip list-none">{r.label}</li>)}</ul>}
      {terms.team && <p class="co-meta">{sm.terms.team}</p>}
    </section>
  )}
  <section class="co-grid co-grid--3 mb-6" data-testid="my-totals">
    {F.map((x) => (
      <div class="co-card grid gap-1">
        <p class="text-eyebrow">{x.label}</p>
        <p class="co-figure text-4xl" data-testid={`total-${x.id}`}>{f.money(x.value)}</p>
        <p class="co-meta">{x.hint}</p>
      </div>
    ))}
  </section>
  {totals.ineligible > 0 && <p class="co-alert co-alert--info mb-6">{m.mine.ineligible(f.money(totals.ineligible))}</p>}

  <section class="co-section">
    <div class="co-section__head"><h2 class="text-eyebrow">{m.mine.entries}</h2></div>
    {entries.length === 0
      ? <EmptyState kind="none" title={m.mine.emptyTitle} because={m.mine.emptyBecause} />
      : <ul class="co-rows" data-testid="entries">{entries.map((e) => <EntryRow e={e} />)}</ul>}
  </section>

  {payouts.length > 0 && (
    <section class="co-section">
      <div class="co-section__head"><h2 class="text-eyebrow">{m.mine.payouts}</h2></div>
      <ul class="co-rows" data-testid="payouts">
        {payouts.map((p) => (
          <li class="co-row">
            <span class="co-row__main"><span class="co-row-title">{p.period}</span><span class="co-meta">{p.status === 'paid' ? m.paidOn(f.date(p.paidAt, {})) : m.mine.readyToPay}</span></span>
            <span class="co-row-title tabular-nums">{f.money(p.totalCents, p.currency)}</span>
            <span class={p.status === 'paid' ? 'co-badge co-badge--signal' : 'co-badge co-badge--soft'}>{p.status === 'paid' ? m.mine.payoutPaid : m.mine.payoutPending}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</AdminLayout>
