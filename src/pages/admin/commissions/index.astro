---
/** Mis comisiones: cuánto llevo, de dónde sale cada euro y qué me han pagado (docs/COMMISSIONS.md). */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import EntryRow from '~/components/commissions/EntryRow.astro';
import { formatMoney } from '~/lib/commissions/money';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const { entries, payouts, totals } = await admin.commissions.mine();
const F = [
  { label: 'Pendiente de aprobar', value: totals.pending, hint: 'Calculado; falta que lo apruebe la empresa' },
  { label: 'Aprobado', value: totals.approved + totals.settled, hint: 'Se incluirá en tu próxima liquidación' },
  { label: 'Pagado', value: totals.paid, hint: 'Histórico' },
];
---
<AdminLayout title="Mis comisiones">
  <PageHeader eyebrow="Vender" title="Mis comisiones" lede="Lo que llevas ganado y de dónde sale cada euro. Las ventas que declaras cuentan cuando la empresa las confirma." />
  <section class="co-grid co-grid--3 mb-6" data-testid="my-totals">
    {F.map((f) => (
      <div class="co-card grid gap-1">
        <p class="text-eyebrow">{f.label}</p>
        <p class="co-figure text-4xl" data-testid={`total-${f.label}`}>{formatMoney(f.value)}</p>
        <p class="co-meta">{f.hint}</p>
      </div>
    ))}
  </section>
  {totals.ineligible > 0 && <p class="co-alert co-alert--info mb-6">Tienes {formatMoney(totals.ineligible)} en ventas sin comisión por ahora (conflicto de cuenta). Tu jefe/a de ventas decidirá.</p>}

  <section class="co-section">
    <div class="co-section__head"><h2 class="text-eyebrow">Movimientos</h2></div>
    {entries.length === 0
      ? <EmptyState kind="none" title="Todavía no hay comisiones" because="Aparecen cuando la empresa confirma una venta tuya. Al ganar una propuesta, declara la venta desde la propia propuesta." />
      : <ul class="co-rows" data-testid="entries">{entries.map((e) => <EntryRow e={e} />)}</ul>}
  </section>

  {payouts.length > 0 && (
    <section class="co-section">
      <div class="co-section__head"><h2 class="text-eyebrow">Liquidaciones</h2></div>
      <ul class="co-rows" data-testid="payouts">
        {payouts.map((p) => (
          <li class="co-row">
            <span class="co-row__main"><span class="co-row-title">{p.period}</span><span class="co-meta">{p.status === 'paid' ? `Pagada el ${new Date(p.paidAt!).toLocaleDateString('es-ES')}` : 'Lista para pago'}</span></span>
            <span class="co-row-title tabular-nums">{formatMoney(p.totalCents, p.currency)}</span>
            <span class={p.status === 'paid' ? 'co-badge co-badge--signal' : 'co-badge co-badge--soft'}>{p.status === 'paid' ? 'Pagada' : 'Pendiente de pago'}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</AdminLayout>
