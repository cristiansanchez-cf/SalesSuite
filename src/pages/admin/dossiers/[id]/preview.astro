---
/** Vista previa autenticada: renderiza el dossier tal cual lo vería el cliente, en cualquier estado. */
import DossierView from '~/components/dossier/DossierView.astro';
import { AdminError } from '~/lib/admin/service';
import { STATUS_LABEL } from '~/lib/admin/format';
import { moduleTranslations } from '~/lib/i18n/content-db';
import { readContact, toRep } from '~/lib/admin/rep-contact';

const { admin, tenant } = Astro.locals;
if (!admin || !tenant) return Astro.redirect('/admin/login');
let dossier;
let status;
try {
  dossier = await admin.service.previewDossier(Astro.params.id ?? '');
  const st = (await admin.service.getState(Astro.params.id!)).dossier;
  status = st.status;
  // Con el contacto de quien la hizo, como la verá el cliente.
  if (st.authorId) dossier = { ...dossier, repContact: toRep(await readContact(admin, st.authorId).catch(() => ({ channel: null, value: '', name: '' }))) };
} catch (e) {
  if (e instanceof AdminError && e.status === 404) return Astro.rewrite('/404');
  throw e;
}
// En otro idioma que el del espacio: como la verá el cliente, con los textos de los módulos traducidos.
const translations = dossier.locale.slice(0, 2) !== tenant.defaultLocale.slice(0, 2) ? await moduleTranslations(admin.content, tenant.id, dossier.locale) : undefined;
---
<DossierView tenant={tenant} dossier={dossier} banner={`Vista previa · ${STATUS_LABEL[status]}`} translations={translations} />
