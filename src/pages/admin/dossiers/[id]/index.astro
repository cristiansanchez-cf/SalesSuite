---
import { liteOf } from '~/lib/proposal/preset';
import AdminLayout from '~/layouts/AdminLayout.astro';
import Builder from '~/components/admin/Builder.svelte';
import Icon from '~/components/ui/Icon.astro';
import Alert from '~/components/ui/Alert.astro';
import { AdminError } from '~/lib/admin/service';
import { can } from '~/lib/admin/permissions';
import { formAction } from '~/lib/admin/forms';
import { i18n } from '~/lib/i18n';
import { builderMessages } from '~/lib/i18n/messages/builder';
import { analyticsMessages } from '~/lib/i18n/messages/analytics';
import { relativeTime } from '~/lib/admin/format';
import type { BuilderState } from '~/lib/admin/types';
import { requestOrigin } from '~/lib/http';
import { copyMessages } from '~/lib/i18n/messages/copy';
import { claudeTranslator, fixtureTranslator } from '~/lib/i18n/translate';
import { glossaryFor } from '~/lib/i18n/translate-glossary';
import { env } from '~/lib/env';
import { flash } from '~/lib/admin/forms';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const perms = can(admin.session.role);
const { m: t, f: fmt, locale } = i18n(Astro, builderMessages);
const id = Astro.params.id ?? '';

// Cuenta del CRM y decisión sobre la comisión (docs/ACCOUNTS.md).
let result: { error: string | null; details: string[] } = { error: null, details: [] };
const copied = { n: 0 };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const str = (k: string) => String(f.get(k) ?? '');
  result = await formAction(async () => {
    if (str('action') === 'copy-to') {
      // Dar copia (solo admin o gerente; lo comprueba el servicio). Con «traducir», los textos propios van con IA.
      const tenant = Astro.locals.tenant;
      const key = env('ANTHROPIC_API_KEY');
      const translator = f.get('translate') !== 'on' ? null
        : key ? claudeTranslator(key, { company: tenant?.name ?? '', ...(await glossaryFor(tenant?.slug ?? '')) })
        : env('AI_RESEARCH_FIXTURE') === '1' ? fixtureTranslator() : null;
      const ids = await admin.service.copyTo(id, f.getAll('to').map(String), { locale: str('locale') || undefined, translator });
      copied.n = ids.length;
      return;
    }
    if (str('action') === 'link') await admin.service.apply(id, { op: 'setAccount', accountId: str('accountId') || null });
    if (str('action') === 'decide') await admin.accounts.decide(id, str('decision') === 'approved' ? 'approved' : 'rejected');
    if (str('action') === 'declare') await admin.commissions.declareSale(id, { amount: str('amount'), offer: str('offer'), occurredAt: str('occurredAt'), kind: str('kind') || 'sale' });
  });
  if (!result.error) return Astro.redirect(`/admin/dossiers/${id}${copied.n ? `?ok=copied&n=${copied.n}` : ''}`, 303);
}

let state: BuilderState;
let market;
let facets;
let hasStory = false;
try {
  state = await admin.service.getState(id);
  const [m, fs, story] = await Promise.all([admin.playbook.market(), admin.evidence.facets(), admin.evidence.storyForDossier(state.dossier.id)]);
  facets = fs.map((f) => ({ key: f.key, label: f.label, question: f.question, scope: f.scope, multi: f.multi, options: f.options }));
  hasStory = !!story;
  market = {
    segments: m.filter((x) => x.status !== 'archived').map((x) => ({ id: x.id, key: x.key, name: x.name, proposal: liteOf(x.proposal), modules: [...x.modules].sort((p, q) => p.priority - q.priority).map((mo) => mo.moduleId) })),
    personas: m.flatMap((x) => x.personas.map((p) => ({ id: p.id, segmentId: p.segmentId, name: p.name, role: p.role }))),
  };
} catch (e) {
  if (e instanceof AdminError && e.status === 404) return Astro.rewrite('/404');
  throw e;
}
const d = state.dossier;
// Las propuestas de otro comercial no se abren (cada uno ve las suyas; admin y gerentes, todas).
if (!perms.editAllDossiers && admin.session.role !== 'partner' && d.authorId && d.authorId !== admin.session.userId) return Astro.rewrite('/404');
const CP = copyMessages[locale];
const copyTo = perms.editAllDossiers ? (await admin.tenantAdmin.listMembers().catch(() => [])).filter((x) => x.role !== 'partner' && x.userId !== d.authorId) : [];
const okCopied = flash(Astro.url, { copied: CP.ok(Number(Astro.url.searchParams.get('n')) || 0) });
const am = analyticsMessages[locale];
const opened = d.status === 'published' ? (await admin.analytics.statsFor([d.id]).catch(() => new Map())).get(d.id) : undefined;
const crm = perms.useAccounts;
const linked = crm && d.accountId ? await admin.accounts.get(d.accountId).then((x) => x.account).catch(() => null) : null;
const mine = crm && !d.accountId && state.canEdit ? await admin.accounts.mine() : [];
// Venta declarada (docs/COMMISSIONS.md): quien ganó la propuesta declara el importe; un admin lo confirma.
const canDeclare = d.outcome === 'won' && d.authorId === admin.session.userId;
const declared = d.outcome === 'won' ? (await admin.commissions.events()).filter((e) => e.dossierId === d.id) : [];
const coupons = admin.session.role === 'partner' ? [] : (await admin.commissions.coupons()).map((c) => ({ id: c.id, code: c.code, label: c.label }));
const conflict = d.outcome === 'won' && d.accountEligibility && d.accountEligibility !== 'eligible';
// El enlace público vive en el mismo host del tenant que la consola.
const origin = requestOrigin(Astro.request, Astro.url);
---
<AdminLayout title={d.title} wide>
  {result.error && <div class="mb-4"><Alert kind="rejection" title={result.error} details={result.details} /></div>}
  {okCopied && <div class="mb-4"><Alert kind="success" title={okCopied} /></div>}
  {copyTo.length > 0 && (
    <div class="mb-4 flex justify-end">
      <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-dialog-open="copy-to" data-testid="copy-to-open"><Icon name="copy" size={14} />{CP.open}</button>
      <dialog id="copy-to" class="co-dialog" aria-labelledby="copy-to-title">
        <form method="post" data-testid="copy-to-form">
          <input type="hidden" name="action" value="copy-to" />
          <div class="co-dialog__body grid gap-3">
            <h2 id="copy-to-title" class="co-entity">{CP.title}</h2>
            <p class="co-body">{CP.body}</p>
            <fieldset class="grid gap-1.5">
              <legend class="co-field mb-1">{CP.to}</legend>
              {copyTo.map((x) => <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="to" value={x.userId} class="h-4 w-4 accent-[var(--co-ink)]" data-testid="copy-to-member" /><span>{x.displayName || x.email}</span><span class="co-meta">{x.email}</span></label>)}
            </fieldset>
            <label class="co-field">{CP.language}
              <select class="co-select" name="locale" data-testid="copy-to-locale">
                <option value="">{CP.same} ({CP.langs[d.locale as keyof typeof CP.langs] ?? d.locale})</option>
                {Object.entries(CP.langs).filter(([k]) => k !== d.locale).map(([k, v]) => <option value={k}>{v}</option>)}
              </select></label>
            <label class="flex items-start gap-2 text-sm"><input type="checkbox" name="translate" checked class="mt-0.5 h-4 w-4 accent-[var(--co-ink)]" data-testid="copy-to-translate" /><span>{CP.translate}<span class="co-help block">{CP.translateHelp}</span></span></label>
          </div>
          <div class="co-dialog__foot">
            <button type="button" class="co-btn co-btn--ghost" data-dialog-close>{CP.cancel}</button>
            <button type="submit" class="co-btn co-btn--primary" data-testid="copy-to-send">{CP.send}</button>
          </div>
        </form>
      </dialog>
    </div>
  )}
  {conflict && (
    <div class:list={['co-alert mb-4', d.accountDecision === 'approved' ? 'co-alert--success' : 'co-alert--rejection']} data-testid="commission-conflict">
      <Icon name="shield-alert" size={18} />
      <div class="min-w-0 flex-1">
        <p class="font-semibold">{d.accountDecision === 'approved' ? t.page.approved : t.page.noCommission(t.page.eligibility[d.accountEligibility!].toLowerCase())}</p>
        <p>{d.accountDecision ? t.page.decided : perms.manageAccounts ? t.page.decide : t.page.leadDecides}</p>
      </div>
      {perms.manageAccounts && !d.accountDecision && (
        <form method="post" class="flex flex-wrap gap-2">
          <input type="hidden" name="action" value="decide" />
          <button class="co-btn co-btn--ghost co-btn--sm" type="submit" name="decision" value="approved">{t.page.pay}</button>
          <button class="co-btn co-btn--quiet co-btn--sm" type="submit" name="decision" value="rejected">{t.page.dontPay}</button>
        </form>
      )}
    </div>
  )}
  {(canDeclare || declared.length > 0) && (
    <section class="co-card mb-4 grid gap-3" data-testid="declare-sale">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="co-card-title flex items-center gap-2"><Icon name="wallet" size={18} />{t.page.sale}</h2>
        <a class="co-meta underline" href="/admin/commissions">{t.page.myCommissions}</a>
      </div>
      {declared.length > 0 && (
        <ul class="grid gap-1 p-0">{declared.map((e) => (
          <li class="flex list-none flex-wrap items-center gap-2 text-sm" data-testid="declared">
            <strong>{fmt.money(e.amountCents, e.currency)}</strong>{e.offer && <span class="co-meta">{e.offer}</span>}
            <span class="co-meta">· {new Date(e.occurredAt).toLocaleDateString(fmt.tag)}</span>
            <span class={e.status === 'confirmed' ? 'co-badge co-badge--signal' : e.status === 'void' ? 'co-badge' : 'co-badge co-badge--soft'}>{e.status === 'confirmed' ? t.page.confirmed : e.status === 'void' ? t.page.void : t.page.pending}</span>
          </li>))}
        </ul>
      )}
      {canDeclare && (
        <form method="post" class="flex flex-wrap items-end gap-2">
          <input type="hidden" name="action" value="declare" />
          <label class="co-field">{t.page.amount}<input class="co-input max-w-[9rem]" name="amount" required inputmode="decimal" placeholder={t.page.amountPlaceholder} /></label>
          <label class="co-field">{t.page.kind}<select class="co-select" name="kind"><option value="sale">{t.page.oneOff}</option><option value="recurring">{t.page.recurring}</option></select></label>
          <label class="co-field">{t.page.offer} <span class="co-help">{t.page.optional}</span><input class="co-input max-w-[10rem]" name="offer" maxlength="80" placeholder="pack-1000" /></label>
          <label class="co-field">{t.page.date}<input class="co-input" type="date" name="occurredAt" required value={new Date().toISOString().slice(0, 10)} /></label>
          <button class="co-btn co-btn--primary" type="submit">{declared.length ? t.page.declareAnother : t.page.declare}</button>
        </form>
      )}
      {canDeclare && declared.length === 0 && <p class="co-help">{t.page.declareHelp}</p>}
    </section>
  )}
  {crm && (linked || mine.length > 0) && (
    <div class="co-inset mb-4 flex flex-wrap items-center gap-3 !py-2.5" data-testid="crm-account">
      <Icon name="map-pin" size={16} />
      {linked
        ? <span class="text-sm">{t.page.account} <a class="font-semibold underline" href={`/admin/accounts/${linked.id}`}>{linked.name}</a> <span class="co-meta">· {linked.zonePath || t.page.noZone}</span></span>
        : (
          <form method="post" class="flex flex-wrap items-center gap-2">
            <input type="hidden" name="action" value="link" />
            <label class="text-sm" for="link-account">{t.page.linkTo}</label>
            <select id="link-account" class="co-select !min-h-[32px] !w-auto !py-0" name="accountId" required>{mine.map((a) => <option value={a.id}>{a.name}</option>)}</select>
            <button class="co-btn co-btn--ghost co-btn--sm" type="submit">{t.page.link}</button>
          </form>
        )}
    </div>
  )}
  {state.dossier.status === 'published' && (
    <a class="co-inset mb-4 flex flex-wrap items-center gap-3 !py-2.5 hover:underline" href={`/admin/dossiers/${state.dossier.id}/analytics`} data-testid="dossier-analytics-link">
      <Icon name={opened?.opens ? 'eye' : 'eye-off'} size={16} />
      <span class="text-sm"><strong>{am.badge(opened?.opens ?? 0)}</strong>{opened?.lastAt ? ` · ${am.detail.last.toLowerCase()} ${relativeTime(opened.lastAt, undefined, locale)}` : ''}</span>
      <span class="co-meta ml-auto">{am.nav} →</span>
    </a>
  )}
  <Builder client:load initial={state} publicOrigin={origin} market={market} facets={facets} hasStory={hasStory} coupons={coupons} locale={locale} />
</AdminLayout>
