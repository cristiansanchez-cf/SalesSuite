---
/**
 * Territorio (docs/ACCOUNTS.md): zonas, quién cubre cada una, reglas de reserva, importación de cuentas
 * y ventas que esperan tu decisión. Zonas y reglas: admin. Asignaciones, importación y decisiones: admin y jefe/a.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import Icon from '~/components/ui/Icon.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import ConfirmDialog from '~/components/ui/ConfirmDialog.astro';
import { can } from '~/lib/admin/permissions';
import { formAction } from '~/lib/admin/forms';
import { ELIGIBILITY_LABELS } from '~/lib/accounts/rules';
import type { Zone } from '~/lib/accounts/types';
import { i18n } from '~/lib/i18n';
import { accountsMessages } from '~/lib/i18n/messages/accounts';
import { shellMessages } from '~/lib/i18n/messages/shell';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const perms = can(admin.session.role);
if (!perms.manageAccounts) return Astro.rewrite('/admin/forbidden');
const acc = admin.accounts;
const { m: { territory: M }, locale } = i18n(Astro, accountsMessages);
const S = shellMessages[locale];
const ELIGIBILITY_LABEL = ELIGIBILITY_LABELS[locale];

let result: { error: string | null; details: string[] } = { error: null, details: [] };
let imported: Awaited<ReturnType<typeof acc.importCsv>> | null = null;
let ok = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const str = (k: string) => String(f.get(k) ?? '');
  result = await formAction(async () => {
    switch (str('action')) {
      case 'rules': await acc.saveRules({ claimDays: str('claimDays'), strictZones: f.get('strictZones') === 'on', requireAccount: f.get('requireAccount') === 'on' }); ok = M.okRules; break;
      case 'zone': await acc.saveZone({ name: str('name'), parentId: str('parentId'), kind: str('kind') || 'city' }); ok = M.okZone; break;
      case 'zone-delete': await acc.deleteZone(str('id')); ok = M.okZoneDeleted; break;
      case 'assign': await acc.setAssignments(str('userId'), f.getAll('zoneIds').map(String)); ok = M.okAssigned; break;
      case 'import': imported = await acc.importCsv(str('csv')); break;
      case 'decide': await acc.decide(str('dossierId'), str('decision') === 'approved' ? 'approved' : 'rejected'); ok = M.okDecided; break;
    }
  });
}

// TS no ve la asignación dentro del callback de formAction.
const importedView = imported as Awaited<ReturnType<typeof acc.importCsv>> | null;
const [t, members, conflicts] = await Promise.all([acc.territory(), admin.tenantAdmin.listMembers(), acc.conflicts()]);
const team = members.filter((m) => m.role !== 'partner');
const KIND: Record<Zone['kind'], string> = M.kind;
/** Árbol plano con profundidad, en orden. */
const tree: Array<Zone & { depth: number }> = [];
const walk = (parent: string | null, depth: number) => {
  for (const z of t.zones.filter((x) => x.parentId === parent)) { tree.push({ ...z, depth }); walk(z.id, depth + 1); }
};
walk(null, 0);
const zonesOf = (u: string) => t.assignments.filter((a) => a.userId === u).map((a) => a.zoneId);
---
<AdminLayout title={M.title}>
  <PageHeader eyebrow={M.eyebrow} title={M.title} lede={M.lede} />
  {ok && <div class="mb-4"><Alert kind="success" title={ok} /></div>}
  {result.error && <div class="mb-4"><Alert kind="rejection" title={result.error} details={result.details} /></div>}
  {importedView && (
    <div class="mb-4" data-testid="import-result"><Alert kind="success" title={M.imported(importedView.created, importedView.duplicates)}>
      {importedView.unknownZones.length > 0 && <p>{M.unknownZones(importedView.unknownZones.join(', '))}</p>}
      {importedView.errors.length > 0 && <ul>{importedView.errors.slice(0, 5).map((e: string) => <li>{e}</li>)}</ul>}
    </Alert></div>
  )}

  {conflicts.length > 0 && (
    <section class="co-section" data-testid="conflicts">
      <div class="co-section__head"><h2 class="text-eyebrow">{M.conflicts(conflicts.length)}</h2><span class="co-meta">{M.conflictsHelp}</span></div>
      <ul class="co-rows">
        {conflicts.map((d) => (
          <li class="co-row co-row--attention">
            <span class="co-row__lead"><Icon name="shield-alert" /></span>
            <a class="co-row__main text-inherit !no-underline" href={`/admin/dossiers/${d.id}`}>
              <span class="co-row-title">{d.title}</span><span class="co-meta">{d.authorName ?? M.noAuthor} · {ELIGIBILITY_LABEL[d.accountEligibility!]}</span>
            </a>
            <form method="post" class="flex flex-wrap gap-2">
              <input type="hidden" name="action" value="decide" /><input type="hidden" name="dossierId" value={d.id} />
              <button class="co-btn co-btn--ghost co-btn--sm" type="submit" name="decision" value="approved">{M.pay}</button>
              <button class="co-btn co-btn--quiet co-btn--sm" type="submit" name="decision" value="rejected">{M.noCommission}</button>
            </form>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="co-split">
    <div class="grid content-start gap-6">
      <section class="co-section !mt-0" data-testid="zones">
        <div class="co-section__head"><h2 class="text-eyebrow">{M.zones}</h2><span class="co-meta">{M.zonesHelp}</span></div>
        {tree.length === 0
          ? <EmptyState kind="none" title={M.noZones} because={M.noZonesBecause} />
          : <ul class="co-card co-card--flush m-0 p-0">
              {tree.map((z) => (
                <li class="flex list-none flex-wrap items-center gap-2 border-b border-line px-4 py-2.5 last:border-b-0" style={`padding-left:${16 + z.depth * 22}px`} data-testid="zone" data-name={z.name}>
                  <Icon name={z.depth === 0 ? 'globe' : 'map-pin'} size={16} />
                  <span class="co-row-title">{z.name}</span><span class="co-meta">{KIND[z.kind]}</span>
                  <span class="co-meta ml-auto">{team.filter((m) => zonesOf(m.userId).includes(z.id)).map((m) => m.displayName || m.email).join(', ')}</span>
                  {perms.manageZones && <button type="button" class="co-btn co-btn--quiet co-btn--icon co-btn--sm" data-dialog-open={`zdel-${z.id}`} aria-label={M.deleteZone(z.name)}><Icon name="trash2" size={14} /></button>}
                  {perms.manageZones && (
                    <ConfirmDialog id={`zdel-${z.id}`} title={M.deleteZone(z.name)} confirmLabel={M.deleteZoneConfirm} danger
                      does={M.deleteZoneDoes}
                      doesNot={M.deleteZoneDoesNot}>
                      <input type="hidden" name="action" value="zone-delete" /><input type="hidden" name="id" value={z.id} />
                    </ConfirmDialog>
                  )}
                </li>
              ))}
            </ul>}
        {perms.manageZones && (
          <form method="post" class="co-card mt-3 grid gap-3 sm:grid-cols-[1fr_1fr_auto_auto] sm:items-end" data-testid="zone-form">
            <input type="hidden" name="action" value="zone" />
            <label class="co-field">{M.newZone}<input class="co-input" name="name" required maxlength="80" placeholder={M.newZonePlaceholder} /></label>
            <label class="co-field">{M.inside}<select class="co-select" name="parentId"><option value="">{M.topLevel}</option>{tree.map((z) => <option value={z.id}>{' '.repeat(z.depth * 3)}{z.name}</option>)}</select></label>
            <label class="co-field">{M.type}<select class="co-select" name="kind">{Object.entries(KIND).map(([k, v]) => <option value={k} selected={k === 'city'}>{v}</option>)}</select></label>
            <button class="co-btn co-btn--primary" type="submit">{M.add}</button>
          </form>
        )}
      </section>

      <section class="co-section" data-testid="assignments">
        <div class="co-section__head"><h2 class="text-eyebrow">{M.coverage}</h2><span class="co-meta">{M.coverageHelp}</span></div>
        <div class="grid gap-3">
          {team.map((m) => (
            <form method="post" class="co-card grid gap-3" data-testid="assign" data-user={m.email}>
              <input type="hidden" name="action" value="assign" /><input type="hidden" name="userId" value={m.userId} />
              <div class="flex flex-wrap items-center gap-2"><span class="co-row-title">{m.displayName || m.email}</span><span class="co-meta">{m.role === 'admin' ? S.role.admin : m.role === 'lead' ? S.role.lead : S.role.rep}</span>
                <button class="co-btn co-btn--ghost co-btn--sm ml-auto" type="submit">{M.save}</button></div>
              {tree.length === 0 ? <p class="co-meta">{M.createZonesFirst}</p> : (
                <div class="co-chips">{tree.map((z) => <label class="co-chip"><input type="checkbox" name="zoneIds" value={z.id} checked={zonesOf(m.userId).includes(z.id)} />{z.name}</label>)}</div>
              )}
            </form>
          ))}
        </div>
      </section>
    </div>

    <aside class="grid content-start gap-4">
      <form method="post" class="co-card grid gap-4" data-testid="rules">
        <input type="hidden" name="action" value="rules" />
        <div><p class="text-eyebrow mb-1">{M.rulesEyebrow}</p><h2 class="co-entity">{M.rulesTitle}</h2></div>
        <fieldset class="grid gap-4" disabled={!perms.manageZones}>
          <label class="co-field">{M.claimDays}
            <input class="co-input max-w-[8rem]" type="number" name="claimDays" min="1" max="365" value={t.rules.claimDays} />
            <span class="co-help">{M.claimDaysHelp}</span>
          </label>
          <label class="co-check"><input type="checkbox" name="strictZones" checked={t.rules.strictZones} />
            <span>{M.strict}<span class="co-help block">{M.strictHelp}</span></span></label>
          <label class="co-check"><input type="checkbox" name="requireAccount" checked={t.rules.requireAccount} />
            <span>{M.requireAccount}<span class="co-help block">{M.requireAccountHelp}</span></span></label>
          {perms.manageZones ? <button class="co-btn co-btn--primary w-fit" type="submit">{M.saveRules}</button> : <p class="co-help">{M.rulesByAdmin}</p>}
        </fieldset>
      </form>

      {/* Importar empresas es solo del admin (como Configurar → Datos del CRM → Importar). */}
      {perms.importCrm && <form method="post" id="importar" class="co-card grid gap-3" data-testid="import">
        <input type="hidden" name="action" value="import" />
        <div><p class="text-eyebrow mb-1">{M.importEyebrow}</p><h2 class="co-entity">{M.importTitle}</h2></div>
        <p class="co-body" set:html={M.csvHelp}></p>
        <label class="co-field">{M.file}<input class="co-input" type="file" accept=".csv,text/csv" data-csv-file /></label>
        <label class="co-field">{M.paste}<textarea class="co-textarea font-mono text-xs" name="csv" required data-csv-text placeholder={M.csvPlaceholder}></textarea></label>
        <button class="co-btn co-btn--primary w-fit" type="submit">{M.importButton}</button>
      </form>}
    </aside>
  </div>
  <script>
    // Leer el CSV en el navegador y dejarlo en el textarea (sin subidas de archivos).
    const file = document.querySelector<HTMLInputElement>('[data-csv-file]');
    const text = document.querySelector<HTMLTextAreaElement>('[data-csv-text]');
    file?.addEventListener('change', async () => { const f = file.files?.[0]; if (f && text) text.value = await f.text(); });
  </script>
</AdminLayout>
