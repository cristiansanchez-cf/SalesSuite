---
/** Ficha de un colaborador (docs/PARTNERS.md): qué ve, sus cuentas y cómo se cotiza cada una. Solo admins. */
import AdminLayout from '~/layouts/AdminLayout.astro';
import { can } from '~/lib/admin/permissions';
import { flash, formAction } from '~/lib/admin/forms';
import { AdminError } from '~/lib/admin/service';
import { relativeTime, STATUS_CLASS, STATUS_LABEL } from '~/lib/admin/format';
import { PRICE_POLICY_LABEL } from '~/lib/partner/labels';
import { partnerPrice } from '~/lib/partner/scope';
import type { PartnerAccount } from '~/lib/admin/types';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import Icon from '~/components/ui/Icon.astro';
import ConfirmDialog from '~/components/ui/ConfirmDialog.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import PricePolicyFields from '~/components/admin/PricePolicyFields.astro';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
if (!can(admin.session.role).manageTeam) return Astro.rewrite('/admin/forbidden');
const t = admin.tenantAdmin;
const canPrice = can(admin.session.role).setPrices;
const userId = Astro.params.userId ?? '';

let result: { error: string | null; details: string[] } = { error: null, details: [] };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = String(f.get('action'));
  const accountId = String(f.get('accountId') ?? '') || undefined;
  const accountInput = () => ({
    name: f.get('name'), segmentId: String(f.get('segmentId') ?? ''), pricePolicy: f.get('pricePolicy'),
    priceAdjustPct: String(f.get('priceAdjustPct') ?? '0') || '0', notes: String(f.get('notes') ?? ''),
  });
  let ok = '';
  result = await formAction(async () => {
    if (action === 'profile') {
      await t.updatePartner(userId, {
        moduleIds: f.getAll('moduleIds').map(String), seeTeamTips: f.get('seeTeamTips') === 'on',
        welcomeNote: String(f.get('welcomeNote') ?? ''), expiresAt: String(f.get('expiresAt') ?? ''), canInvite: f.get('canInvite') === 'on',
      });
      ok = 'profile';
    } else if (action === 'account') {
      await t.savePartnerAccount(userId, accountInput(), accountId, { applyToSent: f.get('applyToSent') === 'on' });
      ok = accountId ? 'account-saved' : 'account-added';
    } else if (action === 'account-delete' && accountId) {
      await t.deletePartnerAccount(userId, accountId);
      ok = 'account-deleted';
    } else if (action === 'remove') {
      await t.removeMember(userId);
      ok = 'removed';
    }
  });
  if (!result.error) return Astro.redirect(ok === 'removed' ? '/admin/team?ok=removed' : `/admin/team/partners/${userId}?ok=${ok}`, 303);
}

let p;
try { p = await t.partner(userId); } catch (e) {
  if (e instanceof AdminError && e.status === 404) return Astro.rewrite('/404');
  throw e;
}
const [catalog, segments] = await Promise.all([t.listCatalog(), admin.playbook.market()]);
const modules = catalog.filter((m) => m.isCatalog && m.versions.some((v) => v.status === 'published'));
const listPrice = (moduleId: string) => modules.find((m) => m.id === moduleId)?.versions.find((v) => v.status === 'published') ?? null;
const allowed = modules.filter((m) => p.profile?.moduleIds.includes(m.id));
const money = (n: number, c: string) => new Intl.NumberFormat('es-ES', { style: 'currency', currency: c }).format(n);
/** Lo que vería el cliente de esta cuenta en cada módulo permitido. */
const preview = (a: PartnerAccount) => allowed.map((m) => {
  const v = listPrice(m.id);
  const price = v ? partnerPrice(a.pricePolicy, a.priceAdjustPct, v.defaultPrice) : null;
  return { name: m.name, list: v?.defaultPrice ?? null, price, currency: v?.currency ?? 'EUR' };
});
const okMsg = flash(Astro.url, {
  'partner-invited': 'Invitación enviada. Ahora asígnale sus cuentas.',
  'partner-added': 'Ya tenía cuenta: tiene acceso como colaborador. Ahora asígnale sus cuentas.',
  profile: 'Permisos guardados.',
  'account-added': 'Cuenta añadida.',
  'account-saved': 'Cuenta guardada. Si cambiaste el precio, ya se aplica a sus borradores.',
  'account-deleted': 'Cuenta eliminada. Sus propuestas se conservan, sin cuenta asignada.',
});
const dateInput = p.profile?.expiresAt ? p.profile.expiresAt.slice(0, 10) : '';
const segName = new Map(segments.map((sg) => [sg.id, sg.name]));
const sentCount = (a: PartnerAccount) => p.dossiers.filter((d) => d.partnerAccountId === a.id && d.status !== 'draft').length;
const pct = (n: number) => `${n > 0 ? '+' : ''}${n} %`;
---
<AdminLayout title={p.displayName || p.email}>
  <PageHeader eyebrow="Colaborador" title={p.displayName || p.email} back={{ href: '/admin/team', label: 'Equipo' }}
    lede={`${p.email} · ${p.accounts.length} ${p.accounts.length === 1 ? 'cuenta' : 'cuentas'} · ${p.dossierCount} propuestas`}>
    {p.expired && <span class="co-badge co-badge--attention" data-testid="expired">Acceso caducado</span>}
    <button type="button" class="co-btn co-btn--primary" data-dialog-open="add-account-dialog"><Icon name="plus" size={16} />Añadir cuenta</button>
  </PageHeader>
  {okMsg && <div class="mb-4"><Alert kind="success" title={okMsg} /></div>}
  {result.error && <div class="mb-4"><Alert kind="rejection" title={result.error} details={result.details} /></div>}

  <div class="co-split">
    <div>
      <section class="co-section">
        <div class="co-section__head">
          <h2 class="text-eyebrow">Cuentas</h2>
          <span class="co-meta">Para cada una decides el precio que verá el cliente. Él no ve la tarifa ni puede cambiarlo.</span>
        </div>
        {p.accounts.length === 0 && <EmptyState kind="create" title="Sin cuentas asignadas" detail="Añade los locales o centros donde vende: hasta entonces no puede crear propuestas." action={{ dialog: 'add-account-dialog', label: 'Añadir cuenta' }} />}
        <div class="grid gap-3">
          {p.accounts.map((a) => (
            <article class="co-card grid gap-3" data-testid="partner-account" data-account={a.name}>
              <div class="flex flex-wrap items-start gap-3">
                <span class="co-row__lead"><Icon name="store" /></span>
                <div class="min-w-0 flex-1">
                  <h3 class="co-card-title">{a.name}</h3>
                  <p class="co-meta">{[a.segmentId ? segName.get(a.segmentId) : 'Sin sector', `${PRICE_POLICY_LABEL[a.pricePolicy]}${a.pricePolicy === 'adjusted' ? ` (${pct(a.priceAdjustPct)})` : ''}`].join(' · ')}</p>
                </div>
                <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-dialog-open={`acc-${a.id}`} data-testid="edit-account"><Icon name="pencil" size={14} />Editar</button>
              </div>
              {a.notes && <p class="co-body">«{a.notes}»</p>}
              {allowed.length > 0 && (
                <ul class="co-chips" data-testid="price-preview">
                  {preview(a).map((x) => (
                    <li class="co-badge co-badge--soft !normal-case !tracking-normal">
                      {x.name}: {x.price != null ? money(x.price, x.currency) : 'sin precio'}
                      {x.list != null && x.price != null && x.price !== x.list && <span class="text-[var(--co-ink-dim)]">&nbsp;(tarifa {money(x.list, x.currency)})</span>}
                    </li>
                  ))}
                </ul>
              )}
              <dialog id={`acc-${a.id}`} class="co-dialog co-dialog--wide" aria-label={`Editar ${a.name}`}>
                <form method="post">
                  <input type="hidden" name="action" value="account" />
                  <input type="hidden" name="accountId" value={a.id} />
                  <div class="co-dialog__body">
                    <h2 class="co-entity">Editar {a.name}</h2>
                    <label class="co-field">Nombre<input class="co-input" name="name" value={a.name} required maxlength="120" /></label>
                    <label class="co-field">Sector
                      <select class="co-select" name="segmentId"><option value="">Sin sector</option>{segments.map((sg) => <option value={sg.id} selected={sg.id === a.segmentId}>{sg.name}</option>)}</select>
                    </label>
                    <PricePolicyFields policy={a.pricePolicy} pct={a.priceAdjustPct} canPrice={canPrice} />
                    <label class="co-field">Indicaciones para él<textarea class="co-textarea" name="notes" maxlength="2000">{a.notes ?? ''}</textarea></label>
                    {canPrice && sentCount(a) > 0 && (
                      <label class="co-check" data-testid="apply-to-sent">
                        <input type="checkbox" name="applyToSent" />
                        <span>Aplicar el precio nuevo también a {sentCount(a) === 1 ? 'la propuesta ya enviada' : `las ${sentCount(a)} propuestas ya enviadas`}<span class="co-help block">Sin marcar, el cliente sigue viendo el precio que recibió. Los borradores se actualizan siempre.</span></span>
                      </label>
                    )}
                    <p class="co-dialog__not"><strong>Lo que no hace:</strong> no avisa ni al colaborador ni al cliente.</p>
                  </div>
                  <div class="co-dialog__foot">
                    <button type="button" class="co-btn co-btn--quiet !mr-auto !text-[var(--console-danger)]" data-dialog-open={`del-${a.id}`}><Icon name="trash2" size={14} />Eliminar cuenta</button>
                    <button type="button" class="co-btn co-btn--ghost" data-dialog-close>Cancelar</button>
                    <button type="submit" class="co-btn co-btn--primary">Guardar cuenta</button>
                  </div>
                </form>
              </dialog>
              <ConfirmDialog id={`del-${a.id}`} title={`Eliminar ${a.name}`} confirmLabel="Eliminar cuenta" danger
                does="El colaborador deja de ver esta cuenta y no puede crear propuestas para ella."
                doesNot="No borra sus propuestas ni desactiva los enlaces enviados; se quedan sin cuenta asignada y con el precio que tenían.">
                <input type="hidden" name="action" value="account-delete" />
                <input type="hidden" name="accountId" value={a.id} />
              </ConfirmDialog>
            </article>
          ))}
        </div>
      </section>

      {p.dossiers.length > 0 && (
        <section class="co-section">
          <div class="co-section__head"><h2 class="text-eyebrow">Sus propuestas · {p.dossiers.length}</h2></div>
          <ul class="co-rows">
            {p.dossiers.map((d) => (
              <li>
                <a href={`/admin/dossiers/${d.id}`} class="co-row">
                  <span class="co-row__main"><span class="co-row-title">{d.title}</span><span class="co-meta">{p.accounts.find((a) => a.id === d.partnerAccountId)?.name ?? 'Sin cuenta'} · {relativeTime(d.updatedAt)}</span></span>
                  <span class={STATUS_CLASS[d.status]}>{STATUS_LABEL[d.status]}</span>
                  <span class="co-row__chevron"><Icon name="chevron-right" /></span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <aside class="grid content-start gap-4">
      <form method="post" class="co-card grid gap-4" data-testid="partner-profile">
        <input type="hidden" name="action" value="profile" />
        <div><p class="text-eyebrow mb-1">Acceso</p><h2 class="co-entity">Qué puede ver</h2></div>
        <fieldset class="grid gap-2">
          <legend class="co-field mb-2">Módulos que puede vender</legend>
          {modules.map((m) => <label class="co-check"><input type="checkbox" name="moduleIds" value={m.id} checked={p.profile?.moduleIds.includes(m.id)} />{m.name}</label>)}
        </fieldset>
        <label class="co-check">
          <input type="checkbox" name="seeTeamTips" checked={p.profile?.seeTeamTips} />
          <span>Ve lo que comparte el equipo interno<span class="co-help block">Nunca ve precio y monetización, ni dossiers o notas de otros vendedores.</span></span>
        </label>
        <label class="co-check">
          <input type="checkbox" name="canInvite" checked={p.profile?.canInvite} />
          <span>Puede invitar a otros colaboradores<span class="co-help block">Heredan sus módulos, sin cuentas. Verás siempre quién invitó a quién y te avisaremos.</span></span>
        </label>
        <label class="co-field">Acceso hasta<input class="co-input" type="date" name="expiresAt" value={dateInput} /><span class="co-help">Vacío = sin fecha de fin. Al caducar no entra; sus propuestas se conservan.</span></label>
        <label class="co-field">Su guía <span class="co-help">Solo la ve él. Admite **negrita** y listas con «- ».</span>
          <textarea class="co-textarea min-h-[8rem]" name="welcomeNote" maxlength="4000">{p.profile?.welcomeNote ?? ''}</textarea>
        </label>
        <button class="co-btn co-btn--primary co-btn--block" type="submit">Guardar acceso</button>
      </form>

      <section class="co-card grid gap-3">
        <h2 class="text-eyebrow">Acciones irreversibles</h2>
        <div class="co-actions co-actions--danger">
          <button type="button" class="co-action" data-dialog-open="remove-partner"><Icon name="ban" /><span class="co-action__label">Quitarle el acceso<small>Para una pausa, mejor una fecha de fin</small></span><Icon name="chevron-right" size={16} /></button>
        </div>
      </section>
      <ConfirmDialog id="remove-partner" title={`Quitar el acceso a ${p.displayName || p.email}`} confirmLabel="Quitar acceso" danger
        does="Deja de poder entrar y se eliminan sus cuentas asignadas."
        doesNot="No borra sus propuestas ni desactiva los enlaces que ya ha enviado: siguen funcionando hasta que los revoques.">
        <input type="hidden" name="action" value="remove" />
      </ConfirmDialog>
    </aside>
  </div>

  <dialog id="add-account-dialog" class="co-dialog co-dialog--wide" aria-label="Añadir cuenta">
    <form method="post" data-testid="add-account">
      <input type="hidden" name="action" value="account" />
      <div class="co-dialog__body">
        <h2 class="co-entity">Añadir cuenta</h2>
        <label class="co-field">Nombre<input class="co-input" name="name" required maxlength="120" placeholder="Sala Luna" /></label>
        <label class="co-field">Sector<select class="co-select" name="segmentId"><option value="">Sin sector</option>{segments.map((sg) => <option value={sg.id}>{sg.name}</option>)}</select></label>
        <PricePolicyFields canPrice={canPrice} />
        <label class="co-field">Indicaciones para él<textarea class="co-textarea" name="notes" maxlength="2000" placeholder="El dueño es Marcos; no hables de precio, lo cerramos nosotros."></textarea></label>
      </div>
      <div class="co-dialog__foot">
        <button type="button" class="co-btn co-btn--ghost" data-dialog-close>Cancelar</button>
        <button class="co-btn co-btn--primary" type="submit">Añadir cuenta</button>
      </div>
    </form>
  </dialog>
</AdminLayout>
