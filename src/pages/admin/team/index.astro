---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { flash, formAction } from '~/lib/admin/forms';
import { requestOrigin } from '~/lib/http';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
if (admin.session.role !== 'admin') return Astro.rewrite('/admin/forbidden');
const t = admin.tenantAdmin;

let result: { error: string | null; details: string[] } = { error: null, details: [] };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = String(f.get('action'));
  const userId = String(f.get('userId') ?? '');
  let ok = '';
  let partnerId = '';
  result = await formAction(async () => {
    if (action === 'invite-partner') {
      const r = await t.invitePartner({
        email: f.get('email'), moduleIds: f.getAll('moduleIds').map(String), expiresAt: String(f.get('expiresAt') ?? ''),
        welcomeNote: String(f.get('welcomeNote') ?? ''),
      }, `${requestOrigin(Astro.request, Astro.url)}/admin/auth/confirm?next=/admin`);
      partnerId = r.userId;
      ok = r.invited ? 'partner-invited' : 'partner-added';
    } else if (action === 'invite') {
      const r = await t.invite({ email: f.get('email'), role: f.get('role') }, `${requestOrigin(Astro.request, Astro.url)}/admin/auth/confirm?next=/admin/account`);
      ok = r.invited ? 'invited' : 'added';
    } else if (action === 'role') { await t.setRole(userId, f.get('role')); ok = 'role'; }
    else if (action === 'remove') { await t.removeMember(userId); ok = 'removed'; }
  });
  if (!result.error) return Astro.redirect(partnerId ? `/admin/team/partners/${partnerId}?ok=${ok}` : `/admin/team?ok=${ok}`, 303);
}
const okMsg = flash(Astro.url, {
  invited: 'Invitación enviada por email.',
  added: 'Ya tenía cuenta: añadido al equipo (puede entrar con su acceso actual).',
  role: 'Rol actualizado.',
  removed: 'Persona quitada del equipo.',
});
const [members, partners, catalog] = await Promise.all([t.listMembers(), t.listPartners(), t.listCatalog()]);
const modules = catalog.filter((m) => m.isCatalog && m.versions.some((v) => v.status === 'published'));
const dateFmt = (iso: string) => new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(iso));
const field = 'rounded-lg border border-line bg-bg px-3 py-2 outline-none focus:border-ink';
---
<AdminLayout title="Equipo">
  <h1 class="text-3xl font-extrabold">Equipo</h1>
  <p class="text-sm text-muted">Admins: gestionan catálogo, marca, equipo y todos los dossiers. Comerciales: crean y editan sus dossiers. Colaboradores: venden solo lo que les permitas, en las cuentas que les asignes.</p>
  {okMsg && <p class="mt-4 rounded-lg bg-emerald-50 p-3 text-sm text-emerald-800" role="status">{okMsg}</p>}
  {result.error && (
    <div class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-800" role="alert">
      <p class="font-semibold">{result.error}</p>
      {result.details.length > 0 && <ul class="list-disc pl-5">{result.details.map((d) => <li>{d}</li>)}</ul>}
    </div>
  )}

  <form method="post" class="mt-6 flex flex-wrap items-end gap-3 rounded-2xl border border-line bg-bg p-4" data-testid="invite-form">
    <input type="hidden" name="action" value="invite" />
    <label class="min-w-[16rem] flex-1 text-sm font-medium">Email<input class={`${field} w-full`} type="email" name="email" required /></label>
    <label class="text-sm font-medium">Rol
      <select class={`${field} block`} name="role"><option value="rep">Comercial</option><option value="admin">Admin</option></select>
    </label>
    <button class="rounded-lg bg-ink px-4 py-2 font-semibold text-bg" type="submit">Invitar</button>
  </form>

  <ul class="mt-6 divide-y divide-line overflow-hidden rounded-2xl border border-line bg-bg p-0" data-testid="members">
    {members.map((m) => (
      <li class="flex list-none flex-wrap items-center gap-3 px-4 py-3">
        <div class="min-w-0 flex-1">
          <p class="truncate font-semibold">{m.displayName || m.email}{m.userId === admin.session.userId && <span class="ml-2 text-xs font-normal text-muted">(tú)</span>}</p>
          {m.displayName && <p class="truncate text-sm text-muted">{m.email}</p>}
        </div>
        <form method="post" class="flex items-center gap-2">
          <input type="hidden" name="action" value="role" />
          <input type="hidden" name="userId" value={m.userId} />
          <select class={field} name="role" aria-label={`Rol de ${m.email}`}>
            <option value="rep" selected={m.role === 'rep'}>Comercial</option>
            <option value="admin" selected={m.role === 'admin'}>Admin</option>
          </select>
          <button class="rounded-lg border border-line px-3 py-2 text-sm font-semibold hover:bg-surface" type="submit">Cambiar</button>
        </form>
        <form method="post" onsubmit="return confirm('¿Quitar a esta persona del equipo? Sus dossiers se conservan.')">
          <input type="hidden" name="action" value="remove" />
          <input type="hidden" name="userId" value={m.userId} />
          <button class="rounded-lg border border-line px-3 py-2 text-sm font-semibold text-red-700 hover:bg-surface" type="submit">Quitar</button>
        </form>
      </li>
    ))}
  </ul>

  <section class="mt-10" data-testid="partners">
    <h2 class="text-2xl font-extrabold">Colaboradores</h2>
    <p class="text-sm text-muted">Vendedores puntuales (un DJ en sus locales, un monitor en sus centros…). Entran con un código por email, solo ven los módulos y las cuentas que elijas, nunca ven la tarifa y no tocan precios.</p>

    {partners.length > 0 && (
      <ul class="mt-4 divide-y divide-line overflow-hidden rounded-2xl border border-line bg-bg p-0" data-testid="partner-list">
        {partners.map((p) => (
          <li class="list-none">
            <a href={`/admin/team/partners/${p.userId}`} class="flex flex-wrap items-center gap-3 px-4 py-3 hover:bg-surface" data-testid="partner-row">
              <span class="min-w-0 flex-1">
                <span class="block truncate font-semibold">{p.displayName || p.email}</span>
                <span class="block truncate text-sm text-muted">
                  {p.accounts.length} {p.accounts.length === 1 ? 'cuenta' : 'cuentas'} · {p.profile?.moduleIds.length ?? 0} módulos · {p.dossierCount} propuestas
                </span>
              </span>
              {p.expired
                ? <span class="rounded-full bg-zinc-200 px-2.5 py-0.5 text-xs font-semibold text-zinc-700">Caducado</span>
                : p.profile?.expiresAt && <span class="text-xs text-muted">hasta {dateFmt(p.profile.expiresAt)}</span>}
              <span class="text-sm font-semibold">Gestionar →</span>
            </a>
          </li>
        ))}
      </ul>
    )}

    <form method="post" class="mt-4 space-y-3 rounded-2xl border border-line bg-bg p-4" data-testid="invite-partner-form">
      <input type="hidden" name="action" value="invite-partner" />
      <h3 class="font-bold">Invitar colaborador</h3>
      <div class="grid gap-3 sm:grid-cols-[1fr_12rem]">
        <label class="text-sm font-medium">Email<input class={`${field} w-full`} type="email" name="email" required /></label>
        <label class="text-sm font-medium">Acceso hasta (opcional)<input class={`${field} w-full`} type="date" name="expiresAt" /></label>
      </div>
      <fieldset>
        <legend class="text-sm font-medium">Qué puede ver y vender</legend>
        <div class="mt-1 flex flex-wrap gap-2">
          {modules.map((m) => (
            <label class="flex items-center gap-2 rounded-lg border border-line px-3 py-1.5 text-sm">
              <input type="checkbox" name="moduleIds" value={m.id} /> {m.name}
            </label>
          ))}
        </div>
      </fieldset>
      <label class="block text-sm font-medium">Nota de bienvenida (opcional, solo la ve él)
        <textarea class={`${field} h-20 w-full`} name="welcomeNote" maxlength="4000" placeholder="Hola Dani: ofrece Experiencias en tus tres locales. Del precio nos encargamos nosotros."></textarea>
      </label>
      <p class="text-xs text-muted">Después de invitarlo le asignas sus cuentas (locales, centros…) y decides cómo se cotiza cada una.</p>
      <button class="rounded-lg bg-ink px-4 py-2 font-semibold text-bg" type="submit">Invitar colaborador</button>
    </form>
  </section>
</AdminLayout>
