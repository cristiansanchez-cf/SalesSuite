---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { can, ROLE_LABEL } from '~/lib/admin/permissions';
import { flash, formAction } from '~/lib/admin/forms';
import { requestOrigin } from '~/lib/http';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import Icon from '~/components/ui/Icon.astro';
import ConfirmDialog from '~/components/ui/ConfirmDialog.astro';
import EmptyState from '~/components/ui/EmptyState.astro';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
if (!can(admin.session.role).manageTeam) return Astro.rewrite('/admin/forbidden');
const t = admin.tenantAdmin;

let result: { error: string | null; details: string[] } = { error: null, details: [] };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = String(f.get('action'));
  const userId = String(f.get('userId') ?? '');
  let ok = '';
  let partnerId = '';
  result = await formAction(async () => {
    if (action === 'invite-partner') {
      const r = await t.invitePartner({
        email: f.get('email'), moduleIds: f.getAll('moduleIds').map(String), expiresAt: String(f.get('expiresAt') ?? ''),
        welcomeNote: String(f.get('welcomeNote') ?? ''),
      }, `${requestOrigin(Astro.request, Astro.url)}/admin/auth/confirm?next=/admin`);
      partnerId = r.userId;
      ok = r.invited ? 'partner-invited' : 'partner-added';
    } else if (action === 'invite') {
      const r = await t.invite({ email: f.get('email'), role: f.get('role') }, `${requestOrigin(Astro.request, Astro.url)}/admin/auth/confirm?next=/admin/account`);
      ok = r.invited ? 'invited' : 'added';
    } else if (action === 'role') { await t.setRole(userId, f.get('role')); ok = 'role'; }
    else if (action === 'remove') { await t.removeMember(userId); ok = 'removed'; }
  });
  if (!result.error) return Astro.redirect(partnerId ? `/admin/team/partners/${partnerId}?ok=${ok}` : `/admin/team?ok=${ok}`, 303);
}
const okMsg = flash(Astro.url, {
  invited: 'Invitación enviada por email.',
  added: 'Ya tenía cuenta: añadido al equipo (puede entrar con su acceso actual).',
  role: 'Rol actualizado.',
  removed: 'Persona quitada del equipo.',
});
const [members, partners, catalog] = await Promise.all([t.listMembers(), t.listPartners(), t.listCatalog()]);
const modules = catalog.filter((m) => m.isCatalog && m.versions.some((v) => v.status === 'published'));
const dateFmt = (iso: string) => new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(iso));
const perms = can(admin.session.role);
const nameOf = (id: string | null) => { const m = [...members, ...partners].find((x) => x.userId === id); return m ? m.displayName || m.email : null; };
const dateShort = (iso: string | null) => (iso ? new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short' }).format(new Date(iso)) : '');
const initials = (s: string) => s.split(/[\s@.]+/).filter(Boolean).slice(0, 2).map((x) => x[0]!.toUpperCase()).join('');
---
<AdminLayout title="Equipo">
  <PageHeader eyebrow="Configurar" title="Equipo" lede="Admins: todo. Jefes de ventas: equipo, colaboradores, playbook y todos los dossiers (no marca, catálogo ni precios). Comerciales: sus dossiers. Colaboradores: solo sus módulos y cuentas.">
    <button type="button" class="co-btn co-btn--ghost" data-dialog-open="invite-partner"><Icon name="handshake" size={16} />Invitar colaborador</button>
    <button type="button" class="co-btn co-btn--primary" data-dialog-open="invite"><Icon name="user-plus" size={16} />Invitar al equipo</button>
  </PageHeader>
  {okMsg && <div class="mb-4"><Alert kind="success" title={okMsg} /></div>}
  {result.error && <div class="mb-4"><Alert kind="rejection" title={result.error} details={result.details} /></div>}

  <section class="co-section">
    <div class="co-section__head"><h2 class="text-eyebrow">Equipo interno · {members.length}</h2></div>
    <ul class="co-rows" data-testid="members">
      {members.map((m) => (
        <li class="co-row">
          <span class="co-anchor__avatar co-anchor__avatar--soft">{initials(m.displayName || m.email)}</span>
          <span class="co-row__main">
            <span class="co-row-title">{m.displayName || m.email}{m.userId === admin.session.userId && <span class="co-meta"> (tú)</span>}</span>
            <span class="co-meta">{m.email}{m.invitedBy && nameOf(m.invitedBy) ? ` · invitado por ${nameOf(m.invitedBy)}` : ''}</span>
          </span>
          <span class:list={['co-badge', m.role !== 'rep' && 'co-badge--ink']}>{ROLE_LABEL[m.role]}</span>
          {perms.manageTenant && <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-dialog-open={`role-${m.userId}`}>Cambiar rol</button>}
          <button type="button" class="co-btn co-btn--quiet co-btn--sm !text-[var(--console-danger)]" data-dialog-open={`remove-${m.userId}`} data-testid="remove-open">Quitar</button>
          <ConfirmDialog id={`role-${m.userId}`} title={`Rol de ${m.displayName || m.email}`} confirmLabel="Guardar rol"
            does="Cambia lo que puede hacer en la consola desde su próxima página."
            doesNot="No le avisa por email ni cambia de autor sus dossiers.">
            <input type="hidden" name="action" value="role" />
            <input type="hidden" name="userId" value={m.userId} />
            <label class="co-field">Rol
              <select class="co-select" name="role" aria-label={`Rol de ${m.email}`}>
                <option value="rep" selected={m.role === 'rep'}>Comercial</option>
                <option value="lead" selected={m.role === 'lead'}>Jefe/a de ventas</option>
                <option value="admin" selected={m.role === 'admin'}>Admin</option>
              </select>
            </label>
          </ConfirmDialog>
          <ConfirmDialog id={`remove-${m.userId}`} title={`Quitar a ${m.displayName || m.email}`} confirmLabel="Quitar del equipo" danger testid="remove"
            does="Deja de poder entrar en la consola de este espacio."
            doesNot="No borra sus dossiers ni desactiva los enlaces que ya ha enviado: siguen funcionando hasta que los revoques.">
            <input type="hidden" name="action" value="remove" />
            <input type="hidden" name="userId" value={m.userId} />
          </ConfirmDialog>
        </li>
      ))}
    </ul>
  </section>

  <section class="co-section" data-testid="partners">
    <div class="co-section__head">
      <h2 class="text-eyebrow">Colaboradores · {partners.length}</h2>
      <span class="co-meta">Entran con un código por email. Nunca ven la tarifa ni tocan precios.</span>
    </div>
    {partners.length === 0
      ? <EmptyState kind="create" title="Todavía no hay colaboradores" detail="Un DJ que vende en sus locales, un monitor que vende en sus centros… Solo verán lo que les permitas." action={{ dialog: 'invite-partner', label: 'Invitar colaborador' }} />
      : (
        <ul class="co-rows" data-testid="partner-list">
          {partners.map((p) => (
            <li>
              <a href={`/admin/team/partners/${p.userId}`} class:list={['co-row', p.expired && 'co-row--attention']} data-testid="partner-row">
                <span class="co-anchor__avatar co-anchor__avatar--soft">{initials(p.displayName || p.email)}</span>
                <span class="co-row__main">
                  <span class="co-row-title">{p.displayName || p.email}</span>
                  <span class="co-meta">{p.invitedBy && nameOf(p.invitedBy) ? `Invitado por ${nameOf(p.invitedBy)}${p.joinedAt ? ` el ${dateShort(p.joinedAt)}` : ''} · ` : ''}{p.accounts.length} {p.accounts.length === 1 ? 'cuenta' : 'cuentas'} · {p.profile?.moduleIds.length ?? 0} módulos · {p.dossierCount} propuestas{p.expired ? ' · Acceso caducado: no puede entrar' : p.profile?.expiresAt ? ` · Acceso hasta ${dateFmt(p.profile.expiresAt)}` : ''}</span>
                </span>
                <span class="co-badge">Colaborador</span>
                <span class="co-row__chevron"><Icon name="chevron-right" /></span>
              </a>
            </li>
          ))}
        </ul>
      )}
  </section>

  <dialog id="invite" class="co-dialog" aria-labelledby="invite-title">
    <form method="post" data-testid="invite-form">
      <input type="hidden" name="action" value="invite" />
      <div class="co-dialog__body">
        <h2 id="invite-title" class="co-entity">Invitar al equipo</h2>
        <p class="co-body">Le llega un email para entrar. Después entra con su email y un código, sin contraseña.</p>
        <label class="co-field">Email<input class="co-input" type="email" name="email" required /></label>
        <label class="co-field">Rol
          <select class="co-select" name="role"><option value="rep">Comercial</option>{perms.manageTenant && <option value="lead">Jefe/a de ventas</option>}{perms.manageTenant && <option value="admin">Admin</option>}</select>
        </label>
      </div>
      <div class="co-dialog__foot">
        <button type="button" class="co-btn co-btn--ghost" data-dialog-close>Cancelar</button>
        <button class="co-btn co-btn--primary" type="submit">Enviar invitación</button>
      </div>
    </form>
  </dialog>

  <dialog id="invite-partner" class="co-dialog" aria-labelledby="invite-partner-title" style="width:min(40rem,calc(100vw - 32px))">
    <form method="post" data-testid="invite-partner-form">
      <input type="hidden" name="action" value="invite-partner" />
      <div class="co-dialog__body">
        <h2 id="invite-partner-title" class="co-entity">Invitar colaborador</h2>
        <p class="co-body">Después de invitarlo le asignas sus cuentas (locales, centros…) y decides cómo se cotiza cada una.</p>
        <div class="grid gap-3 sm:grid-cols-[1fr_12rem]">
          <label class="co-field">Email<input class="co-input" type="email" name="email" required /></label>
          <label class="co-field">Acceso hasta<input class="co-input" type="date" name="expiresAt" /><span class="co-help">Vacío = sin fecha de fin</span></label>
        </div>
        <fieldset class="grid gap-2">
          <legend class="co-field mb-2">Qué puede ver y vender</legend>
          <div class="co-chips">
            {modules.map((m) => <label class="co-chip"><input type="checkbox" name="moduleIds" value={m.id} />{m.name}</label>)}
          </div>
        </fieldset>
        <label class="co-field">Nota de bienvenida <span class="co-help">Solo la ve él</span>
          <textarea class="co-textarea" name="welcomeNote" maxlength="4000" placeholder="Hola Dani: ofrece Experiencias en tus tres locales. Del precio nos encargamos nosotros."></textarea>
        </label>
        <p class="co-dialog__not"><strong>Lo que no hace:</strong> no le da acceso a la tarifa, a los dossiers del equipo ni a la configuración.</p>
      </div>
      <div class="co-dialog__foot">
        <button type="button" class="co-btn co-btn--ghost" data-dialog-close>Cancelar</button>
        <button class="co-btn co-btn--primary" type="submit">Invitar colaborador</button>
      </div>
    </form>
  </dialog>
</AdminLayout>
