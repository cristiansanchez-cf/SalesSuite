---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { can } from '~/lib/admin/permissions';
import { flash, formAction } from '~/lib/admin/forms';
import { requestOrigin } from '~/lib/http';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import Icon from '~/components/ui/Icon.astro';
import ConfirmDialog from '~/components/ui/ConfirmDialog.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import { i18n } from '~/lib/i18n';
import { teamMessages } from '~/lib/i18n/messages/team';
import { shellMessages } from '~/lib/i18n/messages/shell';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
if (!can(admin.session.role).manageTeam) return Astro.rewrite('/admin/forbidden');
const t = admin.tenantAdmin;
const { m: { team: M }, f: fmt, locale } = i18n(Astro, teamMessages);
const S = shellMessages[locale];

let result: { error: string | null; details: string[] } = { error: null, details: [] };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = String(f.get('action'));
  const userId = String(f.get('userId') ?? '');
  let ok = '';
  let partnerId = '';
  result = await formAction(async () => {
    if (action === 'invite-partner') {
      const r = await t.invitePartner({
        email: f.get('email'), moduleIds: f.getAll('moduleIds').map(String), expiresAt: String(f.get('expiresAt') ?? ''),
        welcomeNote: String(f.get('welcomeNote') ?? ''),
      }, `${requestOrigin(Astro.request, Astro.url)}/admin/auth/confirm?next=/admin`);
      partnerId = r.userId;
      ok = r.invited ? 'partner-invited' : 'partner-added';
    } else if (action === 'invite') {
      const r = await t.invite({ email: f.get('email'), role: f.get('role') }, `${requestOrigin(Astro.request, Astro.url)}/admin/auth/confirm?next=/admin/account`);
      ok = r.invited ? 'invited' : 'added';
    } else if (action === 'role') { await t.setRole(userId, f.get('role')); ok = 'role'; }
    else if (action === 'remove') { await t.removeMember(userId); ok = 'removed'; }
  });
  if (!result.error) return Astro.redirect(partnerId ? `/admin/team/partners/${partnerId}?ok=${ok}` : `/admin/team?ok=${ok}`, 303);
}
const okMsg = flash(Astro.url, {
  invited: M.okInvited,
  added: M.okAdded,
  role: M.okRole,
  removed: M.okRemoved,
});
const [members, partners, catalog] = await Promise.all([t.listMembers(), t.listPartners(), t.listCatalog()]);
const modules = catalog.filter((m) => m.isCatalog && m.versions.some((v) => v.status === 'published'));
const dateFmt = (iso: string) => fmt.date(iso);
const perms = can(admin.session.role);
const nameOf = (id: string | null) => { const m = [...members, ...partners].find((x) => x.userId === id); return m ? m.displayName || m.email : null; };
const dateShort = (iso: string | null) => fmt.date(iso, { day: 'numeric', month: 'short' });
const initials = (s: string) => s.split(/[\s@.]+/).filter(Boolean).slice(0, 2).map((x) => x[0]!.toUpperCase()).join('');
---
<AdminLayout title={M.title}>
  <PageHeader eyebrow={M.eyebrow} title={M.title} lede={M.lede}>
    <button type="button" class="co-btn co-btn--ghost" data-dialog-open="invite-partner"><Icon name="handshake" size={16} />{M.invitePartner}</button>
    <button type="button" class="co-btn co-btn--primary" data-dialog-open="invite"><Icon name="user-plus" size={16} />{M.inviteTeam}</button>
  </PageHeader>
  {okMsg && <div class="mb-4"><Alert kind="success" title={okMsg} /></div>}
  {result.error && <div class="mb-4"><Alert kind="rejection" title={result.error} details={result.details} /></div>}

  <section class="co-section">
    <div class="co-section__head"><h2 class="text-eyebrow">{M.internal(members.length)}</h2></div>
    <ul class="co-rows" data-testid="members">
      {members.map((m) => (
        <li class="co-row">
          <span class="co-anchor__avatar co-anchor__avatar--soft">{initials(m.displayName || m.email)}</span>
          <span class="co-row__main">
            <span class="co-row-title">{m.displayName || m.email}{m.userId === admin.session.userId && <span class="co-meta"> {M.you}</span>}</span>
            <span class="co-meta">{m.email}{m.invitedBy && nameOf(m.invitedBy) ? ` · ${M.invitedByLower(nameOf(m.invitedBy)!)}` : ''}</span>
          </span>
          <span class:list={['co-badge', m.role !== 'rep' && 'co-badge--ink']}>{S.role[m.role]}</span>
          {perms.manageTenant && <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-dialog-open={`role-${m.userId}`}>{M.changeRole}</button>}
          <button type="button" class="co-btn co-btn--quiet co-btn--sm !text-[var(--console-danger)]" data-dialog-open={`remove-${m.userId}`} data-testid="remove-open">{M.remove}</button>
          <ConfirmDialog id={`role-${m.userId}`} title={M.roleOf(m.displayName || m.email)} confirmLabel={M.saveRole}
            does={M.roleDoes}
            doesNot={M.roleDoesNot}>
            <input type="hidden" name="action" value="role" />
            <input type="hidden" name="userId" value={m.userId} />
            <label class="co-field">{M.role}
              <select class="co-select" name="role" aria-label={M.roleOf(m.email)}>
                <option value="rep" selected={m.role === 'rep'}>{S.role.rep}</option>
                <option value="lead" selected={m.role === 'lead'}>{S.role.lead}</option>
                <option value="admin" selected={m.role === 'admin'}>{S.role.admin}</option>
              </select>
            </label>
          </ConfirmDialog>
          <ConfirmDialog id={`remove-${m.userId}`} title={M.removeTitle(m.displayName || m.email)} confirmLabel={M.removeConfirm} danger testid="remove"
            does={M.removeDoes}
            doesNot={M.removeDoesNot}>
            <input type="hidden" name="action" value="remove" />
            <input type="hidden" name="userId" value={m.userId} />
          </ConfirmDialog>
        </li>
      ))}
    </ul>
  </section>

  <section class="co-section" data-testid="partners">
    <div class="co-section__head">
      <h2 class="text-eyebrow">{M.partners(partners.length)}</h2>
      <span class="co-meta">{M.partnersHelp}</span>
    </div>
    {partners.length === 0
      ? <EmptyState kind="create" title={M.partnersEmpty} detail={M.partnersEmptyDetail} action={{ dialog: 'invite-partner', label: M.invitePartner }} />
      : (
        <ul class="co-rows" data-testid="partner-list">
          {partners.map((p) => (
            <li>
              <a href={`/admin/team/partners/${p.userId}`} class:list={['co-row', p.expired && 'co-row--attention']} data-testid="partner-row">
                <span class="co-anchor__avatar co-anchor__avatar--soft">{initials(p.displayName || p.email)}</span>
                <span class="co-row__main">
                  <span class="co-row-title">{p.displayName || p.email}</span>
                  <span class="co-meta">{p.invitedBy && nameOf(p.invitedBy) ? `${M.partnerInvitedBy(nameOf(p.invitedBy)!, dateShort(p.joinedAt))} · ` : ''}{M.accounts(p.accounts.length)} · {M.modules(p.profile?.moduleIds.length ?? 0)} · {M.proposals(p.dossierCount)}{p.expired ? ` · ${M.expiredMeta}` : p.profile?.expiresAt ? ` · ${M.accessUntil(dateFmt(p.profile.expiresAt))}` : ''}</span>
                </span>
                <span class="co-badge">{S.role.partner}</span>
                <span class="co-row__chevron"><Icon name="chevron-right" /></span>
              </a>
            </li>
          ))}
        </ul>
      )}
  </section>

  <dialog id="invite" class="co-dialog" aria-labelledby="invite-title">
    <form method="post" data-testid="invite-form">
      <input type="hidden" name="action" value="invite" />
      <div class="co-dialog__body">
        <h2 id="invite-title" class="co-entity">{M.inviteTeam}</h2>
        <p class="co-body">{M.inviteBody}</p>
        <label class="co-field">{M.email}<input class="co-input" type="email" name="email" required /></label>
        <label class="co-field">{M.role}
          <select class="co-select" name="role"><option value="rep">{S.role.rep}</option>{perms.manageTenant && <option value="lead">{S.role.lead}</option>}{perms.manageTenant && <option value="admin">{S.role.admin}</option>}</select>
        </label>
      </div>
      <div class="co-dialog__foot">
        <button type="button" class="co-btn co-btn--ghost" data-dialog-close>{S.ui.cancel}</button>
        <button class="co-btn co-btn--primary" type="submit">{M.sendInvite}</button>
      </div>
    </form>
  </dialog>

  <dialog id="invite-partner" class="co-dialog" aria-labelledby="invite-partner-title" style="width:min(40rem,calc(100vw - 32px))">
    <form method="post" data-testid="invite-partner-form">
      <input type="hidden" name="action" value="invite-partner" />
      <div class="co-dialog__body">
        <h2 id="invite-partner-title" class="co-entity">{M.invitePartner}</h2>
        <p class="co-body">{M.partnerInviteBody}</p>
        <div class="grid gap-3 sm:grid-cols-[1fr_12rem]">
          <label class="co-field">{M.email}<input class="co-input" type="email" name="email" required /></label>
          <label class="co-field">{M.accessUntilLabel}<input class="co-input" type="date" name="expiresAt" /><span class="co-help">{M.noEndDate}</span></label>
        </div>
        <fieldset class="grid gap-2">
          <legend class="co-field mb-2">{M.whatCan}</legend>
          <div class="co-chips">
            {modules.map((m) => <label class="co-chip"><input type="checkbox" name="moduleIds" value={m.id} />{m.name}</label>)}
          </div>
        </fieldset>
        <label class="co-field">{M.welcomeNote} <span class="co-help">{M.onlyThem}</span>
          <textarea class="co-textarea" name="welcomeNote" maxlength="4000" placeholder={M.welcomePlaceholder}></textarea>
        </label>
        <p class="co-dialog__not"><strong>{S.ui.doesNot}</strong> {M.partnerInviteNot}</p>
      </div>
      <div class="co-dialog__foot">
        <button type="button" class="co-btn co-btn--ghost" data-dialog-close>{S.ui.cancel}</button>
        <button class="co-btn co-btn--primary" type="submit">{M.invitePartner}</button>
      </div>
    </form>
  </dialog>
</AdminLayout>
