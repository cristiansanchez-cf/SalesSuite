---
/**
 * Qué ha funcionado (docs/EVIDENCE.md): cierres reales del equipo ordenados por lo que se parecen a tu situación.
 * Sustituye a los «me gusta»: aquí solo cuenta lo que cerró (o lo que hizo perder) una venta.
 */
import AdminLayout from '~/layouts/AdminLayout.astro';
import { can } from '~/lib/admin/permissions';
import PageHeader from '~/components/ui/PageHeader.astro';
import Alert from '~/components/ui/Alert.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import ConfirmDialog from '~/components/ui/ConfirmDialog.astro';
import Icon from '~/components/ui/Icon.astro';
import { flash, formAction } from '~/lib/admin/forms';
import { AdminError } from '~/lib/admin/service';
import { isIconName } from '~/lib/ui/icons';
import type { Situation } from '~/lib/evidence/types';
import { i18n } from '~/lib/i18n';
import { sellMessages } from '~/lib/i18n/messages/sell';

const { admin } = Astro.locals;
if (!admin) return Astro.redirect('/admin/login');
const ev = admin.evidence;
const { m, f: fmt } = i18n(Astro, sellMessages);
const isAdmin = can(admin.session.role).managePlaybook;

let result: { error: string | null; details: string[] } = { error: null, details: [] };
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  result = await formAction(() => ev.setStoryHidden(String(f.get('id') ?? ''), f.get('action') === 'hide'));
  if (!result.error) return Astro.redirect(`/admin/wins${Astro.url.search}`, 303);
}

const u = Astro.url.searchParams;
const facets = await ev.facets();
const market = await admin.playbook.market();
let segmentId = u.get('segment') || null;
let personaIds = u.getAll('persona').filter(Boolean);
let situation: Situation = Object.fromEntries(facets.map((f) => [f.key, u.getAll(`facet:${f.key}`).filter(Boolean)]).filter(([, v]) => v.length));
const fromDossier = u.get('dossier');
let dossierTitle: string | null = null;
if (fromDossier && !u.has('segment') && !u.has('persona') && ![...u.keys()].some((k) => k.startsWith('facet:'))) {
  try {
    const st = await admin.service.getState(fromDossier);
    const q = ev.queryOf(st, facets);
    ({ segmentId, personaIds, situation } = q);
    dossierTitle = st.dossier.title;
  } catch (e) { if (!(e instanceof AdminError)) throw e; }
}
const outcome = u.get('outcome') === 'won' || u.get('outcome') === 'lost' ? (u.get('outcome') as 'won' | 'lost') : null;
const r = await ev.recommend({ segmentId, personaIds, situation, outcome }, { limit: 30 });
const anyStories = r.described || outcome ? (await ev.recommend({})).total > 0 : r.total > 0;
const okMsg = flash(Astro.url, { story: m.wins.storySaved });
const personas = market.flatMap((sg) => sg.personas.map((p) => ({ ...p, segmentName: sg.name })));
const shownPersonas = segmentId ? personas.filter((p) => p.segmentId === segmentId || personaIds.includes(p.id)) : personas;
const date = (iso: string) => fmt.date(iso || null);
const icon = (x: string | null | undefined) => (x && isIconName(x) ? x : null);
const sel = (key: string, v: string) => (situation[key] ?? []).includes(v);
---
<AdminLayout title={m.wins.title}>
  <PageHeader eyebrow={m.common.eyebrow} title={m.wins.title} lede={m.wins.lede} />
  {okMsg && <div class="mb-4"><Alert kind="success" title={okMsg} /></div>}
  {result.error && <div class="mb-4"><Alert kind="rejection" title={result.error} /></div>}

  <div class="co-split">
    <section class="grid content-start gap-4">
      {!r.enough && r.closes > 0 && (
        <p class="co-alert co-alert--info text-sm" data-testid="win-few">{m.wins.few(r.closes, r.minCloses)}</p>
      )}
      {r.plays.length > 0 && (
        <div class="co-card co-card--soft grid gap-3" data-testid="win-plays">
          <p class="text-eyebrow">{r.described ? m.wins.topSimilar : m.wins.top}</p>
          <ol class="grid gap-2 p-0">
            {r.plays.map((p, i) => (
              <li class="flex items-baseline gap-3">
                <span class="co-num text-xl">{String(i + 1).padStart(2, '0')}</span>
                <a class="min-w-0 flex-1 co-row-title hover:underline" href={`/admin/learn/${p.moduleId ?? 'general'}#play-${p.playId}`}>{p.title}</a>
                <span class="co-meta">{m.wins.wonN(p.wonIn)}{p.lostIn ? m.wins.lostN(p.lostIn) : ''}</span>
              </li>
            ))}
          </ol>
          {r.won < 3 && <p class="co-meta">{m.wins.hint(r.won)}</p>}
        </div>
      )}

      <div class="co-section__head !mb-0">
        <h2 class="text-eyebrow">{r.described ? m.wins.similar(r.total) : m.wins.allClosed(r.total)}{dossierTitle ? m.wins.situationOf(dossierTitle) : ''}</h2>
        <nav class="co-chips" aria-label={m.wins.outcome}>
          {([[null, m.common.all], ['won', m.wins.wonPl], ['lost', m.wins.lostPl]] as const).map(([k, label]) => {
            const x = new URL(Astro.url); k ? x.searchParams.set('outcome', k) : x.searchParams.delete('outcome');
            return <a class="co-chip" href={x.pathname + x.search} aria-current={outcome === k ? 'true' : undefined}>{label}</a>;
          })}
        </nav>
      </div>

      {r.stories.length === 0 ? (
        anyStories
          ? <EmptyState kind="filter" title={m.wins.emptyFiltered} clearHref="/admin/wins" clearLabel={m.wins.clearAll} />
          : <EmptyState kind="create" title={m.wins.emptyTitle} detail={m.wins.emptyDetail} action={{ href: '/admin', label: m.wins.emptyAction }} />
      ) : (
        <ul class="co-rows" data-testid="stories">
          {r.stories.map((s) => (
            <li class:list={['co-card grid gap-2', s.story.status === 'hidden' && 'opacity-60']} data-testid="story" data-outcome={s.story.outcome}>
              <div class="flex flex-wrap items-center gap-2">
                <span class:list={['co-badge', s.story.outcome === 'won' ? 'co-badge--ink' : 'co-badge--attention']}>{s.story.outcome === 'won' ? m.common.won : m.common.lost}</span>
                <h3 class="co-card-title min-w-0 flex-1">{s.story.title}</h3>
                <span class="co-meta">{s.authorName ?? m.common.team} · {date(s.story.createdAt)}</span>
              </div>
              <div class="flex flex-wrap gap-1">
                {s.segmentName && !s.matches.some((x) => x.kind === 'segment') && <span class="co-tag">{s.segmentName}</span>}
                {s.matches.map((x) => <span class="co-tag co-tag--match" title={m.wins.matches}><Icon name="check" size={12} />{x.label}</span>)}
                {s.differs.map((x) => <span class="co-tag" title={m.wins.differs}>{x.label}</span>)}
                {s.story.keyStage && <span class="co-tag">{m.wins.keyStage(m.labels.stage[s.story.keyStage])}</span>}
                {s.story.objection && <span class="co-tag">{m.wins.objection(m.labels.objection[s.story.objection])}</span>}
              </div>
              {s.story.whatWorked && <p class="co-body"><strong class="text-ink">{m.wins.worked}</strong> {s.story.whatWorked}</p>}
              {s.story.whatFailed && <p class="co-body"><strong class="text-ink">{m.wins.failed}</strong> {s.story.whatFailed}</p>}
              {isAdmin && (
                <div class="flex justify-end">
                  <button type="button" class="co-btn co-btn--quiet co-btn--sm" data-dialog-open={`hide-${s.story.id}`}>{s.story.status === 'hidden' ? m.wins.share : m.wins.hide}</button>
                  <ConfirmDialog id={`hide-${s.story.id}`} title={s.story.status === 'hidden' ? m.wins.shareTitle : m.wins.hideTitle} confirmLabel={s.story.status === 'hidden' ? m.wins.shareConfirm : m.wins.hide}
                    does={s.story.status === 'hidden' ? m.wins.shareDoes : m.wins.hideDoes}
                    doesNot={m.wins.doesNot}>
                    <input type="hidden" name="action" value={s.story.status === 'hidden' ? 'show' : 'hide'} />
                    <input type="hidden" name="id" value={s.story.id} />
                  </ConfirmDialog>
                </div>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>

    <aside class="co-split__aside--sticky">
      <form method="get" class="co-card grid gap-4" data-testid="situation-form">
        <div><p class="text-eyebrow mb-1">{m.wins.yourSituation}</p><h2 class="co-entity">{m.wins.withWhat}</h2></div>
        {outcome && <input type="hidden" name="outcome" value={outcome} />}
        <fieldset class="grid gap-2">
          <legend class="co-field mb-1">{m.common.sector}</legend>
          <div class="co-chips">
            {market.map((sg) => <label class="co-chip">{icon(sg.icon) && <Icon name={icon(sg.icon)!} size={14} />}<input type="radio" name="segment" value={sg.id} checked={segmentId === sg.id} />{sg.name}</label>)}
            <label class="co-chip"><input type="radio" name="segment" value="" checked={!segmentId} />{m.wins.any}</label>
          </div>
        </fieldset>
        <fieldset class="grid gap-2">
          <legend class="co-field mb-1">{m.common.whoTalk} <span class="co-help">{m.common.optional}</span></legend>
          <div class="co-chips">{shownPersonas.map((p) => <label class="co-chip" title={p.segmentName}><input type="checkbox" name="persona" value={p.id} checked={personaIds.includes(p.id)} />{p.name}</label>)}</div>
        </fieldset>
        {facets.map((f) => (
          <fieldset class="grid gap-2">
            <legend class="co-field mb-1">{f.question ?? f.label} <span class="co-help">{m.common.optional}</span></legend>
            <div class="co-chips">
              {f.options.map((o) => <label class="co-chip" title={o.hint ?? ''}>{icon(o.icon) && <Icon name={icon(o.icon)!} size={14} />}<input type="checkbox" name={`facet:${f.key}`} value={o.key} checked={sel(f.key, o.key)} />{o.label}</label>)}
            </div>
          </fieldset>
        ))}
        <div class="flex flex-wrap gap-2">
          <button class="co-btn co-btn--primary" type="submit" data-testid="situation-go">{m.wins.go} <span aria-hidden="true">→</span></button>
          <a class="co-btn co-btn--quiet" href="/admin/wins">{m.wins.clear}</a>
        </div>
      </form>
    </aside>
  </div>
</AdminLayout>
