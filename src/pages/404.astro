---
import '~/styles/global.css';
import { DEFAULT_LOCALE, fromAcceptLanguage, type Locale } from '~/lib/i18n';
// Página neutra a propósito: no revela si el dossier existe ni de qué tenant es. En el idioma de quien la abre.
Astro.response.status = 404;
const locale: Locale = Astro.locals.locale ?? fromAcceptLanguage(Astro.request.headers.get('accept-language')) ?? DEFAULT_LOCALE;
const T: Record<Locale, { title: string; body: string }> = {
  es: { title: 'No encontrado', body: 'Este enlace no existe o ya no está disponible.' },
  en: { title: 'Not found', body: 'This link does not exist or is no longer available.' },
  pt: { title: 'Não encontrado', body: 'Este link não existe ou não está mais disponível.' },
  ko: { title: '찾을 수 없음', body: '이 링크는 존재하지 않거나 더 이상 사용할 수 없습니다.' },
};
const t = T[locale] ?? T.es;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{t.title}</title>
  </head>
  <body class="grid min-h-screen place-items-center p-6 text-center">
    <div>
      <h1 class="text-4xl font-extrabold">404</h1>
      <p class="mt-3 text-muted">{t.body}</p>
    </div>
  </body>
</html>
