---
/**
 * La raíz de cada espacio (enjoy.ventas.cofundo.io/): no hay nada público que ver aquí (las propuestas van por su
 * enlace /d/<token>), así que lleva a la consola; sin sesión, la consola lleva a entrar y luego vuelve.
 */
const { tenant } = Astro.locals;
if (!tenant) return Astro.rewrite('/404');
return Astro.redirect('/admin', 302);
