---
/**
 * Cualificación de una promotora o de un DJ (docs/CRM_DINAMICO.md §24): sus preguntas, un clic cada una (pulsar lo
 * marcado lo desmarca), y su nota. Mismo formulario que la del local («qualify»), con sus propias claves.
 */
import type { Priority } from '~/lib/crm/priority';
import { CACHE_OF, DJ_OPTIONS, PROMOTER_OPTIONS, STYLES, offStyle } from '~/lib/crm/profiles';
import { i18n } from '~/lib/i18n';
import { profilesMessages } from '~/lib/i18n/messages/profiles';
import { priorityMessages } from '~/lib/i18n/messages/priority';

interface Props { profile: 'promoter' | 'dj'; q: Record<string, unknown>; p: Priority; canEdit: boolean }
const { profile, q, p, canEdit } = Astro.props;
const { m: PM, locale } = i18n(Astro, profilesMessages);
const R = priorityMessages[locale];
const styleKey = profile === 'promoter' ? 'pstyle' : 'dstyle';
const keys = profile === 'promoter' ? (Object.keys(PROMOTER_OPTIONS) as Array<keyof typeof PROMOTER_OPTIONS>) : (Object.keys(DJ_OPTIONS) as Array<keyof typeof DJ_OPTIONS>);
const styles = Array.isArray(q[styleKey]) ? (q[styleKey] as string[]) : q[styleKey] ? [String(q[styleKey])] : [];
const part = (k: string) => p.parts.find((x) => x.key === k);
const pts = (k: string) => { const x = part(k); return x ? (x.points === null ? `${R.unknown} / ${x.weight}` : `${Number.isInteger(x.points) ? x.points : x.points.toFixed(1).replace('.', ',')} / ${x.weight}`) : ''; };
// Cada pregunta con sus opciones (fuera de la plantilla: los tipos genéricos no van dentro del HTML).
const rows = keys.map((k) => { const [label, opts] = PM.q[k] as unknown as [string, Record<string, string>]; return { k: k as string, label, opts }; });
const cache = profile === 'dj' && typeof q.dfollow === 'string' && q.dfollow in CACHE_OF ? CACHE_OF[q.dfollow as keyof typeof CACHE_OF] : null;
---
<section id="qual" class="co-card grid gap-4" data-testid="qualification" data-profile={profile} data-score={p.score} data-out={p.out ? 'true' : 'false'}>
  <div class="flex items-start justify-between gap-3">
    <div class="grid min-w-0 gap-1"><h2 class="co-entity">{PM.title[profile]}</h2><p class="co-meta">{PM.lede[profile]}</p></div>
    <div class="grid max-w-[45%] shrink-0 justify-items-end gap-1 text-right">
      {p.out ? <span class="co-tag !bg-[var(--co-ink)] !text-[var(--co-canvas)]" data-testid="qual-out">{R.outBy(p.kills.map((k) => R.kills[k]).join(' · '))}</span>
        : <span class="co-figure text-4xl" data-testid="qual-score">{p.score}</span>}
      {!p.out && <span class="co-meta">{p.qualified ? R.qualified : `${R.unqualified} · ${R.upTo(p.max)}`}</span>}
    </div>
  </div>
  <form method="post" action="#qual" class="grid gap-3" data-testid="qual-form" data-async="qual account-summary">
    <input type="hidden" name="action" value="qualify" />
    <fieldset class="grid gap-3" disabled={!canEdit}>
      <div class="grid gap-1.5" data-criterion={styleKey}>
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <span class="co-row-title">{PM.style} <span class="co-meta font-normal">· {PM.styleHint}</span></span>
          <span class="co-meta tabular-nums">{pts(styleKey)}</span>
        </div>
        <div class="flex flex-wrap gap-2">
          {STYLES.map((s) => <button type="submit" name="set" value={`${styleKey}:${s}`} class="co-chip" aria-pressed={styles.includes(s) ? 'true' : 'false'} data-testid={`qual-${styleKey}-${s}`}>{PM.styles[s]}</button>)}
        </div>
        {offStyle(q, styleKey) && <p class="co-tag co-tag--danger m-0 w-fit" data-testid="qual-offstyle">{PM.offStyle}</p>}
      </div>
      {rows.map(({ k, label, opts }) => {
        return (
          <div class="grid gap-1.5 border-t border-[var(--co-rule)] pt-3" data-criterion={k}>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <span class="co-row-title">{label}</span>
              <span class="co-meta tabular-nums" data-testid={`qual-points-${k}`}>{pts(k)}</span>
            </div>
            <div class="flex flex-wrap gap-2">
              {Object.keys(opts).map((v) => <button type="submit" name="set" value={`${k}:${v}`} class="co-chip" aria-pressed={q[k] === v ? 'true' : 'false'} data-testid={`qual-${k}-${v}`}>{opts[v]}</button>)}
            </div>
            {k === 'dfollow' && cache && <p class="co-meta m-0" data-testid="qual-cache">{PM.cache[cache]}</p>}
          </div>
        );
      })}
      <div class="grid gap-1.5 border-t border-[var(--co-rule)] pt-3" data-criterion="kills">
        <span class="co-row-title">{R.killsTitle} <span class="co-meta font-normal">· {R.killsHelp}</span></span>
        <div class="flex flex-wrap gap-2">
          <button type="submit" name="set" value="debt:true" class="co-chip qual-kill" aria-pressed={q.debt ? 'true' : 'false'} data-testid="qual-kill-debt">{R.kills.debt}</button>
        </div>
      </div>
    </fieldset>
  </form>
</section>

<style>
  [data-testid=qualification] .co-chip[aria-pressed=true] { background: var(--co-ink); color: var(--co-canvas); border-color: var(--co-ink); }
  [data-testid=qualification] .qual-kill[aria-pressed=true] { background: #b42318; border-color: #b42318; color: #fff; }
</style>
