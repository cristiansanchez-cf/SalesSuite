---
/**
 * El acuerdo de una empresa en su ficha (docs/CLIENTS.md): el vigente y sus versiones, el pendiente de confirmar y
 * «Cerrar con acuerdo» / «Cambiar el acuerdo». Formularios con action agreement / agreement-ok / agreement-no.
 */
import Icon from '~/components/ui/Icon.astro';
import type { Agreement } from '~/lib/crm/types';
import { clientsMessages } from '~/lib/i18n/messages/clients';
import type { Locale } from '~/lib/i18n/core';
import { cleanPicks, discountPct, extraTerms, freeNotes, type Product, type Tier } from '~/lib/crm/packages';
import { packagesMessages } from '~/lib/i18n/messages/packages';

interface Props {
  locale: Locale; agreements: Agreement[]; customer: boolean; canClose: boolean; canDecide: boolean; ownerName: string | null;
  date: (iso: string) => string;
  /** Dentro de la tarjeta «Cierre»: sin marco ni título, y el formulario abierto si aún no es cliente. */
  embedded?: boolean;
  /** Paquetes (docs/PAQUETES.md): con catálogo, se cierra eligiendo paquetes y precio (el normal sale de su tamaño). */
  products?: Product[]; tier?: Tier; money?: (n: number) => string;
  /** packages: paquetes al mes · event: pago por evento (promotoras y festivales) · plain: solo lo acordado. */
  mode?: 'packages' | 'event' | 'plain';
  /** Solo el formulario (la segunda pestaña de «Cierre»: lo vigente ya sale en la primera). */
  formOnly?: boolean;
  /** Atajos de precio por evento (las tarifas por evento del espacio). */
  eventHints?: Array<{ label: string; amount: number; note: string | null }>;
}
const { locale, agreements, customer, canClose, canDecide, ownerName, date, embedded = false, products = [], tier = 'medium', money = (n: number) => `${n} €`, formOnly = false, eventHints = [] } = Astro.props;
const mode = Astro.props.mode ?? (products.length ? 'packages' : 'plain');
const C = clientsMessages[locale];
const P = packagesMessages[locale];
const withPkgs = mode === 'packages' && products.length > 0;
const isEvent = mode === 'event';
/** Los paquetes de un acuerdo, en etiquetas, y su precio («50 € al mes · −33 %»). */
const chips = (g: Agreement) => cleanPicks(g.packages, products.map((p) => ({ ...p, active: true }))).map((x) => `${products.find((p) => p.key === x.key)?.name ?? x.key}${x.free ? ` (${P.freeCheck})` : ''}`);
const priceLine = (g: Agreement) => (g.price == null ? null : [g.price === 0 ? P.freeCheck : `${money(g.price)}/${P.periods[g.pricePeriod ?? 'month']}`, discountPct(g.price, g.listPrice) != null ? P.discount(discountPct(g.price, g.listPrice)!) : null].filter(Boolean).join(' · '));
const preset = (agreements.find((g) => g.status === 'active') ?? null);
const chosen = new Set(preset?.packages ?? []);
const active = agreements.find((g) => g.status === 'active') ?? null;
const pending = agreements.find((g) => g.status === 'pending') ?? null;
const old = agreements.filter((g) => g.status === 'replaced');
const today = new Date().toISOString().slice(0, 10);
const CHECKINS = [14, 30, 60, 90];
const show = formOnly ? canClose : customer || active || pending || canClose;
/** Dentro de «Cierre» y sin cerrar aún: el formulario, directamente. */
const inline = formOnly || (embedded && !customer && !active && !pending);
---
{show && (
  <section id="agreement" class:list={['grid gap-3', !embedded && 'co-card']} data-testid="agreement">
    {!embedded && <div class="flex items-center gap-2"><Icon name="handshake" size={16} /><p class="text-eyebrow m-0">{C.card}</p></div>}

    {!formOnly && pending && (
      <div class="grid gap-2 rounded-xl border border-[var(--console-attention)] bg-[var(--console-attention-bg)] p-3" data-testid="agreement-pending">
        <strong>{C.pending}</strong>
        <p class="co-body m-0 whitespace-pre-line" data-ugc>{pending.terms}</p>
        <p class="co-meta m-0">{[C.sinceLine(date(pending.startsOn)), pending.checkinDays ? C.every(C.days(pending.checkinDays)) : null, ownerName ? C.pendingBy(ownerName) : null].filter(Boolean).join(' · ')}</p>
        {canDecide && (
          <div class="flex flex-wrap gap-2">
            <form method="post"><input type="hidden" name="action" value="agreement-ok" /><input type="hidden" name="agreementId" value={pending.id} />
              <button class="co-btn co-btn--primary co-btn--sm" data-testid="agreement-confirm">{C.confirm}</button></form>
            <form method="post"><input type="hidden" name="action" value="agreement-no" /><input type="hidden" name="agreementId" value={pending.id} />
              <button class="co-btn co-btn--quiet co-btn--sm" data-testid="agreement-reject">{C.reject}</button></form>
          </div>
        )}
      </div>
    )}

    {formOnly ? null : active ? (
      <div class="grid gap-1" data-testid="agreement-active">
        <p class="co-meta m-0">{C.current}</p>
        {active.packages.length > 0 && (
          <div class="flex flex-wrap items-center gap-1.5" data-testid="agreement-packages">
            {chips(active).map((x) => <span class="co-badge co-badge--ink">{x}</span>)}
            {priceLine(active) && <span class="co-entity ml-1 !text-base" data-testid="agreement-price">{priceLine(active)}</span>}
          </div>
        )}
        {(() => { const t = active.packages.length ? extraTerms(active.terms, cleanPicks(active.packages, products.map((p) => ({ ...p, active: true }))), products, { price: active.price, list: active.listPrice }) : active.terms; return t && <p class="co-body m-0 whitespace-pre-line" data-ugc>{t}</p>; })()}
        {active.packages.length > 0 && freeNotes(cleanPicks(active.packages, products.map((p) => ({ ...p, active: true }))), products).map((n) => <p class="co-meta m-0" data-testid="agreement-free">{n}</p>)}
        <p class="co-meta m-0">{[C.sinceLine(date(active.startsOn)), active.checkinDays ? C.every(C.days(active.checkinDays)) : null].filter(Boolean).join(' · ')}</p>
      </div>
    ) : customer && !pending ? <p class="co-meta m-0">{C.noAgreement}</p> : null}

    {!formOnly && old.length > 0 && (
      <details class="co-meta" data-testid="agreement-history"><summary class="cursor-pointer">{C.history(old.length)}</summary>
        <ul class="mt-2 grid gap-2 pl-0">
          {old.map((g) => <li class="list-none"><span class="whitespace-pre-line" data-ugc>{g.terms}</span><br />{C.sinceLine(date(g.startsOn))}</li>)}
        </ul>
      </details>
    )}

    {canClose && (
      <details class="grid gap-2" data-testid="agreement-form-wrap" open={inline ? true : undefined}>
        {/* Dentro de «Cierre» y sin cerrar aún, el formulario ya está abierto: sin botón para abrirlo (un solo botón). */}
        <summary class:list={[`co-btn ${customer || active ? 'co-btn--ghost' : 'co-btn--primary'} co-btn--sm w-fit cursor-pointer list-none`, inline && '!hidden']} data-testid="agreement-open">
          <Icon name="handshake" size={14} />{isEvent ? P.eventTab : withPkgs ? (active || customer ? P.changeBtn : C.close) : active ? C.change : customer ? C.note : C.close}
        </summary>
        <form method="post" class:list={['grid gap-3', !inline && 'mt-2']} data-testid="agreement-form">
          <input type="hidden" name="action" value="agreement" />
          {isEvent ? (
            <div class="grid gap-3" data-event data-testid="agreement-event">
              <input type="hidden" name="priceMode" value="event" />
              <p class="co-help m-0">{P.eventHelp}</p>
              <fieldset class="grid gap-2"><legend class="co-entity !text-base mb-1">{P.eventPrice}</legend>
                {eventHints.length > 0 && (
                  <div class="co-chips">
                    {eventHints.map((h) => <button type="button" class="co-chip" data-fill={String(h.amount)} title={h.note ?? undefined} data-testid="event-hint">{h.label.replace(/\s*·\s*por evento$/i, '')} · {money(h.amount)}{h.note ? <span class="co-meta ml-1 text-xs">({h.note})</span> : null}</button>)}
                  </div>
                )}
                <span class="flex items-center gap-2"><input class="co-input !w-28" name="price" inputmode="decimal" required data-testid="event-price" /><span class="co-meta text-sm">{P.perEvent}</span></span>
              </fieldset>
              {products.length > 0 && (
                <fieldset class="grid gap-2"><legend class="co-meta mb-1">{P.eventIncludes}</legend>
                  <div class="co-chips">
                    {products.map((p) => <label class="co-chip relative cursor-pointer"><input type="checkbox" name="packages" value={p.key} data-testid={`event-pkg-${p.key}`} />{p.name}</label>)}
                  </div>
                </fieldset>
              )}
              <label class="co-field">{P.notes}<textarea class="co-textarea !min-h-[56px]" name="terms" maxlength="4000" placeholder={P.notesPh} data-testid="event-terms"></textarea></label>
            </div>
          ) : withPkgs ? (
            <div class="grid gap-3" data-pkgs data-testid="agreement-pkgs">
              <fieldset class="grid gap-2"><legend class="co-entity !text-base mb-1">{P.pick}</legend>
                <span class="co-help">{P.pickHelp(P.tiers[tier].toLowerCase())}</span>
                {products.map((p) => { const v = p.prices[tier]; const on = chosen.has(p.key) || chosen.has(`${p.key}:free`); return (
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 rounded-xl border border-[var(--console-divider)] px-3 py-2 has-[input[name=packages]:checked]:border-[var(--co-ink)]">
                    <label class="flex min-w-0 flex-1 cursor-pointer items-center gap-2">
                      <input type="checkbox" name="packages" value={p.key} checked={on} disabled={v == null} data-price={v ?? ''} class="h-4 w-4 accent-[var(--co-ink)]" data-testid={`pkg-${p.key}`} />
                      <span class="grid min-w-0"><span class="font-semibold">{p.name}</span>{p.summary && <span class="co-meta truncate text-xs">{p.summary}</span>}</span>
                    </label>
                    <span class="co-meta text-sm">{v == null ? P.noPrice : `${money(v)}/${P.periods[p.period]}`}</span>
                    {p.freeAllowed && <label class="flex items-center gap-1 text-sm" title={p.freeNote ?? undefined}><input type="checkbox" name="free" value={p.key} checked={chosen.has(`${p.key}:free`)} data-testid={`pkg-free-${p.key}`} />{P.freeCheck}</label>}
                  </div>
                ); })}
              </fieldset>
              <fieldset class="grid gap-2"><legend class="co-entity !text-base mb-1">{P.price}</legend>
                <div class="flex flex-wrap items-center gap-2">
                  <label class="co-chip relative cursor-pointer"><input type="radio" name="priceMode" value="list" checked={!(preset?.price != null && preset.price !== preset.listPrice)} />{P.normal('')}<strong data-list>—</strong></label>
                  <label class="co-chip relative cursor-pointer"><input type="radio" name="priceMode" value="custom" checked={preset?.price != null && preset.price !== preset.listPrice} data-testid="price-custom" />{P.other}</label>
                  <span class="pkg-custom flex items-center gap-1"><input class="co-input !w-24" name="price" inputmode="decimal" value={preset?.price != null && preset.price !== preset.listPrice ? String(preset.price) : ''} data-testid="price-input" /><span class="co-meta text-sm">{P.perMonth}</span></span>
                  <span class="co-badge co-badge--attention" data-discount hidden />
                </div>
              </fieldset>
              <label class="co-field">{P.notes}<textarea class="co-textarea !min-h-[56px]" name="terms" maxlength="4000" placeholder={P.notesPh} data-testid="agreement-terms"></textarea></label>
            </div>
          ) : (
            <>
              <p class="co-help m-0">{customer || active ? C.changeHelp : products.length ? P.dealHelp : C.closeHelp}</p>
              <label class="co-field">{C.terms}<textarea class="co-textarea" name="terms" required minlength="3" maxlength="4000" placeholder={C.termsPh} data-testid="agreement-terms">{active?.terms ?? ''}</textarea></label>
            </>
          )}
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="co-field">{C.since}<input class="co-input" type="date" name="startsOn" value={today} /></label>
            <label class="co-field">{C.checkin}
              <select class="co-select" name="checkinDays" data-testid="agreement-checkin">
                <option value="">{C.checkinNone}</option>
                {CHECKINS.map((d) => <option value={d} selected={(active?.checkinDays ?? 30) === d}>{C.days(d)}</option>)}
              </select>
            </label>
          </div>
          <p class="co-help m-0">{C.checkinHelp}{!canDecide && ` ${C.proposeHelp}`}</p>
          <button class="co-btn co-btn--primary w-fit" data-testid={isEvent ? 'event-save' : 'agreement-save'}>{withPkgs || isEvent ? (!canDecide ? P.proposeBtn : customer || active ? C.saveChange : P.closeBtn) : !canDecide ? C.propose : customer || active ? C.saveChange : C.save}</button>
          {(withPkgs || isEvent) && !canDecide && <p class="co-help m-0">{P.proposeHelp}</p>}
        </form>
      </details>
    )}
  </section>
)}

<style>
  /* «Otro precio»: el campo solo si está marcado. */
  [data-pkgs]:not(:has(input[name='priceMode'][value='custom']:checked)) .pkg-custom { display: none; }
</style>
<script>
  // Pago por evento: los atajos rellenan el precio.
  document.querySelectorAll<HTMLButtonElement>('[data-event] [data-fill]').forEach((b) => b.addEventListener('click', () => {
    const i = b.closest('[data-event]')!.querySelector<HTMLInputElement>('input[name=price]')!;
    i.value = b.dataset.fill!; i.focus();
  }));
  // El precio normal de lo marcado (lo gratis no suma) y el descuento del que se ponga.
  document.querySelectorAll<HTMLElement>('[data-pkgs]').forEach((box) => {
    const fmt = new Intl.NumberFormat(document.documentElement.lang || 'es', { style: 'currency', currency: 'EUR', maximumFractionDigits: 2 });
    const refresh = () => {
      const free = new Set([...box.querySelectorAll<HTMLInputElement>('input[name=free]:checked')].map((x) => x.value));
      const list = [...box.querySelectorAll<HTMLInputElement>('input[name=packages]:checked')].reduce((s, x) => s + (free.has(x.value) ? 0 : Number(x.dataset.price || 0)), 0);
      box.querySelector('[data-list]')!.textContent = ` ${fmt.format(list)}`;
      const custom = box.querySelector<HTMLInputElement>('input[name=priceMode][value=custom]')!.checked;
      const price = Number((box.querySelector<HTMLInputElement>('input[name=price]')!.value || '').replace(',', '.'));
      const tag = box.querySelector<HTMLElement>('[data-discount]')!;
      const pct = custom && list > 0 && Number.isFinite(price) && price < list ? Math.round(((list - price) / list) * 100) : 0;
      tag.hidden = !pct;
      tag.textContent = pct ? `−${pct} %` : '';
    };
    // Marcar «gratis» marca también el paquete.
    box.querySelectorAll<HTMLInputElement>('input[name=free]').forEach((f) => f.addEventListener('change', () => {
      if (f.checked) { const p = box.querySelector<HTMLInputElement>(`input[name=packages][value="${f.value}"]`); if (p) p.checked = true; }
    }));
    box.addEventListener('input', refresh);
    box.addEventListener('change', refresh);
    refresh();
  });
</script>
