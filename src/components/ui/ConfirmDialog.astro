---
/**
 * Confirmación de una acción que cambia el estado de alguien o manda algo fuera (guía Lumbra §9–11).
 * <dialog> nativo: foco atrapado, Escape y devolución del foco gratis. Se abre con
 * <button type="button" data-dialog-open="ID">. Dice lo que la acción hace y, obligatorio, lo que NO hace.
 */
interface Props {
  id: string;
  title: string;
  does: string;
  doesNot: string;
  confirmLabel: string;
  danger?: boolean;
  action?: string;
  testid?: string;
}
const { id, title, does, doesNot, confirmLabel, danger = false, action, testid } = Astro.props;
---
<dialog id={id} class="co-dialog" aria-labelledby={`${id}-title`} data-testid={testid}>
  <form method="post" action={action}>
    <div class="co-dialog__body">
      <h2 id={`${id}-title`} class="co-entity">{title}</h2>
      <p class="co-body">{does}</p>
      <p class="co-dialog__not"><strong>Lo que no hace:</strong> {doesNot}</p>
      <slot />
    </div>
    <div class="co-dialog__foot">
      <button type="button" class="co-btn co-btn--ghost" data-dialog-close>Cancelar</button>
      <button type="submit" class:list={['co-btn', danger ? 'co-btn--danger' : 'co-btn--primary']} data-testid={testid ? `${testid}-confirm` : undefined}>{confirmLabel}</button>
    </div>
  </form>
</dialog>
