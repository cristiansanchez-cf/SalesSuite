---
/**
 * Contenido de la barra lateral (también se reutiliza en el cajón móvil).
 * Orden vertical (guía §8): marca → conmutador → destinos → [anclas abajo: espacio activo, perfil].
 */
import Icon from './Icon.astro';
import { BRAND } from '~/lib/site';
import { navFor } from '~/lib/ui/nav';
import type { AdminContext } from '~/lib/admin/auth';
import type { NotificationFeed } from '~/lib/notify/service';
import NotificationBell from './NotificationBell.astro';
import { i18n, LOCALES, LOCALE_NAME } from '~/lib/i18n';
import { shellMessages } from '~/lib/i18n/messages/shell';
import { mySpaces } from '~/lib/admin/spaces';

interface Props { admin: AdminContext; tenantName: string; path: string; pending: number; primary?: boolean; feed: NotificationFeed; back: string }
const { admin, tenantName, path, pending, primary = false, feed, back } = Astro.props;
const { m, locale } = i18n(Astro, shellMessages);
const nav = navFor(admin.session.role, path, { pendingPlaybook: pending, superadmin: admin.session.superadmin }, m.nav);

const name = admin.session.displayName || admin.session.email;
// Espacios a los que tiene acceso (docs/ORG.md §Cambiar de espacio): con más de uno, la tarjeta del espacio es un menú.
const spaces = await mySpaces(admin);
const roleLabel = (r: (typeof spaces)[number]['role']) => (r === 'superadmin' ? 'Superadmin' : m.role[r]);
const initials = name.split(/[\s@.]+/).filter(Boolean).slice(0, 2).map((x) => x[0]!.toUpperCase()).join('');
---
<div class="co-sidebar__head">
  <a href="/admin" class="co-sidebar__brand" aria-label={`${BRAND.company} · ${BRAND.app}`}>
    <span class="co-wordmark">{BRAND.wordmark}</span><span class="co-sidebar__app">· {BRAND.app}</span>
  </a>
  <NotificationBell feed={feed} id={primary ? 'bell-panel' : 'bell-panel-drawer'} back={back} testid={primary ? 'bell' : undefined} />
</div>

{nav.canSwitch && (
  <nav class="co-segmented" aria-label={m.nav.modes}>
    {nav.modes.map((md) => <a href={md.href} aria-current={nav.mode === md.key ? 'page' : undefined} data-testid={primary ? `mode-${md.key}` : undefined}><Icon name={md.icon} size={14} />{md.label}{md.key === 'setup' && pending > 0 && nav.mode !== 'setup' ? <span class="co-nav__count !ml-1" aria-label={m.nav.pendingReview(pending)}>{pending}</span> : null}</a>)}
  </nav>
)}

<nav class="co-nav" aria-label={m.nav.sections}>
  {nav.items.map((n) => (
    <a href={n.href} class="co-nav__item" aria-current={n.on ? 'page' : undefined} data-testid={primary ? n.testid : undefined}>
      <Icon name={n.icon} size={18} />{n.label}{n.count ? <span class="co-nav__count" aria-label={m.nav.pending(n.count)}>{n.count}</span> : null}
    </a>
  ))}
</nav>

<div class="co-sidebar__anchors">
  {spaces.length > 1 ? (
    <details class="co-popover" data-testid={primary ? 'workspace' : undefined}>
      <summary class="co-anchor" title={m.shell.switchSpace}>
        <span class="co-anchor__avatar co-anchor__avatar--soft"><Icon name="building2" size={16} /></span>
        <span class="co-anchor__text"><span class="co-row-title">{tenantName}</span><span class="co-meta">{m.shell.switchSpace}</span></span>
        <Icon name="chevron-down" size={16} />
      </summary>
      <div class="co-popover__menu">
        <p class="text-eyebrow px-2 pb-2">{m.shell.yourSpaces}</p>
        <div class="co-actions" data-testid={primary ? 'spaces' : undefined}>
          {spaces.map((sp) => (
            <form method="post" action="/admin/switch">
              <input type="hidden" name="tenant" value={sp.id} />
              <button class="co-action" type="submit" disabled={sp.current} aria-current={sp.current ? 'true' : undefined} data-space={sp.slug}>
                <Icon name={sp.current ? 'circle-check' : 'building2'} />
                <span class="co-action__label">{sp.name}<small>{sp.current ? m.shell.hereNow : roleLabel(sp.role)}</small></span>
                {!sp.current && <Icon name="chevron-right" size={16} />}
              </button>
            </form>
          ))}
        </div>
      </div>
    </details>
  ) : (
    <div class="co-anchor" title={m.shell.workspaceHint}>
      <span class="co-anchor__avatar co-anchor__avatar--soft"><Icon name="building2" size={16} /></span>
      <span class="co-anchor__text"><span class="co-row-title">{tenantName}</span><span class="co-meta">{m.shell.workspace}</span></span>
    </div>
  )}
  <details class="co-popover">
    <summary class="co-anchor" data-testid={primary ? 'profile' : undefined}>
      <span class="co-anchor__avatar">{initials}</span>
      <span class="co-anchor__text"><span class="co-row-title">{name}</span><span class="co-meta" data-testid={primary ? 'role' : undefined}>{admin.session.superadmin ? 'Superadmin' : m.role[admin.session.role]}{admin.session.role === 'lead' && !admin.session.superadmin ? (admin.session.delegationId ? ` · ${admin.session.delegationName ?? m.shell.delegation}` : ` · ${m.shell.global}`) : ''}</span></span>
      <Icon name="chevron-down" size={16} />
    </summary>
    <div class="co-popover__menu">
      <p class="co-meta px-2 pb-2">{admin.session.email}</p>
      <form method="post" action="/admin/locale" class="mb-2 px-2" data-testid={primary ? 'locale-switch' : undefined}>
        <input type="hidden" name="back" value={back} />
        <p class="text-eyebrow mb-1.5">{m.shell.language}</p>
        <div class="co-chips !gap-1.5">
          {LOCALES.map((l) => <button type="submit" name="locale" value={l} class="co-chip !min-h-[28px] !px-2.5 !text-xs" aria-pressed={l === locale ? 'true' : 'false'} lang={l} data-testid={primary ? `locale-${l}` : undefined}>{LOCALE_NAME[l]}</button>)}
        </div>
      </form>
      <div class="co-actions">
        <a class="co-action" href="/admin/account"><Icon name="user" /><span class="co-action__label">{m.shell.myAccount}</span><Icon name="chevron-right" size={16} /></a>
        <form method="post" action="/admin/logout"><button class="co-action" type="submit"><Icon name="log-out" /><span class="co-action__label">{m.shell.logout}</span><Icon name="chevron-right" size={16} /></button></form>
      </div>
    </div>
  </details>
</div>

<script>
  // Menú de perfil en la barra lateral: fijo sobre la página, justo encima de su botón (no lo recorta el scroll de la barra).
  for (const d of document.querySelectorAll<HTMLDetailsElement>('.co-sidebar details.co-popover')) {
    const menu = d.querySelector<HTMLElement>('.co-popover__menu');
    const place = () => {
      if (!menu || !d.open) return;
      const r = d.querySelector('summary')!.getBoundingClientRect();
      menu.style.left = `${Math.max(8, r.left)}px`;
      menu.style.top = `${Math.max(8, r.top - menu.offsetHeight - 8)}px`;
    };
    d.addEventListener('toggle', place);
    addEventListener('resize', place);
    // Se cierra al pulsar fuera.
    document.addEventListener('click', (e) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
  }
</script>

