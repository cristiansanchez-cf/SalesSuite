---
/** Cabecera de pantalla: eyebrow → titular (Big Shoulders) → lede, y acciones a la derecha. */
interface Props { eyebrow: string; title: string; /** Segunda parte del titular, en gris (titular a dos tonos). */ tail?: string; lede?: string; back?: { href: string; label: string } }
const { eyebrow, title, tail, lede, back } = Astro.props;
import Icon from './Icon.astro';
---
<header class="mb-6 flex flex-wrap items-end gap-4" data-testid="page-header">
  {/* Mínimo de ancho para el texto: en el móvil las acciones bajan a su propia línea en vez de estrujar el lede. */}
  <div class="min-w-[min(100%,20rem)] flex-1">
    {back && <a href={back.href} class="co-meta mb-3 inline-flex items-center gap-1 hover:text-ink"><Icon name="chevron-left" size={14} />{back.label}</a>}
    <p class="text-eyebrow mb-3">{eyebrow}</p>
    <h1 class="co-page-title">{title}{tail && <> <span class="co-tail">{tail}</span></>}</h1>
    {lede && <p class="co-lede mt-3">{lede}</p>}
    <slot name="below" />
  </div>
  {Astro.slots.has('default') && <div class="flex flex-wrap items-center gap-2"><slot /></div>}
</header>
