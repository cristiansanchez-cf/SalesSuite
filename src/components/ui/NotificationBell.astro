---
/**
 * Campana junto al logo (docs/NOTIFICATIONS.md): lo que pide algo primero, descartar en un clic.
 * Panel con la API nativa `popover` (capa superior: no lo recorta la barra lateral con scroll).
 */
import Icon from './Icon.astro';
import { i18n } from '~/lib/i18n';
import { shellMessages } from '~/lib/i18n/messages/shell';
import type { NotificationFeed } from '~/lib/notify/service';

interface Props { feed: NotificationFeed; id: string; back: string; testid?: string }
const { feed, id, back, testid } = Astro.props;
const { m, f } = i18n(Astro, shellMessages);
const label = m.bell.label(feed.open);
---
<button type="button" class="co-bell" popovertarget={id} aria-label={label} title={label} data-testid={testid}>
  <Icon name="bell" size={18} />
  {feed.open > 0 && <span class="co-bell__count" data-testid={testid ? `${testid}-count` : undefined}>{feed.open > 9 ? '9+' : feed.open}</span>}
</button>
<div id={id} popover class="co-bell__panel" data-testid={testid ? `${testid}-panel` : undefined}>
  <div class="co-bell__head">
    <h2 class="co-card-title">{m.bell.title}</h2>
    {feed.items.some((n) => !n.readAt) && (
      <form method="post" action="/admin/notifications">
        <input type="hidden" name="action" value="read-all" /><input type="hidden" name="back" value={back} />
        <button class="co-btn co-btn--quiet co-btn--sm" type="submit">{m.bell.markAll}</button>
      </form>
    )}
  </div>
  {feed.items.length === 0
    ? <p class="co-bell__empty">{m.bell.empty}</p>
    : <ul class="co-bell__list">
        {feed.items.map((n) => (
          <li class:list={['co-bell__item', n.open && 'co-bell__item--open', n.open && n.severity === 'action' && 'co-bell__item--action']} data-testid="notification" data-kind={n.kind}>
            <span class="co-row__lead"><Icon name={n.icon as never} size={16} /></span>
            <a class="co-bell__text" href={`/admin/notifications/${n.id}`}>
              <span class="co-bell__title">{n.title}</span>
              {n.detail && <span class="co-meta block">{n.detail}</span>}
              <span class="co-meta block">{n.open && n.severity === 'action' ? `${m.bell.needsAction} · ` : ''}{f.relative(n.createdAt)}</span>
            </a>
            <form method="post" action="/admin/notifications">
              <input type="hidden" name="action" value="dismiss" /><input type="hidden" name="id" value={n.id} /><input type="hidden" name="back" value={back} />
              <button class="co-btn co-btn--quiet co-btn--icon co-btn--sm" type="submit" aria-label={m.bell.dismissLabel(n.title)} title={m.bell.dismiss} data-testid="dismiss"><Icon name="x" size={14} /></button>
            </form>
          </li>
        ))}
      </ul>}
  <a class="co-bell__all" href="/admin/notifications">{m.bell.all}</a>
</div>
