---
/** "Me funcionó / No me funcionó" (formulario sin JS; vuelve al ancla). Pulsar de nuevo tu voto lo quita. */
import type { Score, TargetType } from '~/lib/playbook/types';
interface Props { targetType: TargetType; targetId: string; score: Score; anchor: string }
const { targetType, targetId, score, anchor } = Astro.props;
const btn = (on: boolean) => ['rounded-lg border px-2.5 py-1 text-xs font-semibold', on ? 'border-ink bg-ink text-bg' : 'border-line hover:bg-surface'];
---
<form method="post" class="flex items-center gap-1.5" action={`#${anchor}`}>
  <input type="hidden" name="action" value="vote" />
  <input type="hidden" name="targetType" value={targetType} />
  <input type="hidden" name="targetId" value={targetId} />
  <button name="verdict" value={score.mine === 'worked' ? '' : 'worked'} class:list={btn(score.mine === 'worked')} type="submit" aria-pressed={score.mine === 'worked'} data-testid="vote-worked">
    👍 Me funcionó{score.worked > 0 && ` · ${score.worked}`}
  </button>
  <button name="verdict" value={score.mine === 'didnt' ? '' : 'didnt'} class:list={btn(score.mine === 'didnt')} type="submit" aria-pressed={score.mine === 'didnt'}>
    👎{score.didnt > 0 && ` ${score.didnt}`}
  </button>
</form>
