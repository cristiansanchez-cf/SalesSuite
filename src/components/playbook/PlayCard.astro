---
import Badges from './Badges.astro';
import Votes from './Votes.astro';
import { renderMarkdown } from '~/lib/playbook/markdown';
import type { PlayView } from '~/lib/playbook/types';

interface Props { play: PlayView; canPropose?: boolean; adminEdit?: boolean }
const { play, canPropose = true, adminEdit = false } = Astro.props;
const anchor = `play-${play.id}`;
const field = 'w-full rounded-lg border border-line bg-bg px-3 py-2 text-sm outline-none focus:border-ink';
---
<article id={anchor} class="scroll-mt-24 rounded-2xl border border-line bg-bg p-5" data-testid="play" data-play-key={play.key}>
  <div class="flex flex-wrap items-start gap-2">
    <h3 class="min-w-0 flex-1 text-lg font-bold">{play.title}</h3>
    {adminEdit && <a href={`/admin/playbook/${play.id}`} class="text-xs text-muted underline">Editar</a>}
  </div>
  <div class="mt-1"><Badges stage={play.stage} objection={play.objection} segments={play.segments} /></div>
  {play.body && <div class="prose-play mt-3 text-[15px] leading-relaxed" set:html={renderMarkdown(play.body)} />}
  {(play.whenToUse || play.whyItWorks) && (
    <dl class:list={['mt-3 grid gap-2 rounded-xl bg-surface p-3 text-sm', play.whenToUse && play.whyItWorks && 'sm:grid-cols-2']}>
      {play.whenToUse && <div><dt class="text-xs font-semibold text-muted">Cuándo usarla</dt><dd class="m-0">{play.whenToUse}</dd></div>}
      {play.whyItWorks && <div><dt class="text-xs font-semibold text-muted">Por qué funciona</dt><dd class="m-0">{play.whyItWorks}</dd></div>}
    </dl>
  )}
  {play.techniqueRefs.length > 0 && (
    <div class="mt-3 text-sm" data-testid="cerebro-refs">
      <p class="text-xs font-semibold text-muted">🧠 Técnicas relacionadas del Cerebro de Ventas</p>
      <ul class="mt-1 space-y-1 p-0">
        {play.techniqueRefs.map((r) => (
          <li class="list-none">
            {r.url ? <a href={r.url} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">[{r.id}] {r.title}</a> : <span>[{r.id}] {r.title}</span>}
            {r.creator && <span class="text-muted"> · {r.creator}</span>}
          </li>
        ))}
      </ul>
    </div>
  )}
  <div class="mt-4 flex flex-wrap items-center gap-3">
    <Votes targetType="play" targetId={play.id} score={play.score} anchor={anchor} />
    <span class="text-xs text-muted">v{play.version}</span>
    {canPropose && (
      <details class="w-full text-sm">
        <summary class="cursor-pointer text-muted hover:text-ink">✏️ Proponer una mejora</summary>
        <form method="post" action={`#${anchor}`} class="mt-2 space-y-2 rounded-xl border border-line p-3">
          <input type="hidden" name="action" value="change" />
          <input type="hidden" name="playId" value={play.id} />
          <label class="block text-xs font-semibold">¿Qué mejora? (una línea)<input class={field} name="title" required maxlength="200" placeholder="Añadir el coste por invitado" /></label>
          <label class="block text-xs font-semibold">Texto propuesto
            <textarea class={`${field} h-32`} name="body" required maxlength="8000">{play.body}</textarea>
          </label>
          <button class="rounded-lg bg-ink px-3 py-1.5 text-sm font-semibold text-bg" type="submit">Enviar al líder</button>
        </form>
      </details>
    )}
  </div>
</article>
