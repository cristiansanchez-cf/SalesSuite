---
import { KIND_LABEL, OBJECTION_LABEL, STAGE_LABEL, type Objection, type PlayKind, type Stage } from '~/lib/playbook/types';
interface Props { kind?: PlayKind; stage?: Stage | null; objection?: Objection | null; segments?: string[]; team?: boolean }
const { kind, stage, objection, segments = [], team = false } = Astro.props;
---
<span class="flex flex-wrap gap-1">
  {team && <span class="co-badge co-badge--soft">Del equipo</span>}
  {kind && <span class="co-badge">{KIND_LABEL[kind]}</span>}
  {stage && <span class="co-badge co-badge--soft" title="Etapa (misma taxonomía que el Cerebro de Ventas)">{STAGE_LABEL[stage]}</span>}
  {objection && <span class="co-badge co-badge--attention" title="Tipo de objeción">Objeción: {OBJECTION_LABEL[objection]}</span>}
  {segments.map((s) => <span class="co-badge">{s}</span>)}
</span>
