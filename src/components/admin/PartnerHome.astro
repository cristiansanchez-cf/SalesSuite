---
/**
 * Inicio del colaborador (docs/PARTNERS.md): sus cuentas, lo que puede ofrecer y su guía.
 * Todo lo que se lista ya viene filtrado por el alcance del partner (servicio + RLS).
 */
import { relativeTime, STATUS_CLASS, STATUS_LABEL } from '~/lib/admin/format';
import type { AdminContext } from '~/lib/admin/auth';
import { renderMarkdown } from '~/lib/playbook/markdown';
import { PRICE_POLICY_LABEL } from '~/lib/partner/labels';

interface Props { admin: AdminContext; error: string | null; errorAccount: string | null }
const { admin, error, errorAccount } = Astro.props;
const partner = admin.session.partner!;
const [dossiers, idx, market] = await Promise.all([admin.service.listDossiers(), admin.playbook.learnIndex(), admin.playbook.market()]);
const segName = new Map(market.map((s) => [s.id, s.name]));
const nowMs = Date.now();
const overdue = dossiers.filter((d) => d.nextStepAt && new Date(d.nextStepAt).getTime() < nowMs).length;
const name = admin.session.displayName || admin.session.email;
const dateFmt = (iso: string) => new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso));
const input = 'w-full rounded-lg border border-line bg-bg px-3 py-2 text-sm outline-none focus:border-ink';
---
<div class="grid gap-6 lg:grid-cols-[1fr_20rem]">
  <section>
    <h1 class="text-3xl font-extrabold">Hola, {name.split(' ')[0]}</h1>
    <p class="text-sm text-muted">Estas son tus cuentas. Crea la propuesta de cada una, envíale el enlace y apunta el próximo paso.</p>
    {overdue > 0 && (
      <p class="mt-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-900" data-testid="overdue-banner">
        ⏰ Tienes <strong>{overdue}</strong> {overdue === 1 ? 'seguimiento vencido' : 'seguimientos vencidos'}.
      </p>
    )}

    {partner.accounts.length === 0 && (
      <p class="mt-8 rounded-2xl border border-dashed border-line p-8 text-center text-muted" data-testid="no-accounts">
        Todavía no tienes cuentas asignadas. Cuando la empresa te asigne locales o centros, aparecerán aquí.
      </p>
    )}

    <div class="mt-6 space-y-4" data-testid="accounts">
      {partner.accounts.map((a) => {
        const list = dossiers.filter((d) => d.partnerAccountId === a.id);
        return (
          <article class="rounded-2xl border border-line bg-bg p-5" data-testid="account" data-account={a.name}>
            <div class="flex flex-wrap items-start gap-3">
              <div class="min-w-0 flex-1">
                <h2 class="text-xl font-bold">{a.name}</h2>
                <p class="text-sm text-muted">{[a.segmentId ? segName.get(a.segmentId) : null, PRICE_POLICY_LABEL[a.pricePolicy]].filter(Boolean).join(' · ')}</p>
              </div>
            </div>
            {a.notes && <p class="mt-3 rounded-xl bg-surface p-3 text-sm" data-testid="account-notes">📌 {a.notes}</p>}

            {list.length > 0 && (
              <ul class="mt-3 divide-y divide-line overflow-hidden rounded-xl border border-line p-0">
                {list.map((d) => (
                  <li class="list-none">
                    <a href={`/admin/dossiers/${d.id}`} class="flex flex-wrap items-center gap-x-3 gap-y-1 px-3 py-2 text-sm hover:bg-surface" data-testid="partner-dossier">
                      <span class="min-w-0 flex-1 truncate font-semibold">{d.title}</span>
                      {d.nextStepAt && <span class:list={['rounded-lg px-2 py-0.5 text-xs', new Date(d.nextStepAt).getTime() < nowMs ? 'bg-red-100 font-semibold text-red-800' : 'bg-surface']}>⏰ {d.nextStep ?? 'Seguimiento'}</span>}
                      <span class="text-xs text-muted">{relativeTime(d.updatedAt)}</span>
                      <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-semibold', STATUS_CLASS[d.status]]}>{STATUS_LABEL[d.status]}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}

            <details class="mt-3" open={list.length === 0 || errorAccount === a.id}>
              <summary class="cursor-pointer text-sm font-semibold">＋ Nueva propuesta para {a.name}</summary>
              <form method="post" class="mt-3 grid gap-3 sm:grid-cols-2" data-testid="partner-create">
                <input type="hidden" name="partnerAccountId" value={a.id} />
                {error && errorAccount === a.id && <p class="rounded-lg bg-red-50 p-2 text-sm text-red-700 sm:col-span-2" role="alert">{error}</p>}
                <label class="text-sm font-medium sm:col-span-2">Título<input class={input} name="title" required maxlength="140" value={`${a.name} · Propuesta`} /></label>
                <label class="text-sm font-medium">Persona de contacto<input class={input} name="prospectName" maxlength="120" placeholder="Marcos (dueño)" /></label>
                <input type="hidden" name="prospectCompany" value={a.name} />
                <label class="text-sm font-medium">Partir de
                  <select class={input} name="fromDossierId">
                    <option value="">Propuesta vacía</option>
                    {list.filter((d) => d.itemCount > 0).map((d) => <option value={d.id}>{d.title}</option>)}
                  </select>
                </label>
                <button class="rounded-lg bg-ink px-4 py-2.5 text-sm font-semibold text-bg hover:opacity-90 sm:col-span-2" type="submit">Crear y editar</button>
              </form>
            </details>
          </article>
        );
      })}
    </div>
  </section>

  <aside class="space-y-4">
    {partner.welcomeNote && (
      <section class="rounded-2xl border border-line bg-bg p-5" data-testid="welcome-note">
        <h2 class="mb-2 font-bold">Tu guía</h2>
        <div class="prose-sm space-y-2 text-sm" set:html={renderMarkdown(partner.welcomeNote)} />
      </section>
    )}
    <section class="rounded-2xl border border-line bg-bg p-5" data-testid="partner-modules">
      <h2 class="font-bold">Lo que puedes ofrecer</h2>
      <ul class="mt-2 space-y-1 p-0 text-sm">
        {idx.modules.map((m) => (
          <li class="list-none"><a class="underline-offset-2 hover:underline" href={`/admin/learn/${m.moduleId}`}>{m.learned ? '✓ ' : ''}{m.name}</a></li>
        ))}
      </ul>
      <a href="/admin/learn" class="mt-3 inline-block text-sm font-semibold">Aprende a venderlo →</a>
    </section>
    {partner.expiresAt && (
      <p class="rounded-2xl border border-line bg-bg p-4 text-xs text-muted" data-testid="partner-expiry">Tu acceso está activo hasta el {dateFmt(partner.expiresAt)}.</p>
    )}
  </aside>
</div>
