---
/**
 * Paso guiado «Conecta tu web o tu app» (docs/PLAN_AJUSTES.md, paso 2). Cuatro partes:
 *  1. Qué ganas (con una vista previa: formulario → email → CRM).
 *  2. Tus webs: lista con «Añadir» y «Quitar» (se guardan al momento).
 *  3. Pásaselo: el prompt para el desarrollador o el agente, o el código para pegar.
 *  4. Pruébalo: un lead de prueba desde la consola y el estado del primero que llegue de la web o la app.
 */
import Icon from '~/components/ui/Icon.astro';
import StepDialog from '~/components/ui/StepDialog.astro';
import type { leadsSetupMessages } from '~/lib/i18n/messages/leadsSetup';

interface Props {
  id: string;
  open: boolean;
  part: number;
  origins: string[];
  prompt: string;
  snippet: string;
  /** Fecha del primer lead de la web o la app ya formateada, o null si aún no ha llegado. */
  received: string | null;
  /** Se acaba de mandar el lead de prueba. */
  testSent: boolean;
  T: (typeof leadsSetupMessages)['es']['connect'];
  notice?: string | null;
  error?: { title: string; details: string[] } | null;
}
const { id, open, part, origins, prompt, snippet, received, testSent, T, notice, error } = Astro.props;
const ACTION = '/admin/leads/configurar';
---
<StepDialog id={id} title={T.title} parts={T.parts} open={open} part={part} notice={notice} error={error} testid="connect"
  labels={{ back: T.back, next: T.next, close: T.close, copied: T.handoff.copied }}>
  <Fragment slot="p1">
    <div class="grid items-center gap-3 sm:grid-cols-[1fr_auto_1fr]" aria-hidden="true">
      <div class="co-inset grid gap-2 !p-4 text-sm">
        <span class="co-meta">{T.mock.name}</span><span class="rounded-lg border border-[var(--console-card-border)] bg-[var(--console-surface)] px-3 py-1.5">Ana López</span>
        <span class="co-meta">{T.mock.email}</span><span class="rounded-lg border border-[var(--console-card-border)] bg-[var(--console-surface)] px-3 py-1.5">ana@empresa.com</span>
        <span class="co-btn co-btn--primary co-btn--sm w-fit">{T.mock.send}</span>
      </div>
      <span class="mx-auto inline-flex rotate-90 sm:rotate-0"><Icon name="chevron-right" size={20} /></span>
      <div class="grid gap-2">
        <div class="co-card connect-pop flex items-center gap-2 !p-3 text-sm"><Icon name="mail" size={16} />{T.mock.mail}</div>
        <div class="co-card connect-pop connect-pop--2 flex items-center gap-2 !p-3 text-sm font-semibold"><Icon name="inbox" size={16} />{T.mock.lead}</div>
      </div>
    </div>
    <ol class="grid list-decimal gap-1 pl-5">{T.why.map((w) => <li>{w}</li>)}</ol>
  </Fragment>

  <Fragment slot="p2">
    <p>{T.webs.lede}</p>
    {origins.length
      ? (
        <ul class="grid gap-2" data-testid="connect-origins">
          {origins.map((o) => (
            <li class="co-inset flex items-center justify-between gap-2 !px-4 !py-2">
              <span class="flex min-w-0 items-center gap-2 break-all"><Icon name="globe" size={16} />{o}</span>
              <form method="post" action={ACTION} class="shrink-0">
                <input type="hidden" name="action" value="remove-origin" /><input type="hidden" name="origin" value={o} />
                <button class="co-btn co-btn--ghost co-btn--sm" aria-label={`${T.webs.remove} ${o}`}><Icon name="trash2" size={14} />{T.webs.remove}</button>
              </form>
            </li>
          ))}
        </ul>
      )
      : <p class="co-meta" data-testid="connect-origins-empty">{T.webs.empty}</p>}
    <form method="post" action={ACTION} class="flex flex-wrap items-end gap-2" data-autosave data-testid="connect-add-origin">
      <input type="hidden" name="action" value="add-origin" />
      <label class="co-field min-w-[14rem] flex-1">{T.webs.add}<input class="co-input" name="origin" required maxlength="200" placeholder={T.webs.placeholder} inputmode="url" autocomplete="off" spellcheck="false" /></label>
      <button class="co-btn co-btn--primary"><Icon name="plus" size={16} />{T.webs.add}</button>
    </form>
    <p class="co-meta">{T.webs.app}</p>
  </Fragment>

  <Fragment slot="p3">
    <p>{T.handoff.lede}</p>
    <div class="co-segmented w-fit" data-tabs>
      <button type="button" aria-pressed="true" data-tab="prompt" data-handoff="prompt">{T.handoff.tabPrompt}</button>
      <button type="button" aria-pressed="false" data-tab="code" data-handoff="code">{T.handoff.tabCode}</button>
    </div>
    <div class="grid gap-2" data-tab-panel="prompt">
      <p class="co-meta">{T.handoff.promptHelp}</p>
      <textarea class="co-textarea h-64 font-mono text-xs" readonly data-testid="connect-prompt">{prompt}</textarea>
      <button type="button" class="co-btn co-btn--primary w-fit" data-copy><Icon name="copy" size={16} /><span>{T.handoff.copy}</span></button>
    </div>
    <div class="grid gap-2" data-tab-panel="code">
      <p class="co-meta">{T.handoff.codeHelp}</p>
      <textarea class="co-textarea h-64 font-mono text-xs" readonly data-testid="connect-snippet">{snippet}</textarea>
      <button type="button" class="co-btn co-btn--primary w-fit" data-copy><Icon name="copy" size={16} /><span>{T.handoff.copy}</span></button>
    </div>
  </Fragment>

  <Fragment slot="p4">
    <p>{T.test.lede}</p>
    <form method="post" action={ACTION} class="flex flex-wrap items-center gap-2">
      <input type="hidden" name="action" value="test-lead" />
      <button class="co-btn co-btn--ghost" data-testid="connect-test-lead"><Icon name="send" size={16} />{T.test.send}</button>
      {testSent && <span class="flex items-center gap-1 text-sm" data-testid="connect-test-sent"><Icon name="circle-check" size={16} />{T.test.sent} <a class="underline" href="/admin/leads?ver=test">{T.test.seeTests}</a></span>}
    </form>
    <div class="co-inset flex flex-wrap items-center justify-between gap-2 !p-4" data-testid="connect-received" data-ok={received ? '1' : '0'}>
      <span class="flex items-center gap-2"><Icon name={received ? 'circle-check' : 'clock'} size={18} />{received ? T.test.received(received) : T.test.waiting}</span>
      {!received && <a class="co-btn co-btn--ghost co-btn--sm" href="?abrir=connect&p=4">{T.test.check}</a>}
    </div>
  </Fragment>
</StepDialog>

<style is:global>
  .connect-pop { animation: connect-pop 2.4s ease-in-out infinite; }
  .connect-pop--2 { animation-delay: .4s; }
  @keyframes connect-pop { 0%, 15% { opacity: 0; transform: translateY(6px); } 30%, 85% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .connect-pop { animation: none; } }
</style>
