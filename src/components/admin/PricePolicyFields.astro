---
/**
 * Precio que verá el cliente de una cuenta de colaborador (docs/PARTNERS.md): tres opciones en tarjetas;
 * el ajuste en % solo aparece con «Precio especial». Sin permiso de precios, se ve pero no se cambia.
 */
import Icon from '~/components/ui/Icon.astro';
import { PRICE_POLICY_HELPS, PRICE_POLICY_LABELS } from '~/lib/partner/labels';
import type { PricePolicy } from '~/lib/admin/types';
import type { IconName } from '~/lib/ui/icons';
import { i18n } from '~/lib/i18n';
import { teamMessages } from '~/lib/i18n/messages/team';

interface Props { policy?: PricePolicy; pct?: number; canPrice: boolean }
const { policy = 'hidden', pct = 0, canPrice } = Astro.props;
const { m: { policy: m }, locale } = i18n(Astro, teamMessages);
const ICON: Record<PricePolicy, IconName> = { hidden: 'eye-off', list: 'tag', adjusted: 'percent' };
---
<fieldset class="co-policy grid gap-3" data-testid="price-policy" disabled={!canPrice}>
  <legend class="co-field mb-2">{m.legend} {!canPrice && <span class="co-help">{m.adminDecides}</span>}</legend>
  <div class="grid gap-2 sm:grid-cols-3">
    {(['hidden', 'list', 'adjusted'] as const).map((k) => (
      <label class="co-option !p-3" data-testid={`policy-${k}`}>
        <input type="radio" name="pricePolicy" value={k} checked={k === policy} />
        <span class="co-option__icon"><Icon name={ICON[k]} size={16} /></span>
        <span class="co-row-title">{PRICE_POLICY_LABELS[locale][k]}</span>
        <span class="co-meta">{PRICE_POLICY_HELPS[locale][k]}</span>
      </label>
    ))}
  </div>
  <label class="co-field co-policy__pct">{m.adjust}
    <input class="co-input max-w-[10rem]" name="priceAdjustPct" type="number" step="0.01" min="-90" max="200" value={pct} data-testid="price-adjust" />
    <span class="co-help">{m.adjustHelp}</span>
  </label>
</fieldset>
