---
/** Cabecera de marca del dossier: logo del tenant + contacto directo (el de quien hizo la propuesta, o el de la marca). */
import Container from '~/components/Container.astro';
import type { Brand } from '~/lib/brand';
import { contactLinks, type RepContact } from '~/lib/contact';

interface Props { brand: Brand; tenantName: string; dossierTitle: string; locale?: string; repContact?: RepContact | null }
const { brand, tenantName, dossierTitle } = Astro.props;
const primary = contactLinks(brand, dossierTitle, Astro.props.locale, Astro.props.repContact)[0];
---
<header class="border-b border-line bg-bg/90 backdrop-blur" data-testid="brand-bar">
  <Container class="flex h-16 items-center justify-between gap-4">
    {brand.logoUrl
      ? <img src={brand.logoUrl} alt={brand.logoAlt ?? tenantName} class="h-8 w-auto max-w-[11rem] object-contain" />
      : <span class="font-display text-lg font-extrabold">{tenantName}</span>}
    {primary && !primary.href && <span class="rounded-button border border-line px-4 py-2 text-sm font-semibold" data-testid="rep-contact">{primary.label}</span>}
    {primary?.href && (
      <a href={primary.href} data-testid={primary.rep ? 'rep-contact' : undefined} class="rounded-button bg-primary px-4 py-2 text-sm font-semibold text-primary-contrast" target={primary.external ? '_blank' : undefined} rel="noopener noreferrer">
        {primary.cta}
      </a>
    )}
  </Container>
</header>
