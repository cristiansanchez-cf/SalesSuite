---
/** Pie de la propuesta: logo, para quién es y contacto. En presentación va dentro de la última diapositiva. */
import type { TenantContext } from '~/lib/types';
import { contactLinks, type RepContact } from '~/lib/contact';
import { proposalText } from '~/lib/i18n/messages/proposal';

interface Props { tenant: TenantContext; title: string; prospect: string | null; locale?: string; repContact?: RepContact | null }
const { tenant, title, prospect, locale, repContact } = Astro.props;
const contacts = contactLinks(tenant.brand, title, locale, repContact);
const t = proposalText(locale);
---
<footer class="border-t border-line py-10 text-center text-sm text-muted" data-testid="brand-footer">
  {tenant.brand.logoUrl && <img src={tenant.brand.logoUrl} alt={tenant.brand.logoAlt ?? tenant.name} class="mx-auto mb-4 h-7 w-auto opacity-80" loading="lazy" />}
  <p>{tenant.name} · {prospect ? t.forProspect(prospect) : title}</p>
  {repContact && contacts[0]?.rep && <p class="mt-3 font-semibold text-ink">{t.repBy(repContact.name)}</p>}
  {contacts.length > 0 && (
    <p class="mt-3 flex flex-wrap justify-center gap-x-5 gap-y-1">
      {contacts.map((c) => c.href ? <a class="underline-offset-4 hover:underline" href={c.href} target={c.external ? '_blank' : undefined} rel="noopener noreferrer">{c.label}</a> : <span>{c.label}</span>)}
    </p>
  )}
  {tenant.brand.legal && <p class="mt-3 text-xs">{tenant.brand.legal}</p>}
</footer>
