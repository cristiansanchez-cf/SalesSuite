---
/**
 * Shell de la consola con el design system de Cofundo (src/styles/console.css, docs/DESIGN_SYSTEM.md).
 * Un solo sitio decide el ancho: `width` elige una receta (content 1120 px | workspace) y ninguna pantalla pone el suyo.
 */
// Fuentes del design system autoalojadas (sin peticiones a Google: privacidad y RGPD).
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/big-shoulders/wght.css';
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '~/styles/global.css';
import '~/styles/console.css';
import ConsoleNav from '~/components/ui/ConsoleNav.astro';
import Icon from '~/components/ui/Icon.astro';
import { BRAND } from '~/lib/site';

interface Props {
  title: string;
  /** content: lectura y listas (1120). workspace: editores lado a lado. */
  width?: 'content' | 'workspace';
  /** Alias antiguo de width="workspace". */
  wide?: boolean;
  /** Sin barra lateral (acceso, 403). */
  bare?: boolean;
}
const { title, wide = false, bare = false } = Astro.props;
const width = Astro.props.width ?? (wide ? 'workspace' : 'content');
const { tenant, admin } = Astro.locals;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const pending = admin ? await admin.playbook.pendingCount() : 0;
const tenantName = tenant?.name ?? BRAND.app;
const shell = !!admin && !bare;
---
<!doctype html>
<html lang="es" class="console">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · {tenantName}</title>
  </head>
  <body>
    {shell ? (
      <div class="co-shell">
        <aside class="co-sidebar" aria-label="Navegación">
          <ConsoleNav admin={admin!} tenantName={tenantName} path={path} pending={pending} primary />
        </aside>
        <div class="co-main">
          <div class="co-topbar">
            <button type="button" class="co-btn co-btn--ghost co-btn--icon co-btn--sm" data-dialog-open="co-drawer" aria-label="Abrir menú"><Icon name="menu" size={18} /></button>
            <a href="/admin" class="co-wordmark" style="font-size:1.125rem">{BRAND.wordmark}</a>
            <span class="co-meta ml-auto truncate">{tenantName}</span>
          </div>
          {admin?.mode === 'demo' && <p class="co-demo-banner">Modo demo: los datos viven en memoria y se pierden al reiniciar el servidor.</p>}
          <main class:list={['co-page', `co-page--${width}`]}><slot /></main>
        </div>
      </div>
      <dialog id="co-drawer" class="co-dialog co-drawer" aria-label="Menú">
        <div class="flex h-full flex-col gap-5 p-4">
          <ConsoleNav admin={admin!} tenantName={tenantName} path={path} pending={pending} />
          <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-dialog-close>Cerrar menú</button>
        </div>
      </dialog>
    ) : (
      <main class="co-page co-page--content"><slot /></main>
    )}
    <script is:inline>
      // <dialog> nativo para modales y cajón: abrir con data-dialog-open="id", cerrar con data-dialog-close.
      document.addEventListener('click', (e) => {
        const t = e.target instanceof Element ? e.target : null;
        const open = t && t.closest('[data-dialog-open]');
        if (open) { const d = document.getElementById(open.getAttribute('data-dialog-open')); if (d && d.showModal) { e.preventDefault(); d.showModal(); } return; }
        const close = t && t.closest('[data-dialog-close]');
        if (close) { const d = close.closest('dialog'); if (d) d.close(); return; }
        if (t && t.tagName === 'DIALOG' && t.classList.contains('co-dialog')) t.close(); // clic en el fondo
        document.querySelectorAll('details.co-popover[open]').forEach((p) => { if (!p.contains(t)) p.removeAttribute('open'); });
      });
    </script>
  </body>
</html>
