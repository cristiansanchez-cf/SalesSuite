---
/**
 * Shell de la consola con el design system de Cofundo (src/styles/console.css, docs/DESIGN_SYSTEM.md).
 * Un solo sitio decide el ancho: `width` elige una receta (content 1120 px | workspace) y ninguna pantalla pone el suyo.
 */
// Fuentes del design system autoalojadas (sin peticiones a Google: privacidad y RGPD).
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/big-shoulders/wght.css';
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '~/styles/global.css';
import '~/styles/console.css';
import ConsoleNav from '~/components/ui/ConsoleNav.astro';
import Shimmer from '~/components/ui/Shimmer.astro';
import Icon from '~/components/ui/Icon.astro';
import { BRAND } from '~/lib/site';
import { brandVars, themeToCss } from '~/lib/theme';
import { contentTranslated } from '~/lib/i18n/content-db';
import { contentI18nMessages } from '~/lib/i18n/messages/contentI18n';
import { i18n } from '~/lib/i18n';
import { shellMessages } from '~/lib/i18n/messages/shell';
import { sectionTabs } from '~/lib/ui/nav';

interface Props {
  title: string;
  /** content: lectura y listas (1120). workspace: editores lado a lado. */
  width?: 'content' | 'workspace';
  /** Alias antiguo de width="workspace". */
  wide?: boolean;
  /** Sin barra lateral (acceso, 403). */
  bare?: boolean;
}
const { title, wide = false, bare = false } = Astro.props;
const width = Astro.props.width ?? (wide ? 'workspace' : 'content');
const { tenant, admin } = Astro.locals;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const { m, locale } = i18n(Astro, shellMessages);
const [pending, feed] = await Promise.all([
  admin ? admin.playbook.pendingCount() : 0,
  admin && !bare ? admin.notifications.feed({ limit: 8, locale }) : { items: [], open: 0 },
]);
const back = Astro.url.pathname + Astro.url.search;
const tenantName = tenant?.name ?? BRAND.app;
const shell = !!admin && !bare;
// La página ha enseñado contenido traducido sin revisar: se dice (docs/I18N.md §Contenido).
const translated = contentTranslated();
const autoNote = translated?.auto ? i18n(Astro, contentI18nMessages).m.auto : null;
// La consola es de Cofundo; lo que enseña el producto del espacio (miniaturas, portadas, tour) lleva sus colores.
// .tn-ui: dentro, el tema entero del espacio (colores, radios, fuentes), para la UI recreada de su producto.
const brandCss = `.console{${brandVars(tenant?.themeTokens ?? {})}}\n${themeToCss(tenant?.themeTokens ?? {}, '.console .tn-ui')}`;
// Pestañas de la sección (menú corto: cada destino agrupa páginas afines).
const tabs = shell ? sectionTabs(admin!.session.role, path, { superadmin: admin!.session.superadmin }, m.nav) : [];
---
<!doctype html>
<html lang={locale} class="console">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · {tenantName}</title>
    <style set:html={brandCss}></style>
  </head>
  <body>
    <div class="co-progress" aria-hidden="true"></div>
    {shell ? (
      <div class="co-shell">
        <aside class="co-sidebar" aria-label={m.shell.navigation}>
          <ConsoleNav admin={admin!} tenantName={tenantName} path={path} pending={pending} feed={feed} back={back} primary />
        </aside>
        <div class="co-main">
          <div class="co-topbar">
            <button type="button" class="co-btn co-btn--ghost co-btn--icon co-btn--sm" data-dialog-open="co-drawer" aria-label={m.shell.openMenu}><Icon name="menu" size={18} /></button>
            <a href="/admin" class="co-wordmark" style="font-size:1.125rem">{BRAND.wordmark}</a>
            <span class="co-meta ml-auto truncate">{tenantName}</span>
            <a href="/admin/notifications" class="co-bell" aria-label={m.bell.label(feed.open)} data-testid="bell-mobile"><Icon name="bell" size={18} />{feed.open > 0 && <span class="co-bell__count">{feed.open > 9 ? '9+' : feed.open}</span>}</a>
          </div>
          {admin?.mode === 'demo' && <p class="co-demo-banner">{m.shell.demo}</p>}
          <main class:list={['co-page', `co-page--${width}`]}>
            {tabs.length > 0 && (
              <nav class="co-section-tabs" aria-label={m.nav.sectionTabs} data-testid="section-tabs" data-scroll-x>
                {tabs.map((t) => <a href={t.href} aria-current={t.on ? 'page' : undefined} data-testid={t.testid}>{t.label}</a>)}
              </nav>
            )}
            {autoNote && <p class="co-auto-translated" data-testid="auto-translated" lang={translated?.locale}>{autoNote}</p>}
            <Shimmer variant="page" class="co-nav-skeleton" label={m.shell.loading} /><slot />
          </main>
        </div>
      </div>
      <dialog id="co-drawer" class="co-dialog co-drawer" aria-label={m.shell.menu}>
        <div class="flex h-full flex-col gap-5 p-4">
          <ConsoleNav admin={admin!} tenantName={tenantName} path={path} pending={pending} feed={feed} back={back} />
          <button type="button" class="co-btn co-btn--ghost co-btn--sm" data-dialog-close>{m.shell.closeMenu}</button>
        </div>
      </dialog>
    ) : (
      <main class="co-page co-page--content"><slot /></main>
    )}
    <script is:inline>
      // Carga (docs/UX_REVIEW.md §Carga): al ir a otra página, barra arriba al momento y, si tarda, la forma de una página.
      (() => {
        const root = document.documentElement;
        let slow = 0;
        const start = () => { root.classList.add('is-navigating'); clearTimeout(slow); slow = setTimeout(() => root.classList.add('is-navigating-slow'), 350); };
        const stop = () => { clearTimeout(slow); root.classList.remove('is-navigating', 'is-navigating-slow'); };
        document.addEventListener('click', (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const a = e.target instanceof Element ? e.target.closest('a[href]') : null;
          if (!a || a.target || a.hasAttribute('download') || a.hasAttribute('data-no-progress')) return;
          const u = new URL(a.href, location.href);
          if (u.origin !== location.origin || (u.pathname === location.pathname && u.search === location.search)) return;
          // Lo que la propia página resuelve sin navegar (p. ej. «Nueva propuesta» en ventana) no muestra la carga.
          setTimeout(() => { if (!e.defaultPrevented) start(); }, 0);
        });
        document.addEventListener('submit', (e) => { if (!e.defaultPrevented && !(e.target instanceof HTMLFormElement && e.target.method === 'dialog')) setTimeout(() => { if (!e.defaultPrevented) start(); }, 0); });
        addEventListener('pageshow', stop);
        // Fotos: el hueco brilla hasta que llegan.
        const loaded = (img) => img.classList.add('is-loaded');
        const watch = () => document.querySelectorAll('img.co-img:not(.is-loaded)').forEach((img) => { if (img.complete && img.naturalWidth) loaded(img); else img.addEventListener('load', () => loaded(img), { once: true }); img.addEventListener('error', () => loaded(img), { once: true }); });
        watch();
        new MutationObserver(watch).observe(document.body, { childList: true, subtree: true });
      })();
      // <dialog> nativo para modales y cajón: abrir con data-dialog-open="id", cerrar con data-dialog-close.
      document.addEventListener('click', (e) => {
        const t = e.target instanceof Element ? e.target : null;
        const open = t && t.closest('[data-dialog-open]');
        if (open) { const d = document.getElementById(open.getAttribute('data-dialog-open')); if (d && d.showModal) { e.preventDefault(); d.showModal(); } return; }
        const close = t && t.closest('[data-dialog-close]');
        if (close) { const d = close.closest('dialog'); if (d) d.close(); return; }
        if (t && t.tagName === 'DIALOG' && t.classList.contains('co-dialog')) t.close(); // clic en el fondo
        document.querySelectorAll('details.co-popover[open]').forEach((p) => { if (!p.contains(t)) p.removeAttribute('open'); });
      });
    </script>
    <div class="co-toasts" id="co-toasts" aria-live="polite" data-testid="toasts"></div>
    <script is:inline define:vars={{ T: m.async }}>
      // Acciones en segundo plano (docs/UX_REVIEW.md §Carga): un formulario con data-async="id1 id2" no cambia de página.
      // Se manda por detrás, se puede seguir usando la página y, al acabar, se cambian solo esas partes (con lo nuevo del
      // servidor) y un aviso abajo dice el resultado. data-async-busy: aviso mientras trabaja (para lo que tarda);
      // data-async-quiet: sin aviso si no hay nada que contar (p. ej. una búsqueda: ya se ven los resultados).
      (() => {
        const box = document.getElementById('co-toasts');
        const toast = (text, kind) => {
          const el = document.createElement('div');
          el.className = `co-toast co-toast--${kind}`;
          el.setAttribute('role', kind === 'error' ? 'alert' : 'status');
          el.dataset.testid = `toast-${kind}`;
          const msg = document.createElement('span'); msg.textContent = text; el.append(msg);
          if (kind !== 'busy') {
            const x = document.createElement('button'); x.type = 'button'; x.className = 'co-toast__x'; x.setAttribute('aria-label', T.close); x.textContent = '×';
            x.addEventListener('click', () => el.remove()); el.append(x);
            setTimeout(() => el.remove(), kind === 'error' ? 12000 : 6000);
          }
          box.append(el);
          return el;
        };
        const queue = new Map();
        document.addEventListener('submit', async (e) => {
          const form = e.target;
          if (!(form instanceof HTMLFormElement) || !form.hasAttribute('data-async') || !window.fetch || !window.DOMParser) return;
          e.preventDefault();
          const btn = e.submitter instanceof HTMLButtonElement ? e.submitter : form.querySelector('button[type=submit]');
          const body = new FormData(form);
          if (e.submitter && e.submitter.name) body.set(e.submitter.name, e.submitter.value);
          const label = btn && btn.querySelector('span');
          const before = label ? label.textContent : '';
          if (btn) { btn.disabled = true; btn.setAttribute('aria-busy', 'true'); if (label && btn.dataset.busyLabel) label.textContent = btn.dataset.busyLabel; }
          const busy = form.dataset.asyncBusy ? toast(form.dataset.asyncBusy, 'busy') : null;
          // Varios clics seguidos sobre lo mismo (p. ej. cualificar): van en orden, uno tras otro.
          const key = form.dataset.async || '';
          const prev = queue.get(key) || Promise.resolve();
          let release;
          queue.set(key, new Promise((r) => { release = r; }));
          await prev;
          const restore = () => { if (btn && btn.isConnected) { btn.disabled = false; btn.removeAttribute('aria-busy'); if (label) label.textContent = before; } };
          try {
            const url = new URL(form.getAttribute('action') || location.href, location.href); url.hash = '';
            const res = await fetch(url, { method: 'POST', body, credentials: 'same-origin' });
            if (!res.ok) throw new Error(String(res.status));
            const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
            // Hecho = el servidor redirige con ?ok= (y su aviso); si no redirige y trae un rechazo, es un error.
            const flashed = res.redirected && new URL(res.url).searchParams.has('ok');
            const err = flashed ? null : doc.querySelector('main [data-testid=alert-rejection], main [data-testid=alert-failure]');
            if (err) { restore(); toast(err.textContent.replace(/\s+/g, ' ').trim(), 'error'); return; }
            for (const id of (form.dataset.async || '').split(/\s+/).filter(Boolean)) {
              const next = doc.getElementById(id); const cur = document.getElementById(id);
              if (next && cur) cur.replaceWith(document.importNode(next, true));
            }
            restore();
            const ok = flashed ? doc.querySelector('main [data-testid=alert-success]') : null;
            if (ok || !form.hasAttribute('data-async-quiet')) toast(ok ? ok.textContent.replace(/\s+/g, ' ').trim() : form.dataset.asyncDone || T.done, 'ok');
            document.dispatchEvent(new CustomEvent('co:swapped'));
          } catch {
            restore(); toast(T.failed, 'error');
          } finally {
            if (busy) busy.remove();
            release();
            // Para las pruebas y quien quiera esperar: cuántas acciones en segundo plano han terminado.
            document.documentElement.dataset.asyncDone = String(Number(document.documentElement.dataset.asyncDone || 0) + 1);
          }
        });
      })();
    </script>
  </body>
</html>
