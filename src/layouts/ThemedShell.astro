---
/**
 * Shell temado (white-label). Inyecta tenant.theme_tokens ⊕ dossier.theme_override como
 * CSS custom properties sobre .ds-root. Los módulos no cambian: re-skin con cero código.
 */
import '~/styles/global.css';
import { mergeTheme, themeToCss, type ThemeTokens } from '~/lib/theme';

interface Props {
  title: string;
  tenantName: string;
  locale?: string;
  theme: ThemeTokens;
  themeOverride?: ThemeTokens | null;
  robots?: string;
  faviconUrl?: string;
  /** Previsualización al compartir el enlace (WhatsApp, Slack, LinkedIn, email). */
  og?: { title: string; description: string; image?: string };
}
const { title, tenantName, locale = 'es-ES', theme, themeOverride, robots = 'noindex, nofollow', faviconUrl, og } = Astro.props;
const css = themeToCss(mergeTheme(theme, themeOverride));
const lang = locale.split('-')[0];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <title>{title} · {tenantName}</title>
    {faviconUrl && <link rel="icon" href={faviconUrl} />}
    {og && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={tenantName} />
        <meta property="og:title" content={og.title} />
        <meta property="og:description" content={og.description} />
        <meta name="description" content={og.description} />
        {og.image && <meta property="og:image" content={og.image} />}
        <meta name="twitter:card" content={og.image ? 'summary_large_image' : 'summary'} />
      </>
    )}
    <style set:html={css}></style>
  </head>
  <body>
    <div class="ds-root min-h-screen bg-bg text-ink">
      <slot />
    </div>
  </body>
</html>
