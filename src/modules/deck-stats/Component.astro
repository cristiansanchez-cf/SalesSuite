---
/**
 * deck-stats ← cifras que cuentan al verse: tarjetas grandes, una fila numerada, tarjetas de texto, un reparto (barras o
 * donut) y frases destacadas. Solo tokens del tema.
 */
import "../deck/deck.css";
import Section from "~/components/Section.astro";
import Rich from "../deck/Rich.astro";
import Count from "../deck/Count.astro";
import { interpolate } from "../resolve";
import type { ModuleBaseProps } from "../types";
import type { DeckStatsProps } from './schema';

type Props = DeckStatsProps & ModuleBaseProps;
const { eyebrow, title, lede, stats = [], minor, cards, breakdownTitle, breakdownStyle, breakdown, callouts, ctx } = Astro.props;
const t = (s: string) => interpolate(s, ctx);
const toneOf = (x?: string, featured?: boolean) => (featured || x === 'primary' ? 'tone-primary' : x === 'accent' ? 'tone-accent' : '');
const parts = breakdown ?? [];
const donut = breakdownStyle === 'donut' && parts.length > 0;
const COLORS = ['rgb(var(--color-primary))', 'rgb(var(--color-accent))', 'color-mix(in srgb, rgb(var(--color-primary)) 55%, rgb(var(--color-accent)))', 'rgb(var(--color-muted) / 0.55)', 'rgb(var(--color-primary) / 0.5)', 'rgb(var(--color-accent) / 0.5)', 'rgb(var(--color-text) / 0.35)', 'rgb(var(--color-text) / 0.2)'];
const total = parts.reduce((n, b) => n + b.percent, 0) || 100;
let acc = 0;
const arcs = parts.map((b, i) => { const a = { from: acc / total, len: b.percent / total, color: COLORS[i % COLORS.length] }; acc += b.percent; return a; });
const pct = (n: number) => `${String(n).replace('.', ',')}%`;
const cols = stats.length % 3 === 0 ? 'lg:grid-cols-3' : stats.length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-2';
---
<div data-module="deck-stats" class="relative overflow-hidden">
  <Section>
    {eyebrow && <p class="deck-eyebrow deck-in">{t(eyebrow)}</p>}
    <h2 class="deck-title deck-in max-w-5xl" style="--d:80ms"><Rich text={t(title)} /></h2>
    {lede && <p class="deck-lede deck-in" style="--d:140ms"><Rich text={t(lede)} /></p>}
    {stats.length > 0 && (
      <div class:list={['mt-[clamp(1.25rem,4vh,2.5rem)] grid gap-4 sm:grid-cols-2', cols]}>
        {stats.map((s, i) => (
          <div class:list={['deck-card deck-card--line deck-in grid min-h-[11rem] content-between gap-6', s.featured && 'deck-card--featured']} style={`--d:${200 + i * 90}ms`} data-testid="deck-stat">
            <div class="grid gap-3">
              {s.kicker && <p class:list={['m-0 text-xs font-bold uppercase tracking-[0.2em]', toneOf(s.tone, s.featured) || 'tone-accent']}>{t(s.kicker)}</p>}
              <p class:list={['deck-figure', toneOf(s.tone, s.featured) || (s.kicker ? '' : 'tone-accent')]}><Count value={t(s.value)} /></p>
            </div>
            <div class="grid gap-1">
              <p class="m-0 font-bold leading-snug">{t(s.label)}</p>
              {s.note && <p class="m-0 text-sm text-muted">{t(s.note)}</p>}
            </div>
          </div>
        ))}
      </div>
    )}
    {minor && minor.length > 0 && (
      <ol class="m-0 mt-4 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4">
        {minor.map((m, i) => (
          <li class="deck-card deck-in flex items-start gap-4 !p-5" style={`--d:${300 + (stats.length + i) * 70}ms`}>
            <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-primary-contrast">{i + 1}</span>
            <span class="grid gap-1"><span class="font-display text-[clamp(1.4rem,2.4vw,2rem)] font-extrabold leading-none"><Count value={t(m.value)} /></span><span class="text-sm text-muted">{t(m.label)}</span></span>
          </li>
        ))}
      </ol>
    )}
    {cards && cards.length > 0 && (
      <div class:list={['mt-4 grid gap-4', cards.length > 1 && 'md:grid-cols-2']}>
        {cards.map((c, i) => (
          <div class="deck-card deck-card--line deck-in grid content-start gap-3" style={`--d:${400 + i * 90}ms`}>
            {c.tag && <span class="deck-tag deck-tag--primary w-fit">{t(c.tag)}</span>}
            <p class="m-0 font-display text-[clamp(1.6rem,3vw,2.4rem)] font-extrabold leading-tight"><Rich text={t(c.title)} /></p>
            {c.text && <p class="m-0 text-muted"><Rich text={t(c.text)} /></p>}
          </div>
        ))}
      </div>
    )}
    {parts.length > 0 && (donut ? (
      <div class="mt-[clamp(1.25rem,4vh,2.5rem)] grid items-center gap-10 lg:grid-cols-[1.2fr_1fr]">
        <ol class="m-0 grid list-none gap-6 p-0">
          {breakdownTitle && <li class="deck-eyebrow deck-in !mb-0">{t(breakdownTitle)}</li>}
          {parts.map((b, i) => (
            <li class="deck-in grid grid-cols-[3px_1fr_auto] gap-x-4" style={`--d:${200 + i * 100}ms`}>
              <span class="row-span-2 rounded-full" style={`background:${arcs[i]!.color}`}></span>
              <span class="flex items-baseline gap-3"><span class="text-xs text-muted">{String(i + 1).padStart(2, '0')}</span><span class="font-display text-2xl font-extrabold">{t(b.label)}</span></span>
              <span class="font-display text-2xl font-extrabold" style={`color:${arcs[i]!.color}`}><Count value={pct(b.percent)} /></span>
              {b.note && <span class="col-span-2 text-sm text-muted"><Rich text={t(b.note)} /></span>}
            </li>
          ))}
        </ol>
        <div class="deck-in relative mx-auto aspect-square w-full max-w-[22rem]" style="--d:300ms" role="img" aria-label={parts.map((b) => `${b.label} ${pct(b.percent)}`).join(', ')}>
          <svg viewBox="0 0 120 120" class="h-full w-full -rotate-90">
            {arcs.map((a, i) => (
              <circle class="deck-arc" cx="60" cy="60" r="46" fill="none" stroke={a.color} stroke-width="22" pathLength="1000"
                style={`--len:${(a.len * 1000).toFixed(1)};--off:${(-a.from * 1000).toFixed(1)};--d:${400 + i * 160}ms`} />
            ))}
          </svg>
          <div class="absolute inset-0 grid place-content-center text-center"><span class="font-display text-5xl font-extrabold">100<span class="text-2xl text-muted">%</span></span></div>
        </div>
      </div>
    ) : (
      <div class="mt-[clamp(1.25rem,4vh,2.5rem)] grid max-w-3xl gap-4">
        {breakdownTitle && <p class="deck-eyebrow deck-in !mb-0">{t(breakdownTitle)}</p>}
        {parts.map((b, i) => (
          <div class="deck-in grid gap-1.5" style={`--d:${200 + i * 90}ms`}>
            <div class="flex justify-between gap-3 font-bold"><span>{t(b.label)}</span><span class="tone-primary"><Count value={pct(b.percent)} /></span></div>
            <div class="h-2.5 overflow-hidden rounded-full bg-surface"><div class="deck-bar h-full rounded-full bg-primary" style={`--w:${Math.max(0, Math.min(100, b.percent))}%;--d:${300 + i * 90}ms`}></div></div>
            {b.note && <p class="m-0 text-sm text-muted"><Rich text={t(b.note)} /></p>}
          </div>
        ))}
      </div>
    ))}
    {callouts && callouts.length > 0 && (
      <div class="mt-6 grid gap-3">
        {callouts.map((c, i) => (
          <p class="deck-callout deck-in m-0 flex flex-wrap items-center gap-4" style={`--d:${500 + i * 100}ms`}>
            {c.tag && <span class="deck-tag deck-tag--primary">{t(c.tag)}</span>}
            <span><Rich text={t(c.text)} /></span>
          </p>
        ))}
      </div>
    )}
  </Section>
</div>

<style>
  .deck-arc { stroke-dasharray: 0 1000; stroke-dashoffset: var(--off); transition: stroke-dasharray 1100ms var(--ease-out, ease-out) var(--d, 0ms); }
  [data-revealed] .deck-arc { stroke-dasharray: var(--len) 1000; }
  .deck-bar { width: 0; transition: width 1000ms var(--ease-out, ease-out) var(--d, 0ms); }
  [data-revealed] .deck-bar { width: var(--w); }
  @media (prefers-reduced-motion: reduce) { .deck-arc { stroke-dasharray: var(--len) 1000; transition: none; } .deck-bar { width: var(--w); transition: none; } }
</style>

<script>
  import { mountAll } from '../runtime';
  import { init } from '../deck/client';
  mountAll('deck-stats', init);
</script>
