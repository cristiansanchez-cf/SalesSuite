---
/**
 * site-verify ← «Su web con el sello» (SciScreen): su web de verdad (Personalizar → Su web) en un navegador, con el sello
 * real encima a su tamaño y la etiqueta «Simulación» siempre a la vista. Al verse la diapositiva: aparece el sello, un
 * cursor lo pulsa, la barra de direcciones pasa a sciscreen.com y se abre la página pública del sello (lo que ve el
 * consumidor: marca, estado, URL verificada, fechas y cada afirmación con su evidencia y sus estudios). Con frases que
 * acompañan cada momento. El sello también se pulsa a mano; «Volver a verlo» repite la escena.
 */
import Section from '~/components/Section.astro';
import Headline from '../Headline.astro';
import SciSeal from '../SciSeal.astro';
import { ISO_PATHS, SHIELD_PATH, longDate, sealDate, sealId } from '../sciscreen-seal';
import { interpolate } from '../resolve';
import type { ModuleBaseProps } from '../types';
import type { SiteVerifyProps } from './schema';

type Props = SiteVerifyProps & ModuleBaseProps;
const { eyebrow, title, lede, seals, press, simulation, hint, replay, back, captions, page, fallback, note, ctx } = Astro.props;
const now = new Date();
const locale = ctx.locale || 'es-ES';
const nextYear = new Date(now.getFullYear() + 1, now.getMonth(), now.getDate());
const t = (s: string) => interpolate(s, ctx).replaceAll('{date}', longDate(now, locale)).replaceAll('{nextYear}', longDate(nextYear, locale));
const brand = ctx.prospectCompany || ctx.prospectName || '';
const shot = ctx.media?.site ?? null;
const short = (u: string) => u.replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/\/$/, '');
const address = ctx.media?.siteUrl ? short(ctx.media.siteUrl) : t(fallback?.address ?? 'tumarca.com');
const verifiedUrl = ctx.media?.siteUrl ?? `https://www.${address}/`;
const sealUrl = `${page.path.replace(/\/?$/, '/')}${sealId(ctx.itemId)}`;
const pageId = `sv-${ctx.itemId}`;
const target = Math.min(press, seals.length - 1);
const lines = { start: t(captions.start), seal: t(captions.seal), click: t(captions.click), page: t(captions.page) };
const lock = 'M7 10V7a5 5 0 0 1 10 0v3h1a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1h1Zm2 0h6V7a3 3 0 0 0-6 0v3Z';
---
<div data-module="site-verify" class="site-verify">
  <Section>
    <div class="sv-head">
      {eyebrow && <p class="mb-3 text-sm font-bold uppercase tracking-wider text-primary">{t(eyebrow)}</p>}
      <h2 class="max-w-3xl font-display text-[clamp(1.9rem,4vw,3rem)] font-extrabold tracking-tight"><Headline text={t(title)} /></h2>
      {lede && <p class="mt-2 max-w-2xl text-lg text-muted">{t(lede)}</p>}
    </div>

    <div class="sv-stage" data-step="done" data-captions={JSON.stringify(lines)}>
      <figure class="sv-browser">
        <div class="sv-bar">
          <button type="button" class="sv-back" data-sv-back aria-label={t(back)} tabindex="-1"><span aria-hidden="true">←</span></button>
          <span class="sv-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="sv-url">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={lock} /></svg>
            <em class="sv-url-site">{address}</em>
            <em class="sv-url-seal" aria-hidden="true"><b>sciscreen.com</b>{sealUrl.replace(/^sciscreen\.com/, '')}</em>
          </span>
        </div>
        <div class="sv-page">
          {shot ? (
            <img class="sv-shot" src={shot} alt={brand ? `${brand}: ${address}` : address} loading="lazy" decoding="async" />
          ) : (
            <div class="sv-mock">
              {brand && <p class="sv-mock-brand">{brand}</p>}
              <ul class="sv-mock-claims">{(fallback?.claims ?? page.claims.map((c) => c.text)).map((c) => <li>{t(c)}</li>)}</ul>
            </div>
          )}
          <span class="sv-dim" aria-hidden="true"></span>
          {seals.map((s, i) => (
            <button type="button" class:list={['sv-seal', i === target && 'sv-seal--target']} style={`left:${s.x}%;top:${s.y}%;--d:${i * 280}ms;--s:${s.scale}`}
              aria-expanded="false" aria-controls={pageId} aria-label={`${t(hint)}: ${sealUrl}`}>
              <span class="sv-pop"><SciSeal size={s.size} ground={s.ground} date={sealDate(now)} /></span>
            </button>
          ))}
          <span class="sv-hint" aria-hidden="true">{t(hint)}</span>
          <svg class="sv-cursor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 2.5 19.5 13l-7.1 1.2 4 7.3-2.9 1.5-4-7.4L4 20.9Z" /></svg>
          <span class="sv-click" aria-hidden="true"></span>
          <!-- Siempre a la vista: es una simulación (la marca aún no está verificada). -->
          <span class="sv-tag">{t(simulation)}</span>
        </div>
      </figure>

      <!-- La página pública del sello, en sciscreen.com (lo que se abre al pulsarlo). -->
      <section class="sv-ss" id={pageId} data-open="0" aria-label={`sciscreen.com · ${t(page.labels.claims)}`}>
        <div class="sv-ss-bar">
          <button type="button" class="sv-back sv-back--in" data-sv-back aria-label={t(back)}><span aria-hidden="true">←</span></button>
          <span class="sv-url sv-url--in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={lock} /></svg><em><b>sciscreen.com</b>{sealUrl.replace(/^sciscreen\.com/, '')}</em></span>
        </div>
        <div class="sv-ss-scroll" data-sv-scroll>
          <header class="sv-ss-top">
            <svg class="sv-ss-logo" viewBox="0 0 116 114" aria-label="SciScreen" role="img">{ISO_PATHS.map((d) => <path fill="currentColor" fill-rule="evenodd" d={d} />)}</svg>
            <span class="sv-ss-lang"><b>ES</b> EN</span>
          </header>
          <div class="sv-ss-card sv-ss-grid">
            <span class="sv-ss-k">{t(page.labels.brand)}</span><span class="sv-ss-v">{brand}</span>
            <span class="sv-ss-k">{t(page.labels.seal)}</span>
            <span class="sv-ss-state">
              <svg class="sv-ss-iso" viewBox="0 0 116 114" aria-hidden="true">{ISO_PATHS.map((d) => <path fill="currentColor" fill-rule="evenodd" d={d} />)}</svg>
              <span class="grid gap-1">
                <span class="sv-ss-status"><svg viewBox="0 0 24 25" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d={SHIELD_PATH} /></svg>{t(page.status)}</span>
                <span class="sv-ss-reviewed">{t(page.reviewed)}</span>
              </span>
            </span>
          </div>
          <div class="sv-ss-card">
            <p class="sv-ss-small">{t(page.labels.url)}</p>
            <p class="sv-ss-mono">{verifiedUrl}</p>
          </div>
          <div class="sv-ss-card sv-ss-grid">
            <span class="sv-ss-k">{t(page.labels.date)}</span><span class="sv-ss-v">{t('{date}')}</span>
            <span class="sv-ss-k">{t(page.labels.until)}</span><span class="sv-ss-v">{t(page.validUntil)}</span>
          </div>
          <div class="sv-ss-card" data-sv-claims>
            <p class="sv-ss-h">{t(page.labels.claims)}</p>
            <ol class="sv-ss-claims">
              {page.claims.map((c) => (
                <li>
                  <p class="sv-ss-claim">{t(c.text)}</p>
                  {c.evidence && <p class="sv-ss-evidence">{t(c.evidence)}</p>}
                  {c.sources.length > 0 && (
                    <ul class="sv-ss-sources">{c.sources.map((s) => <li><span class="sv-ss-link">{t(s.title)}</span>{s.ref && <span class="sv-ss-ref"> — {t(s.ref)}</span>}</li>)}</ul>
                  )}
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

    </div>

    <p class="sv-caption" aria-live="polite" data-sv-caption>{lines.start}</p>
    <div class="sv-foot">
      <button type="button" class="sv-replay" data-sv-replay>{t(replay)}</button>
      {note && <p class="sv-note">{t(note)}</p>}
    </div>
  </Section>
</div>

<style>
  .sv-head { margin-bottom: clamp(1rem, 2.5vw, 1.5rem); }
  .sv-stage { position: relative; --bar: 2.75rem; }
  @media (min-width: 900px) {
    .sv-head, .sv-stage, .sv-caption, .sv-foot { width: min(100%, max(660px, calc((100svh - 500px) * 1.6))); margin-inline: auto; }
  }

  /* El navegador, redondeado y con la sombra suave de las tarjetas del tema. */
  .sv-browser { margin: 0; border-radius: var(--radius-card, 24px); overflow: hidden; background: rgb(var(--color-bg, 252 250 245));
    border: 1px solid rgb(var(--color-border, 233 232 227)); box-shadow: 0 30px 60px -30px rgb(0 0 0 / .35), 0 8px 20px -12px rgb(0 0 0 / .2); }
  .sv-bar { display: flex; align-items: center; gap: .5rem; height: var(--bar); padding: 0 .9rem; background: rgb(var(--color-surface, 246 242 230)); border-bottom: 1px solid rgb(var(--color-border, 233 232 227)); }
  .sv-dots { display: flex; gap: .35rem; }
  .sv-dots span { width: .62rem; height: .62rem; border-radius: 99px; background: rgb(var(--color-border, 233 232 227)); }
  .sv-back { display: none; width: 1.8rem; height: 1.8rem; border-radius: 99px; border: 0; background: transparent; color: inherit; cursor: pointer; font-size: 1rem; }
  .sv-url { margin-left: .5rem; flex: 1; max-width: 28rem; min-width: 0; display: flex; align-items: center; gap: .4rem; padding: .3rem .8rem; border-radius: 99px;
    background: rgb(var(--color-bg, 252 250 245)); font-size: .82rem; color: rgb(var(--color-muted, 83 82 79)); }
  .sv-url svg { width: .8rem; height: .8rem; flex: none; fill: currentColor; opacity: .7; }
  .sv-url em { font-style: normal; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sv-url b { color: rgb(var(--color-text, 36 35 32)); font-weight: 600; }
  .sv-url-seal { display: none; }
  /* En pantalla grande el mismo navegador pasa a sciscreen.com; en el móvil, la página del sello sale debajo con su barra. */
  @media (min-width: 900px) {
    .sv-stage.is-open .sv-bar .sv-back { display: inline-grid; place-items: center; }
    .sv-stage.is-open .sv-bar .sv-dots { display: none; }
    .sv-stage.is-open .sv-bar .sv-url-site { display: none; }
    .sv-stage.is-open .sv-bar .sv-url-seal { display: inline; animation: sv-fade .3s ease-out; }
  }

  .sv-page { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #fff; container-type: inline-size; }
  .sv-shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; transition: transform .45s ease, filter .45s ease; }
  .sv-stage.is-open .sv-shot { transform: scale(.98); filter: brightness(.96); }
  .sv-mock { position: absolute; inset: 0; padding: clamp(1.25rem, 4vw, 3rem); display: grid; align-content: start; gap: 1rem; background: rgb(var(--color-bg, 252 250 245)); }
  .sv-mock-brand { margin: 0; font-family: var(--font-display, inherit); font-weight: 700; font-size: clamp(1.6rem, 4vw, 3rem); line-height: 1; }
  .sv-mock-claims { margin: 0; padding: 0; list-style: none; display: grid; gap: .6rem; max-width: 34rem; }
  .sv-mock-claims li { padding: .7rem .9rem; border-radius: .9rem; background: rgb(var(--color-surface, 246 242 230)); line-height: 1.45; }

  /* Los sellos, del tamaño que tendrían instalados: --k = ancho de la captura / 1440 (client.ts). */
  .sv-seal { position: absolute; z-index: 2; padding: 0; margin: 0; border: 0; background: none; cursor: pointer; line-height: 0; transform-origin: 0 0;
    transform: scale(calc(var(--k, .7) * var(--s, 1))); filter: drop-shadow(0 6px 14px rgb(0 0 0 / .18)); border-radius: 18px; }
  /* La entrada: cae sobre la página con un pequeño rebote (se repite con «Volver a verlo»). */
  .sv-pop { display: inline-block; transform-origin: 50% 50%; }
  .sv-stage[data-step='idle'] .sv-pop { opacity: 0; }
  .sv-stage:not([data-step='idle']) .sv-pop { animation: sv-drop .75s cubic-bezier(.2, 1.3, .4, 1) var(--d, 0ms) both; }
  @keyframes sv-drop { 0% { opacity: 0; transform: translateY(-28px) scale(1.55); } 55% { opacity: 1; transform: translateY(0) scale(.94); } 100% { opacity: 1; transform: none; } }
  /* Foco: lo de alrededor se oscurece mientras el sello entra y el cursor va a pulsarlo. */
  .sv-dim { position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: 0; transition: opacity .5s ease;
    background: radial-gradient(circle at var(--fx, 50%) var(--fy, 50%), transparent 0, transparent var(--fr, 120px), rgb(8 10 30 / .42) calc(var(--fr, 120px) + 90px)); }
  .sv-stage[data-step='seal'] .sv-dim, .sv-stage[data-step='move'] .sv-dim, .sv-stage[data-step='press'] .sv-dim { opacity: 1; }
  .sv-seal:focus-visible { outline: 3px solid rgb(var(--color-primary, 34 70 178)); outline-offset: 3px; }
  .sv-stage[data-step='seal'] .sv-seal--target, .sv-stage[data-step='move'] .sv-seal--target { animation: sv-pulse 1.2s ease-in-out infinite; }
  .sv-stage[data-step='press'] .sv-seal--target { filter: drop-shadow(0 6px 14px rgb(0 0 0 / .18)) brightness(1.15); }
  @keyframes sv-pulse { 50% { filter: drop-shadow(0 0 0 rgb(34 70 178 / 0)) drop-shadow(0 0 12px rgb(34 70 178 / .55)); } }

  .sv-hint { position: absolute; z-index: 3; left: var(--hx, 50%); top: var(--hy, 80%); transform: translate(var(--hdx, 0), -50%); padding: .3rem .7rem; border-radius: 99px; font-size: .78rem; font-weight: 600;
    background: rgb(var(--color-accent-contrast, 0 3 65)); color: rgb(var(--color-bg, 252 250 245)); white-space: nowrap; opacity: 0; transition: opacity .3s; pointer-events: none; }
  .sv-stage[data-step='done']:not(.is-open) .sv-hint, .sv-stage.no-anim:not(.is-open) .sv-hint { opacity: .95; }

  /* El cursor: entra por la esquina, va al sello, se vuelve mano y pulsa. */
  .sv-cursor { position: absolute; z-index: 4; left: var(--cx, 105%); top: var(--cy, 92%); width: clamp(20px, 2.2vw, 30px); height: auto; fill: #111; stroke: #fff; stroke-width: 1.4; opacity: 0; pointer-events: none;
    filter: drop-shadow(0 3px 6px rgb(0 0 0 / .35)); transform-origin: 4px 2px; transition: left 1.3s cubic-bezier(.55, 0, .2, 1), top 1.3s cubic-bezier(.55, 0, .2, 1), opacity .3s, transform .15s; }
  .sv-stage[data-step='move'] .sv-cursor, .sv-stage[data-step='press'] .sv-cursor { opacity: 1; }
  .sv-stage[data-step='press'] .sv-cursor { transform: scale(.82); }
  .sv-click { position: absolute; z-index: 4; left: var(--cx, 0); top: var(--cy, 0); width: 44px; height: 44px; margin: -22px 0 0 -22px; border-radius: 99px; border: 2px solid rgb(var(--color-primary, 34 70 178)); opacity: 0; pointer-events: none; }
  .sv-stage[data-step='press'] .sv-click { animation: sv-ring .5s ease-out; }
  @keyframes sv-ring { from { opacity: .9; transform: scale(.4); } to { opacity: 0; transform: scale(1.5); } }

  /* «Simulación»: discreta y siempre a la vista, en la esquina de su web (encima también de la página del sello). */
  .sv-tag { position: absolute; z-index: 6; bottom: .75rem; left: .75rem; padding: .28rem .7rem; border-radius: 99px; font-size: .74rem; font-weight: 700; letter-spacing: .04em;
    background: rgb(0 0 0 / .72); color: #fff; backdrop-filter: blur(4px); pointer-events: none; }

  /* La página del sello en sciscreen.com: su diseño (papel, crema y azul marino), no el de la marca. */
  .sv-ss { --ss-paper: #fcfaf5; --ss-card: #f6f2e6; --ss-line: #e9e8e3; --ss-ink: #242320; --ss-muted: #53524f; --ss-navy: #000341; --ss-link: #2246b2;
    display: none; color: var(--ss-ink); background: var(--ss-paper); font-family: var(--font-sans, system-ui, sans-serif); }
  .sv-ss[data-open='1'] { display: block; animation: sv-in .4s ease-out; }
  .sv-ss-bar { display: flex; align-items: center; gap: .5rem; height: var(--bar); padding: 0 .9rem; background: var(--ss-card); border-bottom: 1px solid var(--ss-line); }
  .sv-back--in { display: inline-grid; place-items: center; }
  .sv-ss-scroll { padding: clamp(.9rem, 2.4cqw, 1.6rem); display: grid; gap: .8rem; }
  .sv-ss-top { display: flex; justify-content: space-between; align-items: center; padding-bottom: .4rem; border-bottom: 1px solid var(--ss-line); }
  .sv-ss-logo { width: 2.1rem; height: auto; color: var(--ss-navy); }
  .sv-ss-lang { font-size: .72rem; letter-spacing: .08em; color: var(--ss-muted); }
  .sv-ss-lang b { color: var(--ss-ink); }
  .sv-ss-card { padding: .85rem 1rem; border-radius: 1.1rem; background: var(--ss-card); border: 1px solid var(--ss-line); }
  .sv-ss-grid { display: grid; grid-template-columns: minmax(6.5rem, 30%) 1fr; gap: .6rem 1rem; align-items: center; }
  .sv-ss-k { font-size: .76rem; color: var(--ss-muted); }
  .sv-ss-v { font-size: .92rem; }
  .sv-ss-state { display: flex; align-items: center; gap: .9rem; color: var(--ss-navy); }
  .sv-ss-iso { width: 3rem; height: auto; flex: none; }
  .sv-ss-status { display: inline-flex; align-items: center; gap: .35rem; font-size: 1.15rem; }
  .sv-ss-status svg { width: 1.05rem; height: 1.05rem; }
  .sv-ss-reviewed { font-size: .92rem; }
  .sv-ss-small { margin: 0 0 .25rem; font-size: .68rem; font-weight: 600; color: var(--ss-muted); }
  .sv-ss-mono { margin: 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .78rem; overflow-wrap: anywhere; }
  .sv-ss-h { margin: 0 0 .5rem; font-weight: 600; font-size: .92rem; }
  .sv-ss-claims { margin: 0; padding-left: 1.2rem; display: grid; gap: .7rem; list-style: decimal; }
  .sv-ss-claims > li::marker { font-weight: 600; font-size: .9rem; }
  .sv-ss-claim { margin: 0; font-weight: 600; font-size: .9rem; line-height: 1.35; }
  .sv-ss-evidence { margin: .2rem 0 0; font-size: .76rem; color: var(--ss-muted); line-height: 1.4; }
  .sv-ss-sources { margin: .25rem 0 0; padding-left: 1rem; list-style: circle; font-size: .78rem; line-height: 1.4; }
  .sv-ss-link { color: var(--ss-link); text-decoration: underline; text-underline-offset: 2px; }
  .sv-ss-ref { color: var(--ss-muted); }

  /* Pantalla grande: la página del sello se abre en el mismo navegador (la barra pasa a sciscreen.com). Móvil: debajo,
     con su propia barra. */
  @media (min-width: 900px) {
    .sv-ss { position: absolute; z-index: 3; left: 1px; right: 1px; top: calc(var(--bar) + 1px); aspect-ratio: auto; height: calc(100% - var(--bar) - 2px);
      border-radius: 0 0 calc(var(--radius-card, 24px) - 1px) calc(var(--radius-card, 24px) - 1px); overflow: hidden; }
    .sv-ss[data-open='1'] { display: flex; flex-direction: column; animation: sv-slide .45s cubic-bezier(.2, .7, .2, 1); }
    .sv-ss-bar { display: none; }
    .sv-ss-scroll { overflow: auto; scroll-behavior: smooth; flex: 1; padding-inline: clamp(1.5rem, 9%, 6rem); }
  }
  @media (max-width: 899px) {
    .sv-ss { margin-top: .9rem; border-radius: var(--radius-card, 24px); overflow: hidden; border: 1px solid var(--ss-line); box-shadow: 0 24px 50px -24px rgb(0 0 0 / .35); }
  }
  @keyframes sv-in { from { opacity: 0; transform: translateY(10px); } }
  @keyframes sv-slide { from { opacity: 0; transform: translateY(16px) scale(.985); } }
  @keyframes sv-fade { from { opacity: 0; } }

  .sv-caption { margin: 1rem auto 0; min-height: 1.6em; font-size: 1.05rem; line-height: 1.45; text-align: center; color: rgb(var(--color-text, 36 35 32)); transition: opacity .25s; }
  .sv-caption.is-out { opacity: 0; }
  .sv-foot { margin-top: .9rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .75rem 1.5rem; }
  .sv-replay { border: 1px solid rgb(var(--color-border, 233 232 227)); background: transparent; color: inherit; padding: .5rem 1rem; border-radius: var(--radius-button, 999px); font-weight: 600; cursor: pointer; }
  .sv-note { margin: 0; padding-left: 1rem; border-left: 3px solid rgb(var(--color-primary, 34 70 178)); line-height: 1.5; max-width: 46rem; font-size: .95rem; color: rgb(var(--color-muted, 83 82 79)); }

  @media (prefers-reduced-motion: reduce) {
    .sv-cursor, .sv-click { display: none; }
    .sv-seal, .sv-pop, .sv-stage:not([data-step='idle']) .sv-pop, .sv-ss, .sv-ss[data-open='1'], .sv-shot, .sv-dim { transition: none; animation: none; }
  }
</style>

<script>
  import { mountAll } from '../runtime';
  import { init } from './client';
  mountAll('site-verify', init);
</script>
