---
/**
 * Portada «así funciona»: la pantalla del local pasando sola y, delante, el móvil del invitado (como en la web).
 * Con la app de Oquea (app-steps): la foto de portada y, delante, el móvil con las tarjetas para compartir pasando.
 * Rellena su contenedor (position: absolute). Sin módulos de pantalla, de móvil ni de app, no pinta nada.
 */
import Phone from './phone-tour/Phone.astro';
import ScreenMini from './live-screen/ScreenMini.astro';
import AppScreen from './app-steps/Screen.astro';
import { phoneTourSchema } from './phone-tour/schema';
import { appStepsSchema } from './app-steps/schema';
import type { UiKit } from '~/lib/playbook/service';

interface Props { kit: UiKit; venue?: string; photo?: string | null; class?: string }
const { kit, venue = 'Tu local', photo = null, class: cls } = Astro.props;
const phone = kit.phone ? phoneTourSchema.safeParse(kit.phone) : null;
// La app: los datos de ejemplo del módulo que enseña las tarjetas (si no, los del primero).
const appRaw = kit.screen || phone?.success ? null : (kit.apps ?? []).find((x) => Array.isArray(x.screens) && (x.screens as Array<{ screen?: string }>).some((y) => y.screen === 'share-card')) ?? kit.app ?? null;
const app = appRaw ? appStepsSchema.partial().safeParse(appRaw) : null;
const sample = app?.success ? appStepsSchema.shape.sample.parse(app.data.sample ?? {}) : null;
---
{(kit.screen || phone?.success) && (
  <div class:list={['kc', cls]} aria-hidden="true">
    <span class="kc__glow"></span>
    {kit.screen && <div class="kc__screen"><ScreenMini props={kit.screen} scenes={['club.photo', 'club.message', 'club.song']} venue={venue} /></div>}
    {phone?.success && <div class="kc__phone"><Phone {...phone.data} venue={venue} only="sheet" zoom={0.5} float /></div>}
  </div>
)}
{sample && (
  <div class:list={['kc', cls]} aria-hidden="true">
    {photo && <img src={photo} alt="" class="kc__photo" decoding="async" />}
    <div class="kc__app tn-ui"><AppScreen screen="share-card" sample={sample} center={venue} photo={app?.success ? app.data.photo ?? null : null} zoom={0.42} /></div>
  </div>
)}

<style>
  .kc { position: absolute; inset: 0; z-index: -2; overflow: hidden; background: var(--tn-dark, #0d0a12); }
  .kc__glow { position: absolute; inset: 0; background: radial-gradient(ellipse at 70% 20%, color-mix(in srgb, var(--tn-primary, #ff27bb) 30%, transparent), transparent 55%); }
  .kc__screen { position: absolute; right: 8%; top: 7%; width: 76%; }
  .kc__phone { position: absolute; right: 3%; top: 22%; transform: rotate(5deg); }
  .kc__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .kc__app { position: absolute; right: 6%; top: 8%; filter: drop-shadow(0 18px 30px rgb(0 0 0 / .45)); }
  /* En móvil, la tarjeta es estrecha: solo la foto (el móvil taparía el texto) */
  @media (max-width: 560px) { .kc__app { display: none; } }
</style>
