---
/**
 * phone-tour ← la app del invitado de Enjoy (UI recreada de las capturas: «Aparece en pantalla», «¿Qué quieres hacer?»,
 * «Foto en pantalla», pendiente, en directo, álbum). Los pasos a la izquierda (se tocan o van solos) y el móvil, grande, a la derecha.
 * Se adapta a lo que tiene el cliente (ctx.media.features) y usa sus fotos, su nombre y su estilo musical.
 */
import Section from '~/components/Section.astro';
import Headline from '../Headline.astro';
import { interpolate } from '../resolve';
import type { ModuleBaseProps } from '../types';
import type { PhoneTourProps } from './schema';
import { featuresOf } from '../live-screen/music';
import Phone from './Phone.astro';
import { partsFor, stepsFor, type Part, type Step } from './steps';

/** part: solo en modo presentación (DossierView), qué trozo del recorrido es esta diapositiva. */
type Props = PhoneTourProps & ModuleBaseProps & { part?: Part };
const { eyebrow, title, lede, djName, price, photos, qrImage, musicStyles, autoplay, parts, ownerLabel, ctx, part } = Astro.props;
const t = (s: string) => interpolate(s, ctx);
const media = ctx.media ?? {};
const f = featuresOf(media.features);
const venue = (ctx.prospectCompany || 'Tu local').slice(0, 24);

// Los pasos, en orden; los que el cliente no tiene, fuera. En presentación, una diapositiva por grupo (part).
// Con grupos propios, sus textos (y la frase «para ti»); fuera de la presentación, todos seguidos.
const dj = !!djName;
const custom = parts?.length ? partsFor(media, venue, price, parts, dj) : null;
const allSteps: Step[] = custom ? custom.flatMap((g) => g.steps ?? []) : stepsFor(f, venue, price, dj);
const steps = part ? (part.steps ?? allSteps.filter((s) => part.keys.includes(s.key))) : allSteps;
const first = Math.max(0, part?.steps ? custom?.slice(0, part.n - 1).reduce((n, g) => n + g.keys.length, 0) ?? 0 : allSteps.findIndex((s) => s.key === steps[0]?.key));
// Título: con grupos propios, el de cada grupo (también el primero); si no, el del módulo y luego el del grupo.
const heading = part ? (part.steps ? part.title : part.n > 1 ? part.title : t(title)) : t(title);
const sub = part?.steps ? part.lede : part && part.n > 1 ? undefined : lede;
---
<div data-module="phone-tour" class:list={['phone-tour', part && 'phone-tour--part']} data-autoplay={autoplay || part ? '1' : '0'}>
  <Section tone="surface">
    <div class="pt-layout">
      <div class="pt-copy">
        <div class="pt-head">
        {(eyebrow || part) && <p class="mb-3 text-sm font-bold uppercase tracking-wider text-primary">{eyebrow ? t(eyebrow) : ''}{part && part.of > 1 && <span class="pt-part"> · {part.n}/{part.of}</span>}</p>}
        <h2 class="font-display text-[clamp(1.75rem,3.6vw,2.75rem)] font-extrabold tracking-tight"><Headline text={t(heading)} /></h2>
        {sub && <p class="mt-3 max-w-xl text-lg text-muted">{t(sub)}</p>}
        </div>

        <ol class="pt-steps" role="tablist">
          {steps.map((s, i) => (
            <li><button type="button" role="tab" class="pt-step" data-step-btn={s.key} aria-selected={i === 0 ? 'true' : 'false'}>
              <span class="pt-step__n">{first + i + 1}</span><span class="pt-step__t"><b>{s.label}</b><small>{t(s.says)}</small>{s.owner && <em class="pt-step__owner" title={ownerLabel}>{t(s.owner)}</em>}</span><i class="pt-step__bar" aria-hidden="true"></i>
            </button></li>
          ))}
        </ol>
      </div>
      <div class="pt-device">
        <Phone djName={djName} price={price} photos={photos} qrImage={qrImage} musicStyles={musicStyles} media={media} venue={ctx.prospectCompany} float={!!part} />
      </div>
    </div>
  </Section>
</div>

<style>
  /* El texto a la izquierda (título y pasos), el móvil grande a la derecha: lo que se mira es la app. */
  .pt-layout { display: grid; gap: 1.75rem; align-items: center; }
  /* En móvil: título, móvil y pasos, en ese orden. */
  @media (max-width: 899px) { .pt-copy { display: contents; } .pt-head { order: -2; } .pt-device { order: -1; } .pt-steps { margin-top: 0; } }
  @media (min-width: 900px) { .pt-layout { grid-template-columns: minmax(0, 1fr) auto; gap: 4rem; } .pt-device { padding-right: 2rem; } }
  /* Los pasos: se tocan o van solos. */
  .pt-steps { display: grid; gap: .35rem; margin-top: 1.5rem; padding: 0; list-style: none; }
  .pt-step { width: 100%; display: flex; gap: .85rem; align-items: flex-start; text-align: left; padding: .7rem .9rem; border-radius: 14px; border: 1px solid transparent; background: transparent; color: inherit; cursor: pointer; opacity: .6; transition: opacity .2s, background .2s; }
  .pt-step[aria-selected='true'] { opacity: 1; background: rgb(var(--color-bg, 8 3 12) / .6); border-color: rgb(var(--color-primary, 255 39 187) / .45); }
  /* Va solo: una barra en el paso activo dice cuánto falta para el siguiente. */
  .pt-step { position: relative; overflow: hidden; }
  .pt-step__bar { position: absolute; left: 0; bottom: 0; height: 3px; width: 0; background: rgb(var(--color-primary, 255 39 187)); }
  .is-auto .pt-step[aria-selected='true'] .pt-step__bar { animation: pt-bar var(--dur, 3500ms) linear forwards; }
  @keyframes pt-bar { to { width: 100%; } }
  .pt-step__n { flex-shrink: 0; width: 1.7rem; height: 1.7rem; border-radius: 99px; display: grid; place-items: center; font-size: .9rem; font-weight: 800; background: rgb(var(--color-primary, 255 39 187)); color: #fff; }
  .pt-step__t b { display: block; font-size: 1.1rem; line-height: 1.3; } .pt-step__t small { display: block; opacity: .9; font-size: .98rem; line-height: 1.45; margin-top: .2rem; }
  /* Lo que significa para quien paga: pequeño, y solo en el paso que se está viendo. */
  .pt-step__owner { display: none; margin-top: .4rem; font-style: normal; font-size: .9rem; line-height: 1.4; color: rgb(var(--color-primary, 255 39 187)); }
  .pt-step__owner::before { content: '→ '; }
  .pt-step[aria-selected='true'] .pt-step__owner { display: block; }
  @media (max-width: 899px) { .pt-step__t small { display: none; } .pt-step[aria-selected='true'] .pt-step__t small { display: block; } }
  @media (prefers-reduced-motion: reduce) { :global(.pt-phone) { animation: none !important; } }
</style>

<script>
  import { mountAll } from '../runtime';
  import { init } from './client';
  mountAll('phone-tour', init);
</script>
