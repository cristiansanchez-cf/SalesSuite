---
/** pricing-card — NUEVO (greenfield). Consume price_mode / total del dossier vía ctx. */
import Section from '~/components/Section.astro';
import Button from '~/components/Button.astro';
import Icon from '~/components/Icon.astro';
import { interpolate } from '../resolve';
import type { ModuleBaseProps } from '../types';
import { pricingFigure, type PricingCardProps } from './schema';

type Props = PricingCardProps & ModuleBaseProps;
const { eyebrow, title, subtitle, features, priceSuffix, noPriceLabel, taxNote, cta, ctx } = Astro.props;
const figure = pricingFigure(ctx);
const t = (s: string) => interpolate(s, ctx);
---
<div data-module="pricing-card">
  <Section>
    <div class="pricing-card mx-auto max-w-3xl overflow-hidden rounded-card border border-line bg-bg shadow-card">
      <div class="bg-primary p-8 text-primary-contrast sm:p-10">
        {eyebrow && <p class="text-sm font-bold uppercase tracking-wider opacity-80">{t(eyebrow)}</p>}
        <h2 class="mt-2 font-display text-3xl font-extrabold sm:text-4xl">{t(title)}</h2>
        {subtitle && <p class="mt-3 opacity-90">{t(subtitle)}</p>}
        {figure?.discount && <p class="mt-8 inline-flex rounded-pill bg-primary-contrast/15 px-3 py-1 text-sm font-semibold" data-testid="pricing-discount">{figure.discount.label}</p>}
        <p class:list={['flex flex-wrap items-baseline gap-x-3', figure?.discount ? 'mt-3' : 'mt-8']} data-testid="pricing-figure">
          {figure?.before && <s class="text-2xl opacity-60" data-testid="pricing-before">{figure.before.formatted}</s>}
          {figure
            ? <><span class="font-display text-5xl font-extrabold sm:text-6xl">{figure.formatted}</span>
                {priceSuffix && <span class="text-lg opacity-80">{priceSuffix}</span>}</>
            : <span class="font-display text-3xl font-extrabold">{noPriceLabel}</span>}
        </p>
        {figure && taxNote && <p class="mt-1 text-sm opacity-75">{taxNote}</p>}
      </div>
      {(features.length > 0 || cta) && (
        <div class="p-8 sm:p-10">
          {features.length > 0 && (
            <ul class="grid gap-3 p-0 sm:grid-cols-2">
              {features.map((f) => (
                <li class="flex list-none items-start gap-3">
                  <span class="mt-0.5 rounded-pill bg-accent p-1 text-accent-contrast"><Icon name="check" size={14} /></span>
                  {t(f)}
                </li>
              ))}
            </ul>
          )}
          {cta && <div class="mt-8"><Button href={cta.href} variant="primary">{cta.label} <Icon name="arrow" size={16} /></Button></div>}
        </div>
      )}
    </div>
  </Section>
</div>
