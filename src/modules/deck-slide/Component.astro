---
/** deck-slide ← una diapositiva: titular y puntos. Solo tokens del tema. */
import Section from '~/components/Section.astro';
import Headline from '../Headline.astro';
import { interpolate } from '../resolve';
import type { ModuleBaseProps } from '../types';
import type { DeckSlideProps } from './schema';

type Props = DeckSlideProps & ModuleBaseProps;
const { eyebrow, title, lede, bullets, note, ctx } = Astro.props;
const t = (s: string) => interpolate(s, ctx);
---
<div data-module="deck-slide">
  <Section tone="surface">
    {eyebrow && <p class="mb-3 text-sm font-bold uppercase tracking-wider text-primary">{t(eyebrow)}</p>}
    <h2 class="max-w-3xl font-display text-[clamp(2rem,5vw,3.5rem)] font-extrabold tracking-tight"><Headline text={t(title)} /></h2>
    {lede && <p class="mt-3 max-w-2xl text-lg text-muted">{t(lede)}</p>}
    <ol class="ds-list mt-8 grid gap-0 p-0">
      {bullets.map((b, i) => <li class="ds-item" style={`--i:${i}`}><span class="ds-n">{String(i + 1).padStart(2, '0')}</span><span>{t(b)}</span></li>)}
    </ol>
    {note && <p class="ds-note mt-6 max-w-3xl">{t(note)}</p>}
  </Section>
</div>

<style>
  .ds-list { list-style: none; margin: 0; }
  .ds-item { display: grid; grid-template-columns: 3rem minmax(0, 1fr); align-items: baseline; gap: 1rem; padding: 1.1rem 0; border-top: 1px solid rgb(var(--color-text, 255 255 255) / .1); font-family: var(--font-display, inherit); font-weight: 700; font-size: clamp(1.15rem, 2vw, 1.55rem); line-height: 1.3; }
  .ds-item:last-child { border-bottom: 1px solid rgb(var(--color-text, 255 255 255) / .1); }
  .ds-n { font-family: var(--font-sans, inherit); font-size: .8rem; font-weight: 800; letter-spacing: .12em; color: rgb(var(--color-primary, 255 39 187)); }
  .ds-note { padding-left: 1rem; border-left: 3px solid rgb(var(--color-accent, 225 255 0)); font-size: 1.1rem; line-height: 1.5; }
  @media (prefers-reduced-motion: no-preference) { .ds-item { animation: ds-in .5s ease both; animation-delay: calc(var(--i) * 80ms); } }
  @keyframes ds-in { from { opacity: .001; transform: translateY(8px); } }
</style>
