---
/** deck-slide ← titular con *acento*, una cita destacada y puntos numerados en tarjetas. Animada al verse. */
import "../deck/deck.css";
import Section from "~/components/Section.astro";
import Rich from "../deck/Rich.astro";
import Count from "../deck/Count.astro";
import { interpolate } from "../resolve";
import type { ModuleBaseProps } from "../types";
import type { DeckSlideProps } from './schema';

type Props = DeckSlideProps & ModuleBaseProps;
const { eyebrow, title, lede, bullets = [], note, callout, ctx } = Astro.props;
const t = (s: string) => interpolate(s, ctx);
---
<div data-module="deck-slide" class="relative overflow-hidden">
  <Section>
    {eyebrow && <p class="deck-eyebrow deck-in">{t(eyebrow)}</p>}
    <h2 class="deck-title deck-in max-w-5xl" style="--d:80ms"><Rich text={t(title)} /></h2>
    {lede && <blockquote class="deck-in m-0 mt-8 max-w-5xl border-l-[3px] border-primary pl-6 text-[clamp(1.05rem,min(1.8vw,3vh),1.5rem)] leading-snug text-text/90" style="--d:180ms"><Rich text={t(lede)} /></blockquote>}
    {bullets.length > 0 && (
      <ol class="m-0 mt-[clamp(1.25rem,4vh,2.5rem)] grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {bullets.map((b, i) => (
          <li class="deck-card deck-card--line deck-in grid gap-3" style={`--d:${240 + i * 90}ms`}>
            <span class="font-display text-sm font-bold tracking-[0.2em] text-primary">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-lg leading-snug"><Rich text={t(b)} /></span>
          </li>
        ))}
      </ol>
    )}
    {note && <p class="deck-in mt-6 text-sm text-muted" style={`--d:${300 + bullets.length * 90}ms`}><Rich text={t(note)} /></p>}
    {callout && <p class="deck-callout deck-in m-0 mt-4" style={`--d:${360 + bullets.length * 90}ms`}><Rich text={t(callout)} /></p>}
  </Section>
</div>

<script>
  import { mountAll } from '../runtime';
  import { init } from '../deck/client';
  mountAll('deck-slide', init);
</script>
