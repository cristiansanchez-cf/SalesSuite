---
/** deck-math ← por qué entrar ahora: una cuenta grande que cuenta, tarjetas, una tabla de escenarios y una frase. */
import "../deck/deck.css";
import Section from "~/components/Section.astro";
import Rich from "../deck/Rich.astro";
import Count from "../deck/Count.astro";
import { interpolate } from "../resolve";
import type { ModuleBaseProps } from "../types";
import type { DeckMathProps } from './schema';

type Props = DeckMathProps & ModuleBaseProps;
const { eyebrow, title, equation, cardsTitle, cards, table, callout, ctx } = Astro.props;
const t = (s: string) => interpolate(s, ctx);
const ops = equation?.ops?.length ? equation.ops : equation?.terms.length === 3 ? ['−', '='] : ['='];
const tone = (x?: string) => (x === 'primary' ? 'tone-primary' : x === 'accent' ? 'tone-accent' : '');
---
<div data-module="deck-math" class="relative overflow-hidden">
  <Section>
    <div class="flex flex-wrap items-baseline gap-x-8 gap-y-2">
      {eyebrow && <p class="deck-eyebrow deck-in !mb-0">{t(eyebrow)}</p>}
      <h2 class="deck-title deck-in !text-[clamp(2rem,4.6vw,3.6rem)]" style="--d:80ms"><Rich text={t(title)} /></h2>
    </div>
    {equation && (
      <div class="deck-card deck-card--featured deck-card--line deck-in mt-8 grid gap-6" style="--d:160ms" data-testid="deck-equation">
        {(equation.tag || equation.caption) && <p class="m-0 flex flex-wrap items-center gap-3">{equation.tag && <span class="deck-tag deck-tag--primary">{t(equation.tag)}</span>}{equation.caption && <span class="text-sm text-muted">{t(equation.caption)}</span>}</p>}
        <div class="flex flex-wrap items-end gap-x-6 gap-y-4">
          {equation.terms.map((x, i) => (
            <>
              {i > 0 && <span class="deck-in pb-3 font-display text-4xl text-muted" style={`--d:${260 + i * 160}ms`}>{ops[i - 1] ?? '='}</span>}
              <div class="deck-in grid gap-1" style={`--d:${240 + i * 160}ms`}>
                <span class="text-xs font-bold uppercase tracking-[0.2em] text-muted">{t(x.label)}</span>
                <span class:list={['deck-figure !text-[clamp(2.2rem,min(5vw,9vh),4.6rem)]', tone(x.tone)]}><Count value={t(x.value)} /></span>
              </div>
            </>
          ))}
        </div>
        {equation.note && <p class="m-0 text-xs text-muted">{t(equation.note)}</p>}
      </div>
    )}
    {cardsTitle && <p class="deck-in mt-8 font-display text-[clamp(1.2rem,2vw,1.6rem)] font-extrabold" style="--d:420ms"><Rich text={t(cardsTitle)} /></p>}
    {cards && cards.length > 0 && (
      <div class:list={['mt-4 grid gap-4', cards.length > 1 && 'md:grid-cols-2', cards.length > 2 && 'lg:grid-cols-3']}>
        {cards.map((c, i) => (
          <div class="deck-card deck-in grid content-start gap-2" style={`--d:${480 + i * 90}ms`}>
            {c.tag && <span class="deck-tag deck-tag--primary w-fit">{t(c.tag)}</span>}
            <p class="m-0 font-display text-xl font-extrabold">{t(c.title)}</p>
            {c.text && <p class="m-0 text-sm text-muted"><Rich text={t(c.text)} /></p>}
          </div>
        ))}
      </div>
    )}
    {(table || callout) && (
      <div class:list={['mt-4 grid gap-4', table && callout && 'lg:grid-cols-[1.6fr_1fr]']}>
        {table && (
          <div class="deck-card deck-in overflow-x-auto !p-5" style="--d:620ms">
            <table class="w-full border-collapse text-sm" data-testid="deck-table">
              <thead><tr>{table.columns.map((c, i) => <th class:list={['pb-3 text-xs font-bold uppercase tracking-[0.18em] text-muted', i === 0 ? 'text-left' : i === table.columns.length - 1 ? 'text-right' : 'text-left']}>{t(c)}</th>)}</tr></thead>
              <tbody>{table.rows.map((r, k) => (
                <tr class="border-t border-line">{r.map((c, i) => <td class:list={['py-3', i === 0 && 'font-bold', i === r.length - 1 ? 'text-right font-display text-lg font-extrabold' : 'text-muted', i === r.length - 1 && k === table.rows.length - 1 && 'tone-primary']}>{t(c)}</td>)}</tr>
              ))}</tbody>
            </table>
          </div>
        )}
        {callout && (
          <div class="deck-card deck-card--featured deck-card--line deck-in grid content-center gap-2" style="--d:720ms">
            <p class="m-0 text-lg"><Rich text={t(callout.text)} /></p>
            {callout.big && <p class="m-0 flex flex-wrap items-baseline gap-3"><span class="font-display text-[clamp(2.2rem,4vw,3.2rem)] font-extrabold tone-primary">{t(callout.big)}</span>{callout.after && <span class="text-lg">{t(callout.after)}</span>}</p>}
            {callout.note && <p class="m-0 text-xs text-muted">{t(callout.note)}</p>}
          </div>
        )}
      </div>
    )}
  </Section>
</div>

<script>
  import { mountAll } from '../runtime';
  import { init } from '../deck/client';
  mountAll('deck-math', init);
</script>
