---
/**
 * problem-solution ← «Lo que te pasa hoy»: el problema del cliente y lo que cambia, una fila por problema.
 * Solo tokens del tema (bg, surface, primary, accent, muted, line).
 */
import Section from '~/components/Section.astro';
import Headline from '../Headline.astro';
import { interpolate } from '../resolve';
import type { ModuleBaseProps } from '../types';
import type { ProblemSolutionProps } from './schema';

type Props = ProblemSolutionProps & ModuleBaseProps;
const { eyebrow, title, lede, beforeLabel, afterLabel, cards, note, ctx } = Astro.props;
const t = (s: string) => interpolate(s, ctx);
---
<div data-module="problem-solution" class="problem-solution">
  <Section tone="surface">
    {eyebrow && <p class="mb-3 text-sm font-bold uppercase tracking-wider text-primary">{t(eyebrow)}</p>}
    <h2 class="max-w-3xl font-display text-[clamp(2rem,5vw,3.5rem)] font-extrabold tracking-tight"><Headline text={t(title)} /></h2>
    {lede && <p class="mt-3 max-w-2xl text-lg text-muted">{t(lede)}</p>}

    <div class="ps-table mt-8">
      <div class="ps-head" aria-hidden="true"><span>{beforeLabel}</span><span></span><span class="ps-head__after">{afterLabel}</span></div>
      <ol class="ps-rows p-0">
        {cards.map((c, i) => (
          <li class="ps-row" style={`--i:${i}`}>
            <p class="ps-before"><span class="ps-mlabel">{beforeLabel}</span>{t(c.problem)}</p>
            <span class="ps-arrow" aria-hidden="true">→</span>
            <p class="ps-after"><span class="ps-mlabel ps-mlabel--after">{afterLabel}</span>{t(c.solution)}</p>
          </li>
        ))}
      </ol>
    </div>
    {note && <p class="ps-note mt-6 max-w-3xl">{t(note)}</p>}
  </Section>
</div>

<style>
  /* Una fila por problema: lo de hoy, pequeño y apagado; lo que cambia, grande. Sin cajas: aire y una línea fina. */
  .ps-head { display: none; }
  .ps-rows { list-style: none; margin: 0; }
  .ps-row { display: grid; gap: .35rem; padding: 1.15rem 0; border-top: 1px solid rgb(var(--color-text, 255 255 255) / .1); }
  .ps-row:last-child { border-bottom: 1px solid rgb(var(--color-text, 255 255 255) / .1); }
  .ps-before { margin: 0; color: rgb(var(--color-muted, 160 160 170)); font-size: 1.05rem; line-height: 1.45; }
  .ps-after { margin: 0; font-family: var(--font-display, inherit); font-weight: 700; font-size: clamp(1.2rem, 2.1vw, 1.6rem); line-height: 1.25; letter-spacing: -.01em; }
  .ps-arrow { display: none; }
  .ps-mlabel { display: block; margin-bottom: .2rem; font-family: var(--font-sans, inherit); font-size: .7rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; opacity: .8; }
  .ps-mlabel--after { color: rgb(var(--color-primary, 255 39 187)); opacity: 1; }
  @media (min-width: 900px) {
    .ps-head, .ps-row { display: grid; grid-template-columns: minmax(0, 1fr) 3.5rem minmax(0, 1.35fr); align-items: center; gap: 1.5rem; }
    .ps-head { padding-bottom: .6rem; font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: rgb(var(--color-muted, 160 160 170)); }
    .ps-head__after { color: rgb(var(--color-primary, 255 39 187)); }
    .ps-row { padding: 1.35rem 0; }
    .ps-mlabel { display: none; }
    .ps-arrow { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 99px; font-weight: 800; color: rgb(var(--color-primary, 255 39 187)); background: rgb(var(--color-primary, 255 39 187) / .12); }
  }
  .ps-note { padding-left: 1rem; border-left: 3px solid rgb(var(--color-accent, 225 255 0)); font-size: 1.1rem; line-height: 1.5; }
  @media (prefers-reduced-motion: no-preference) { .ps-row { animation: ps-in .5s ease both; animation-delay: calc(var(--i) * 90ms); } }
  @keyframes ps-in { from { opacity: .001; transform: translateY(8px); } }
</style>
