---
/**
 * La ficha del mapa (marker sheet): el paso entre tocar un marcador y abrir su página. Lo que es → lo que pasa → qué
 * hacer. Con evento, su bloque va entre la identidad y el botón; el botón es siempre del sujeto del marcador
 * («Ver centro», «Ver ONG»…). Un evento suelto se lleva el botón y el organizador pasa a ruta secundaria.
 * Entrega de Cristian (6-oct-2026): «Marker sheet — with events».
 */
import { Sprout, X, Star, Waves, House, ChevronRight, MapPin } from 'lucide-static';

type Kind = 'centre' | 'ngo' | 'site' | 'event';
interface Props {
  kind: Kind; name: string; place: string; meta?: string[];
  event?: { label: string; title: string; when: string } | null;
  organiser?: string | null;
}
const { kind, name, place, meta = [], event = null, organiser = null } = Astro.props;
const inner = (svg: string, size: number, sw = 1.8) => svg.replace(/width="24"/, `width="${size}"`).replace(/height="24"/, `height="${size}"`).replace(/stroke-width="2"/, `stroke-width="${sw}"`);
const STAR = '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9z" fill="#D0FF00"/></svg>';
const LABEL: Record<Kind, string> = { centre: 'Centro de buceo', ngo: 'ONG', site: 'Punto de inmersión', event: 'Evento' };
const CTA: Record<Kind, string> = { centre: 'Ver centro', ngo: 'Ver ONG', site: 'Ver punto de inmersión', event: 'Ver evento' };
const ICON: Record<Kind, string> = { centre: inner(House, 28), ngo: inner(Sprout, 28), site: inner(Waves, 28), event: STAR.replace(/18/g, '28') };
void Star;
---
<div class:list={['ms', `ms--${kind}`]}>
  <span class="ms__grip"></span>
  <div class="ms__id">
    <span class="ms__thumb" set:html={ICON[kind]} />
    <span class="ms__txt">
      <em class="ms__chip">{LABEL[kind]}</em>
      <b>{name}</b>
      <small><Fragment set:html={inner(MapPin, 12, 1.6)} />{place}</small>
      {meta.length > 0 && <span class="ms__meta">{meta.join(' · ')}</span>}
    </span>
    <span class="ms__x" set:html={inner(X, 18, 1.6)} />
  </div>
  {event && (
    <div class="ms__event">
      <span class="ms__evico" set:html={STAR} />
      <span class="ms__evtxt"><em>{event.label}</em><b>{event.title}</b><small>{event.when}</small></span>
      <span class="ms__chev" set:html={inner(ChevronRight, 18)} />
    </div>
  )}
  {organiser && (
    <div class="ms__event ms__event--org">
      <span class="ms__evico ms__evico--ngo" set:html={inner(Sprout, 18)} />
      <span class="ms__evtxt"><em>Organiza</em><b>{organiser}</b></span>
      <span class="ms__chev" set:html={inner(ChevronRight, 18)} />
    </div>
  )}
  <span class="ms__cta">{CTA[kind]}</span>
</div>

<style>
  .ms { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; display: grid; gap: 12px; padding: 12px 16px 26px; border-radius: 24px 24px 0 0; background: #fff; font-family: var(--font-sans, inherit); }
  .ms__grip { width: 36px; height: 4px; border-radius: 2px; background: #efefef; }
  .ms__id { display: flex; align-items: flex-start; gap: 14px; }
  .ms__thumb { display: grid; place-items: center; width: 60px; height: 60px; flex: none; border-radius: 16px; background: #e4edfa; color: #406ad0; }
  .ms--ngo .ms__thumb { background: #d0ff00; color: #1f294c; }
  .ms--event .ms__thumb { background: #3757be; }
  .ms__txt { flex: 1; min-width: 0; display: grid; gap: 3px; justify-items: start; }
  .ms__chip { padding: 3px 8px; border-radius: 10px; background: #1f294c; color: #fff; font-size: 9.5px; font-weight: 700; font-style: normal; }
  .ms--ngo .ms__chip { background: #d0ff00; color: #1f294c; }
  .ms--site .ms__chip { background: #406ad0; }
  .ms--event .ms__chip { background: #3757be; }
  .ms__txt b { font-size: 17px; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .ms__txt small { display: flex; align-items: center; gap: 4px; color: #8a8f9c; font-size: 11.5px; }
  .ms__meta { color: #464646; font-size: 11.5px; }
  .ms__x { color: #8a8f9c; }
  .ms__event { display: flex; align-items: center; gap: 12px; padding: 11px 12px; border-radius: 16px; background: #e4edfa; }
  .ms__event--org { background: #f5f6f8; }
  .ms__evico { display: grid; place-items: center; width: 38px; height: 38px; flex: none; border-radius: 99px; background: #3757be; }
  .ms__evico--ngo { background: #d0ff00; color: #1f294c; }
  .ms__evtxt { flex: 1; min-width: 0; display: grid; gap: 2px; }
  .ms__evtxt em { color: #3757be; font-size: 9.5px; font-weight: 700; font-style: normal; letter-spacing: .05em; text-transform: uppercase; }
  .ms__evtxt b { font-size: 13.5px; font-weight: 400; color: #292929; }
  .ms__evtxt small { color: #8a8f9c; font-size: 11.5px; }
  .ms__chev { color: #3757be; }
  .ms__cta { padding: 14px; border-radius: 99px; background: var(--ap, #3757be); color: #fff; font-size: 15px; text-align: center; }
</style>
