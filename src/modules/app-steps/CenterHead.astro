---
/** Cabecera del modo centro: centro activo (con su logo o los dos puntos de Oquea) y pestañas Buceos · CRM · Mi centro. */
import { APP_ICONS } from './icons';
interface Props { center: string; logo?: string | null; tab: 'dives' | 'crm' | 'centre' }
const { center, logo, tab } = Astro.props;
const caret = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${APP_ICONS.caret}</svg>`;
const tabs = [['dives', 'Buceos'], ['crm', 'CRM'], ['centre', 'Mi centro']] as const;
---
<div class="as-chead">
  {logo ? <img class="as-chead__logo" src={logo} alt="" /> : <span class="as-dots"><i></i><i></i></span>}
  <b>{center}</b><Fragment set:html={caret} />
</div>
<div class="as-tabs">{tabs.map(([k, l]) => <span class:list={[tab === k && 'on']}>{l}</span>)}</div>
<style>
  .as-chead { display: flex; align-items: center; gap: 8px; height: 34px; font-size: 18px; }
  .as-chead b { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 240px; }
  .as-chead :global(svg) { color: #7c7c7c; margin-left: auto; }
  .as-chead__logo { width: 28px; height: 28px; border-radius: 8px; object-fit: contain; }
  .as-dots { display: inline-flex; gap: 3px; }
  .as-dots i { width: 13px; height: 13px; border-radius: 99px; background: var(--ap); }
  .as-dots i + i { background: var(--ap-acc); }
  .as-tabs { display: grid; grid-template-columns: repeat(3, 1fr); margin: 8px -18px 12px; border-bottom: 1px solid #e6e8ee; text-align: center; font-size: 15px; color: #9a9a9a; }
  .as-tabs span { padding: 10px 0; }
  .as-tabs .on { color: var(--ap); font-weight: 600; box-shadow: inset 0 -2px 0 var(--ap); }
</style>
