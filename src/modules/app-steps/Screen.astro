---
/**
 * Un móvil con una pantalla de la app de Oquea recreada en HTML (OqueaApp, docs/ventas/oquea/fuentes/02-entrega-UI-
 * aplicacion.md y las capturas de la guía de inicio). La app es clara siempre: fondo blanco, texto casi negro, tarjetas
 * de radio 16 con borde de 1 px y sin sombra; el azul y el acento salen del tema (--color-primary, --color-accent).
 * Lo del cliente: su nombre ({company} ya resuelto en `center`), su logo y su primera foto (media).
 * Se diseña a 375 px de ancho; `zoom` lo encoge.
 */
import { APP_ICONS, MASK_ICON, type AppIcon } from './icons';
import { fakeQr } from './qr';
import type { AppSample, AppScreen } from './schema';
import AppNav from './AppNav.astro';
import CenterHead from './CenterHead.astro';
import SeaMap from './SeaMap.astro';
import MapSheet from './MapSheet.astro';
import SITE_PIN from './markers/punto-inmersion.svg?raw';
import { APP_TEXT, appLang, escHtml, localSample } from './app-text';
import { requestLocale } from '~/lib/i18n/request';

interface Props {
  screen: AppScreen; src?: string; alt?: string; sample: AppSample; center: string; logo?: string | null; photo?: string | null;
  zoom?: number; class?: string; locale?: string;
}
const { screen, src, alt, sample: sample0, center, logo, photo, zoom = 1, class: cls } = Astro.props;
const locale = Astro.props.locale ?? requestLocale();
const L = APP_TEXT[appLang(locale)];
// Personas y lugares de ejemplo en el idioma de quien lee (en coreano, coreanos).
const s = localSample(sample0, L);
const P = L.people;
const ic = (n: AppIcon, size = 18) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${APP_ICONS[n]}</svg>`;
const mask = (size = 22) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${MASK_ICON}</svg>`;
const initials = (n: string) => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join('');
const centerName = center.slice(0, 28);

const qr = fakeQr(centerName);

// share-card: cada tarjeta con su foto (las de ejemplo, en orden; si faltan, la foto del centro o la del módulo).
const cards = s.cards ?? ['dive'];
const cardPhotos = s.photos ?? [];
const cardBg = (i: number) => { const u = cardPhotos.length ? cardPhotos[i % cardPhotos.length] : photo; return u ? `background-image:url('${u.replace(/'/g, '%27')}')` : ''; };
// Fotos de ejemplo para logbook y álbum: las del módulo en orden; sin fotos, degradados de mar (como el diseño).
const SEA = ['linear-gradient(146deg,#0ea5e9,#0369a1)', 'linear-gradient(180deg,#1e3a5f,#0c4a6e)', 'linear-gradient(131deg,#0ea5e9,#1e40af)', 'linear-gradient(180deg,#78716c,#44403c)', 'linear-gradient(131deg,#f59e0b,#0ea5e9)', 'linear-gradient(180deg,#0ea5e9,#164e63)', 'linear-gradient(180deg,#22d3ee,#0c4a6e)'];
const photoPool = [...cardPhotos, ...(photo ? [photo] : [])];
const pool = (i: number) => (photoPool.length ? `background-image:url('${photoPool[i % photoPool.length]!.replace(/'/g, '%27')}')` : `background-image:${SEA[i % SEA.length]}`);
const me = s.diver.split(/\s+/).map((w, i) => (i === 0 ? w : `${w[0]}.`)).slice(0, 2).join(' ');
const ALBUM: Array<[string, boolean, string]> = [[P.album[0]!, false, ''], [me, true, '5'], [P.album[0]!, false, ''], [P.album[1]!, false, ''], [P.album[2]!, false, '12'], [me, true, '']];
const DEPTH_CHART = '<svg viewBox="0 0 256 62" preserveAspectRatio="none" aria-hidden="true"><g stroke="currentColor" stroke-opacity=".35" stroke-width="1"><line x1="0" y1="18" x2="256" y2="18"/><line x1="0" y1="34" x2="256" y2="34"/><line x1="0" y1="50" x2="256" y2="50"/></g><path d="M6 8 L50 20 L95 28 L136 48 L178 40 L220 26 L250 10 L250 62 L6 62 Z" fill="currentColor" fill-opacity=".1"/><polyline points="6,8 50,20 95,28 136,48 178,40 220,26 250,10" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><circle cx="136" cy="48" r="6" fill="currentColor"/></svg>';
const TRIP_CHART = '<svg viewBox="0 0 256 62" preserveAspectRatio="none" aria-hidden="true"><g fill="none" stroke="#4d7ad6" stroke-width="1.5"><path d="M0 22 Q64 14 128 22 T256 22"/><path d="M0 44 Q64 36 128 44 T256 44"/></g><polyline points="30,44 68,24 104,48 140,20 176,40 210,30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4"/><g fill="currentColor"><circle cx="30" cy="44" r="6"/><circle cx="68" cy="24" r="6"/><circle cx="104" cy="48" r="6"/><circle cx="140" cy="20" r="6"/><circle cx="176" cy="40" r="6"/><circle cx="210" cy="30" r="6" fill-opacity=".7"/></g></svg>';
const FISH = '<svg viewBox="0 0 120 60" aria-hidden="true"><path d="M8 30 C30 8 78 6 100 26 L116 12 L112 30 L116 48 L100 34 C78 54 30 52 8 30 Z" fill="#9fb3c8"/><path d="M52 14 L60 2 L66 16 Z" fill="#9fb3c8"/><g fill="#fff" fill-opacity=".85"><circle cx="34" cy="24" r="1.6"/><circle cx="44" cy="20" r="1.6"/><circle cx="54" cy="26" r="1.6"/><circle cx="64" cy="20" r="1.6"/><circle cx="74" cy="27" r="1.6"/><circle cx="40" cy="34" r="1.6"/><circle cx="60" cy="36" r="1.6"/><circle cx="82" cy="32" r="1.6"/></g><circle cx="20" cy="28" r="2" fill="#1f294c"/></svg>';
const bg = photo ? `background-image:url('${photo.replace(/'/g, '%27')}')` : '';
---
<div class:list={['as-phone', cls]} style={zoom !== 1 ? `zoom:${zoom}` : undefined} aria-hidden={screen === 'image' ? undefined : 'true'}>
  <div class="as-notch"></div>
  <div class:list={['as-screen', `as-screen--${screen}`]}>
    {screen === 'image' ? (
      src ? <img class="as-shot" src={src} alt={alt ?? ''} loading="lazy" decoding="async" /> : null
    ) : screen === 'access' ? (
      <div class="as-access" style={bg}>
        <span class="as-access__bars"><i class="on"></i><i></i><i></i></span>
        <span class="as-access__logo">oquea</span>
        <div class="as-access__copy"><b>{L.signUp}</b><span>{L.tagline}</span></div>
        <span class="as-access__btn">{L.withEmail} <Fragment set:html={ic('mail', 16)} /></span>
        <span class="as-access__btn">{L.withGoogle} <b class="as-g">G</b></span>
        <small class="as-access__legal">{L.legal}</small>
      </div>
    ) : screen === 'qr-activity' ? (
      <Fragment>
        <div class="as-bar"><Fragment set:html={ic('back')} /><span>{L.todayActivities}</span></div>
        <div class="as-hero" style={bg}><span class="as-hero__fade"></span></div>
        <div class="as-act">
          <h3>{s.activity}</h3>
          <span class="as-chip as-chip--ghost">{s.discipline}</span>
          <p class="as-meta"><span><Fragment set:html={ic('pin', 14)} />{s.site}</span><span><Fragment set:html={ic('calendar', 14)} />{s.date}</span><span><Fragment set:html={ic('clock', 14)} />{s.time}</span></p>
          <p class="as-pager"><i class="on"></i><i></i><i></i></p>
        </div>
        <div class="as-save"><span class="as-save__ico" set:html={mask(30)} /><span><b>{L.saveToLogbook}</b><small><Fragment set:html={ic('globe', 13)} />{L.logInOquea}</small></span></div>
        <div class="as-tiles">
          <span class="as-tile"><i set:html={ic('image')} /><b>{L.seeMedia}</b><small>{L.files('125')}</small></span>
          <span class="as-tile"><i set:html={ic('mobile')} /><b>{L.shareDive}</b><small>{L.cardForSocials}</small></span>
        </div>
        <ul class="as-rows">
          <li><Fragment set:html={ic('thermo', 16)} /><span>{L.temperature}</span><em>{s.temp} °C</em></li>
          <li><Fragment set:html={ic('down', 16)} /><span>{L.depth}</span><em>{s.depth} m</em></li>
          <li><Fragment set:html={ic('fish', 16)} /><span>{L.marineLife}</span><em>{s.life}</em></li>
        </ul>
        <p class="as-foot">{L.savedBy(centerName)}</p>
      </Fragment>
    ) : screen === 'qr-pick' || screen === 'qr-scan' ? (
      <Fragment>
        {screen === 'qr-scan' && (
          <div class="qs">
            <span class="qs__hint">{L.scanHint}</span>
            <span class="qs__frame"><span class="qs__qr" set:html={qr} /><i class="qs__line"></i></span>
            <span class="qs__found"><Fragment set:html={ic('anchor', 14)} />{centerName}</span>
          </div>
        )}
        <div class="qp">
          <div class="qp-centre"><span class="qp-centre__ico" set:html={logo ? `<img src="${logo}" alt="" />` : ic('anchor', 16)} /><span><b>{centerName}</b><small><Fragment set:html={ic('pin', 10)} />{s.place}</small></span></div>
          <h3 class="qp-title">{L.whichActivity}</h3>
          <p class="qp-date">{L.pickDate}</p>
          {[[s.activity, s.time, s.site, P.guides[0]!], [L.tryDive, '11:30', L.centreBeach, P.guides[1]!], [L.nightDive, '20:00', P.site3, P.guides[0]!]].map(([a, h, site, by], i) => (
            <div class:list={['qp-act', i === 0 && 'is-on']}>
              <span class="qp-act__ico" set:html={mask(18)} />
              <span class="qp-act__txt"><em class="qp-by"><Fragment set:html={ic('person', 9)} />{L.addedBy(by!)}</em><b>{a}</b><small>{h} · {site}</small></span>
              <Fragment set:html={ic('next', 14)} />
            </div>
          ))}
          <div class="qp-miss"><span class="qp-miss__ico" set:html={ic('search', 16)} /><span><b>{L.notFound}</b><small>{L.lookEarlier}</small></span><Fragment set:html={ic('next', 14)} /></div>
        </div>
      </Fragment>
    ) : screen === 'dive-detail' ? (
      <Fragment>
        <div class="dd-bar"><Fragment set:html={ic('back')} /><span>{L.logbook}</span></div>
        <div class="dd-tabs"><span class="on">{L.dive}</span><span>{L.participants}</span></div>
        <div class="as-hero dd-hero" style={bg}><span class="as-hero__fade"></span></div>
        <div class="as-act dd-act">
          <h3>{s.activity}</h3>
          <span class="as-chip as-chip--ghost">{s.discipline}</span>
          <p class="as-meta"><span><Fragment set:html={ic('pin', 14)} />{s.site}</span><span><Fragment set:html={ic('calendar', 14)} />{s.date}</span><span><Fragment set:html={ic('clock', 14)} />{s.time}</span></p>
          <p class="as-pager"><i class="on"></i><i></i><i></i></p>
        </div>
        <div class="as-save"><span class="as-save__ico" set:html={mask(30)} /><span><b>{L.seeMyData}</b><small><Fragment set:html={ic('history', 13)} />{L.seeOrEdit}</small></span></div>
        <div class="as-tiles">
          <span class="as-tile"><i set:html={ic('image')} /><b>{L.seeMedia}</b><small>{L.files('125')}</small></span>
          <span class="as-tile"><i set:html={ic('mobile')} /><b>{L.shareDive}</b><small>{L.inCardForSocials}</small></span>
        </div>
        <ul class="as-rows">
          <li><Fragment set:html={ic('thermo', 16)} /><span>{L.temperature}</span><em>{s.temp} °C</em></li>
          <li><Fragment set:html={ic('down', 16)} /><span>{L.depth}</span><em>{s.depth} m</em></li>
          <li><Fragment set:html={ic('fish', 16)} /><span>{L.marineLife}</span><em>{s.life}</em></li>
        </ul>
      </Fragment>
    ) : screen === 'dive-saved' ? (
      <Fragment>
        <div class="as-dim">
          <div class="as-bar"><span class="as-iso"></span><span>{L.todayActivities}</span></div>
          <div class="as-hero as-hero--short" style={bg}><span class="as-hero__fade"></span></div>
          <h3 class="as-dim__title">{s.activity}</h3>
        </div>
        <div class="as-sheet">
          <span class="as-okdot" set:html={ic('check', 22)} />
          <h4>{L.diveAdded}</h4>
          <div class="as-divecard"><span class="as-divecard__ico" set:html={mask(26)} /><span><b>{s.activity}</b><small><span class="as-chip as-chip--sm">{s.discipline}</span> <Fragment set:html={ic('clock', 12)} />{s.time} · <Fragment set:html={ic('pin', 12)} />{s.site}</small></span></div>
          <p class="as-ask">{L.whatNow}</p>
          <span class="as-btn"><Fragment set:html={ic('book', 16)} />{L.seeInLogbook}</span>
          <span class="as-btn as-btn--line"><Fragment set:html={ic('image', 16)} />{L.seeMedia}</span>
          <span class="as-btn as-btn--line"><Fragment set:html={ic('mobile', 16)} />{L.shareOnSocials}</span>
          <span class="as-btn as-btn--line"><Fragment set:html={ic('back', 16)} />{L.backToActivities}</span>
        </div>
      </Fragment>
    ) : screen === 'share-card' ? (
      (s.exports ?? []).length ? (
      <div class="as-cards" data-cards={s.exports.length}>
        {s.exports.map((u, i) => <div class="as-card as-card--png" style={`--i:${i};background-image:url('${u.replace(/'/g, '%27')}')`}></div>)}
        {s.exports.length > 1 && <span class="as-cards__dots">{s.exports.map((_, i) => <i style={`--i:${i}`}></i>)}</span>}
      </div>
      ) :
      <div class="as-cards" style={`--n:${cards.length}`} data-cards={cards.length}>
        {cards.map((k, i) => (
          <div class:list={['as-card', `as-card--${k}`]} style={`--i:${i};${cardBg(i)}`}>
            <span class="as-card__shade"></span>
            <div class="as-stk">
              {k === 'dive' ? (
                <Fragment>
                  <p class="as-stk__loc"><Fragment set:html={ic('pin', 13)} />{L.divingAt(s.site)}</p>
                  <p class="as-stk__hero"><b>47</b><span>{L.dive}</span></p>
                  <div class="as-stk__stats">
                    <span><b>{s.duration}<i>{L.min}</i></b><small>{L.time}</small></span>
                    <span><b>{s.depth}<i>m</i></b><small>{L.depth}</small></span>
                    <span><b>{s.temp}<i>°C</i></b><small>{L.tempShort}</small></span>
                  </div>
                  <p class="as-stk__life">{s.life.replace(/,\s*/g, ' · ')}</p>
                  <p class="as-stk__foot"><span>{L.withName(centerName)}</span><span>{L.cardDate1}</span></p>
                </Fragment>
              ) : k === 'record' ? (
                <Fragment>
                  <span class="as-stk__chart" set:html={DEPTH_CHART} />
                  <span class="as-stk__pill">{L.newRecord}</span>
                  <p class="as-stk__hero as-stk__hero--xl"><b>42</b><span class="as-stk__unit">m</span></p>
                  <p class="as-stk__label">{L.maxDepth}</p>
                  <p class="as-stk__life">{L.prevRecord(s.site)}</p>
                  <p class="as-stk__foot"><span>{L.withName(centerName)}</span><span>{L.cardDate2}</span></p>
                </Fragment>
              ) : k === 'milestone' ? (
                <Fragment>
                  <p class="as-stk__label as-stk__label--hi">{L.milestone}</p>
                  <p class="as-stk__hero as-stk__hero--xxl"><b>100</b><span class="as-stk__unit">{L.unitDives}</span></p>
                  <p class="as-stk__sub">{L.divingSince}</p>
                  <div class="as-stk__stats">
                    <span><b>82h</b><small>{L.underwater}</small></span>
                    <span><b>42 m</b><small>{L.deepest}</small></span>
                  </div>
                  <p class="as-stk__life">{L.diveNumberAt(s.site)}</p>
                  <p class="as-stk__foot"><span>{L.withName(centerName)}</span></p>
                </Fragment>
              ) : k === 'trip' ? (
                <Fragment>
                  <span class="as-stk__chart" set:html={TRIP_CHART} />
                  <p class="as-stk__label">{L.theTrip}</p>
                  <p class="as-stk__title">{L.tripTitle}</p>
                  <div class="as-stk__stats as-stk__stats--hi">
                    <span><b>12</b><small>{L.divesCap}</small></span>
                    <span><b>6</b><small>{L.sitesCap}</small></span>
                    <span><b>8h 40m</b><small>{L.underwater}</small></span>
                  </div>
                  <p class="as-stk__life">{L.tripLife}</p>
                  <p class="as-stk__foot"><span>{L.withName(centerName)}</span><span>{L.cardDate3}</span></p>
                </Fragment>
              ) : (
                <Fragment>
                  {s.species ? <span class="as-stk__tile"><img src={s.species} alt="" /></span> : <span class="as-stk__tile" set:html={FISH} />}
                  <span class="as-stk__pill">{L.seenIn}</span>
                  <p class="as-stk__title">{L.whaleShark}</p>
                  <p class="as-stk__sub">{L.diveNo47(s.site)}</p>
                  <p class="as-stk__foot"><span>{L.withName(centerName)}</span></p>
                </Fragment>
              )}
              {s.brand ? <img class="as-stk__brand" src={s.brand} alt="Oquea" /> : <b class="as-stk__brand as-stk__brand--txt">oquea</b>}
            </div>
          </div>
        ))}
        {cards.length > 1 && <span class="as-cards__dots">{cards.map((_, i) => <i style={`--i:${i}`}></i>)}</span>}
      </div>
    ) : screen === 'logbook' ? (
      <Fragment>
        <div class="lb-head"><span class="as-iso"></span><b>{L.logbook}</b><span class="lb-qr" set:html={ic('qr', 18)} /><span class="lb-add"><Fragment set:html={ic('add', 16)} />{L.dive}</span></div>
        <div class="lb-tools"><span class="lb-search"><Fragment set:html={ic('search', 14)} />{L.searchPlaces}</span><span class="lb-view"><i class="on" set:html={ic('grid', 14)} /><i set:html={ic('list', 14)} /></span></div>
        <div class="lb-years"><span class="on">{L.allYears}</span><span>2026</span><span>2025</span><span>2024</span></div>
        <p class="lb-year"><b>2026</b><i></i><small>{L.divesN('12')}</small></p>
        <div class="lb-card">
          <div class="lb-card__top"><span class="lb-num"><small>{L.dive}</small><b>47</b></span><span class="lb-card__txt"><b>{L.moonDive}</b><span class="lb-chips"><em class="lb-chip lb-chip--acc">{centerName}</em><em class="lb-chip lb-chip--blue">{L.event}</em><em class="lb-chip">{s.level}</em></span><small>{L.lbDate1} · {centerName}</small></span></div>
          <span class="lb-pic" style={pool(0)}><span class="lb-pic__badge" set:html={ic('award', 22)} /></span>
          <span class="lb-share"><Fragment set:html={ic('export', 16)} />{L.shareThisDive}</span>
        </div>
        <div class="lb-card">
          <div class="lb-card__top"><span class="lb-num"><small>{L.dive}</small><b>46</b></span><span class="lb-card__txt"><b>{s.site}</b><small>{L.lbDate2} · {centerName}</small></span></div>
          <span class="lb-map"><span class="lb-map__one" set:html={SITE_PIN} /><span class="lb-map__tag"><Fragment set:html={ic('pin', 13)} />{s.site}</span></span>
          <span class="lb-share"><Fragment set:html={ic('export', 16)} />{L.shareThisDive}</span>
        </div>
      </Fragment>
    ) : screen === 'diver-profile' ? (
      <Fragment>
        <div class="as-bar as-bar--title"><span class="as-iso"></span><span>{L.profile}</span><span class="as-bar__end as-bar__end--pill" set:html={ic('menu')} /></div>
        <div class="as-pcard"><span class="as-avatar" set:html={ic('user', 30)} /><b>{s.diver}</b><small>@{s.handle} · {L.instructor}</small><p set:html={L.diveCountHtml(escHtml(s.dives))} /></div>
        <p class="as-h">{L.myStats}</p>
        <div class="as-stats">
          {[['9h 30m', L.diveTime, 'clock'], ['30 m', L.maxDepthShort, 'down'], ['8', L.certifications, 'ok'], ['3', L.countries, 'globe'], ['2', L.centres, 'building'], [L.lastDiveDate, L.lastDive, 'calendar']].map(([v, l, i]) => (
            <span><b>{v}</b><small><Fragment set:html={ic(i as AppIcon, 12)} />{l}</small></span>
          ))}
        </div>
        <div class="as-link"><span class="as-link__ico" set:html={ic('home', 16)} /><span>{L.myCentres}</span><Fragment set:html={ic('next', 16)} /></div>
        <AppNav on='profile' locale={locale} />
      </Fragment>
    ) : screen === 'activities' ? (
      <Fragment>
        <CenterHead center={centerName} logo={logo} tab='dives' locale={locale} />
        <div class="as-toggle"><span class="on">{L.activities}</span><span>{L.diveSite}</span></div>
        <div class="as-sec"><span><Fragment set:html={ic('calendar', 16)} />{L.todayActivities}</span><em>{L.seeAll} <Fragment set:html={ic('next', 13)} /></em></div>
        {[[L.boatTrip, s.time, s.site, '6'], [L.nightDiving, '20:00', P.site3, '3']].map(([t, h, site, n], i) => (
          <div class="as-acard">
            <div class="as-acard__head"><b>{t}</b><span class="as-acard__clip" set:html={ic('clipboard', 16)} /></div>
            <span class="as-chip"><Fragment set:html={mask(14)} />{L.dive}</span>
            <div class="as-acard__grid">
              <span><Fragment set:html={ic('clock', 14)} />{h}</span><span><Fragment set:html={ic('calendar', 14)} />{s.date}</span>
              <span><Fragment set:html={ic('pin', 14)} />{site}</span><span><Fragment set:html={ic('users', 14)} />{L.diversN(n!)}</span>
            </div>
            {i === 0 && <div class="as-acard__actions"><span class="as-chip as-chip--btn"><Fragment set:html={ic('edit', 13)} />{L.edit}</span><span class="as-danger">{L.delete}</span></div>}
          </div>
        ))}
        <div class="as-sec as-sec--line"><span><Fragment set:html={ic('calendar', 16)} />{L.upcoming}</span><em>{L.seeAll}</em></div>
        <div class="as-next"><span><b>{L.owCourse}</b><small>09:00 · {s.site} · {L.oneStudent}</small></span><em>{L.nextDate}</em></div>
      </Fragment>
    ) : screen === 'create-activity' ? (
      <Fragment>
        <div class="as-bar"><Fragment set:html={ic('back')} /><span>{L.newDive}</span></div>
        <span class="as-progress"><i style="width:22%"></i></span>
        <div class="as-form">
          <span class="as-field as-field--filled">{s.date} · {s.time}<Fragment set:html={ic('clock', 16)} /></span>
          <span class="as-field as-field--filled">{s.site}<Fragment set:html={ic('pin', 16)} /></span>
          <span class="as-field as-field--filled">Scuba<Fragment set:html={ic('caret', 16)} /></span>
          <span class="as-field as-field--filled">{s.discipline}<Fragment set:html={ic('caret', 16)} /></span>
          <div class="as-preset"><small>{L.presetLoaded}</small><span><b>30 m</b><i>{L.maxDepthAbbr}</i></span><span><b>{L.minutes('45')}</b><i>{L.time}</i></span><span><b>20 m</b><i>{L.visibility}</i></span><span class="as-preset__life"><b>{s.life}</b><i>{L.marineLife}</i></span></div>
        </div>
        <span class="as-btn as-btn--bottom">{L.continue}</span>
      </Fragment>
    ) : screen === 'center-qr' ? (
      <Fragment>
        <CenterHead center={centerName} logo={logo} tab='centre' locale={locale} />
        <div class="as-qr"><span class="as-qr__code"><Fragment set:html={qr} /><span class="as-qr__iso"></span></span></div>
        <p class="as-qr__txt">{L.qrText}</p>
        <div class="as-qr__btns"><span class="as-btn as-btn--sm">{L.shareLink}</span><span class="as-btn as-btn--sm as-btn--line">{L.download}</span></div>
        <div class="as-list">
          <span>{L.manageTeam}<Fragment set:html={ic('next', 16)} /></span>
          <span>{L.editCentre}<Fragment set:html={ic('next', 16)} /></span>
        </div>
        <AppNav on='centres' locale={locale} />
      </Fragment>
    ) : screen === 'crm-list' ? (
      <Fragment>
        <CenterHead center={centerName} logo={logo} tab='crm' locale={locale} />
        <div class="as-search"><Fragment set:html={ic('search', 16)} />{L.searchDiver}</div>
        <p class="as-count" set:html={L.diversInCentreHtml('128')} />
        {[[s.diver, s.level, '42', 'qr'], [P.crm[0]!, 'Open Water', '8', 'qr'], [P.crm[1]!, 'Divemaster', '310', 'hand'], [P.crm[2]!, 'Rescue Diver', '57', 'qr'], [P.crm[3]!, 'Open Water', '3', 'qr']].map(([n, l, d, how]) => (
          <div class="as-person">
            <span class="as-ini">{initials(n!)}</span>
            <span class="as-person__txt"><b>{n}</b><small>{l} · {L.divesN(d!)}</small></span>
            <span class:list={['as-chip as-chip--sm', how === 'hand' && 'as-chip--grey']}>{how === 'qr' ? L.scannedQr : L.addedByHand}</span>
          </div>
        ))}
      </Fragment>
    ) : screen === 'crm-diver' ? (
      <Fragment>
        <div class="as-bar"><Fragment set:html={ic('back')} /><span>{L.diverProfile}</span></div>
        <div class="as-diver">
          <span class="as-avatar as-avatar--lg" set:html={ic('user', 34)} />
          <b>{s.diver}</b><small>@{s.handle}</small>
          <span class="as-chip"><Fragment set:html={ic('shield', 13)} />{s.level}</span>
          <span class="as-chip as-chip--line"><Fragment set:html={ic('eye', 14)} />{L.seePublicProfile}</span>
        </div>
        <div class="as-band"></div>
        <p class="as-h"><Fragment set:html={ic('home', 16)} />{L.atYourCentre}</p>
        <div class="as-kpis as-kpis--grey"><span><b>8</b><small>{L.divesHere}</small></span><span><b>{L.firstDate}</b><small>{L.first}</small></span><span><b>{s.date.slice(0, 5)}</b><small>{L.last}</small></span></div>
        <div class="as-band"></div>
        <p class="as-h"><Fragment set:html={ic('clipboard', 16)} />{L.activityHistory}</p>
        {[[L.diveAt(s.site), s.date, L.recreational, false], [L.diveAt(P.site3), L.histDate2, L.recreational, false], [L.courseAdvanced, L.histDate3, L.course, true]].map(([t, d, k, course]) => (
          <div class="as-hist"><span class:list={['as-dive__ico', course && 'as-dive__ico--warm']} set:html={course ? ic('shield', 20) : mask(20)} /><span><b>{t}</b><small>{d} <span class:list={['as-chip as-chip--sm', course && 'as-chip--warm']}>{k}</span></small></span></div>
        ))}
      </Fragment>
    ) : screen === 'my-centres' ? (
      <Fragment>
        <div class="as-bar as-bar--center"><Fragment set:html={ic('back')} /><span>{L.myCentres}</span></div>
        <p class="as-label">{L.owner}</p>
        <div class="as-ccard"><span class="as-ccard__ico" set:html={logo ? `<img src="${logo}" alt="" />` : ic('anchor', 20)} /><span><b>{centerName}</b><small>{L.ownerActivities(3)}</small></span><Fragment set:html={ic('next', 18)} /></div>
        <div class="as-ccard"><span class="as-ccard__ico" set:html={ic('waves', 20)} /><span><b>{centerName} · {L.harbour}</b><small>{L.ownerActivities(0)}</small></span><Fragment set:html={ic('next', 18)} /></div>
        <span class="as-dashed"><Fragment set:html={ic('add', 16)} />{L.createCentre}</span>
        <p class="as-label">{L.team}</p>
        <p class="as-muted">{L.noTeam}</p>
      </Fragment>
    ) : screen === 'team' ? (
      <Fragment>
        <div class="as-bar"><Fragment set:html={ic('back')} /><span>{L.manageTeam}</span></div>
        {[[s.diver, L.roleOwner], [P.team[0]!, L.roleAdmin], [P.team[1]!, L.roleAdmin]].map(([n, r]) => (
          <div class="as-member">
            <div class="as-member__head"><span class="as-ini as-ini--sm">{initials(n!)}</span><b>{n}</b><span class="as-chip as-chip--grey as-chip--sm">{r}</span></div>
            <div class="as-member__btns"><span class="as-btn as-btn--sm">{L.edit}</span><span class="as-btn as-btn--sm as-btn--line">{L.delete}</span></div>
          </div>
        ))}
        <span class="as-btn as-btn--line as-btn--bottom">{L.addMember}</span>
      </Fragment>
    ) : screen === 'dive-sites' ? (
      <Fragment>
        <CenterHead center={centerName} logo={logo} tab='dives' locale={locale} />
        <div class="as-toggle"><span>{L.activities}</span><span class="on">{L.diveSite}</span></div>
        <div class="as-sec"><span><Fragment set:html={ic('anchor', 16)} />{L.diveSites}</span><em>3</em></div>
        {[[s.site, '12–30 m', L.siteMantas], [P.site3, '18–24 m', L.siteWall], ['The Cathedral', '8–16 m', L.siteCave]].map(([n, d, k]) => (
          <div class="as-site"><span class="as-site__ico" set:html={ic('pin', 18)} /><span class="as-site__txt"><b>{n}</b><small>{k}</small></span><span class="as-chip as-chip--sm">{d}</span></div>
        ))}
        <span class="as-btn as-btn--sm as-site__add"><Fragment set:html={ic('plus', 15)} />{L.addDiveSite}</span>
        <AppNav on='centres' locale={locale} />
      </Fragment>
    ) : screen === 'map' ? (
      <div class="as-map">
        <SeaMap center={centerName} site={s.site} focus='centre' locale={locale} />
        <div class="as-map__search"><Fragment set:html={ic('search', 15)} />{L.searchPlaces}</div>
        
        <MapSheet kind='centre' name={centerName} place={s.place} event={{ label: L.eventOn, title: L.beachCleanup, when: L.beachWhen }} locale={locale} />
      </div>
    ) : screen === 'album' ? (
      <Fragment>
        <div class="al-bar"><Fragment set:html={ic('back')} /><b>{s.album}</b><Fragment set:html={ic('download', 20)} /></div>
        <p class="al-meta"><span><Fragment set:html={ic('images', 14)} />{L.photosN('8')}</span><span><Fragment set:html={ic('users', 14)} />{L.diversN('3')}</span><em>{L.daysLeft('23')}</em></p>
        <div class="al-grid">
          {ALBUM.map(([who, mine, likes], i) => (
            <span class:list={['al-ph', i === 0 && 'al-ph--big', mine && 'al-ph--mine']} style={pool(i)}>
              {mine && <em class="al-mine"><Fragment set:html={ic('person', 10)} />{L.yourPhoto}</em>}
              <span class="al-ph__foot"><span><i class="al-av"></i>{who}</span><span>{likes && <Fragment><Fragment set:html={ic('heart', 12)} />{likes}</Fragment>}<Fragment set:html={ic('download', 13)} /></span></span>
            </span>
          ))}
        </div>
        <span class="al-add"><Fragment set:html={ic('imageAdd', 18)} />{L.addPhotos}</span>
      </Fragment>
    ) : screen === 'album-photo' ? (
      <Fragment>
        <div class="al-bar al-bar--dim"><Fragment set:html={ic('back')} /><b>{s.album}</b><Fragment set:html={ic('download', 20)} /></div>
        <div class="ap">
          <div class="ap-card" style={pool(1)}>
            <span class="ap-who"><i class="al-av al-av--lg"></i><b>Lucía Fernández</b><em>{L.follow}</em></span>
            <span class="ap-foot"><span><Fragment set:html={ic('heart', 20)} />15</span><Fragment set:html={ic('download', 20)} /></span>
          </div>
          <span class="ap-add"><Fragment set:html={ic('add', 18)} />{L.addPhotos}</span>
        </div>
        <AppNav on='logbook' locale={locale} />
      </Fragment>
    ) : screen === 'badge' ? (
      <Fragment>
        <div class="as-bar"><Fragment set:html={ic('back')} /><span>{L.badgeTitle}</span></div>
        <div class="as-badge">
          <span class="as-badge__medal"><Fragment set:html={ic('heart', 40)} /></span>
          <small>{centerName}</small>
          <b>{L.seabedCleanup}</b>
          <span class="as-chip">{L.attended(s.date)}</span>
          <p>{L.tookPart(s.diver)}</p>
        </div>
        <div class="as-list as-list--flat"><span><Fragment set:html={ic('anchor', 16)} />{L.withName(s.site)}</span><span><Fragment set:html={ic('share', 16)} />{L.share}</span></div>
      </Fragment>
    ) : screen === 'event' ? (
      <div class="as-map">
        <SeaMap center={centerName} site={s.site} focus='ngo' locale={locale} />
        <MapSheet kind='ngo' name={P.ngo} place={s.place} event={{ label: L.eventOn, title: L.seabedCleanup, when: L.seabedWhen }} locale={locale} />
      </div>
    ) : null}
  </div>
</div>

<style>
  /* El móvil: 375 de ancho de diseño. Marco oscuro fino, como los mockups de la web de Oquea. */
  .as-phone {
    --ap: rgb(var(--color-primary, 55 87 190));
    --ap-tint: color-mix(in srgb, var(--ap) 7%, #fff);
    --ap-chip: color-mix(in srgb, var(--ap) 12%, #fff);
    --ap-acc: rgb(var(--color-accent, 208 255 0));
    --ap-navy: rgb(var(--color-accent-contrast, 31 41 76));
    --ink: #111318; --mut: #7c7c7c; --hint: #a3a3a8; --line: #e6e8ee; --soft: #f6f7f9;
    position: relative; width: 375px; height: 780px; flex: none; border-radius: 54px; padding: 12px;
    background: #1d2130; box-shadow: inset 0 0 0 2px #3a3f52;
    font-family: var(--font-sans, 'Gilroy', 'Inter', system-ui, sans-serif); color: var(--ink); text-align: left;
  }
  .as-notch { position: absolute; z-index: 3; top: 22px; left: 50%; width: 112px; height: 30px; margin-left: -56px; border-radius: 99px; background: #1d2130; }
  .as-screen { position: relative; height: 100%; overflow: hidden; border-radius: 42px; background: #fff; padding: 56px 18px 0; font-size: 14px; line-height: 1.3; }
  .as-screen--share-card { padding: 0; }
  .as-screen--image { padding: 44px 0 0; }
  .as-shot { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .as-screen :global(svg) { flex: none; }
  b { font-weight: 700; }
  small { display: block; font-size: 12px; color: var(--mut); }

  .as-bar { display: flex; align-items: center; gap: 10px; height: 34px; margin-bottom: 8px; font-size: 16px; color: var(--ink); }
  .as-bar :global(svg) { color: var(--ap); }
  .as-bar--title { font-size: 17px; font-weight: 600; }
  .as-bar--center { justify-content: center; position: relative; }
  .as-bar--center :global(svg) { position: absolute; left: 0; }
  .as-bar__end { margin-left: auto; display: grid; place-items: center; }
  .as-bar__end--pill { width: 34px; height: 34px; border-radius: 99px; background: var(--ap-tint); }
  .as-iso { width: 24px; height: 18px; border-radius: 9px 12px 12px 9px; background: radial-gradient(circle at 30% 50%, var(--ap) 0 4px, transparent 5px), radial-gradient(circle at 70% 50%, var(--ap) 0 8px, transparent 9px); }
  .as-iso--light { background: radial-gradient(circle at 30% 50%, #fff 0 4px, transparent 5px), radial-gradient(circle at 70% 50%, #fff 0 8px, transparent 9px); }

  .as-chip { display: inline-flex; align-items: center; gap: 5px; padding: 5px 12px; border-radius: 99px; background: var(--ap-chip); color: var(--ap); font-size: 13px; font-weight: 500; white-space: nowrap; }
  .as-chip--sm { padding: 2px 9px; font-size: 11px; }
  .as-chip--ghost { background: #fff; color: var(--ink); border: 1px solid var(--line); font-weight: 400; }
  .as-chip--line { background: #fff; border: 1px solid color-mix(in srgb, var(--ap) 30%, #fff); }
  .as-chip--grey { background: #f1f2f4; color: #5b5f6a; }
  .as-chip--warm { background: #fff1e3; color: #d4620a; }
  .as-chip--btn { padding: 7px 14px; }
  .as-btn { display: flex; align-items: center; justify-content: center; gap: 8px; height: 46px; border-radius: 99px; background: var(--ap); color: #fff; font-size: 15px; font-weight: 400; }
  .as-btn--line { background: #fff; color: var(--ap); border: 1px solid color-mix(in srgb, var(--ap) 45%, #fff); }
  .as-btn--sm { height: 34px; padding: 0 18px; font-size: 13px; }
  .as-btn--bottom { position: absolute; left: 18px; right: 18px; bottom: 34px; }

  /* Actividad tras escanear el QR */
  .as-hero { height: 150px; margin: 0 -18px; position: relative; background: linear-gradient(180deg, #f59e0b 0%, #ea580c 28%, #7aa7c7 55%, #5ec8ef 72%, #fff6e2 100%); background-size: cover; background-position: center; }
  .as-hero--short { height: 120px; }
  .as-hero__fade { position: absolute; inset: auto 0 0; height: 60px; background: linear-gradient(transparent, #fff); }
  .as-act { text-align: center; margin-top: -22px; position: relative; }
  .as-act h3 { line-height: 1.1; }
  .as-act h3 { margin: 0 0 8px; font-size: 26px; font-weight: 700; color: var(--ap); letter-spacing: -.01em; }
  .as-meta { display: flex; justify-content: center; gap: 12px; margin: 10px 0 0; color: #555; font-size: 13px; }
  .as-meta span { display: inline-flex; align-items: center; gap: 4px; }
  .as-pager { display: flex; justify-content: center; gap: 6px; margin: 12px 0 14px; }
  .as-pager i { width: 7px; height: 7px; border-radius: 99px; background: #e5e7eb; }
  .as-pager i.on { background: var(--ap); }
  .as-save { display: flex; align-items: center; gap: 14px; padding: 16px; border-radius: 22px; background: var(--ap); color: #fff; }
  .as-save b { font-size: 17px; font-weight: 500; }
  .as-save small { display: flex; align-items: center; gap: 5px; margin-top: 3px; color: rgb(255 255 255 / .75); font-size: 12px; }
  .as-save__ico { width: 52px; height: 52px; border-radius: 99px; display: grid; place-items: center; background: rgb(255 255 255 / .16); }
  .as-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 16px 0; }
  .as-tile { padding: 14px; border-radius: 20px; background: var(--ap-tint); }
  .as-tile i { display: grid; place-items: center; width: 34px; height: 34px; margin-bottom: 10px; border-radius: 10px; background: var(--ap-chip); color: var(--ap); }
  .as-tile b { display: block; color: var(--ap); font-size: 14px; font-weight: 500; }
  .as-rows { list-style: none; margin: 0; padding: 0; border: 1px solid var(--line); border-radius: 16px; background: #fbfbfb; }
  .as-rows li { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-top: 1px solid var(--line); }
  .as-rows li:first-child { border-top: 0; }
  .as-rows em { margin-left: auto; font-style: normal; color: var(--mut); max-width: 140px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .as-foot { position: absolute; left: 18px; right: 18px; bottom: 16px; margin: 0; text-align: center; font-size: 11px; color: var(--hint); }

  /* Inmersión guardada */
  .as-dim { position: absolute; inset: 0; padding: 56px 18px 0; background: #fff; filter: brightness(.55) saturate(.8); }
  .as-dim__title { margin: 6px 0; text-align: center; color: var(--ap); font-size: 18px; }
  .as-sheet { position: absolute; left: 0; right: 0; bottom: 0; padding: 22px 20px 26px; border-radius: 30px 30px 0 0; background: #fff; text-align: center; }
  .as-okdot { display: inline-grid; place-items: center; width: 42px; height: 42px; border-radius: 99px; background: var(--ap-acc); color: #1f294c; animation: as-pop .45s cubic-bezier(.34,1.56,.64,1) both; }
  .as-sheet h4 { margin: 12px 0 14px; font-size: 18px; font-weight: 600; }
  .as-divecard { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 16px; text-align: left; }
  .as-divecard small { display: flex; align-items: center; gap: 4px; margin-top: 4px; font-size: 11px; }
  .as-divecard__ico, .as-dive__ico { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--ap-chip); color: var(--ap); flex: none; }
  .as-dive__ico--warm { background: #fff1e3; color: #d4620a; }
  .as-ask { margin: 14px 0 10px; font-size: 12px; color: var(--mut); }
  .as-sheet .as-btn { height: 40px; margin-top: 8px; font-size: 14px; }

  /* Tarjeta para compartir (tipo Strava) */
  /* share-card: las tarjetas para redes (sticker de Oquea sobre la foto del buceador), una tras otra */
  .as-cards { position: absolute; inset: 0; overflow: hidden; background: #0b2a44; }
  .as-card { position: absolute; inset: 0; background: radial-gradient(ellipse at 30% 20%, #3fb4c9, transparent 55%), linear-gradient(170deg, #1a7a94, #082f4a); background-size: cover; background-position: center; color: #fff; opacity: 0; }
  .as-card:first-child { opacity: 1; }
  /* Las exportadas (600 × 1066): llenan la pantalla, centradas */
  .as-card--png { background-size: cover; background-position: center; }
  .as-card__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(0 0 0 / .1), rgb(0 0 0 / .3) 45%, transparent 75%); }
  .as-stk { position: absolute; left: 24px; right: 24px; top: 92px; display: grid; justify-items: start; gap: 9px; font-family: var(--font-sans, inherit); text-shadow: 0 0 12px rgb(0 0 0 / .55); }
  .as-stk p { margin: 0; }
  .as-stk__loc { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .as-stk__hero { display: flex; align-items: baseline; gap: 10px; line-height: .95; }
  .as-stk__hero b { color: var(--ap-acc); font-size: 56px; font-weight: 700; letter-spacing: -.02em; }
  .as-stk__hero span { color: rgb(255 255 255 / .75); font-size: 14px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .as-stk__hero--xl b { font-size: 66px; } .as-stk__hero--xxl b { font-size: 74px; }
  .as-stk__unit { font-size: 23px !important; font-weight: 400 !important; letter-spacing: 0 !important; text-transform: none !important; color: rgb(255 255 255 / .88) !important; }
  .as-stk__stats { display: flex; gap: 22px; }
  .as-stk__stats span { display: grid; gap: 3px; }
  .as-stk__stats b { font-size: 32px; font-weight: 700; line-height: 1; }
  .as-stk__stats i { margin-left: 4px; font-size: 14px; font-style: normal; }
  .as-stk__stats small { color: rgb(255 255 255 / .65); font-size: 9.5px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .as-stk__stats--hi b { color: var(--ap-acc); }
  .as-stk__life { font-size: 10px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: rgb(255 255 255 / .86); }
  .as-stk__label { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: rgb(255 255 255 / .75); }
  .as-stk__label--hi { color: #fff; }
  .as-stk__sub { font-size: 14px; color: rgb(255 255 255 / .85); }
  .as-stk__title { font-size: 34px; font-weight: 700; line-height: 1.05; letter-spacing: -.01em; }
  .as-stk__foot { display: flex; justify-content: space-between; gap: 10px; width: 100%; font-size: 9.5px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; color: rgb(255 255 255 / .7); }
  .as-stk__chart { display: block; width: 100%; height: 68px; padding: 6px 8px; border-radius: 18px; background: #08182b; color: var(--ap-acc); box-shadow: 0 10px 28px rgb(0 0 0 / .4); }
  .as-stk__chart :global(svg) { display: block; width: 100%; height: 100%; }
  .as-stk__pill { padding: 6px 14px; border-radius: 99px; background: var(--ap-acc); color: #1f294c; font-size: 12px; font-weight: 700; text-shadow: none; }
  .as-stk__tile { display: grid; place-items: center; width: 116px; height: 96px; border-radius: 20px; background: linear-gradient(180deg, #3a5a7c, #1c3350); box-shadow: 0 10px 28px rgb(0 0 0 / .35); }
  .as-stk__tile :global(svg) { width: 92px; }
  .as-stk__tile img { width: 104px; height: auto; filter: drop-shadow(0 4px 8px rgb(0 0 0 / .3)); }
  .as-stk__brand { height: 18px; width: auto; margin-top: 2px; }
  .as-stk__brand--txt { height: auto; font-size: 17px; font-weight: 800; letter-spacing: -.03em; }
  /* Cada tarjeta, con sus datos donde van en las que exporta la app (entrega de Cristian, 10-oct-2026): la inmersión a
     media altura; récord y viaje, arriba; hito y vida marina, abajo. La sombra, solo donde están los datos. */
  /* Un pelín más pequeñas que las de la app (Cristian, 10-oct-2026): el bloque entero al 92 %, desde su esquina. */
  .as-stk { transform: scale(.92); transform-origin: left top; }
  .as-card--dive .as-stk { transform-origin: left center; }
  .as-card--milestone .as-stk, .as-card--species .as-stk { transform-origin: left bottom; }
  .as-stk__brand { filter: drop-shadow(0 2px 6px rgb(0 0 0 / .35)); }
  .as-card--dive .as-stk { top: 40%; }
  .as-card--record .as-stk, .as-card--trip .as-stk { top: 7%; }
  .as-card--milestone .as-stk { top: auto; bottom: 12%; }
  .as-card--species .as-stk { top: auto; bottom: 8%; }
  .as-card--dive .as-card__shade { background: linear-gradient(180deg, transparent 25%, rgb(0 0 0 / .32) 45%, rgb(0 0 0 / .32) 72%, transparent 92%); }
  .as-card--milestone .as-card__shade, .as-card--species .as-card__shade { background: linear-gradient(180deg, transparent 40%, rgb(0 0 0 / .45) 100%); }
  .as-cards__dots { position: absolute; left: 0; right: 0; bottom: 22px; display: flex; justify-content: center; gap: 6px; }
  .as-cards__dots i { width: 6px; height: 6px; border-radius: 99px; background: rgb(255 255 255 / .45); }
  .as-cards__dots i:first-child { background: #fff; }
  /* Una tras otra: cada tarjeta se ve 1/n del ciclo (3,2 s cada una), con la foto acercándose despacio */
  @media (prefers-reduced-motion: no-preference) {
    [data-cards='2'] .as-card { animation: as-cyc-2 6.4s infinite; } [data-cards='2'] .as-cards__dots i { animation: as-dot-2 6.4s infinite; }
    [data-cards='3'] .as-card { animation: as-cyc-3 9.6s infinite; } [data-cards='3'] .as-cards__dots i { animation: as-dot-3 9.6s infinite; }
    [data-cards='4'] .as-card { animation: as-cyc-4 12.8s infinite; } [data-cards='4'] .as-cards__dots i { animation: as-dot-4 12.8s infinite; }
    [data-cards='5'] .as-card { animation: as-cyc-5 16s infinite; } [data-cards='5'] .as-cards__dots i { animation: as-dot-5 16s infinite; }
    [data-cards='6'] .as-card { animation: as-cyc-6 19.2s infinite; } [data-cards='6'] .as-cards__dots i { animation: as-dot-6 19.2s infinite; }
    .as-card, .as-cards__dots i { animation-delay: calc(var(--i) * 3.2s) !important; }
    .as-card:first-child, .as-cards__dots i:first-child { opacity: 0; background: rgb(255 255 255 / .45); }
    .as-card:first-child { animation-delay: 0s; }
  }
  /* Cada tarjeta entra encima de la anterior y la anterior no se va hasta que la nueva está entera (sin el «fundido a oscuro») */
  @keyframes as-cyc-2 { 0% { opacity: 0; } 5%, 54% { opacity: 1; } 55%, 100% { opacity: 0; } }
  @keyframes as-cyc-3 { 0% { opacity: 0; } 3.5%, 36.5% { opacity: 1; } 37.5%, 100% { opacity: 0; } }
  @keyframes as-cyc-4 { 0% { opacity: 0; } 2.5%, 27.5% { opacity: 1; } 28.5%, 100% { opacity: 0; } }
  @keyframes as-cyc-5 { 0% { opacity: 0; } 2%, 22% { opacity: 1; } 23%, 100% { opacity: 0; } }
  @keyframes as-cyc-6 { 0% { opacity: 0; } 2%, 18.6% { opacity: 1; } 19.4%, 100% { opacity: 0; } }
  @keyframes as-dot-6 { 0%, 16% { background: #fff; } 16.7%, 100% { background: rgb(255 255 255 / .45); } }
  @keyframes as-dot-2 { 0%, 49% { background: #fff; } 50%, 100% { background: rgb(255 255 255 / .45); } }
  @keyframes as-dot-3 { 0%, 32% { background: #fff; } 33%, 100% { background: rgb(255 255 255 / .45); } }
  @keyframes as-dot-4 { 0%, 24% { background: #fff; } 25%, 100% { background: rgb(255 255 255 / .45); } }
  @keyframes as-dot-5 { 0%, 19% { background: #fff; } 20%, 100% { background: rgb(255 255 255 / .45); } }

  /* Logbook y perfil */
  .as-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 6px 0 14px; }
  .as-kpis span { padding: 12px 8px; border: 1px solid var(--line); border-radius: 16px; text-align: center; }
  .as-kpis--grey span { border: 0; background: #f8f8f9; }
  .as-kpis b { display: block; font-size: 17px; }
  .as-month { margin: 4px 0 6px; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--hint); }
  .as-dive { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .as-dive__txt { flex: 1; min-width: 0; }
  .as-dive .as-chip { max-width: 110px; overflow: hidden; text-overflow: ellipsis; }
  .as-pcard { display: grid; justify-items: center; gap: 4px; padding: 18px; border-radius: 22px; background: #f8f8f9; text-align: center; }
  .as-pcard p { margin: 6px 0 0; color: var(--mut); font-size: 12px; }
  .as-pcard :global(em) { font-style: normal; font-size: 22px; font-weight: 700; color: var(--ap); margin-right: 4px; }
  .as-avatar { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 99px; background: var(--ap-chip); color: #6b7280; margin-bottom: 6px; }
  .as-avatar--lg { width: 84px; height: 84px; }
  .as-h { display: flex; align-items: center; gap: 8px; margin: 16px 0 10px; font-size: 16px; font-weight: 600; }
  .as-h :global(svg) { color: var(--ap); }
  .as-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .as-stats span { padding: 10px; border-radius: 12px; background: #f8f8f9; }
  .as-stats b { display: block; font-size: 16px; margin-bottom: 4px; }
  .as-stats small { display: flex; align-items: center; gap: 3px; font-size: 10px; }
  .as-link { display: flex; align-items: center; gap: 12px; margin-top: 14px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 18px; color: #555; }
  .as-link > span:nth-child(2) { flex: 1; }
  .as-link__ico { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--ap-tint); color: var(--ap); }

  /* Panel del centro */
  .as-toggle { display: flex; gap: 8px; margin-bottom: 14px; }
  .as-toggle span { padding: 9px 18px; border-radius: 99px; border: 1px solid var(--line); font-size: 14px; font-weight: 500; }
  .as-toggle .on { background: var(--ap); border-color: var(--ap); color: #fff; }
  .as-sec { display: flex; align-items: center; justify-content: space-between; margin: 4px 0 10px; font-weight: 600; font-size: 15px; }
  .as-sec span { display: inline-flex; align-items: center; gap: 8px; }
  .as-sec span :global(svg) { color: var(--ap); }
  .as-sec em { display: inline-flex; align-items: center; gap: 3px; font-style: normal; font-weight: 400; font-size: 13px; color: var(--ap); }
  .as-sec--line { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--line); }
  .as-acard { margin-bottom: 10px; padding: 12px 14px; border: 1px solid var(--line); border-left: 4px solid var(--ap); border-radius: 16px; }
  .as-acard__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: 16px; }
  .as-acard__clip { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; background: var(--ap-tint); color: var(--ap); }
  .as-acard .as-chip { border: 1px solid color-mix(in srgb, var(--ap) 30%, #fff); }
  .as-acard__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 10px; margin-top: 10px; color: #555; font-size: 13px; }
  .as-acard__grid span { display: inline-flex; align-items: center; gap: 6px; }
  .as-acard__actions { display: flex; align-items: center; gap: 14px; margin: 10px -14px 0; padding: 10px 14px 0; border-top: 1px solid var(--line); }
  .as-danger { color: #e53935; font-size: 13px; }
  .as-next { display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; border-left: 4px solid color-mix(in srgb, var(--ap) 45%, #fff); border-radius: 12px; background: #fbfbfb; }
  .as-next em { font-style: normal; padding: 5px 10px; border-radius: 10px; background: var(--ap-tint); color: var(--ap); font-weight: 600; font-size: 13px; }
  .as-progress { display: block; height: 3px; margin: 0 -18px 18px; background: #eef0f4; }
  .as-progress i { display: block; height: 100%; background: var(--ap); }
  .as-form { display: grid; gap: 12px; }
  .as-field { display: flex; align-items: center; justify-content: space-between; height: 50px; padding: 0 14px; border-radius: 12px; background: #f6f7f9; color: var(--hint); }
  .as-field--filled { color: var(--ink); }
  .as-field :global(svg) { color: #666; }

  .as-qr { display: grid; place-items: center; margin: 6px 20px 12px; padding: 18px; border-radius: 22px; background: var(--ap-tint); }
  .as-qr__code { position: relative; display: block; width: 200px; padding: 10px; border-radius: 8px; background: #fff; color: #111; }
  .as-qr__iso { position: absolute; top: 50%; left: 50%; width: 30px; height: 22px; margin: -11px 0 0 -15px; border-radius: 6px; background: radial-gradient(circle at 30% 50%, var(--ap) 0 5px, transparent 6px), radial-gradient(circle at 70% 50%, var(--ap) 0 9px, transparent 10px), #fff; }
  .as-qr__txt { margin: 0 6px; text-align: center; font-size: 13px; color: #333; }
  .as-qr__btns { display: flex; justify-content: center; gap: 10px; margin: 14px 0 12px; }
  .as-list { margin: 0 -18px; border-top: 6px solid #f3f4f6; }
  .as-list span { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; border-bottom: 1px solid var(--line); color: #444; }

  .as-search { display: flex; align-items: center; gap: 8px; height: 42px; padding: 0 14px; border-radius: 99px; background: #f6f7f9; color: var(--hint); }
  .as-count { margin: 12px 0 6px; color: var(--mut); font-size: 13px; }
  .as-count :global(b) { color: var(--ink); }
  .as-person { display: flex; align-items: center; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--line); }
  .as-person__txt { flex: 1; min-width: 0; }
  .as-ini { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--ap-tint); color: var(--ap); font-weight: 700; font-size: 14px; flex: none; }
  .as-ini--sm { width: 32px; height: 32px; border-radius: 99px; font-size: 12px; }
  .as-diver { display: grid; justify-items: center; gap: 6px; text-align: center; }
  .as-diver b { font-size: 22px; }
  .as-band { height: 6px; margin: 14px -18px 0; background: #f3f4f6; }
  .as-hist { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .as-hist small { display: flex; align-items: center; gap: 6px; margin-top: 3px; }
  .as-label { margin: 8px 0 8px; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--mut); }
  .as-ccard { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; padding: 14px; border: 1px solid var(--line); border-radius: 18px; background: #fbfbfb; }
  .as-ccard > span:nth-child(2) { flex: 1; min-width: 0; }
  .as-ccard b { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .as-ccard__ico { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--ap-chip); color: var(--ap); overflow: hidden; }
  .as-ccard__ico :global(img) { width: 100%; height: 100%; object-fit: contain; background: #fff; }
  .as-dashed { display: flex; align-items: center; justify-content: center; gap: 8px; height: 46px; margin: 6px 0 18px; border: 1.5px dashed color-mix(in srgb, var(--ap) 40%, #fff); border-radius: 16px; background: var(--ap-tint); color: var(--ap); }
  .as-muted { margin: 0; color: var(--hint); font-size: 13px; }
  .as-member { margin-bottom: 10px; padding: 12px; border-radius: 16px; background: #f8f8f9; }
  .as-member__head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .as-member__head .as-chip { margin-left: auto; }
  .as-member__btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

  /* Acceso */
  .as-screen--access { padding: 0; }
  .as-access { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; gap: 12px; padding: 0 26px 30px; color: #fff; background: linear-gradient(180deg, #2b7e96, #0b3b55 70%, #08263a); background-size: cover; background-position: center; }
  .as-access::before { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(0 0 0 / .15), transparent 35%, rgb(0 0 0 / .55)); }
  .as-access__copy, .as-access__btn, .as-access__legal { position: relative; }
  .as-access__bars { position: absolute; top: 60px; left: 26px; right: 26px; display: flex; gap: 6px; }
  .as-access__bars i { flex: 1; height: 3px; border-radius: 99px; background: rgb(255 255 255 / .35); }
  .as-access__bars i.on { background: var(--ap); }
  .as-access__logo { position: absolute; top: 78px; left: 26px; font-weight: 800; font-size: 18px; letter-spacing: -.02em; }
  .as-access__copy { margin-bottom: 20px; }
  .as-access__copy b { display: block; font-size: 22px; font-weight: 600; }
  .as-access__copy span { font-size: 16px; opacity: .9; }
  .as-access__btn { display: flex; align-items: center; justify-content: center; gap: 10px; height: 50px; border-radius: 99px; background: #fff; color: #333; font-size: 15px; }
  .as-g { font-weight: 800; color: #ea4335; }
  .as-access__legal { margin-top: 4px; text-align: center; color: rgb(255 255 255 / .8); font-size: 10px; }
  /* Dive sites */
  .as-site { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; padding: 12px; border: 1px solid var(--line); border-radius: 16px; }
  .as-site__txt { flex: 1; min-width: 0; }
  .as-site__ico { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--ap-tint); color: var(--ap); }
  .as-site__add { width: max-content; margin-top: 6px; }
  /* Crear inmersión: datos del punto */
  .as-preset { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding: 12px; border-radius: 16px; background: var(--ap-tint); }
  .as-preset small { grid-column: 1 / -1; color: var(--ap); font-weight: 600; }
  .as-preset span { display: grid; gap: 2px; }
  .as-preset i { font-style: normal; font-size: 11px; color: var(--mut); }
  .as-preset__life { grid-column: 1 / -1; }
  /* Mapa, perfil y evento */
  .as-screen--map, .as-screen--event { padding: 0; }
  .as-map { position: absolute; inset: 0; }
  .as-map__sea { position: absolute; inset: 0; background:
    radial-gradient(ellipse 38% 26% at 18% 78%, #e9eedb 98%, transparent), radial-gradient(ellipse 30% 40% at 92% 20%, #e9eedb 98%, transparent),
    radial-gradient(circle at 50% 40%, #cfe6f3, #a9d3ea 70%); }
  .as-pin { position: absolute; width: 16px; height: 16px; margin: -8px 0 0 -8px; border-radius: 99px; border: 3px solid #fff; background: #5585dc; }
  .as-pin--center { background: var(--ap); }
  .as-pin--ngo { background: #2e9e6b; }
  .as-pin--me { display: grid; place-items: center; width: 34px; height: 34px; margin: -17px 0 0 -17px; background: var(--ap); color: #fff; box-shadow: 0 0 0 6px color-mix(in srgb, var(--ap) 25%, transparent); }
  .as-map__search { position: absolute; top: 58px; left: 16px; right: 16px; display: flex; align-items: center; gap: 8px; height: 42px; padding: 0 14px; border-radius: 99px; background: #fff; color: var(--hint); font-size: 13px; }
  .as-map__legend { position: absolute; top: 110px; left: 16px; display: flex; gap: 6px; }
  .as-map__legend span { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 99px; background: #fff; font-size: 11px; }
  .as-dot { width: 8px; height: 8px; border-radius: 99px; background: #5585dc; }
  .as-dot--center { background: var(--ap); }
  .as-dot--ngo { background: #2e9e6b; }
  .as-ficha { position: absolute; left: 12px; right: 12px; bottom: 16px; display: grid; gap: 10px; padding: 16px; border-radius: 22px; background: #fff; }
  .as-ficha__head { display: flex; align-items: center; gap: 12px; }
  .as-ficha__head small, .as-ficha > small { display: flex; align-items: center; gap: 4px; }
  .as-ficha__chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .as-ficha__rows { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .as-ficha__rows span { display: flex; align-items: center; justify-content: center; gap: 5px; padding: 8px; border-radius: 12px; background: #f6f7f9; font-size: 12px; color: #444; }
  .as-ficha__rows--col { grid-template-columns: 1fr; }
  .as-ficha__rows--col span { justify-content: flex-start; }
  .as-ficha__rows em { margin-left: auto; font-style: normal; color: var(--ap); font-size: 11px; }
  .as-ficha__title { font-size: 18px; }
  .as-ficha .as-chip { width: max-content; }
  /* Insignia */
  .as-badge { display: grid; justify-items: center; gap: 8px; margin: 24px 0 18px; padding: 26px 18px; border-radius: 24px; background: var(--ap-tint); text-align: center; }
  .as-badge__medal { display: grid; place-items: center; width: 110px; height: 110px; border-radius: 99px; background: var(--ap); color: #fff; box-shadow: 0 0 0 8px var(--ap-acc); margin-bottom: 10px; }
  .as-badge b { font-size: 22px; }
  .as-badge p { margin: 6px 0 0; color: var(--mut); font-size: 13px; }
  .as-list--flat { border-top: 0; margin: 0; }
  .as-list--flat span { justify-content: flex-start; gap: 10px; border: 1px solid var(--line); border-radius: 14px; margin-bottom: 8px; }
  /* Álbum */
  .as-album__meta { display: flex; align-items: center; gap: 5px; margin: 0 0 12px; color: var(--mut); font-size: 12px; }
  .as-album { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
  .as-album__ph { aspect-ratio: 1; border-radius: 8px; background-color: #2b7e96; background-image: linear-gradient(160deg, #3fb4c9, #0d4a6b); background-size: 300% 300%; }
  @keyframes as-pop { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .as-okdot { animation: none; } }

  /* Logbook público (el que ve el buceador): tarjetas por inmersión con foto o mapa del punto */
  .lb-head { display: flex; align-items: center; gap: 8px; height: 40px; margin-bottom: 10px; }
  .lb-head b { flex: 1; font-size: 16px; }
  .lb-head .as-iso { width: 28px; height: 16px; background: radial-gradient(circle at 30% 50%, var(--ap-navy) 0 7px, transparent 7.5px), radial-gradient(circle at 62% 50%, var(--ap) 0 7px, transparent 7.5px); }
  .lb-qr { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 99px; background: var(--ap-chip); color: var(--ap); }
  .lb-add { display: inline-flex; align-items: center; gap: 6px; padding: 9px 14px; border-radius: 99px; background: var(--ap); color: #fff; font-size: 13px; }
  .lb-tools { display: flex; gap: 8px; margin-bottom: 10px; }
  .lb-search { flex: 1; display: flex; align-items: center; gap: 6px; min-width: 0; padding: 9px 12px; border-radius: 99px; background: #f5f6f8; color: #8a8f9c; font-size: 11.5px; white-space: nowrap; overflow: hidden; }
  .lb-view { display: flex; gap: 2px; padding: 4px; border-radius: 99px; background: #f5f6f8; }
  .lb-view i { display: grid; place-items: center; width: 30px; border-radius: 99px; color: #8a8f9c; }
  .lb-view i.on { background: #fff; color: var(--ap); }
  .lb-years { display: flex; gap: 8px; margin-bottom: 12px; }
  .lb-years span { padding: 7px 13px; border-radius: 99px; background: #f5f6f8; color: #464646; font-size: 13px; }
  .lb-years .on { background: var(--ap-navy); color: #fff; }
  .lb-year { display: flex; align-items: center; gap: 8px; margin: 0 0 10px; font-size: 13px; color: var(--ap-navy); }
  .lb-year i { flex: 1; height: 1px; background: #efefef; }
  .lb-year small { color: #8a8f9c; font-size: 11px; }
  .lb-card { display: grid; gap: 10px; margin-bottom: 12px; padding: 14px; border: 1px solid #ececec; border-radius: 20px; }
  .lb-card__top { display: flex; gap: 12px; }
  .lb-num { display: grid; place-items: center; align-content: center; width: 50px; height: 50px; flex: none; border-radius: 12px; background: var(--ap-navy); color: #fff; }
  .lb-num small { font-size: 7.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: rgb(255 255 255 / .6); }
  .lb-num b { font-size: 20px; line-height: 1; }
  .lb-card__txt { display: grid; gap: 6px; min-width: 0; }
  .lb-card__txt > b { font-size: 15px; }
  .lb-card__txt > small { color: #8a8f9c; font-size: 11.5px; }
  .lb-chips { display: flex; flex-wrap: wrap; gap: 5px; }
  .lb-chip { padding: 3px 8px; border-radius: 10px; background: #f5f6f8; color: #464646; font-size: 9.5px; font-weight: 700; font-style: normal; white-space: nowrap; max-width: 150px; overflow: hidden; text-overflow: ellipsis; }
  .lb-chip--acc { background: var(--ap-acc); color: var(--ap-navy); }
  .lb-chip--blue { background: var(--ap-chip); color: var(--ap); }
  .lb-pic { position: relative; height: 128px; border-radius: 12px; background-size: cover; background-position: center; }
  .lb-pic__badge { position: absolute; top: 8px; right: 8px; display: grid; place-items: center; width: 40px; height: 38px; border-radius: 14px; background: rgb(255 255 255 / .94); color: var(--ap-navy); }
  .lb-share { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 9px; border-radius: 99px; background: var(--ap-tint); color: var(--ap); font-size: 13px; }
  .lb-map { position: relative; height: 128px; overflow: hidden; border-radius: 12px; background: #dceaf9; }
  .lb-map { background: linear-gradient(180deg, #e9f1dc 0 32%, #dceaf9 32%); }
  .lb-map__one { position: absolute; left: 50%; top: 22%; width: 40px; height: 54px; margin-left: -20px; }
  .lb-map__one :global(svg) { width: 100%; height: 100%; }
  .lb-map__land { position: absolute; left: -10px; right: -10px; top: -8px; height: 46px; border-radius: 0 0 40% 60%; background: #e9f1dc; }
