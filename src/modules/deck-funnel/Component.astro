---
/** deck-funnel ← embudo que se estrecha al verse; cada nivel con su cifra, su texto y su fuente (al pasar el ratón). */
import "../deck/deck.css";
import Section from "~/components/Section.astro";
import Rich from "../deck/Rich.astro";
import Count from "../deck/Count.astro";
import { interpolate } from "../resolve";
import type { ModuleBaseProps } from "../types";
import type { DeckFunnelProps } from './schema';

type Props = DeckFunnelProps & ModuleBaseProps;
const { eyebrow, title, lede, levels, band, ctx } = Astro.props;
const t = (s: string) => interpolate(s, ctx);
const n = levels.length;
---
<div data-module="deck-funnel" class="relative overflow-hidden">
  <Section>
    {eyebrow && <p class="deck-eyebrow deck-in">{t(eyebrow)}</p>}
    <h2 class="deck-title deck-in max-w-5xl !text-[clamp(1.9rem,min(4.2vw,7vh),3.6rem)]" style="--d:80ms"><Rich text={t(title)} /></h2>
    {lede && <p class="deck-lede deck-in" style="--d:140ms"><Rich text={t(lede)} /></p>}
    <ol class="m-0 mt-[clamp(1.25rem,4vh,2.5rem)] grid list-none gap-2 p-0">
      {levels.map((l, i) => (
        <li class="fn-level deck-in grid items-center gap-x-6 gap-y-1 md:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]" style={`--d:${220 + i * 160}ms;--w:${100 - (i * 55) / Math.max(1, n - 1)}%`} data-testid="funnel-level" title={l.source ? t(l.source) : undefined}>
          <div class="fn-bar flex items-center gap-4 rounded-2xl px-5 py-3">
            <span class="deck-figure shrink-0 !text-[clamp(1.6rem,3.2vw,2.8rem)]"><Count value={t(l.value)} /></span>
            <span class="min-w-0 text-sm font-bold leading-tight">{t(l.label)}</span>
          </div>
          {(l.text || l.source) && <p class="m-0 text-sm text-muted">{l.text && <Rich text={t(l.text)} />}{l.source && <span class="fn-src block text-xs opacity-70">{t(l.source)}</span>}</p>}
        </li>
      ))}
    </ol>
    {band && <p class="deck-callout deck-in m-0 mt-6 text-center" style={`--d:${300 + n * 160}ms`}><Rich text={t(band)} /></p>}
  </Section>
</div>

<style>
  .fn-bar { width: 0; min-width: min(100%, 21rem); overflow: hidden; background: linear-gradient(90deg, rgb(var(--color-primary) / .9), rgb(var(--color-primary) / .35)); color: rgb(var(--color-primary-contrast, 255 255 255));
    transition: width 1100ms var(--ease-out, ease-out) var(--d, 0ms); }
  .fn-level:last-child .fn-bar { background: linear-gradient(90deg, rgb(var(--color-accent)), rgb(var(--color-accent) / .5)); color: rgb(var(--color-accent-contrast, 13 13 13)); }
  [data-revealed] .fn-bar { width: var(--w); }
  .fn-src { max-height: 0; overflow: hidden; transition: max-height .3s; }
  .fn-level:hover .fn-src, .fn-level:focus-within .fn-src { max-height: 4rem; }
  @media (hover: none) { .fn-src { max-height: none; } }
  @media (prefers-reduced-motion: reduce) { .fn-bar { width: var(--w); transition: none; } }
</style>

<script>
  import { mountAll } from '../runtime';
  import { init } from '../deck/client';
  mountAll('deck-funnel', init);
</script>
