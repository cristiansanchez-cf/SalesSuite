---
/**
 * La app de la consola del centro (Oquea), a tamaño de diseño (1180 × 640; 720 de ancho en compacto), escalada con --s
 * desde arriba a la izquierda. La usan la diapositiva (Component.astro, interactiva) y la miniatura (ConsoleMini.astro).
 * Clara siempre, como la app; el azul sale de --color-primary del tema.
 */
import { APP_ICONS, MASK_ICON } from '../app-steps/icons';
import { fakeQr } from '../app-steps/qr';
import type { CenterConsoleProps } from './schema';
import { APP_TEXT, appLang } from '../app-steps/app-text';
import { requestLocale } from '~/lib/i18n/request';

interface Props { first: CenterConsoleProps['views'][number]['view']; sample: CenterConsoleProps['sample']; center: string; logo?: string | null; compact?: boolean; locale?: string }
const { first, sample: s, center, logo = null, compact = false } = Astro.props;
const L = APP_TEXT[appLang(Astro.props.locale ?? requestLocale())];
const ic = (n: keyof typeof APP_ICONS, size = 20) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${APP_ICONS[n]}</svg>`;
const mask = (size = 20) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${MASK_ICON}</svg>`;
const initials = (n: string) => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join('');

const NAV = [
  ['today', 'calendar', L.activities, '4'], ['cal', 'calendar', L.calendar, ''], ['crm', 'users', L.tabCrm, s.divers],
  ['sites', 'pin', L.diveSitesNav, ''], ['centre', 'home', L.myCentre, ''], ['team', 'user', L.team, ''],
] as const;
const navFor = (v: string) => (v === 'activity' ? 'today' : v);
const DIVERS = [
  ['Laura Méndez', 'Advanced Open Water', '42', 'qr', '09:30'], ['Tomás Ferreira', 'Open Water', '8', 'qr', '09:31'],
  ['Marta Ruiz', 'Divemaster', '310', 'hand', ''], ['Kenji Sato', 'Rescue Diver', '57', 'qr', '09:34'],
] as const;
---
  <div class:list={['cc-app', compact && 'is-compact']} data-app aria-hidden="true">
    <aside class="cc-side">
      <div class="cc-logo"><span class="cc-iso"></span>oquea</div>
      <div class="cc-mode"><span class="on">{L.modeManage}</span><span>{L.modeDiver}</span></div>
      <nav class="cc-nav">
        {NAV.map(([k, i, l, b]) => (
          <span class:list={['cc-nav__item', navFor(first) === k && 'is-on']} data-nav={k}><Fragment set:html={ic(i)} />{l}{b && <em>{b}</em>}</span>
        ))}
      </nav>
      <div class="cc-side__bottom">
        <span class="cc-ctx">{logo ? <img src={logo} alt="" /> : <b class="cc-av">{initials(center)}</b>}<span><b>{center}</b><small>{L.activeCentre}</small></span></span>
        <span class="cc-ctx"><b class="cc-av">{initials(s.owner)}</b><span><b>{s.owner}</b><small>{L.owner}</small></span></span>
      </div>
    </aside>

    <main class="cc-main">
      <!-- Actividades de hoy -->
      <section class:list={['cc-view', first === 'today' && 'is-on']} data-view="today">
        <header class="cc-head">
          <div><h3>{L.todayActivities}</h3><p>{center} · {L.tripsScheduled}</p></div>
          <span class="cc-btn cc-btn--ghost">{L.seeCentreQr}</span><span class="cc-btn">{L.createActivity}</span>
        </header>
        <div class="cc-grid">
          <div class="cc-card cc-stat"><b>{s.divers}</b><small>{L.statDivers}</small></div>
          <div class="cc-card cc-stat"><b>{s.dives}</b><small>{L.statDives}</small></div>
          <div class="cc-card cc-stat"><b>{L.outOf(5, 6)}</b><small>{L.profileComplete}</small><span class="cc-bar"><i style="width:83%"></i></span></div>
        </div>
        <div class="cc-acts">
          {[[L.boatFunDive, '09:00', s.site, '6'], ['Discover Scuba Diving', '11:30', L.centreBeach, '4'], [L.nightFunDive, '20:00', 'Shark Point', '3']].map(([n, h, site, cap], i) => (
            <div class:list={['cc-card cc-act', i === 0 && 'is-hot']}>
              <span class="cc-act__ico" set:html={mask(22)} />
              <span class="cc-act__txt"><b>{n}</b><small>{h} · {site}</small></span>
              <span class="cc-chip">{L.diversN(cap!)}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Detalle de actividad: participantes -->
      <section class:list={['cc-view', first === 'activity' && 'is-on']} data-view="activity">
        <header class="cc-head">
          <div><p class="cc-crumb">{L.activities} › {L.boatTrip}</p><h3>{L.boatTrip} · 09:00</h3><p>{s.site} · {L.participantsN(6)}</p></div>
          <span class="cc-btn cc-btn--ghost">{L.edit}</span><span class="cc-btn">{L.addParticipant}</span>
        </header>
        <div class="cc-split">
          <div>
            <p class="cc-sec">{L.participants}</p>
            <div class="cc-list">
              {DIVERS.map(([n, l, d, how, h]) => (
                <div class="cc-card cc-row">
                  <b class="cc-pic">{initials(n)}</b>
                  <span><b>{n}</b><small>{l} · {L.divesN(d)}</small></span>
                  <span class="cc-row__meta"><span class:list={['cc-chip', how === 'hand' && 'cc-chip--grey']}>{how === 'qr' ? L.scannedQr : L.addedByHand}</span><small>{how === 'qr' ? `${s.site} · ${h}` : L.noAccount}</small></span>
                </div>
              ))}
            </div>
          </div>
          <aside class="cc-card cc-aside">
            <p class="cc-sec">{L.today}</p>
            <div class="cc-kv"><span>{L.scannedQrPl}</span><b>5</b></div>
            <div class="cc-kv"><span>{L.addedByHandPl}</span><b>1</b></div>
          </aside>
        </div>
      </section>

      <!-- CRM -->
      <section class:list={['cc-view', first === 'crm' && 'is-on']} data-view="crm">
        <header class="cc-head">
          <div><h3>{L.tabCrm}</h3><p>{L.diversVisited(s.divers, center)}</p></div>
          <span class="cc-search"><Fragment set:html={ic('search', 16)} />{L.searchDiver}</span>
        </header>
        <div class="cc-split">
          <div class="cc-list">
            {DIVERS.map(([n, l, d, how], i) => (
              <div class:list={['cc-card cc-row', i === 0 && 'is-sel']}>
                <b class="cc-pic">{initials(n)}</b>
                <span><b>{n}</b><small>{l} · {L.divesN(d)}</small></span>
                <span class="cc-row__meta"><span class:list={['cc-chip', how === 'hand' && 'cc-chip--grey']}>{how === 'qr' ? L.scannedQr : L.addedByHand}</span></span>
              </div>
            ))}
          </div>
          <aside class="cc-card cc-aside cc-profile">
            <b class="cc-pic cc-pic--lg">LM</b>
            <b class="cc-profile__name">Laura Méndez</b>
            <span class="cc-chip"><Fragment set:html={ic('shield', 12)} />Advanced Open Water</span>
            <div class="cc-kv"><span>{L.divesHere}</span><b>8</b></div>
            <div class="cc-kv"><span>{L.first}</span><b>{L.firstDate}</b></div>
            <div class="cc-kv"><span>{L.last}</span><b>{L.lastDate}</b></div>
          </aside>
        </div>
      </section>

      <!-- Mi centro -->
      <section class:list={['cc-view', first === 'centre' && 'is-on']} data-view="centre">
        <header class="cc-head">
          <div><h3>{center}</h3><p>{L.myCentrePublic}</p></div>
          <span class="cc-btn cc-btn--ghost">{L.howDiversSeeYou}</span><span class="cc-btn">{L.editDetails}</span>
        </header>
        <div class="cc-split">
          <div class="cc-grid cc-grid--2">
            <div class="cc-card cc-qrcard"><span class="cc-qr" set:html={fakeQr(center)} /><span><b>{L.uniqueQr}</b><small>{L.qrWhere}</small><span class="cc-mini"><span class="cc-btn cc-btn--sm">{L.download}</span><span class="cc-btn cc-btn--sm cc-btn--ghost">{L.shareLink}</span></span></span></div>
            <div class="cc-card cc-stat"><b>{L.outOf(5, 6)}</b><small>{L.profileComplete}</small><span class="cc-bar"><i style="width:83%"></i></span></div>
            <div class="cc-card cc-tile"><Fragment set:html={ic('pin')} /><span><b>{L.diveSites}</b><small>{L.sitesMore(s.site)}</small></span></div>
            <div class="cc-card cc-tile"><Fragment set:html={ic('users')} /><span><b>{L.team}</b><small>{L.staff}</small></span></div>
            <div class="cc-card cc-tile"><Fragment set:html={ic('globe')} /><span><b>{L.languages}</b><small>Español · English · Português</small></span></div>
            <div class="cc-card cc-tile"><Fragment set:html={ic('ruler')} /><span><b>{L.units}</b><small>{L.unitList}</small></span></div>
          </div>
          <aside class="cc-card cc-aside">
            <p class="cc-sec">{L.howDiversSeeYou}</p>
            {L.profileChecklist.map((x) => <div class="cc-kv"><span>{x}</span><Fragment set:html={ic('check', 16)} /></div>)}
          </aside>
        </div>
      </section>
    </main>
  </div>

<style>
  .cc-app { --cp: rgb(var(--color-primary, 55 87 190)); --cp-tint: color-mix(in srgb, var(--cp) 7%, #fff); --cp-chip: color-mix(in srgb, var(--cp) 11%, #fff); font-family: var(--font-sans, inherit); }
  /* La app, a tamaño de diseño (1180 × 720) y escalada desde arriba a la izquierda ---- */
  .cc-app { --ink: #1f294c; --mut: #6b7280; --hint: #8a8f9a; --line: #e6e8ee; --div: #eeeef2; --grey: #f4f6fa;
    position: absolute; top: 0; left: 0; width: 1180px; height: 640px; display: flex; transform: scale(var(--s, .55)); transform-origin: 0 0;
    color: var(--ink); font-size: 14px; line-height: 1.3; background: #fff; text-align: left; }
  .cc-app b { font-weight: 700; }
  .cc-app small { display: block; font-size: 12px; color: var(--mut); }
  .cc-side { width: 264px; flex: none; display: flex; flex-direction: column; padding: 16px; border-right: 1px solid var(--div); }
  .cc-logo { display: flex; align-items: center; gap: 8px; font-weight: 800; font-size: 20px; letter-spacing: -.02em; }
  .cc-iso { width: 26px; height: 20px; background: radial-gradient(circle at 30% 50%, var(--cp) 0 4px, transparent 5px), radial-gradient(circle at 70% 50%, var(--cp) 0 9px, transparent 10px); }
  .cc-mode { display: flex; gap: 4px; margin-top: 20px; padding: 4px; border-radius: 99px; background: var(--grey); }
  .cc-mode span { flex: 1; padding: 8px 10px; border-radius: 99px; text-align: center; color: var(--hint); font-size: 13px; }
  .cc-mode .on { background: #fff; color: var(--ink); font-weight: 600; }
  .cc-nav { margin-top: 20px; }
  .cc-nav__item { display: flex; align-items: center; gap: 12px; padding: 12px; margin-bottom: 4px; border-radius: 99px; color: #7c7c7c; font-weight: 500; transition: background .25s, color .25s; }
  .cc-nav__item em { margin-left: auto; padding: 2px 8px; border-radius: 99px; background: var(--cp-chip); color: var(--cp); font-style: normal; font-size: 11px; font-weight: 700; }
  .cc-nav__item.is-on { background: var(--cp-tint); color: var(--cp); font-weight: 600; }
  .cc-side__bottom { margin-top: auto; }
  .cc-ctx { display: flex; align-items: center; gap: 10px; margin-top: 8px; padding: 10px; border: 1px solid var(--line); border-radius: 12px; }
  .cc-ctx b:not(.cc-av) { display: block; font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 160px; }
  .cc-ctx small { font-size: 11px; color: var(--hint); }
  .cc-ctx img { width: 36px; height: 36px; border-radius: 99px; object-fit: contain; border: 1px solid var(--line); }
  .cc-av { display: grid; place-items: center; width: 36px; height: 36px; flex: none; border-radius: 99px; background: var(--cp-chip); color: var(--cp); font-weight: 800; font-size: 13px; }

  .cc-main { flex: 1; min-width: 0; position: relative; }
  .cc-view { position: absolute; inset: 0; padding: 24px 28px; opacity: 0; transform: translateY(6px); transition: opacity .25s cubic-bezier(.4,0,.2,1), transform .25s cubic-bezier(.4,0,.2,1); pointer-events: none; }
  .cc-view.is-on { opacity: 1; transform: none; }
  .cc-head { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 22px; }
  .cc-head > div { margin-right: auto; }
  .cc-head h3 { margin: 0; font-size: 22px; font-weight: 800; line-height: 1.15; }
  .cc-head p { margin: 4px 0 0; color: var(--mut); font-size: 13px; }
  .cc-head .cc-crumb { margin: 0 0 6px; color: var(--hint); font-size: 12px; }
  .cc-btn { display: inline-flex; align-items: center; padding: 10px 18px; border-radius: 99px; background: var(--cp); color: #fff; font-size: 13px; font-weight: 600; white-space: nowrap; }
  .cc-btn--ghost { background: #fff; color: var(--ink); border: 1px solid var(--line); }
  .cc-btn--sm { padding: 6px 12px; font-size: 12px; }
  .cc-search { display: inline-flex; align-items: center; gap: 8px; width: 280px; padding: 10px 14px; border-radius: 99px; background: var(--grey); color: var(--hint); font-size: 13px; }
  .cc-card { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 18px; }
  .cc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 22px; }
  .cc-grid--2 { grid-template-columns: repeat(2, 1fr); margin: 0; align-content: start; }
  .cc-stat b { display: block; font-size: 22px; font-weight: 800; }
  .cc-bar { display: block; height: 6px; margin-top: 10px; border-radius: 99px; background: #e8eef8; overflow: hidden; }
  .cc-bar i { display: block; height: 100%; border-radius: 99px; background: var(--cp); }
  .cc-acts { display: grid; gap: 12px; }
  .cc-act { display: flex; align-items: center; gap: 14px; padding: 14px 16px; }
  .cc-act.is-hot { border-color: color-mix(in srgb, var(--cp) 45%, #fff); }
  .cc-act__ico { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--cp-chip); color: var(--cp); }
  .cc-act__txt { flex: 1; }
  .cc-chip { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 99px; background: #eaf0fb; color: var(--cp); font-size: 11px; font-weight: 700; white-space: nowrap; }
  .cc-chip--grey { background: var(--grey); color: var(--mut); }
  .cc-split { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 16px; align-items: start; }
  .cc-sec { margin: 0 0 12px; font-size: 14px; font-weight: 800; }
  .cc-sec--sm { margin: 14px 0 6px; }
  .cc-list { display: grid; gap: 10px; }
  .cc-row { display: flex; align-items: center; gap: 14px; padding: 12px 16px; }
  .cc-row.is-sel { border-color: var(--cp); }
  .cc-row > span:nth-child(2) { flex: 1; min-width: 0; }
  .cc-row b:not(.cc-pic) { display: block; font-size: 14px; font-weight: 600; }
  .cc-row__meta { display: grid; justify-items: end; gap: 4px; }
  .cc-pic { display: grid; place-items: center; width: 44px; height: 44px; flex: none; border-radius: 12px; background: #eaf0fb; color: var(--cp); font-size: 14px; }
  .cc-pic--lg { width: 64px; height: 64px; border-radius: 99px; font-size: 20px; }
  .cc-aside { display: grid; gap: 10px; }
  .cc-kv { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--div); font-size: 13px; color: var(--mut); }
  .cc-kv b { color: var(--ink); }
  .cc-kv :global(svg) { color: var(--cp); }
  .cc-profile { justify-items: center; text-align: center; }
  .cc-profile .cc-kv { width: 100%; }
  .cc-profile__name { font-size: 18px; }
  .cc-profile .cc-sec { justify-self: start; }
  .cc-qrcard { grid-column: 1 / -1; display: flex; gap: 18px; align-items: center; }
  .cc-qr { width: 96px; height: 96px; flex: none; padding: 6px; border-radius: 10px; border: 1px solid var(--line); color: #111; }
  .cc-mini { display: flex; gap: 8px; margin-top: 10px; }
  .cc-tile { display: flex; align-items: center; gap: 12px; padding: 14px 16px; color: var(--cp); }
  .cc-tile b { color: var(--ink); display: block; }

  /* Compacto (pantallas estrechas): sin lateral, como la app por debajo de 1024 */
  .cc-app.is-compact { width: 720px; }
  .cc-app.is-compact .cc-side { display: none; }
  .cc-app.is-compact .cc-view { padding: 18px; }
  .cc-app.is-compact .cc-split { grid-template-columns: 1fr; }
  .cc-app.is-compact .cc-split > aside { display: none; }
  .cc-app.is-compact .cc-grid { grid-template-columns: repeat(3, 1fr); }
  .cc-app.is-compact .cc-head .cc-btn--ghost, .cc-app.is-compact .cc-search { display: none; }

  @media (prefers-reduced-motion: reduce) { .cc-view { transition: none; transform: none; } }
</style>
