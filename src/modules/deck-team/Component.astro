---
/** deck-team ← personas en tarjetas: etiqueta, nombre, organización y unas líneas; una resaltada y una nota al pie. */
import "../deck/deck.css";
import Section from "~/components/Section.astro";
import Rich from "../deck/Rich.astro";
import Count from "../deck/Count.astro";
import { interpolate } from "../resolve";
import type { ModuleBaseProps } from "../types";
import type { DeckTeamProps } from './schema';

type Props = DeckTeamProps & ModuleBaseProps;
const { eyebrow, title, lede, people, note, stats, statsTitle, lines, ctx } = Astro.props;
const t = (s: string) => interpolate(s, ctx);
const initials = (n: string) => n.split(/\s+/).filter(Boolean).slice(0, 2).map((x) => x[0]!.toUpperCase()).join('');
const cols = people.length >= 4 && people.length % 3 !== 0 ? 'md:grid-cols-2' : people.length >= 3 ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-2';
---
<div data-module="deck-team" class="relative overflow-hidden">
  <Section>
    {eyebrow && <p class="deck-eyebrow deck-in">{t(eyebrow)}</p>}
    <h2 class="deck-title deck-in max-w-5xl" style="--d:80ms"><Rich text={t(title)} /></h2>
    {lede && <p class="deck-lede deck-in" style="--d:140ms"><Rich text={t(lede)} /></p>}
    <div class:list={['mt-[clamp(1.25rem,4vh,2.5rem)] grid gap-4', cols]}>
      {people.map((p, i) => (
        <div class:list={['deck-card deck-in grid content-start gap-3', p.featured ? 'deck-card--featured deck-card--line' : '']} style={`--d:${200 + i * 90}ms`} data-testid="deck-person">
          <div class="flex items-start justify-between gap-4">
            <div class="grid gap-3">
              {p.tag && <span class:list={['deck-tag w-fit', p.featured && 'deck-tag--primary']}>{t(p.tag)}</span>}
              <p class="m-0 font-display text-[clamp(1.3rem,2.2vw,1.75rem)] font-extrabold leading-tight">{t(p.name)}</p>
              {p.role && <p class:list={['m-0 text-xs font-bold uppercase tracking-[0.18em]', p.featured ? 'tone-primary' : 'tone-accent']}>{t(p.role)}</p>}
            </div>
            {p.photo ? <img src={p.photo} alt="" class="h-16 w-16 shrink-0 rounded-full object-cover" loading="lazy" /> : !p.tag && <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-primary/15 font-display font-extrabold text-primary" aria-hidden="true">{initials(p.name)}</span>}
          </div>
          {p.bio && <p class="m-0 text-muted"><Rich text={t(p.bio)} /></p>}
        </div>
      ))}
    </div>
    {(stats?.length || lines?.length) && (
      <div class="deck-card deck-in mt-4 grid gap-4 lg:grid-cols-[auto_1fr] lg:items-center" style={`--d:${300 + people.length * 90}ms`} data-testid="deck-team-stats">
        {stats && stats.length > 0 && (
          <div class="grid gap-2">
            {statsTitle && <p class="m-0 text-xs font-bold uppercase tracking-[0.2em] text-muted">{t(statsTitle)}</p>}
            <div class="flex flex-wrap gap-x-8 gap-y-3">{stats.map((x) => <span class="grid"><span class="deck-figure tone-accent !text-[clamp(1.8rem,3vw,2.6rem)]"><Count value={t(x.value)} /></span><span class="text-sm text-muted">{t(x.label)}</span></span>)}</div>
          </div>
        )}
        {lines && lines.length > 0 && <ul class="m-0 grid list-none gap-2 p-0 text-sm text-muted">{lines.map((x) => <li><Rich text={t(x)} /></li>)}</ul>}
      </div>
    )}
    {note && <p class="deck-callout deck-in m-0 mt-4 flex items-center gap-4 !border-l-accent" style={`--d:${300 + people.length * 90}ms`}><span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-accent/60 text-accent">★</span><span><Rich text={t(note)} /></span></p>}
  </Section>
</div>

<script>
  import { mountAll } from '../runtime';
  import { init } from '../deck/client';
  mountAll('deck-team', init);
</script>
