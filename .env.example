# Supabase (si faltan, la app arranca en modo DEMO con datos fixture en memoria)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Tenant a usar cuando el Host no está mapeado (localhost, previews). Solo dev.
DEV_TENANT_SLUG=enjoy

# 1 = usar X-Forwarded-Host (solo detrás de un proxy de confianza que lo sobreescriba).
TRUST_FORWARDED_HOST=0
