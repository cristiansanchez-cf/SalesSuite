# ─── Supabase (Settings → API) ───────────────────────────────────────────────
# Sin estas dos, en desarrollo la app arranca en modo DEMO; en producción responde 503.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (NUNCA en el navegador ni en el repo). Se usa para invitar usuarios (Equipo, y el admin de una empresa
# nueva en Plataforma), para «Cambiar de espacio» sin volver a entrar (/admin/switch), en el script de alta de tenants
# y en el cron de avisos. Sin ella, invitar devuelve un aviso.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Avisos por email (docs/NOTIFICATIONS.md) ────────────────────────────────
# Resend: API key y remitente de un dominio verificado, p. ej. "Ventas <avisos@tudominio.com>".
RESEND_API_KEY=
RESEND_FROM=
# Secreto del cron: el planificador llama a /api/cron/notifications con «Authorization: Bearer <CRON_SECRET>».
CRON_SECRET=
# Opcional: origen de los enlaces de los emails si el espacio no tiene dominio principal.
PUBLIC_SITE_URL=

# ─── Leads de las webs (docs/LEADS.md) ──────────────────────────────────────
# Firma de los enlaces de baja y hash de las IP. Si falta, se usa CRON_SECRET.
LEADS_SECRET=
# WhatsApp Cloud API (Meta). Sin WHATSAPP_TOKEN, los leads solo reciben email.
WHATSAPP_TOKEN=
# Webhook de WhatsApp: el token que se pone en Meta al verificarlo y el App Secret para comprobar la firma.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Opcional: Cloudflare Turnstile (antispam invisible). Si existe, se verifica el token que mande la web.
TURNSTILE_SECRET=

# ─── IA, mapas y Google (opcionales; sin ellas, el botón correspondiente sale desactivado) ───
# Claude: agente de alta (docs/SETUP_WIZARD.md), Investigar/Apuntar/Limpiar del CRM (docs/CRM_DINAMICO.md) y
# traducir textos propios al copiar una propuesta (docs/I18N.md). Solo servidor.
ANTHROPIC_API_KEY=
# Google Places y Routes: «Buscar en Google», ruta del día, ciudades de fuera de España (docs/CRM_DINAMICO.md §12, §15, §44).
GOOGLE_MAPS_API_KEY=
# Fondo del mapa del CRM con MapTiler (estilo «Dataviz»); sin ella, OpenStreetMap (docs/CRM_DINAMICO.md §16).
MAPTILER_KEY=
# 1 = solo pruebas/demo: sin las claves de arriba, la IA y Google responden datos fijos de ejemplo sin llamar a nadie.
AI_RESEARCH_FIXTURE=0

# ─── Comportamiento ──────────────────────────────────────────────────────────
# Tenant para localhost / 127.0.0.1 (solo hosts locales; nunca se aplica a dominios públicos).
DEV_TENANT_SLUG=enjoy
# Opcional: dominio comodín de los espacios nuevos (Plataforma → Nueva empresa crea <dirección>.<esto>). docs/ORG.md
PLATFORM_DOMAIN=ventas.cofundo.io
# 1 = usar X-Forwarded-Host/Proto (solo detrás de un proxy de confianza que los sobreescriba).
# En Vercel y Cloud Run NO hace falta.
TRUST_FORWARDED_HOST=0
# 1 = permitir el modo demo (datos en memoria, login sin contraseña) en un build de producción.
# Solo para una demo pública desechable. NUNCA junto a datos reales.
DEMO_MODE=0
# Opcional: aparece en /api/health
APP_VERSION=
# Opcional (recomendable en producción): sal extra para el hash de las IP del equipo (docs/ANALYTICS.md §Internas).
IP_HASH_SALT=
# Opcional: cierres documentados necesarios antes de ordenar por datos (docs/EVIDENCE.md). Por defecto 20 con Supabase, 0 en demo.
EVIDENCE_MIN_CLOSES=
