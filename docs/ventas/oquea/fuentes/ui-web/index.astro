  <script is:inline>
    /* Auto-rotator for §Ecosystem mockup.
       - Starts (and resets to screen 1) when the section enters the
         viewport.
       - Pauses when the section is fully out of view.
       - Each item is a button: clicking jumps to that screen and
         resets the timer so the visitor has a full interval to read.
       - Respects prefers-reduced-motion (animation off, click still
         works). */
    (function () {
      var root = document.querySelector('[data-oq-featshow]');
      if (!root) return;
      var items = root.querySelectorAll('[data-oq-featshow-items] > li');
      var screens = root.querySelectorAll('[data-oq-featshow-screens] > *');
      var n = Math.min(items.length, screens.length);
      if (n < 2) return;

      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var INTERVAL = 2500;
      var current = 0;
      var timer = null;

      function show(idx) {
        current = idx;
        for (var i = 0; i < n; i++) {
          var on = i === idx;
          items[i].classList.toggle('is-active', on);
          items[i].setAttribute('aria-pressed', on ? 'true' : 'false');
          screens[i].classList.toggle('is-active', on);
        }
      }
      function tick() { show((current + 1) % n); }
      function start() {
        if (prefersReduced) return;
        if (timer) clearInterval(timer);
        timer = setInterval(tick, INTERVAL);
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function jumpTo(idx) {
        show(idx);
        start();   // reset timer so user gets a full interval to read
      }

      // Click + keyboard activation on each item
      for (var k = 0; k < items.length; k++) {
        (function (idx) {
          items[idx].addEventListener('click', function () { jumpTo(idx); });
          items[idx].addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              jumpTo(idx);
            }
          });
        })(k);
      }

      // Run only when the section is actually visible. Reset to the
      // first screen each time the user scrolls back into it.
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              show(0);
              start();
            } else {
              stop();
            }
          });
        }, { threshold: 0.25 });
        io.observe(root);
      } else {
        start();
      }
    })();
  </script>
