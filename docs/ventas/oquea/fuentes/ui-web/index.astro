---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import HeroVisual from '../components/HeroVisual.astro';
import AppBadges from '../components/AppBadges.astro';
import { absoluteUrl, ROUTES } from '../i18n/routes';
import { toJsonLd } from '../utils/jsonld';

const lang = 'es' as const;

const seo = {
  title: 'Oquea — La plataforma digital del buceo',
  description:
    'Oquea conecta centros de buceo, buceadores y destinos en una plataforma digital. Organiza operaciones, descubre experiencias y construye tu vida bajo el agua dentro de un ecosistema global.',
  lang,
  ogImage: '/img/brand/logo-navy.svg',
  ogImageAlt: 'Oquea',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: absoluteUrl(ROUTES.home.es) },
  ],
};

const cohort = [
  { icon: 'handshake', title: 'Centros fundadores bienvenidos', body: 'Buscamos los primeros centros que quieran subir al barco antes que el resto. Acompañamiento cercano y trato directo con el equipo.' },
  { icon: 'sparkle', title: 'Acceso anticipado para buceadores', body: 'Plazas limitadas para los primeros buceadores que quieran probar el logbook automático y descubrir centros de confianza.' },
  { icon: 'briefcase', title: 'Construido con la industria', body: 'Profesionales del sector — instructores, dueños de centros y organizaciones — están moldeando Oquea con nosotros.' },
];

const features = [
  {
    icon: 'calendar',
    title: 'Planificación de actividades',
    body: 'Salidas y actividades donde tu comunidad se apunta y se guarda en su logbook al instante.',
  },
  {
    icon: 'qr-code',
    title: 'Registro de inmersiones por QR',
    body: 'Cada inmersión se guarda en el logbook con un solo escaneo al final del día.',
  },
  {
    icon: 'share',
    title: 'Comparte tu inmersión',
    body: 'Datos de profundidad, tiempo y temperatura sobre tu mejor foto — listo para Stories.',
  },
  {
    icon: 'megaphone',
    title: 'CRM y fidelización',
    body: 'El motor de tu centro: convierte buceadores ocasionales en clientes que vuelven. Promociones, ofertas exclusivas y comunicación directa.',
    featured: true,
  },
  {
    icon: 'map',
    title: 'Mapa interactivo de buceo',
    body: 'Centros aliados, dive sites y rutas verificadas, listas para descubrir.',
    soon: true,
  },
  {
    icon: 'airplane',
    title: 'Viajes, ofertas flash y destinos',
    body: 'Conecta a tu comunidad con experiencias fuera del centro.',
    soon: true,
  },
];
const SOON_LABEL = 'Próximamente';

const steps = [
  { num: '01', icon: 'calendar', eyebrow: 'Centros', title: 'Los centros organizan actividades', body: 'Cada salida con su fecha, sitio, instructor y plazas. Todo en una pantalla.' },
  { num: '02', icon: 'qr-code', eyebrow: 'Buceadores', title: 'Los buceadores se apuntan y registran al instante', body: 'Llega al centro, escanea el QR del día y la inmersión queda guardada en tu perfil.' },
  { num: '03', icon: 'chart-line', eyebrow: 'Comunidad', title: 'Comunidad, viajes y conexión que crecen', body: 'Reseñas honestas, rankings, álbumes de salida y viajes que la gente quiere repetir.' },
];
---
<BaseLayout {...seo} routeKey="home">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={toJsonLd(breadcrumbJsonLd)} is:inline />
  </Fragment>

  <!-- 2 · HERO -->
  <section class="oq-hero" aria-labelledby="hero-title">
    <Container>
      <div class="oq-hero__inner">
        <div class="oq-hero__copy">
          <h1 id="hero-title" class="oq-hero__title">
            La plataforma digital que conecta centros de buceo, buceadores y destinos
          </h1>
          <p class="oq-hero__lede">
            Organiza operaciones de buceo, descubre experiencias y construye tu vida bajo el agua
            dentro de un ecosistema global en crecimiento.
          </p>
          <span class="oq-hero__microline">
            Gratis para empezar · Sin instalación · En marcha en minutos
          </span>
          <div class="oq-hero__cta">
            <Button href={ROUTES.centers.es} variant="primary">
              Para centros de buceo
              <Icon name="arrow-right" size={16} class="oq-btn__icon" />
            </Button>
            <Button href={ROUTES.divers.es} variant="ghost">Para buceadores</Button>
          </div>
        </div>

        <div class="oq-hero__visual">
          <HeroVisual lang={lang} />
        </div>
      </div>
    </Container>
  </section>

  <!-- 3 · FOUNDING COHORT -->
  <Section id="founding">
    <div class="oq-section__head oq-section__head--center reveal">
      <span class="oq-section__eyebrow">Red fundadora</span>
      <h2 class="oq-section__title">Una red global de buceo en crecimiento</h2>
      <p class="oq-section__lede">
        Empezamos por los primeros centros y buceadores que se suman al ecosistema.
        Sin métricas inventadas: cada miembro fundador cuenta.
      </p>
    </div>

    <div class="oq-cohort reveal-stagger">
      {cohort.map((item) => (
        <article class="oq-cohort__item">
          <span class="oq-cohort__icon"><Icon name={item.icon as any} size={22} /></span>
          <h3 class="oq-cohort__title">{item.title}</h3>
          <p class="oq-cohort__body">{item.body}</p>
        </article>
      ))}
    </div>

    <p class="oq-cohort__foot">
      Únete a una nueva generación de centros que se digitaliza.
    </p>
  </Section>

  <!-- 5 · ECOSYSTEM (heading inside left column · 6 rotating mockups) -->
  <Section id="features" variant="soft">
    <div class="oq-featshow reveal" data-oq-featshow>
      <div class="oq-featshow__copy">
        <span class="oq-section__eyebrow">Ecosistema</span>
        <h2 class="oq-section__title">Una plataforma para operaciones, experiencias y comunidad</h2>
        <p class="oq-section__lede">
          Todo lo que un centro y un buceador necesitan, conectado de origen.
        </p>
        <ol class="oq-featshow__list" data-oq-featshow-items>
          {features.map((f, i) => (
            <li
              class:list={['oq-featshow__item', i === 0 && 'is-active']}
              role="button"
              tabindex="0"
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-idx={i}
            >
              <span class="oq-featshow__num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <span class="oq-featshow__item-title">
                  {f.title}
                  {f.featured && (
                    <span class="oq-featshow__featured">
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="m12 2 2.6 6.6L21 9l-5 4.5L17.5 21 12 17.6 6.5 21 8 13.5 3 9l6.4-.4L12 2Z"/>
                      </svg>
                      Esencial
                    </span>
                  )}
                  {f.soon && <span class="oq-featshow__soon">{SOON_LABEL}</span>}
                </span>
                <span class="oq-featshow__item-body">{f.body}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="oq-featshow__media" aria-hidden="true">
        <span class="oq-featshow__halo"></span>
        <div class="oq-phone oq-phone--compact">
          <div class="oq-mock-screens" data-oq-featshow-screens>

            <!-- 01 · Planificación de actividades (centre-side dashboard) -->
            <div class="oq-mock-screen oq-mock-screen--plan is-active">
              <div class="oq-mock-plan__topbar">
                <span class="oq-mock-plan__brand">
                  <span class="oq-mock-plan__brandDot"></span>
                  <span class="oq-mock-plan__brandDot oq-mock-plan__brandDot--accent"></span>
                </span>
                <span class="oq-mock-plan__centreName">Cris Diving Center</span>
                <svg class="oq-mock-plan__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </div>

              <div class="oq-mock-plan__tabs">
                <span class="oq-mock-plan__tab oq-mock-plan__tab--active">Buceos</span>
                <span class="oq-mock-plan__tab">CRM</span>
                <span class="oq-mock-plan__tab">Mi centro</span>
              </div>

              <div class="oq-mock-plan__toggle">
                <span class="oq-mock-plan__pill oq-mock-plan__pill--active">Actividades</span>
                <span class="oq-mock-plan__pill">Dive site</span>
              </div>

              <div class="oq-mock-plan__sectionHead">
                <span class="oq-mock-plan__sectionTitle">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                    <path d="M3 10h18M8 3v4M16 3v4"/>
                  </svg>
                  Actividades de hoy
                </span>
                <span class="oq-mock-plan__seeAll">
                  Ver todas
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="m10 8 4 4-4 4"/>
                  </svg>
                </span>
              </div>

              <div class="oq-mock-plan__list">
                <article class="oq-mock-plan__card">
                  <div class="oq-mock-plan__cardHead">
                    <span class="oq-mock-plan__cardTitle">Salida en barco</span>
                    <span class="oq-mock-plan__logIcon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="6" y="3" width="12" height="18" rx="2"/>
                        <rect x="9" y="2" width="6" height="3" rx="1"/>
                        <path d="M9 10h6M9 14h4"/>
                      </svg>
                    </span>
                  </div>
                  <span class="oq-mock-plan__typeChip">
                    <svg viewBox="0 0 36 36" fill="currentColor" aria-hidden="true">
                      <path d="M23.95 7.61H12.5c-3.44 0-6.36 2.81-6.29 6.25.06 3.33 2.78 6.01 6.13 6.01 1.88 0 3.56-.85 4.68-2.18.59-.7 1.67-.67 2.27.02 1.2 1.42 3.05 2.28 5.09 2.14 3.06-.21 5.55-2.74 5.7-5.81.17-3.52-2.64-6.43-6.13-6.43Z"/>
                      <path d="M17.02 25.02c0 4.2 3.41 7.6 7.6 7.6s7.6-3.47 7.6-7.67V4.68h-2.21l-.03 20.21c0 2.94-2.42 5.33-5.36 5.33s-5.33-2.39-5.33-5.33"/>
                    </svg>
                    Inmersión
                  </span>
                  <div class="oq-mock-plan__meta">
                    <span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"/>
                        <path d="M12 7v5l3 2"/>
                      </svg>
                      9:00
                    </span>
                    <span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="16" rx="2"/>
                        <path d="M3 10h18M8 3v4M16 3v4"/>
                      </svg>
                      15/02/2026
                    </span>
                    <span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 21s7-7 7-12a7 7 0 1 0-14 0c0 5 7 12 7 12Z"/>
                        <circle cx="12" cy="9" r="2.5"/>
                      </svg>
                      Shark Point
                    </span>
                    <span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="9" cy="7" r="3"/>
                        <path d="M2 21c0-3 3-5 7-5s7 2 7 5"/>
                        <circle cx="17" cy="7" r="2.5"/>
                      </svg>
                      6 buceadores
                    </span>
                  </div>
                  <div class="oq-mock-plan__cardSep"></div>
                  <div class="oq-mock-plan__actions">
                    <span class="oq-mock-plan__actionEdit">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m4 20 4-1 11-11-3-3L5 16l-1 4Z"/>
                      </svg>
                      Editar
                    </span>
                    <span class="oq-mock-plan__actionDelete">Eliminar</span>
                  </div>
                </article>

                <article class="oq-mock-plan__card">
                  <div class="oq-mock-plan__cardHead">
                    <span class="oq-mock-plan__cardTitle">Buceo nocturno — Shark Point</span>
                    <span class="oq-mock-plan__logIcon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="6" y="3" width="12" height="18" rx="2"/>
                        <rect x="9" y="2" width="6" height="3" rx="1"/>
                        <path d="M9 10h6M9 14h4"/>
                      </svg>
                    </span>
                  </div>
                  <span class="oq-mock-plan__typeChip">
                    <svg viewBox="0 0 36 36" fill="currentColor" aria-hidden="true">
                      <path d="M23.95 7.61H12.5c-3.44 0-6.36 2.81-6.29 6.25.06 3.33 2.78 6.01 6.13 6.01 1.88 0 3.56-.85 4.68-2.18.59-.7 1.67-.67 2.27.02 1.2 1.42 3.05 2.28 5.09 2.14 3.06-.21 5.55-2.74 5.7-5.81.17-3.52-2.64-6.43-6.13-6.43Z"/>
                      <path d="M17.02 25.02c0 4.2 3.41 7.6 7.6 7.6s7.6-3.47 7.6-7.67V4.68h-2.21l-.03 20.21c0 2.94-2.42 5.33-5.36 5.33s-5.33-2.39-5.33-5.33"/>
                    </svg>
                    Inmersión
                  </span>
                  <div class="oq-mock-plan__meta">
                    <span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"/>
                        <path d="M12 7v5l3 2"/>
                      </svg>
                      20:00
                    </span>
                    <span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="16" rx="2"/>
                        <path d="M3 10h18M8 3v4M16 3v4"/>
                      </svg>
                      15/02/2026
                    </span>
                    <span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 21s7-7 7-12a7 7 0 1 0-14 0c0 5 7 12 7 12Z"/>
                        <circle cx="12" cy="9" r="2.5"/>
                      </svg>
                      Shark Point
                    </span>
                    <span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="9" cy="7" r="3"/>
                        <path d="M2 21c0-3 3-5 7-5s7 2 7 5"/>
                        <circle cx="17" cy="7" r="2.5"/>
                      </svg>
                      3 buceadores
                    </span>
                  </div>
                </article>
              </div>

              <div class="oq-mock-plan__sectionDiv"></div>

              <div class="oq-mock-plan__sectionHead" style="padding-top: 8px;">
                <span class="oq-mock-plan__sectionTitle">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                    <path d="M3 10h18M8 3v4M16 3v4"/>
                  </svg>
                  Próximas actividades
                </span>
                <span class="oq-mock-plan__seeAll">Ver todas</span>
              </div>

              <div class="oq-mock-plan__peek">
                <div class="oq-mock-plan__peekBody">
                  <span class="oq-mock-plan__peekTitle">Open Water — Carlos</span>
                  <span class="oq-mock-plan__peekMeta">9:00 · Shark Point · 1 alumno</span>
                </div>
                <span class="oq-mock-plan__peekDate">18 feb</span>
              </div>
            </div>

            <!-- 02 · Registro de inmersiones por QR -->
            <div class="oq-mock-screen oq-mock-screen--qr">
              <div class="oq-mock-qr__topbar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m15 6-6 6 6 6"/>
                </svg>
                <span>Actividades de hoy</span>
              </div>

              <div class="oq-mock-qr__hero">
                <div class="oq-mock-qr__sky"></div>
                <div class="oq-mock-qr__shimmer"></div>
                <div class="oq-mock-qr__beach"></div>
                <div class="oq-mock-qr__fade"></div>
                <div class="oq-mock-qr__heroContent">
                  <span class="oq-mock-qr__heroTitle">Inmersión a las 9:00</span>
                  <span class="oq-mock-qr__heroPill">Inmersión recreativa</span>
                  <div class="oq-mock-qr__heroMeta">
                    <span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 21s7-6.5 7-11.5a7 7 0 0 0-14 0C5 14.5 12 21 12 21Z"/>
                        <circle cx="12" cy="9.5" r="2.5"/>
                      </svg>
                      Maldivas
                    </span>
                    <span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3.5" y="5" width="17" height="15.5" rx="2"/>
                        <path d="M3.5 10h17"/><path d="M8 3.5v3"/><path d="M16 3.5v3"/>
                      </svg>
                      26/02/2026
                    </span>
                    <span>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
                      </svg>
                      08:35
                    </span>
                  </div>
                </div>
              </div>

              <div class="oq-mock-qr__dots">
                <span class="is-active"></span><span></span><span></span>
              </div>

              <div class="oq-mock-qr__content">
                <div class="oq-mock-qr__cta">
                  <span class="oq-mock-qr__ctaIcon">
                    <svg viewBox="0 0 36 36" fill="none" aria-hidden="true">
                      <path d="M31.99 17.28h-3.66V10.54h3.66c1.14 0 2.06.92 2.06 2.06v2.62c0 1.14-.92 2.06-2.06 2.06Z" fill="#FFFFFF"/>
                      <path d="M7.96 17.27H4.31c-1.14 0-2.06-.92-2.06-2.06v-2.62c0-1.14.92-2.06 2.06-2.06h3.65v6.74Z" fill="#FFFFFF"/>
                      <path d="M23.95 7.61H12.5c-3.44 0-6.36 2.81-6.29 6.25.06 3.33 2.78 6.01 6.13 6.01 1.88 0 3.56-.85 4.68-2.18.59-.7 1.67-.67 2.27.02 1.2 1.42 3.05 2.28 5.09 2.14 3.06-.21 5.55-2.74 5.7-5.81.17-3.52-2.64-6.43-6.13-6.43Z" fill="#C8DBF5" stroke="#FFFFFF" stroke-width="1.99" stroke-miterlimit="10"/>
                      <path d="M10 7.5h2l-4 9-2-1.64L10 7.5Z" fill="#E4EDFA"/>
                      <path d="m12.93 7.69 1.48.23-4.84 11.39-1.48-.23 4.84-11.39Z" fill="#E4EDFA"/>
                      <path d="M17.02 25.02c0 4.2 3.41 7.6 7.6 7.6s7.6-3.47 7.6-7.67V4.68h-2.21l-.03 20.21c0 2.94-2.42 5.33-5.36 5.33s-5.33-2.39-5.33-5.33" fill="#FFFFFF"/>
                      <path d="M21.13 24.02c0 .6-.49 1.08-1.09 1.08h-3.69c-.6 0-1.09-.49-1.09-1.08 0-.6.49-1.09 1.09-1.09h3.69c.6 0 1.09.49 1.09 1.09Z" fill="#FFFFFF"/>
                      <path d="M32.75 4.12c0 .41-.33.75-.75.75h-1.75c-.41 0-.75-.33-.75-.75 0-.41.33-.75.75-.75H32c.41 0 .75.33.75.75Z" fill="#FFFFFF"/>
                    </svg>
                  </span>
                  <div class="oq-mock-qr__ctaText">
                    <span class="oq-mock-qr__ctaTitle">Guardar en mi logbook</span>
                    <span class="oq-mock-qr__ctaSub">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"/>
                        <path d="M3.5 12h17"/>
                        <path d="M12 3c2 3 3 6 3 9s-1 6-3 9c-2-3-3-6-3-9s1-6 3-9Z"/>
                      </svg>
                      Registra esta inmersión en OQUEA
                    </span>
                  </div>
                </div>

                <div class="oq-mock-qr__actions">
                  <div class="oq-mock-qr__action">
                    <span class="oq-mock-qr__actionIcon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3.5" y="3.5" width="17" height="17" rx="2.5"/>
                        <circle cx="9" cy="9.5" r="2"/>
                        <path d="m21 16-5-5-9 9"/>
                      </svg>
                    </span>
                    <span class="oq-mock-qr__actionTitle">Ver fotos y vídeos</span>
                    <span class="oq-mock-qr__actionSub">125 archivos</span>
                  </div>
                  <div class="oq-mock-qr__action">
                    <span class="oq-mock-qr__actionIcon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="6" y="3" width="12" height="18" rx="2.5"/>
                        <path d="M10 17.5h4"/>
                      </svg>
                    </span>
